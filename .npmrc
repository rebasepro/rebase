# Use workspace protocol for local packages
link-workspace-packages=true

# Disable automatic dependency check before running scripts to prevent background install failures in read-only environments
verify-deps-before-run=false

# Hoist dependencies to root when possible
hoist=true

# Force hoist types to ensure consistency across monorepo
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=express

# Save exact versions
save-exact=true

# Use the node_modules layout that's compatible with most tools
node-linker=hoisted

# Automatically install peer dependencies
auto-install-peers=true

# Store location (optional - customize if needed)
# store-dir=~/.pnpm-store
prefer-workspace-packages=true

# How new a version may be before this repo will install it, in minutes.
#
# Three days. The attack this bounds is the one that actually happens to npm: a
# maintainer account is compromised, a malicious version is published, and it is
# found and unpublished within hours — so the whole exposure is the window
# between the publish and the discovery. Waiting the window out is a cheap way
# not to be in it, and it costs nothing here because versions are pinned exactly
# (`save-exact`) and CI installs from a frozen lockfile.
#
# This said `0`, above a comment reading "Temporarily disable release age policy
# for @firecms/neat canary — remove once the package is >24h old". The package
# has been released for two months. A temporary measure with no expiry is a
# permanent one, and this one turned the protection off for every dependency in
# the tree to unblock a single canary.
#
# To take a genuinely fresh version, pass it deliberately for that one install
# rather than lowering it here again:
#     pnpm add <pkg> --config.minimum-release-age=0
minimum-release-age=4320
