# Use workspace protocol for local packages
link-workspace-packages=true

# Disable automatic dependency check before running scripts to prevent background install failures in read-only environments
verify-deps-before-run=false

# Hoist dependencies to root when possible
hoist=true

# Force hoist Express types to ensure consistency across monorepo
public-hoist-pattern[]=@types/express*
public-hoist-pattern[]=express

# Save exact versions
save-exact=true

# Use the node_modules layout that's compatible with most tools
node-linker=hoisted

# Automatically install peer dependencies
auto-install-peers=true

# Store location (optional - customize if needed)
# store-dir=~/.pnpm-store
prefer-workspace-packages=true

# Temporarily disable release age policy for @firecms/neat canary
# Remove once the package is >24h old
minimum-release-age=0
