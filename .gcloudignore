# node_modules everywhere
**/node_modules/
**/.git/
**/dist/
**/build/
**/.DS_Store
# Secrets.
#
# `**/.env` alone was not enough, and the gap was not obvious: this file
# EXISTING is what makes gcloud stop consulting .gitignore, so everything
# gitignored is uploaded unless it is also named here. `**/.env.prod` is not
# `**/.env`, and the control plane's copy of it carries the production
# database password.
#
# The `!` line keeps the checked-in examples, which are the only .env.* files
# that belong in a build context.
**/.env
**/.env.*
!**/.env.example
!**/.env.template

# The Cloud control plane. A separate, PRIVATE repository that happens to live
# inside this tree, and nothing in it is needed to build the demo image — so
# every demo deploy was tarring a private source tree into a bucket whose read
# access is much wider than that repository's.
/saas/

**/test-output.txt
**/eslint-errors*.json
**/lerna-debug.log

# Exclude large development/test folders not needed for SaaS build
/test-cli-init-project/
/scratch/
/.yarn/
# /app/
/website/
/tests/
/videos/
/.idea/
/.vscode/
/.astro/

# Terraform state and provider cache (not needed for Docker builds, contains secrets)
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/.terraform.tfstate.lock.info

# Exclude untracked WIP admin components that fail Cloud Build compilation
/packages/cms/src/components/LogsExplorer.tsx
/packages/cms/src/components/SchemaVisualizer.tsx

# Exclude large logs and reports
/eslint_report.json
/*.log
/yarn.lock

# Claude Code worktrees + session data — each worktree is a full repo checkout
# (1.6 GB+ combined, ~60% of the upload), carrying website videos and assets.
# Never needed for a build; the single biggest source of upload bloat and the
# likely cause of stalled source uploads.
.claude/

# Local tooling caches
/.fallow/
**/.astro/

# Port file written by a running `rebase dev`. It is rewritten and removed
# while the server runs, so gcloud can enumerate it and then fail to read it
# mid-tar — the upload dies with `FileNotFoundError: app/.rebase-dev-port`
# and the deploy never reaches Cloud Build.
**/.rebase-dev-port

/.artifacts/
