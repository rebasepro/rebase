# node_modules everywhere
**/node_modules/
**/.git/
**/dist/
**/build/
**/.DS_Store
**/.env
**/test-output.txt
**/eslint-errors*.json
**/lerna-debug.log

# Exclude large development/test folders not needed for SaaS build
/test-cli-init-project/
/scratch/
/.yarn/
# /app/
/website/
/e2e/
/videos/
/playwright-report/
/test-results/
/.idea/
/.vscode/
/.astro/

# Terraform state and provider cache (not needed for Docker builds, contains secrets)
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/.terraform.tfstate.lock.info

# Exclude untracked WIP admin components that fail Cloud Build compilation
/packages/admin/src/components/LogsExplorer.tsx
/packages/admin/src/components/SchemaVisualizer.tsx

# Exclude large logs and reports
/eslint_report.json
/*.log
/yarn.lock

