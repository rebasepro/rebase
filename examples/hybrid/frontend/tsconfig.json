{
  // Typechecked against the workspace's SOURCE (as examples/firebase is), so
  // `pnpm check:examples` reads this checkout, not whatever `dist` was last
  // built. A project outside the monorepo drops `extends`, `rootDir` and `paths`.
  "extends": "../../../packages/app/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "rootDir": "../../..",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@rebasepro/app": ["../../../packages/app/src"],
      "@rebasepro/app/vitePlugin": ["../../../packages/app/src/vitePlugin"],
      "@rebasepro/client": ["../../../packages/client/src"],
      "@rebasepro/cms": ["../../../packages/cms/src"],
      "@rebasepro/cms-types": ["../../../packages/cms-types/src"],
      "@rebasepro/common": ["../../../packages/common/src"],
      "@rebasepro/firebase": ["../../../packages/firebase/src"],
      "@rebasepro/types": ["../../../packages/types/src"],
      "@rebasepro/ui": ["../../../packages/ui/src"],
      "@rebasepro/server/schema": ["../../../packages/server/src/schema/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
