# Your Firebase project, from Project settings → Your apps in the console.
#
# Copy this file to `.env` and fill it in. None of these are secrets — a
# Firebase web config identifies the project and the security rules are what
# protect the data — but they name YOUR project, and the reason they are not
# committed is that a live project's config in a public example is an invitation
# to spend its quota and probe its rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
