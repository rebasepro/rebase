---
import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

import Layout from '../../layouts/Layout.astro';

const title = "Rebase Studio — Visual Admin Panel for Postgres";
const description = "A full-featured admin panel that generates real TypeScript code. Schema editor, SQL editor, RLS policies, Kanban boards, rich text, storage, and more.";

import StudioContent from '../../components/pages/StudioContent.astro';
const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "Studio", url: "https://rebase.pro/studio" }
];
---
<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
    <StudioContent lang={currentLang} t={t} />
</Layout>
