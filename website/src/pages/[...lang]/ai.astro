---
import { languages, defaultLang, useTranslations, useTranslatedPath } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

import Layout from '../../layouts/Layout.astro';
import AiContent from '../../components/pages/AiContent.astro';

const title = t("ai.meta.title");
const description = t("ai.meta.description");

const translatePath = useTranslatedPath(currentLang as keyof typeof languages);
const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "AI & Agents", url: "https://rebase.pro/ai" }
];
---
<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
    <script is:inline slot="head" define:vars={{ targetUrl: translatePath("/product") }}>
      (function() {
        try {
          if (document.documentElement.getAttribute('data-ab-navigation-structure') === 'flat-nav') {
            window.location.replace(targetUrl);
          }
        } catch(e) {}
      })();
    </script>
    <AiContent lang={currentLang} t={t} />
</Layout>
