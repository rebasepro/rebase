---

import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

import Layout from '../../layouts/Layout.astro';

const title = t("waitlist.meta.title");
const description = t("waitlist.meta.description");
import WaitlistContent from '../../components/pages/WaitlistContent.astro';
---
<Layout title={title} description={description}>
    <WaitlistContent lang={currentLang} t={t} />
</Layout>
