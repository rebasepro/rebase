---

import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

import Layout from '../../layouts/Layout.astro';

const title = "Rebase for Developers — SDK, CLI, Security & Extensibility";
const description = "TypeScript SDK, CLI scaffolding, React extensibility, row-level security, and self-hosted deployment. Build with full control.";

import DevelopersHubContent from '../../components/pages/DevelopersHubContent.astro';
const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "Developers", url: "https://rebase.pro/developers-hub" }
];
---
<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
    <DevelopersHubContent lang={currentLang} t={t} />
</Layout>
