---

import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

import Layout from '../../layouts/Layout.astro';

const title = t("rebase-vs-django.meta.title");
const description = t("rebase-vs-django.meta.description");

import RebaseVsDjangoContent from '../../components/pages/RebaseVsDjangoContent.astro';
const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "Rebase vs Django (Laravel)", url: "https://rebase.pro/rebase-vs-django" }
];
---
<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
    <RebaseVsDjangoContent lang={currentLang} t={t} />
</Layout>
