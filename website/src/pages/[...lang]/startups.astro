---

import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

import Layout from '../../layouts/Layout.astro';

const title = t("startups.meta.title");
const description = t("startups.meta.description");


import StartupsContent from '../../components/pages/StartupsContent.astro';
const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "Startups", url: "https://rebase.pro/startups" }
];
---
<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
    <StartupsContent lang={currentLang} t={t} />
</Layout>
