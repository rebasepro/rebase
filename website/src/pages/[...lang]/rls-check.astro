---
import { languages, defaultLang, useTranslations } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import RlsCheckContent from '../../components/pages/RlsCheckContent.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

const title = "Free Postgres RLS audit — check your row-level security in one command";
const description =
    "rls-check is a free, read-only Row-Level Security audit for any PostgreSQL database. Fourteen checks "
    + "for the failures that make Postgres leak: RLS disabled on exposed tables, policies that are always "
    + "true, views that read past their base table. Works on Supabase, Neon, RDS. No account, no install.";

const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "RLS check", url: "https://rebase.pro/rls-check" }
];
---
<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
    <RlsCheckContent lang={currentLang} t={t} />
</Layout>
