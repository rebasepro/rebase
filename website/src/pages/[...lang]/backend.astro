---
import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

import Layout from '../../layouts/Layout.astro';
import BackendContent from '../../components/pages/BackendContent.astro';

const title = t("backend.meta.title");
const description = t("backend.meta.description");

const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "Backend & APIs", url: "https://rebase.pro/backend" }
];
---
<Layout ogImage="https://rebase.pro/img/og/backend.png" title={title} description={description} breadcrumbs={breadcrumbs}>
    <BackendContent lang={currentLang} t={t} />
</Layout>
