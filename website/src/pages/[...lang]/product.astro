---

import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

import Layout from '../../layouts/Layout.astro';

const title = "Rebase — The complete Postgres application platform";
const description = "Admin panel, APIs, SDK, security, and AI — all generated from your Postgres schema. One framework, everything you need.";

import ProductContent from '../../components/pages/ProductContent.astro';
const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "Product", url: "https://rebase.pro/product" }
];
---
<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
    <ProductContent lang={currentLang} t={t} />
</Layout>
