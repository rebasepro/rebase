---

import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

import Layout from '../../layouts/Layout.astro';

// Routed through t() like every other page. These two were hardcoded in English,
// so /es/product, /de/product and /fr/product shipped an English title and
// description while the localized product.meta.* keys went unread. The keys now
// carry this exact copy — they had drifted to "Rebase Product Ecosystem", so
// switching to t() first would have downgraded the English.
const title = t("product.meta.title");
const description = t("product.meta.description");

import ProductContent from '../../components/pages/ProductContent.astro';
const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "Product", url: "https://rebase.pro/product" }
];
---
<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
    <ProductContent lang={currentLang} t={t} />
</Layout>
