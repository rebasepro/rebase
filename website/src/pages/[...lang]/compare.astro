---

import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

import Layout from '../../layouts/Layout.astro';

const title = "Rebase compared — Supabase, Directus, Strapi, Retool and the rest";
const description = "An honest side-by-side: where Rebase wins, where a competitor is the better call, and what the trade-offs actually are.";

import CompareContent from '../../components/pages/CompareContent.astro';
const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "Compare", url: "https://rebase.pro/compare" }
];
---
<Layout ogImage="https://rebase.pro/img/og/compare.png" title={title} description={description} breadcrumbs={breadcrumbs}>
    <CompareContent lang={currentLang} t={t} />
</Layout>
