---
import Layout from '../../layouts/Layout.astro';
import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

const title = t("index.meta.title");
const description = t("index.meta.description");

// Home v2. IndexContent.astro is left in place untouched — reverting is one
// line: swap this import and the tag below back.
import IndexV2Content from '../../components/pages/IndexV2Content.astro';
---
<Layout title={title} description={description} lang={currentLang}>
    <IndexV2Content lang={currentLang} t={t} />
</Layout>
