---
import Layout from '../../layouts/Layout.astro';
import { languages, defaultLang, useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

const title = t("demo.meta.title");
const description = t("demo.meta.description");

import DemoContent from '../../components/pages/DemoContent.astro';
---
<Layout title={title} description={description} lang={currentLang} showBanner={false}>
    <DemoContent lang={currentLang} t={t} />
</Layout>
