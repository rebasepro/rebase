---
/**
 * The site-wide 404. Firebase Hosting serves dist/404.html for every path it
 * cannot resolve — marketing pages and docs alike — so the ways out cover both.
 * English only: Hosting has one 404 for the whole site.
 */
import Layout from "../layouts/Layout.astro";
import { DEMO_URL } from "../utils/links";

const destinations = [
    { href: "/docs/getting-started/quickstart", label: "Quickstart", note: "a backend running against your Postgres" },
    { href: "/product", label: "Product", note: "the backend and the panel, layer by layer" },
    { href: "/rls-check", label: "rls-check", note: "audit row-level security on any Postgres" },
    { href: "/pricing", label: "Pricing", note: "free to self-host, per resource on Rebase Cloud" },
    { href: "/blog", label: "Blog", note: "guides, comparisons and product updates" }
];
---
<Layout title="Page not found — Rebase" description="That page does not exist. It may have moved, or the link may be out of date." noindex>
    <section class="relative isolate overflow-hidden hero-under-nav pb-chapter">
        <div class="px-6 mx-auto max-w-6xl lg:px-12">
            <p class="font-mono text-sm text-surface-500 mb-6">404</p>
            <h1 class="mb-6 text-display-2 text-white">This page doesn’t exist.</h1>
            <p class="mb-10 max-w-2xl text-lg leading-8 text-surface-300 lg:text-xl">
                It may have moved, or the link may be out of date.
            </p>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                <a href="/"
                   class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark transition-colors"
                   data-track id="404-home">
                    Go to the home page
                </a>
                <a href="/docs" class="inline-flex items-center gap-x-2 text-white hover:text-primary-light transition-colors font-semibold"
                   data-track id="404-docs">
                    Read the docs
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
                <a href={DEMO_URL} target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-x-2 text-white hover:text-primary-light transition-colors font-semibold"
                   data-track id="404-demo">
                    Try the demo
                </a>
            </div>

            <h2 class="mt-20 mb-4 text-sm font-medium uppercase tracking-wider text-surface-400">Where people usually go</h2>
            <ul class="max-w-2xl divide-y divide-surface-800 border-y border-surface-800">
                {destinations.map((d) => (
                    <li>
                        <a href={d.href} class="group flex flex-wrap items-baseline gap-x-3 py-4">
                            <span class="font-semibold text-white group-hover:text-primary-light transition-colors">{d.label}</span>
                            <span class="text-surface-400">{d.note}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>
</Layout>
