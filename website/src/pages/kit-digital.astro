---
import Layout from '../layouts/Layout.astro';
import SectionBackgroundAccents from "../components/SectionBackgroundAccents.astro";

const title = "Programa Kit Digital – Rebase como Agente Digitalizador";
const description = "Rebase es Agente Digitalizador adherido al Programa Kit Digital. Descubre nuestras soluciones de digitalización subvencionadas para pymes y autónomos en España.";

const breadcrumbs = [
    { name: "Inicio", url: "https://rebase.pro" },
    { name: "Kit Digital", url: "https://rebase.pro/kit-digital" }
];

const solutions = [
    {
        slug: "gestion-de-procesos",
        category: "Gestión de Procesos",
        name: "Rebase Process Manager",
        allSectors: true,
        description: "Panel de administración inteligente sobre PostgreSQL para digitalizar y automatizar los procesos internos de tu negocio: gestión de inventarios, proyectos, recursos humanos, logística y flujos de trabajo personalizados.",
        features: [
            "Gestión de inventarios y stock en tiempo real",
            "Gestión de proyectos y tareas con flujos personalizados",
            "Automatización de procesos de negocio con reglas configurables",
            "Panel de control centralizado con roles y permisos",
            "API REST para integración con sistemas existentes",
            "Copias de seguridad y auditoría de cambios",
        ],
        segments: [
            { name: "Segmento I", range: "10–49 empleados", amount: "Hasta 6.000 €" },
            { name: "Segmento II", range: "3–9 empleados", amount: "Hasta 2.000 €" },
            { name: "Segmento III", range: "0–2 empleados", amount: "Hasta 1.000 €" },
        ],
        sectors: "Comercio, hostelería, industria, servicios profesionales, construcción, transporte, salud, educación, agricultura, turismo y cualquier otro sector productivo.",
    },
    {
        slug: "business-intelligence",
        category: "Business Intelligence y Analítica",
        name: "Rebase Analytics Dashboard",
        allSectors: true,
        description: "Solución de inteligencia de negocio basada en PostgreSQL que permite visualizar, analizar y explotar los datos de tu empresa mediante cuadros de mando interactivos y reportes personalizados.",
        features: [
            "Cuadros de mando personalizables con visualización de datos en tiempo real",
            "Conexión directa a tu base de datos PostgreSQL sin duplicar datos",
            "Filtros avanzados, búsquedas y segmentación de información",
            "Exportación de informes en múltiples formatos (CSV, Excel, JSON)",
            "Control de acceso por roles para proteger datos sensibles",
            "Integración con herramientas externas vía API",
        ],
        segments: [
            { name: "Segmento I", range: "10–49 empleados", amount: "Hasta 4.000 €" },
            { name: "Segmento II", range: "3–9 empleados", amount: "Hasta 2.000 €" },
            { name: "Segmento III", range: "0–2 empleados", amount: "Hasta 1.500 €" },
        ],
        sectors: "Retail, logística, fabricación, servicios, alimentación, turismo, tecnología, sanidad, educación y cualquier otro sector productivo.",
    },
    {
        slug: "gestion-de-clientes",
        category: "Gestión de Clientes (CRM)",
        name: "Rebase CRM",
        allSectors: true,
        description: "Sistema de gestión de relaciones con clientes construido sobre PostgreSQL para centralizar contactos, oportunidades de venta, seguimiento comercial y comunicación con clientes.",
        features: [
            "Base de datos centralizada de clientes y contactos",
            "Seguimiento de oportunidades y pipeline comercial",
            "Gestión de interacciones y comunicaciones",
            "Segmentación de clientes por criterios personalizables",
            "Informes y métricas de actividad comercial",
            "Acceso multi-usuario con permisos por rol",
        ],
        segments: [
            { name: "Segmento I", range: "10–49 empleados", amount: "Hasta 4.000 €" },
            { name: "Segmento II", range: "3–9 empleados", amount: "Hasta 2.000 €" },
            { name: "Segmento III", range: "0–2 empleados", amount: "Hasta 2.000 €" },
        ],
        sectors: "Servicios profesionales, consultoría, comercio, inmobiliaria, seguros, educación, industria y cualquier otro sector productivo.",
    },
    {
        slug: "sitio-web",
        category: "Sitio Web y Presencia Básica en Internet",
        name: "Rebase Web Presence",
        allSectors: true,
        description: "Creación y gestión de sitio web profesional con CMS headless sobre PostgreSQL, optimizado para SEO, responsive y con panel de administración intuitivo para actualizar contenidos sin conocimientos técnicos.",
        features: [
            "Diseño responsive y optimizado para móviles",
            "Gestión de contenidos con editor visual intuitivo",
            "Optimización SEO: posicionamiento en buscadores",
            "Dominio propio y certificado SSL incluido",
            "Multi-idioma y accesibilidad (WCAG)",
            "Analítica web integrada",
        ],
        segments: [
            { name: "Segmento I", range: "10–49 empleados", amount: "Hasta 2.000 €" },
            { name: "Segmento II", range: "3–9 empleados", amount: "Hasta 2.000 €" },
            { name: "Segmento III", range: "0–2 empleados", amount: "Hasta 2.000 €" },
        ],
        sectors: "Autónomos, comercios, restaurantes, profesionales liberales, artesanos, startups, industria y cualquier otro sector productivo.",
    },
    {
        slug: "comercio-electronico",
        category: "Comercio Electrónico",
        name: "Rebase E-Commerce",
        allSectors: true,
        description: "Plataforma de comercio electrónico gestionada con Rebase sobre PostgreSQL para vender productos y servicios online con catálogo, carrito de compra, pasarela de pago y gestión de pedidos.",
        features: [
            "Catálogo de productos con variantes, precios e imágenes",
            "Carrito de compra y proceso de checkout seguro",
            "Integración con pasarelas de pago (Stripe, Redsys, PayPal)",
            "Gestión de pedidos, envíos y devoluciones",
            "Panel de administración para gestionar stock y precios",
            "SEO optimizado para tiendas online",
        ],
        segments: [
            { name: "Segmento I", range: "10–49 empleados", amount: "Hasta 2.000 €" },
            { name: "Segmento II", range: "3–9 empleados", amount: "Hasta 2.000 €" },
            { name: "Segmento III", range: "0–2 empleados", amount: "Hasta 2.000 €" },
        ],
        sectors: "Retail, moda, alimentación, artesanía, tecnología, servicios, hostelería y cualquier otro sector productivo.",
    },
];
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
    <Fragment slot="head">
        <meta name="robots" content="index, follow">
        <html lang="es" />
    </Fragment>

    <main>
        <!-- Hero Section -->
        <section class="relative isolate overflow-hidden bg-linear-to-br from-black to-surface-950 pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
            <SectionBackgroundAccents topLine={true} blob={{ position: "top", size: "lg", opacity: 60 }}>
                <div class="absolute -bottom-40 right-1/3 w-[700px] h-[700px] rounded-full bg-blue-500/5 blur-3xl opacity-50"></div>
                <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:40px_40px] opacity-10"></div>
            </SectionBackgroundAccents>

            <div class="px-4 mx-auto max-w-7xl text-center lg:px-12">
                <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 border border-primary/20 px-4 py-1.5 text-sm font-medium text-primary-light mb-8">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                    </svg>
                    Agente Digitalizador Adherido
                </div>
                <h1 class="mb-6 text-4xl font-medium tracking-tight md:text-5xl lg:text-6xl text-white font-sans">
                    Programa <span class="gradient-text">Kit Digital</span>
                </h1>
                <p class="mb-6 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48">
                    Rebase es <strong>Agente Digitalizador</strong> adherido al Programa Kit Digital, financiado por los fondos europeos <strong>Next Generation EU</strong> dentro del Plan de Recuperación, Transformación y Resiliencia del Gobierno de España.
                </p>
                <p class="mb-10 text-base leading-7 text-surface-400 sm:px-16 xl:px-48">
                    Ofrecemos soluciones de digitalización subvencionadas para pymes y autónomos. Consulta a continuación nuestro catálogo de soluciones por categoría y segmento de beneficiario.
                </p>
                <div class="flex items-center justify-center gap-4 flex-wrap">
                    <a href="#soluciones"
                       class="inline-flex items-center gap-x-2 rounded-md bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-all duration-200 ease-in-out btn-glow">
                        Ver Soluciones
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </a>
                    <a href="/contact"
                       class="inline-flex items-center gap-x-2 rounded-md border border-surface-700 bg-surface-800 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-surface-700 transition-all duration-200 ease-in-out">
                        Solicitar Información
                    </a>
                </div>
            </div>
        </section>

        <!-- Logos institucionales -->
        <section class="bg-black py-12 border-b border-surface-800">
            <div class="mx-auto max-w-5xl px-6 lg:px-8">
                <p class="text-center text-sm text-surface-400 mb-8">Programa financiado por:</p>
                <div class="flex items-center justify-center gap-8 flex-wrap">
                    <div class="flex flex-col items-center gap-2 px-6 py-4 rounded-xl bg-white/5 ring-1 ring-surface-800">
                        <span class="text-xs text-surface-400 uppercase tracking-wider">Plan de Recuperación</span>
                        <span class="text-sm font-semibold text-white">Gobierno de España</span>
                    </div>
                    <div class="flex flex-col items-center gap-2 px-6 py-4 rounded-xl bg-white/5 ring-1 ring-surface-800">
                        <span class="text-xs text-surface-400 uppercase tracking-wider">Financiado por</span>
                        <span class="text-sm font-semibold text-white">Next Generation EU</span>
                    </div>
                    <div class="flex flex-col items-center gap-2 px-6 py-4 rounded-xl bg-white/5 ring-1 ring-surface-800">
                        <span class="text-xs text-surface-400 uppercase tracking-wider">Gestionado por</span>
                        <span class="text-sm font-semibold text-white">Red.es</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ¿Qué es el Kit Digital? -->
        <section class="bg-black py-16 sm:py-24">
            <div class="mx-auto max-w-4xl px-6 lg:px-8">
                <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-8 text-center">¿Qué es el Kit Digital?</h2>
                <div class="prose prose-lg prose-invert max-w-none">
                    <p class="text-lg text-surface-300 leading-relaxed mb-6">
                        El <strong>Programa Kit Digital</strong> es una iniciativa del Gobierno de España, gestionada por Red.es y financiada con fondos europeos Next Generation EU, que tiene como objetivo subvencionar la implantación de soluciones digitales disponibles en el mercado para pymes y autónomos con el fin de mejorar su competitividad y nivel de madurez digital.
                    </p>
                    <p class="text-lg text-surface-300 leading-relaxed mb-6">
                        Los beneficiarios reciben un <strong>bono digital</strong> que pueden canjear por soluciones de digitalización ofrecidas por Agentes Digitalizadores adheridos al programa, como Rebase.
                    </p>
                </div>

                <!-- Segmentos -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
                    <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-6 ring-1 ring-inset ring-surface-800 text-center">
                        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 mx-auto mb-4">
                            <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-white mb-2">Segmento I</h3>
                        <p class="text-surface-400 text-sm">Empresas de <strong class="text-white">10 a 49 empleados</strong></p>
                        <p class="text-primary font-semibold mt-2">Hasta 12.000 € de bono</p>
                    </div>
                    <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-6 ring-1 ring-inset ring-surface-800 text-center">
                        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 mx-auto mb-4">
                            <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-white mb-2">Segmento II</h3>
                        <p class="text-surface-400 text-sm">Empresas de <strong class="text-white">3 a 9 empleados</strong></p>
                        <p class="text-primary font-semibold mt-2">Hasta 6.000 € de bono</p>
                    </div>
                    <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-6 ring-1 ring-inset ring-surface-800 text-center">
                        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 mx-auto mb-4">
                            <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-white mb-2">Segmento III</h3>
                        <p class="text-surface-400 text-sm">Autónomos y empresas de <strong class="text-white">0 a 2 empleados</strong></p>
                        <p class="text-primary font-semibold mt-2">Hasta 2.000 € de bono</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Catálogo de Soluciones -->
        <section id="soluciones" class="bg-black py-16 sm:py-24 scroll-mt-20">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <div class="mx-auto max-w-3xl text-center mb-16">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Nuestras Soluciones de Digitalización</h2>
                    <p class="mt-6 text-lg leading-8 text-surface-400">Catálogo de soluciones subvencionables por el Programa Kit Digital, distribuidas por categoría y segmento de beneficiario.</p>
                </div>

                <div class="space-y-12">
                    {solutions.map((sol, idx) => (
                        <div class="relative overflow-hidden rounded-2xl bg-surface-900/30 ring-1 ring-inset ring-surface-800 p-8 lg:p-10" id={sol.slug}>
                            <!-- Category badge -->
                            <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 border border-primary/20 px-3 py-1 text-xs font-medium text-primary-light mb-4">
                                Categoría Kit Digital
                            </div>

                            <h3 class="text-2xl font-semibold text-white mb-2">{sol.category}</h3>
                            <p class="text-primary-light font-medium text-lg mb-4">Solución: {sol.name}</p>
                            <p class="text-surface-300 leading-relaxed mb-6 max-w-4xl">{sol.description}</p>

                            <!-- Sector applicability -->
                            <div class="flex items-center gap-2 mb-4 rounded-lg bg-green-900/20 border border-green-700/30 px-4 py-2.5 w-fit">
                                <svg class="h-5 w-5 text-green-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="text-green-300 text-sm font-medium">La solución puede aplicarse en cualquier sector productivo</span>
                            </div>

                            <!-- Geographic coverage -->
                            <div class="flex items-center gap-2 mb-8 rounded-lg bg-blue-900/20 border border-blue-700/30 px-4 py-2.5 w-fit">
                                <svg class="h-5 w-5 text-blue-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                                </svg>
                                <span class="text-blue-300 text-sm font-medium">Zona geográfica de actuación: Todo el territorio español</span>
                            </div>

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                                <!-- Features -->
                                <div>
                                    <h4 class="text-sm font-semibold uppercase tracking-wider text-surface-400 mb-4">Prestaciones incluidas</h4>
                                    <ul class="space-y-3">
                                        {sol.features.map((f) => (
                                            <li class="flex items-start gap-3">
                                                <svg class="h-5 w-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                                </svg>
                                                <span class="text-surface-300 text-sm">{f}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>

                                <!-- Segments & Sectors -->
                                <div>
                                    <h4 class="text-sm font-semibold uppercase tracking-wider text-surface-400 mb-4">Importe por segmento de beneficiario</h4>
                                    <div class="space-y-3 mb-6">
                                        {sol.segments.map((seg) => (
                                            <div class="flex items-center justify-between rounded-lg bg-surface-800/50 px-4 py-3 ring-1 ring-surface-700">
                                                <div>
                                                    <span class="font-medium text-white text-sm">{seg.name}</span>
                                                    <span class="text-surface-400 text-xs ml-2">({seg.range})</span>
                                                </div>
                                                <span class="text-primary font-semibold text-sm">{seg.amount}</span>
                                            </div>
                                        ))}
                                    </div>

                                    <h4 class="text-sm font-semibold uppercase tracking-wider text-surface-400 mb-3">Sectores de actividad</h4>
                                    <p class="text-surface-400 text-sm leading-relaxed">{sol.sectors}</p>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Zona geográfica de actuación -->
        <section class="bg-black py-16 sm:py-24 border-t border-surface-800">
            <div class="mx-auto max-w-4xl px-6 lg:px-8">
                <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-8 text-center">Zona Geográfica de Actuación</h2>
                <p class="text-lg text-surface-300 leading-relaxed mb-8 text-center">
                    Rebase presta sus servicios de digitalización en <strong class="text-white">todo el territorio español</strong>, incluyendo todas las comunidades autónomas, provincias y ciudades autónomas.
                </p>
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                    {[
                        "Andalucía", "Aragón", "Principado de Asturias", "Illes Balears",
                        "Canarias", "Cantabria", "Castilla y León", "Castilla-La Mancha",
                        "Cataluña", "Comunidad Valenciana", "Extremadura", "Galicia",
                        "Comunidad de Madrid", "Región de Murcia", "Comunidad Foral de Navarra",
                        "País Vasco", "La Rioja", "Ceuta", "Melilla"
                    ].map((region) => (
                        <div class="flex items-center gap-2 rounded-lg bg-surface-900/50 px-3 py-2 ring-1 ring-surface-800">
                            <svg class="h-4 w-4 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                            </svg>
                            <span class="text-surface-300 text-xs">{region}</span>
                        </div>
                    ))}
                </div>
                <p class="text-sm text-surface-400 mt-6 text-center">
                    Servicio prestado de forma remota en todo el territorio nacional. No se requiere presencia física.
                </p>
            </div>
        </section>

        <!-- CTA -->
        <section class="bg-black py-24 sm:py-32">
            <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
                <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">¿Quieres digitalizar tu negocio con Kit Digital?</h2>
                <p class="text-lg text-surface-400 mb-8 max-w-2xl mx-auto">Contacta con nosotros para conocer cómo podemos ayudarte a aprovechar tu bono digital con las soluciones de Rebase.</p>
                <div class="flex items-center justify-center gap-x-6 flex-wrap">
                    <a href="/contact"
                       class="inline-flex items-center gap-x-2 rounded-md bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-all duration-200 ease-in-out btn-glow">
                        Contactar
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                    </a>
                    <a href="https://calendar.app.google/UDSmMagx6AEwar8P8"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold">
                        Reservar una llamada
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7" />
                        </svg>
                    </a>
                </div>
            </div>
        </section>

