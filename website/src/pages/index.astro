---
import Layout from "../layouts/Layout.astro";
import ScrollSyncShowcase from "../components/ScrollSyncShowcase.astro";
import CollectionPowerSection from "../components/CollectionPowerSection.astro";
import SectionBackgroundAccents from "../components/SectionBackgroundAccents.astro";
import { EntityViewDemo } from "../components/demos/EntityViewDemo";
import { KanbanDemo } from "../components/demos/KanbanDemo";
import { ApiMiniDemo } from "../components/demos/ApiMiniDemo";
import { SdkMiniDemo } from "../components/demos/SdkMiniDemo";
import { RealtimeMiniDemo } from "../components/demos/RealtimeMiniDemo";
import RoadmapSection from "../components/RoadmapSection.astro";
import ClientLogos from "../components/ClientLogos.astro";

const title = "Rebase — Ship your back-office in a sprint. Extend it forever.";
const description = "Open-source Postgres platform — admin panel, REST & GraphQL APIs, and typed TypeScript SDK, all generated from your schema. Self-hosted, no vendor lock-in.";

---
<Layout title={title} description={description}>

    <main>

        <!-- Hero -->
        <section class="relative isolate overflow-hidden bg-linear-to-br from-surface-900 to-black pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-48 lg:pb-32">
            <!-- Background gradient top shape -->
            <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80"
                 aria-hidden="true">
                <div class="blob-shape relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-2/3 rotate-30 bg-linear-to-tr from-primary to-[#0d172e] opacity-25 sm:left-[calc(50%-30rem)] sm:w-288.75"></div>
            </div>

            <div class="px-4 mx-auto max-w-7xl text-center lg:px-12 relative z-10">
                <!-- EU badge -->
                <div class="mb-8 flex items-center justify-center gap-3 animate-on-scroll fade-in">
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-surface-700 bg-surface-900/60 text-sm font-medium text-surface-300">
                        <span class="inline-block text-base">🇪🇺</span>
                        Open-source · Postgres-native · Built in Europe
                    </span>
                </div>

                <!-- Headline -->
                <h1 class="mb-5 text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight text-white font-sans animate-on-scroll fade-in-up">
                    Ship your back-office in a <span class="text-primary subtle-shimmer">sprint</span>.<br/>
                    Extend it <span class="text-primary subtle-shimmer">forever</span>.
                </h1>
                <p class="mb-6 text-lg leading-8 text-surface-300 lg:text-xl sm:px-10 xl:px-40 animate-on-scroll fade-in-up">
                    Admin panel, APIs, and typed SDK — generated from a <b class="text-white font-medium">single TypeScript schema</b>.
                </p>
                
                <!-- Feature badges -->
                <div class="mb-8 flex flex-wrap items-center justify-center gap-3 sm:gap-5 text-sm sm:text-base animate-on-scroll fade-in">
                    <span class="inline-flex items-center gap-2.5 rounded-full bg-surface-800/60 px-5 py-2 ring-1 ring-white/10 text-surface-200">
                        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary/15 border border-primary/30">
                            <svg class="h-5 w-5 text-primary" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <rect x="3" y="3" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/>
                                <rect x="9" y="3" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/>
                                <rect x="3" y="9" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/>
                                <rect x="9" y="9" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/>
                            </svg>
                        </span>
                        Admin Panel
                    </span>
                    <span class="inline-flex items-center gap-2.5 rounded-full bg-surface-800/60 px-5 py-2 ring-1 ring-white/10 text-surface-200">
                        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary/15 border border-primary/30">
                            <svg class="h-5 w-5 text-primary" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <circle cx="8" cy="4" r="1.5" stroke="currentColor" stroke-width="1.4"/>
                                <circle cx="4" cy="11" r="1.5" stroke="currentColor" stroke-width="1.4"/>
                                <circle cx="12" cy="11" r="1.5" stroke="currentColor" stroke-width="1.4"/>
                                <path d="M7 5.5l-2.5 4M9 5.5l2.5 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                            </svg>
                        </span>
                        REST & GraphQL
                    </span>
                    <span class="inline-flex items-center gap-2.5 rounded-full bg-surface-800/60 px-5 py-2 ring-1 ring-white/10 text-surface-200">
                        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary/15 border border-primary/30">
                            <svg class="h-5 w-5 text-primary" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <polyline points="5 5 2 8 5 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                <polyline points="11 5 14 8 11 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                <line x1="10" y1="3" x2="6" y2="13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                            </svg>
                        </span>
                        Typed SDK
                    </span>
                    <span class="inline-flex items-center gap-2.5 rounded-full bg-surface-800/60 px-5 py-2 ring-1 ring-white/10 text-surface-200">
                        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary/15 border border-primary/30">
                            <svg class="h-5 w-5 text-primary" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <rect x="4" y="7" width="8" height="6" rx="1" stroke="currentColor" stroke-width="1.4"/>
                                <path d="M5.5 7v-2a2.5 2.5 0 015 0v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                                <circle cx="8" cy="10" r="1" fill="currentColor"/>
                            </svg>
                        </span>
                        Built-in Auth
                    </span>
                    <span class="inline-flex items-center gap-2.5 rounded-full bg-surface-800/60 px-5 py-2 ring-1 ring-white/10 text-surface-200">
                        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary/15 border border-primary/30">
                            <svg class="h-5 w-5 text-primary" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M11 5H3.5a1.5 1.5 0 000 3h7A2.5 2.5 0 0110.5 13H4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M6 11l-2 2 2 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M10 3l2 2-2 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        Real-time
                    </span>
                </div>

                <!-- CTAs -->
                <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-x-4 animate-on-scroll fade-in-up">
                    <a href="/waitlist"
                       data-track
                       id="hero-start-building"
                       class="inline-flex items-center gap-x-2 rounded-md bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-all duration-200 ease-in-out btn-glow">
                        Get Early Access
                        
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

                    </a>
                    <a href="https://github.com/rebasepro/rebase"
                       data-track
                       id="hero-explore-self-hosted"
                       target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-x-2 text-sm font-medium text-surface-300 hover:text-white transition-colors">
                        View on GitHub
                        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M4 8H11.333" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M8.667 4L12 7.99967L8.667 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </div>
                
                <p class="mt-4 text-xs sm:text-sm text-surface-500 animate-on-scroll fade-in-up">
                    Open-source · Postgres-native · No vendor lock-in
                </p>
            </div>
        </section>

        <!-- Product demo -->
        <section class="bg-black border-b border-surface-900 relative" style="min-height: 200vh;">
            <!-- subtle separator line -->
            <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-surface-700/40 to-transparent"></div>

            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14 sm:pt-18">
                <div class="max-w-3xl mx-auto text-center animate-on-scroll fade-in-up">
                    <p class="text-xs font-semibold tracking-[0.25em] text-primary/70 uppercase">Watch the workflow</p>
                    <h2 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-white">
                        Connect · Introspect · Ship
                    </h2>
                    <div class="mt-8 max-w-2xl mx-auto">
                        <div class="rounded-2xl bg-surface-900/80 border border-surface-800/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_24px_80px_rgba(0,0,0,0.65)] text-left relative overflow-hidden group hover:border-primary/40 transition-colors duration-300">
                            <!-- Glow effect behind terminal -->
                            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-500" aria-hidden="true" style="background: radial-gradient(400px 200px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 0;"></div>
                            
                            <div class="relative z-10 flex items-center justify-between px-4 py-3 border-b border-surface-800/80 bg-surface-950/50">
                                <div class="flex items-center gap-1.5">
                                    <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                                    <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                                    <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                                </div>
                                <div class="text-[11px] font-mono font-medium text-surface-500 flex items-center gap-2">
                                    
<svg
  class="lucide lucide-terminal"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M12 19h8" />
  <path d="m4 17 6-6-6-6" />
</svg>

                                    bash
                                </div>
                                <div class="w-12"></div> <!-- spacer -->
                            </div>
                            
                            <div class="relative z-10 font-mono text-[13px] sm:text-sm text-surface-200 space-y-4 px-5 py-5 bg-gradient-to-b from-surface-900/50 to-transparent">
                                <div>
                                    <div class="flex gap-3 items-center justify-between">
                                        <div class="flex gap-3 items-center">
                                            <span class="text-primary font-bold">~</span>
                                            <span class="text-white">npx rebase init</span>
                                        </div>
                                        <button onclick="navigator.clipboard.writeText('npx rebase init')" class="text-surface-500 hover:text-white transition-colors" aria-label="Copy command" title="Copy to clipboard">
                                            
<svg
  class="lucide lucide-copy"
