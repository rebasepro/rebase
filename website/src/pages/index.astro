                </div>
                <p class="mt-4 text-center text-xs sm:text-sm text-surface-500 pb-20">
                    A quick tour of the generated Rebase admin panel.
                </p>
            </div>
        </section>

        <!-- Social proof -->
        <section class="bg-black py-12 sm:py-16 border-t border-surface-800/40">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <p class="text-center text-sm text-surface-500 mb-8 animate-on-scroll fade-in">Trusted by developers and teams at</p>
                <ClientLogos />
            </div>
        </section>

        <!-- How it works -->
        <section class="relative py-24 sm:py-32 overflow-hidden bg-black border-t border-surface-800/40">
            <div class="mx-auto max-w-7xl px-6 lg:px-12">
                <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 animate-on-scroll fade-in-up">
                    <h2 class="text-xs font-semibold tracking-[0.25em] text-primary/70 uppercase">Zero to production</h2>
                    <p class="mt-4 text-3xl md:text-5xl font-semibold tracking-tight text-white font-sans">
                        From zero to <span class="text-primary">admin panel</span> in minutes
                    </p>
                    <p class="mt-5 text-base sm:text-lg text-surface-400">
                        Connect your database, get instant APIs and UI, and customize with code.
                    </p>
