---
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { publishedPosts } from '../../utils/blog';
import { NeatBackground } from '../../components/NeatBackground';

const posts = await publishedPosts();

const breadcrumbs = [
	{ name: "Home", url: "https://rebase.pro" },
	{ name: "Blog", url: "https://rebase.pro/blog" }
];
---

<Layout
	title="Rebase Blog — Postgres Backend Guides, Comparisons & Product Updates"
	description="Guides, comparisons and product updates about Rebase: building on PostgreSQL with auto-generated APIs, RLS, realtime, and a schema-driven admin panel."
	breadcrumbs={breadcrumbs}
>
	<main class="min-h-screen py-24">
		<div class="max-w-6xl mx-auto px-6">
			<!-- Header Section -->
			<div class="text-center mb-16">
				<h1 class="text-5xl md:text-6xl text-white mb-6">Blog</h1>
				<p class="text-xl text-surface-400 max-w-2xl mx-auto">
					Latest updates, tutorials, and insights about Rebase and building on Postgres
				</p>
			</div>

			<!-- Blog Posts Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{posts.map((post) => (
					<a
						href={`/blog/${post.id}/`}
						class="group relative isolate flex min-h-[21rem] flex-col justify-end overflow-hidden rounded-2xl border border-surface-800 p-6 transition-all duration-300 hover:border-primary hover:shadow-lg hover:shadow-primary/10"
					>
						{/* The artwork is the whole card, not a thumbnail band above the
						    text — the same treatment the post's own hero gets, so a card
						    and the page it opens read as one thing. */}
						<div class="absolute inset-0 transition-transform duration-500 group-hover:scale-105">
							{post.data.image ? (
								post.data.image.endsWith('.webm') || post.data.image.endsWith('.mp4') ? (
									<video autoplay loop muted playsinline class="w-full h-full object-cover">
										<source src={post.data.image} type="video/webm" />
									</video>
								) : (
									<img src={post.data.image} alt="" class="w-full h-full object-cover" aria-hidden="true" />
								)
							) : (
								/* `poseKey` is the post slug: every card on this page shares
								   one pathname, so without it the orbit would seat them all
								   identically. The slug is also what the post's own hero
								   passes, so the two land on the same frame. */
								<NeatBackground client:visible variant="card" poseKey={post.id} />
							)}
						</div>

						{/* Where the bright part of the ribbon lands is a function of the
						    slug and not knowable here, so the text gets its own ground
						    rather than relying on the artwork to be dark in the right
						    corner. */}
						<div class="absolute inset-0 bg-gradient-to-t from-surface-950 via-surface-950/85 to-transparent"></div>

						<div class="relative">
							<div class="text-sm text-surface-300 mb-3">
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h2 class="text-xl text-white mb-2 group-hover:text-primary transition-colors [text-shadow:0_2px_20px_rgba(0,0,0,.6)]">
								{post.data.title}
							</h2>
							{post.data.description && (
								<p class="text-surface-300 text-sm line-clamp-2">
									{post.data.description}
								</p>
							)}
						</div>
					</a>
				))}
			</div>

			{posts.length === 0 && (
				<div class="text-center py-20">
					<p class="text-surface-400 text-lg">No blog posts yet. Check back soon!</p>
				</div>
			)}
		</div>
	</main>
</Layout>
