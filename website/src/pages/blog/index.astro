---
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { publishedPosts } from '../../utils/blog';
import { NeatBackground } from '../../components/NeatBackground';
import HeroBackdrop from '../../components/HeroBackdrop.astro';
import ChapterRule from '../../components/ChapterRule.astro';

const posts = await publishedPosts();

const breadcrumbs = [
	{ name: "Home", url: "https://rebase.pro" },
	{ name: "Blog", url: "https://rebase.pro/blog" }
];
---

<Layout
	title="Blog: Postgres backend guides and product updates — Rebase"
	description="Guides, comparisons and product updates about Rebase: building on PostgreSQL with auto-generated APIs, RLS, realtime, and a schema-driven admin panel."
	breadcrumbs={breadcrumbs}
>
	<div class="drafted-page flex flex-col isolate">
		<section class="relative isolate overflow-hidden hero-under-nav pb-20 sm:pb-24">
			<HeroBackdrop />
			<div class="px-4 mx-auto max-w-6xl lg:px-8 relative z-10">
				<p class="hero-eyebrow">Blog</p>
				<h1 class="mt-4 text-display-2 text-white">Building on Postgres</h1>
				<p class="mt-5 text-lg leading-8 text-surface-400 max-w-2xl">
					Latest updates, tutorials, and insights about Rebase and building on Postgres
				</p>
			</div>
		</section>

		<section class="relative z-0 pb-28 sm:pb-36">
			<div class="mx-auto max-w-6xl px-6 lg:px-8">
				<ChapterRule label="Posts" index={`${String(posts.length).padStart(2, "0")} published`} dot="text-cyan-300" />

				<div class="mt-lead grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="frame group flex flex-col transition-colors duration-300 hover:border-white/25">
							{/* The post's own field, held still on the seat its page's
							    hero opens on (`poseKey` is that page's path), so the card
							    and the page it opens show the same light. Masked into the
							    card's ground the way a hero fades into the page. */}
							<div class="relative h-40 overflow-hidden [mask-image:linear-gradient(to_bottom,#000_35%,transparent)]">
								{post.data.image ? (
									post.data.image.endsWith('.webm') || post.data.image.endsWith('.mp4') ? (
										<video autoplay loop muted playsinline class="w-full h-full object-cover" aria-hidden="true">
											<source src={post.data.image} type="video/webm" />
										</video>
									) : (
										<img src={post.data.image} alt="" class="w-full h-full object-cover" aria-hidden="true" />
									)
								) : (
									<NeatBackground client:visible variant="card" poseKey={`/blog/${post.id}`} />
								)}
							</div>
							<div class="flex flex-1 flex-col px-6 pb-6 -mt-6 relative">
								<p class="font-mono text-2xs uppercase tracking-[0.2em] text-surface-500">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h2 class="mt-3 text-xl text-white group-hover:text-primary-light transition-colors">
									{post.data.title}
								</h2>
								{post.data.description && (
									<p class="mt-2 text-surface-400 text-sm line-clamp-3">
										{post.data.description}
									</p>
								)}
							</div>
						</a>
					))}
				</div>

				{posts.length === 0 && (
					<p class="mt-lead text-surface-400 text-lg">No blog posts yet. Check back soon!</p>
				)}
			</div>
		</section>
	</div>
</Layout>
