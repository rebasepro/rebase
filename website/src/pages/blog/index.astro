---
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { publishedPosts } from '../../utils/blog';
import { NeatBackground } from '../../components/NeatBackground';

const posts = await publishedPosts();

const breadcrumbs = [
	{ name: "Home", url: "https://rebase.pro" },
	{ name: "Blog", url: "https://rebase.pro/blog" }
];
---

<Layout
	title="Rebase Blog — Postgres Backend Guides, Comparisons & Product Updates"
	description="Guides, comparisons and product updates about Rebase: building on PostgreSQL with auto-generated APIs, RLS, realtime, and a schema-driven admin panel."
	breadcrumbs={breadcrumbs}
>
	<main class="min-h-screen py-24">
		<div class="max-w-6xl mx-auto px-6">
			<!-- Header Section -->
			<div class="text-center mb-16">
				<h1 class="text-5xl md:text-6xl text-white mb-6">Blog</h1>
				<p class="text-xl text-surface-400 max-w-2xl mx-auto">
					Latest updates, tutorials, and insights about Rebase and building on Postgres
				</p>
			</div>

			<!-- Blog Posts Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{posts.map((post) => (
					<a
						href={`/blog/${post.id}/`}
						class="group block bg-surface-900 rounded-2xl overflow-hidden border border-surface-800 hover:border-primary transition-all duration-300 hover:shadow-lg hover:shadow-primary/10"
					>
						<div class="aspect-video overflow-hidden bg-surface-800">
							{post.data.image ? (
								post.data.image.endsWith('.webm') || post.data.image.endsWith('.mp4') ? (
									<video
										autoplay
										loop
										muted
										playsinline
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
									>
										<source src={post.data.image} type="video/webm" />
									</video>
								) : (
									<img
										src={post.data.image}
										alt={post.data.title}
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
									/>
								)
							) : (
								/* The site's own gradient, live. `poseKey` is the
								   post slug, so each card gets its own seat on the
								   orbit — and the same seat the post's own page
								   derives from its pathname. What stood here was a
								   grey box with a picture icon, on every card,
								   which reads as an image that failed to load. */
								<div class="w-full h-full group-hover:scale-105 transition-transform duration-300">
									<NeatBackground client:visible variant="card" poseKey={post.id} />
								</div>
							)}
						</div>
						<div class="p-6">
							<div class="text-sm text-surface-400 mb-3">
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h2 class="text-xl text-white mb-2 group-hover:text-primary transition-colors">
								{post.data.title}
							</h2>
							{post.data.description && (
								<p class="text-surface-400 text-sm line-clamp-2">
									{post.data.description}
								</p>
							)}
						</div>
					</a>
				))}
			</div>

			{posts.length === 0 && (
				<div class="text-center py-20">
					<p class="text-surface-400 text-lg">No blog posts yet. Check back soon!</p>
				</div>
			)}
		</div>
	</main>
</Layout>
