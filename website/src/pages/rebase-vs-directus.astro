---
import Layout from "../layouts/Layout.astro";
import SectionBackgroundAccents from "../components/SectionBackgroundAccents.astro";

const title = "Rebase vs Directus - The React & Code-First Alternative";
const description = "Discover why developers migrate from Directus to Rebase. Stop battling database-stored metadata, embrace React, and store your schemas securely in version control.";

const breadcrumbs = [
    { name: "Home", url: "https://rebase.pro" },
    { name: "Rebase vs Directus", url: "https://rebase.pro/rebase-vs-directus" }
];
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
  <main>
    <section class="relative isolate overflow-hidden bg-linear-to-br from-black to-surface-950 pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
      <SectionBackgroundAccents topLine={true} blob={{ position: "top", size: "lg", opacity: 60 }}/>
      
      <div class="px-4 mx-auto max-w-7xl text-center lg:px-12">
        <h1 class="mb-8 text-5xl font-extrabold tracking-tight leading-none md:text-6xl text-white font-sans">
          Rebase vs Directus
        </h1>
        <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl max-w-3xl mx-auto">
          Directus is a powerful API engine, but its database-driven architecture makes deployments frustrating and extensibility hard. See why modern engineering teams are choosing Rebase's code-driven, React-native approach.
        </p>
      </div>
    </section>

    <!-- Content Sections -->
    <section class="bg-black py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        
        <div class="space-y-16">
          
          <!-- Point 1 -->
          <div class="py-2">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-sm font-medium mb-3">
                    <span class="material-symbols-rounded text-primary" style="font-size:18px">source_code</span>
                    Schema Management
                  </div>
                  <h3 class="text-2xl font-bold text-white">Code vs Database State</h3>
                </div>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
                <!-- VS Badge -->
                <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full border border-surface-700 bg-surface-900 items-center justify-center text-xs font-bold text-surface-400 z-10 shadow-xl">VS</div>
                
                <!-- Competitor Card -->
                <div class="bg-surface-800/20 rounded-xl p-6 border border-surface-700/50 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-red-500/5 blur-[50px] -mr-16 -mt-16"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="material-symbols-rounded text-red-500/80" style="font-size:20px">error</span>
                      <h4 class="text-white font-semibold">The Directus Pain</h4>
                    </div>
                    <p class="text-surface-400 text-sm leading-relaxed">Directus stores your entire schema and UI configuration in hidden database tables (`directus_collections`, `directus_fields`). Managing environments (Staging to Production) requires clunky schema-sync CLI tools or manual database dumps that frequently break down or overwrite data.</p>
                  </div>
                </div>

                <!-- Rebase Card -->
                <div class="bg-primary/5 rounded-xl p-6 border border-primary/20 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 blur-[50px] -mr-16 -mt-16"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="material-symbols-rounded text-primary" style="font-size:20px">check_circle</span>
                      <h4 class="text-white font-semibold">How Rebase Solves This</h4>
                    </div>
                    <p class="text-surface-300 leading-relaxed text-sm mb-4">
                      Rebase uses a <strong>Schema-as-Code</strong> approach. Every collection and field is defined in a standard TypeScript file.
                    </p>
                    <ul class="text-surface-400 space-y-3 text-sm">
                      <li class="flex items-start"><span class="material-symbols-rounded text-primary mr-2 mt-0.5" style="font-size:18px">done</span> <span class="leading-relaxed">Even when you use the visual Rebase Studio to add fields, the engine uses AST-manipulation to write the changes directly to your TypeScript schemas.</span></li>
                  <li class="flex items-start"><span class="material-symbols-rounded text-primary mr-2 mt-0.5" style="font-size:18px">done</span> <span class="leading-relaxed">Changes are committed to Git.</span></li>
                  <li class="flex items-start"><span class="material-symbols-rounded text-primary mr-2 mt-0.5" style="font-size:18px">done</span> <span class="leading-relaxed">Deployments are just a `git pull` away, guaranteeing perfectly synchronized environments every single time.</span></li>
                    </ul>
                  </div>
                </div>
              </div>
          </div>

          <!-- Point 2 -->
          <div class="py-2">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-sm font-medium mb-3">
                    <span class="material-symbols-rounded text-primary" style="font-size:18px">brush</span>
                    Extensibility
                  </div>
                  <h3 class="text-2xl font-bold text-white">React Framework vs Vue Engine</h3>
                </div>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
                <!-- VS Badge -->
                <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full border border-surface-700 bg-surface-900 items-center justify-center text-xs font-bold text-surface-400 z-10 shadow-xl">VS</div>
                
                <!-- Competitor Card -->
                <div class="bg-surface-800/20 rounded-xl p-6 border border-surface-700/50 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-red-500/5 blur-[50px] -mr-16 -mt-16"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="material-symbols-rounded text-red-500/80" style="font-size:20px">error</span>
                      <h4 class="text-white font-semibold">The Directus Pain</h4>
                    </div>
                    <p class="text-surface-400 text-sm leading-relaxed">Directus is an API engine built heavily on Vue.js. To build custom dashboards, specialized inputs, or unique data views, your team is forced to adopt Vue workflows, and stepping outside Directus's specific extension patterns is notoriously difficult.</p>
                  </div>
                </div>

                <!-- Rebase Card -->
                <div class="bg-primary/5 rounded-xl p-6 border border-primary/20 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 blur-[50px] -mr-16 -mt-16"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="material-symbols-rounded text-primary" style="font-size:20px">check_circle</span>
                      <h4 class="text-white font-semibold">How Rebase Solves This</h4>
                    </div>
                    <p class="text-surface-300 leading-relaxed text-sm mb-4">
                      Rebase is built natively on React.
                    </p>
                    <ul class="text-surface-400 space-y-3 text-sm">
                      <li class="flex items-start"><span class="material-symbols-rounded text-primary mr-2 mt-0.5" style="font-size:18px">done</span> <span class="leading-relaxed">Create custom fields, entirely new pages, or bespoke dashboard widgets leveraging the massive React ecosystem.</span></li>
                  <li class="flex items-start"><span class="material-symbols-rounded text-primary mr-2 mt-0.5" style="font-size:18px">done</span> <span class="leading-relaxed">Use your favorite React components (MUI, Tailwind, Recharts) instantly without friction.</span></li>
                  <li class="flex items-start"><span class="material-symbols-rounded text-primary mr-2 mt-0.5" style="font-size:18px">done</span> <span class="leading-relaxed">The backend is a standard Hono app. Want a custom route? Just add `app.get()`.</span></li>
                    </ul>
                  </div>
                </div>
              </div>
          </div>

          <!-- Point 3 -->
          <div class="py-2">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-sm font-medium mb-3">
                    <span class="material-symbols-rounded text-primary" style="font-size:18px">security</span>
                    Security & Permissions
                  </div>
                  <h3 class="text-2xl font-bold text-white">Native RLS vs Application Layer</h3>
                </div>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
                <!-- VS Badge -->
                <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full border border-surface-700 bg-surface-900 items-center justify-center text-xs font-bold text-surface-400 z-10 shadow-xl">VS</div>
                
                <!-- Competitor Card -->
                <div class="bg-surface-800/20 rounded-xl p-6 border border-surface-700/50 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-red-500/5 blur-[50px] -mr-16 -mt-16"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="material-symbols-rounded text-red-500/80" style="font-size:20px">error</span>
                      <h4 class="text-white font-semibold">The Directus Pain</h4>
                    </div>
                    <p class="text-surface-400 text-sm leading-relaxed">Directus enforces permissions exclusively via its own application layer. It does not utilize Postgres Row Level Security (RLS). If an external service queries your DB directly, all those Directus permissions vanish, leaving data exposed.</p>
                  </div>
                </div>

                <!-- Rebase Card -->
                <div class="bg-primary/5 rounded-xl p-6 border border-primary/20 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 blur-[50px] -mr-16 -mt-16"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="material-symbols-rounded text-primary" style="font-size:20px">check_circle</span>
                      <h4 class="text-white font-semibold">How Rebase Solves This</h4>
                    </div>
                    <p class="text-surface-300 leading-relaxed text-sm mb-4">
                      Rebase marries the power of native Postgres Row-Level Security with a visual management UI.
                    </p>
                    <ul class="text-surface-400 space-y-3 text-sm">
                      <li class="flex items-start"><span class="material-symbols-rounded text-primary mr-2 mt-0.5" style="font-size:18px">done</span> <span class="leading-relaxed">Rules are pushed to the database via RLS (where possible), so your data stays locked down regardless of where the query originated.</span></li>
                  <li class="flex items-start"><span class="material-symbols-rounded text-primary mr-2 mt-0.5" style="font-size:18px">done</span> <span class="leading-relaxed">Visual editors make defining RLS policies intuitive and error-free.</span></li>
                  <li class="flex items-start"><span class="material-symbols-rounded text-primary mr-2 mt-0.5" style="font-size:18px">done</span> <span class="leading-relaxed">You remain in total control of the security context.</span></li>
                    </ul>
                  </div>
                </div>
              </div>
          </div>

          
        </div>

      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-black py-16 sm:py-24 border-t border-surface-800/40">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-6">Own your code, own your data.</h2>
        <p class="text-lg text-surface-400 mb-8 max-w-2xl mx-auto">Migrate your project to a true TypeScript environment built for developers.</p>
        <div class="flex items-center justify-center gap-x-6">
          <a href="/docs" class="inline-flex items-center gap-x-2 rounded-md bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-all duration-200 ease-in-out btn-glow">
            Get Started
            <span class="material-symbols-rounded text-white" style="font-size:20px">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
