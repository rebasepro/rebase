---
/**
 * The trust act: security enforced by Postgres, the MIT licence shown as a
 * self-host terminal, and the free audit that tests the claim.
 *
 * Extracted from `pages/IndexContent.astro` when the beat moved from position 06
 * to position 03. SITE-STORY §2 ranks "security lives in the database" as claim 1,
 * and the page was making it sixth — after a screen of admin-panel screenshots,
 * which is the ordering the backend-first rule exists to prevent. It cannot be
 * first, because "RLS written in the same file as the collection" needs the
 * collection beat to have run; third, straight after the backend it protects, is
 * where it lands.
 *
 * Follows the CollectionPowerSection convention: the component derives `lang` and
 * `t` from the URL itself and takes only `index`, the numbered eyebrow. Deep pages
 * pass nothing and get a plain badge — the numbered idiom is home-page-only.
 */
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/ui";
import { RLSEditorDemo } from "./demos/RLSEditorDemo";
import RlsCheckReport from "./RlsCheckReport.astro";

const { index } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!-- Trust: security shown live, open source shown as a terminal -->
<section id="s-security" class="relative z-0 py-28 sm:py-36 overflow-hidden">

    <div class="mx-auto max-w-7xl px-6 lg:px-8 space-y-24 sm:space-y-32">

        <!-- Row 1: Security-first, with the visual RLS editor -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-5 animate-on-scroll fade-in-up">
                <p class="mb-6 text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase">
                    {index && (<><span class="font-mono text-surface-500">{index}</span><span class="mx-2 text-surface-600">·</span></>)}{t("security.badge")}
                </p>
                <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl mb-4">
                    {t("security.title")}
                </h2>
                <p class="text-lg text-surface-400 leading-relaxed">
                    {t("security.desc")}
                </p>
                <div class="mt-8">
                    <a href={translatePath("/studio")}
                       class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-primary transition-colors">
                        {t("security.link")}
                        <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="20"
                             height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="lg:col-span-7 animate-on-scroll fade-in-up delay-100">
                <div class="rounded-2xl overflow-hidden ring-1 ring-white/10 bg-surface-950 shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
                    <div class="px-4 py-2.5 border-b border-white/5 flex items-center gap-2 bg-surface-900/50">
                        <div class="flex gap-1.5">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                        </div>
                        <div class="ml-4 text-xs font-mono text-surface-500">studio · row-level security</div>
                    </div>
                    <div class="p-4 bg-[#09090b]" inert aria-hidden="true">
                        <RLSEditorDemo client:visible/>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: Open source, with a self-host terminal -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-7 order-last lg:order-first animate-on-scroll fade-in-up delay-100">
                <div class="group relative max-w-xl lg:mx-auto">
                    <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-0 group-hover:opacity-100 blur-lg transition-opacity duration-500"
                         aria-hidden="true"></div>
                    <div class="relative rounded-2xl bg-surface-900/80 border border-surface-700/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_24px_80px_rgba(0,0,0,0.65)] overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                        <div class="flex items-center justify-between px-4 py-3 border-b border-surface-800/80 bg-surface-950/50">
                            <div class="flex items-center gap-1.5">
                                <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
                                <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
                                <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
                            </div>
                            <span class="text-2xs font-mono font-medium text-surface-500">self-host</span>
                            <div class="w-12"></div>
                        </div>
                        <div class="px-5 py-5 font-mono text-sm sm:text-sm space-y-3 bg-gradient-to-b from-surface-900/50 to-transparent">
                            <div class="flex items-center gap-3 whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <span class="text-primary font-semibold">~</span>
                                <span class="text-white">git clone github.com/rebasepro/rebase</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-primary font-semibold">~</span>
                                <span class="text-white">docker compose up -d</span>
                            </div>
                            <div class="text-surface-400 text-xs ml-6">✔ Postgres ready on :5432</div>
                            <div class="text-emerald-400/90 text-xs ml-6 flex items-center gap-2">
                                ✔ Backend live on :3000
                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 ring-1 ring-emerald-500/20 text-emerald-400 text-3xs">
                                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                    running
                                </span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-primary font-semibold">~</span>
                                <span class="w-[2px] h-4 bg-primary animate-pulse"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-5 animate-on-scroll fade-in-up">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-sm font-medium mb-6">
                    <svg class="lucide lucide-git-fork" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="18" r="3"/>
                        <circle cx="6" cy="6" r="3"/>
                        <circle cx="18" cy="6" r="3"/>
                        <path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/>
                        <path d="M12 12v3"/>
                    </svg>
                    {t("opensource.badge")}
                </div>
                <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl mb-4"
                    set:html={t("opensource.title")}>
                </h2>
                <p class="text-lg text-surface-400 leading-relaxed">
                    {t("opensource.desc")}
                </p>
                <!-- The no-caps line. It belongs in this block rather than at the
                     closing CTA: "zero lock-in" is the claim it evidences, and the
                     CTA already carries the trust row. Set as one sentence, not a
                     third row of chips — the page has two chip treatments already. -->
                <p class="mt-5 border-l-2 border-primary/40 pl-4 text-base text-surface-400 leading-relaxed"
                   set:html={t("opensource.limits")}></p>
                <div class="mt-8 flex items-center gap-6">
                    <a href={translatePath("/developers")}
                       class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-primary transition-colors">
                        {t("opensource.link1")}
                        <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="20"
                             height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                    <a href={translatePath("/compare")}
                       class="inline-flex items-center gap-2 text-sm font-semibold text-surface-400 hover:text-white transition-colors">
                        {t("opensource.link2")}
                    </a>
                </div>
            </div>
        </div>

        <!-- Row 3: the free audit. It sits inside the security beat rather than
             up near the hero, because it only means something once the claim it
             tests has been made. -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            <div class="lg:col-span-5 animate-on-scroll fade-in-up lg:pt-6">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-sm font-medium mb-6">
                    {t("rlscheck.badge")}
                </div>
                <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl mb-4">
                    {t("rlscheck.title")}
                </h2>
                <p class="text-lg text-surface-400 leading-relaxed mb-6">
                    {t("rlscheck.subtitle")}
                </p>

                <div class="group relative max-w-md">
                    <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-0 group-hover:opacity-100 blur-lg transition-opacity duration-500"
                         aria-hidden="true"></div>
                    <div class="relative rounded-xl bg-surface-900/80 border border-surface-700/80 overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                        <div class="px-5 py-4 flex items-center justify-between">
                            <div class="font-mono text-sm flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                <span class="text-primary mr-3">~</span>
                                <span class="text-white">npx @rebasepro/rls-check $DATABASE_URL</span>
                            </div>
                            <button data-track-copy="rls-check" data-command="npx @rebasepro/rls-check $DATABASE_URL"
                                    class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                    aria-label="Copy command" title="Copy to clipboard">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <p class="mt-5 text-sm leading-6 text-surface-500">{t("rlscheck.note")}</p>

                <div class="mt-6">
                    <a href={translatePath("/docs/rls-check")}
                       class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-primary transition-colors">
                        {t("rlscheck.cta")}
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="lg:col-span-7 animate-on-scroll fade-in-up delay-100">
                <RlsCheckReport/>
            </div>
        </div>


    </div>
</section>
