---
// Cookie Banner Component — non-blocking corner card
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/ui";

const t = useTranslations(getLangFromUrl(Astro.url));
const translatePath = useTranslatedPath(getLangFromUrl(Astro.url));
---

<!-- Small card pinned to the bottom-right. It never blocks the page: no
     backdrop, no scroll lock, no `inert` on the shell — a consent notice is
     not worth taking the site away from the person who just arrived. -->
<div id="cookie-banner" class="fixed bottom-3 right-3 sm:bottom-4 sm:right-4 z-[9999] w-[calc(100%-1.5rem)] sm:w-[calc(100%-2rem)] max-w-[380px] hidden">
    <div class="bg-white dark:bg-surface-900 rounded-2xl shadow-[0_25px_50px_rgba(0,0,0,0.25),0_0_0_1px_rgba(0,0,0,0.05)_inset] w-full overflow-hidden border border-surface-200 dark:border-surface-800 opacity-0 scale-95 transition-all duration-300 ease-out">
        <div class="p-4 sm:p-5">
            <div class="mb-3 sm:mb-4">
                <h2 class="text-base sm:text-lg text-surface-900 dark:text-white mb-1.5 sm:mb-2">{t("cookies.title")}</h2>
                <p class="text-xs sm:text-sm leading-relaxed text-surface-800 dark:text-surface-200 m-0">
                    <Fragment set:html={t("cookies.body")} />
                    <a href="/policy/cookies_policy" target="_blank"
                       class="text-primary-light hover:text-primary underline transition-colors">{t("cookies.link")}</a>.
                </p>
            </div>
            <div class="flex flex-row gap-3">
                <button
                        id="cookie-decline"
                        type="button"
                        class="w-full h-auto border-none px-5 py-2.5 sm:py-3 rounded-lg bg-surface-200 dark:bg-surface-800 text-surface-900 dark:text-surface-100 text-sm leading-none cursor-pointer font-semibold hover:bg-surface-300 dark:hover:bg-surface-700 transition-colors duration-200">
                    {t("cookies.decline")}
                </button>
                <button
                        id="cookie-accept"
                        type="button"
                        class="w-full h-auto border-none px-5 py-2.5 sm:py-3 rounded-lg bg-page-ground dark:bg-white text-white dark:text-black text-sm leading-none cursor-pointer font-semibold hover:opacity-90 transition-opacity duration-200">
                    {t("cookies.accept")}
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function initializeCookieBanner() {
        // Helper to get cookie value by name
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }

        // Helper to set cookie on root domain
        function setConsentCookie(value) {
            // Set cookie for 1 year on the root domain (.rebase.pro)
            const maxAge = 365 * 24 * 60 * 60;
            const domain = window.location.hostname.includes('rebase.pro') ? '; domain=.rebase.pro' : '';
            document.cookie = `cookie-consent=${value}; path=/; max-age=${maxAge}${domain}; samesite=lax; secure`;
            // Layout.astro waits for this before fetching gtag.js. Without it,
            // accepting would only take effect on the next page view — and the
            // visitor who just said yes is the one most likely to leave next.
            dispatchEvent(new CustomEvent("rebase:consent", { detail: value }));
        }

        // Check if user has already made a choice
        const cookieConsent = getCookie("cookie-consent");
        const banner = document.getElementById("cookie-banner");

        if (!banner) return;

        // Helper to hide the card immediately (no animation)
        function hideBanner() {
            banner.classList.add("hidden");
        }

        if (!cookieConsent) {
            banner.classList.remove("hidden");

            // Trigger reflow
            banner.offsetHeight;

            // Animate in
            const card = banner.querySelector(".opacity-0");
            if (card) {
                card.classList.remove("opacity-0", "scale-95");
                card.classList.add("opacity-100", "scale-100");
            }
        } else {
            // Ensure banner stays hidden if consent was already given
            banner.classList.add("hidden");
        }

        // Handle accept button
        const acceptBtn = document.getElementById("cookie-accept");
        if (acceptBtn) {
            // Remove any existing listeners by cloning the element
            const newAcceptBtn = acceptBtn.cloneNode(true);
            acceptBtn.parentNode?.replaceChild(newAcceptBtn, acceptBtn);

            newAcceptBtn.addEventListener("click", () => {
                setConsentCookie("accepted");
                hideBanner();
                // Enable Google Analytics tracking (Consent Mode v2)
                if (typeof window.gtag !== "undefined") {
                    window.gtag("consent", "update", {
                        "ad_storage": "granted",
                        "ad_user_data": "granted",
                        "ad_personalization": "granted",
                        "analytics_storage": "granted"
                    });
                }
            });
        }

        // Handle decline button
        const declineBtn = document.getElementById("cookie-decline");
        if (declineBtn) {
            // Remove any existing listeners by cloning the element
            const newDeclineBtn = declineBtn.cloneNode(true);
            declineBtn.parentNode?.replaceChild(newDeclineBtn, declineBtn);

            newDeclineBtn.addEventListener("click", () => {
                setConsentCookie("declined");
                hideBanner();
                // Disable Google Analytics tracking (Consent Mode v2)
                if (typeof window.gtag !== "undefined") {
                    window.gtag("consent", "update", {
                        "ad_storage": "denied",
                        "ad_user_data": "denied",
                        "ad_personalization": "denied",
                        "analytics_storage": "denied"
                    });
                }
            });
        }
    }

    // Initialize on first load
    initializeCookieBanner();

    // Re-initialize after Astro view transitions
    document.addEventListener("astro:page-load", initializeCookieBanner);
</script>
