---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// The waitlist form posts cross-origin to the control plane, which already
// allows this origin (CORS accepts any *.rebase.pro plus the bare apex; the apex
// is on the CSRF allow-list). `source` distinguishes these signups from the ones
// landing on rebase.website.
//
// SITE-STORY: /europe used to suppress this form. That rule existed because the
// page argued there was no second party *at all*, and a cloud waitlist in its
// own footer contradicted the argument on the page above it. The page now argues
// the other thing — that the second party's jurisdiction is what matters, and
// that ours is Spanish — so the waitlist is on-message there and the special case
// is gone. If /europe ever goes back to a no-operator argument, this is the line
// that has to come back with it.

// Grouped by the two layers, same as the header — see website/SITE-STORY.md.
const footerNavs = [
    {
        title: t("nav.col.backend"),
        links: [
            { label: t("nav.overview"), url: "/product" },
            { label: t("footer.backend"), url: "/backend" },
            { label: t("nav.security"), url: "/security" },
            { label: t("nav.ai"), url: "/ai" },
            { label: t("footer.pricing"), url: "/pricing" },
        ],
    },
    {
        title: t("nav.col.admin"),
        links: [
            { label: t("footer.cms"), url: "/cms" },
            { label: t("nav.studio"), url: "/studio" },
            { label: t("footer.demo"), url: "/demo" },
        ],
    },
    {
        title: t("footer.developers"),
        links: [
            { label: t("footer.devOverview"), url: "/developers" },
            { label: t("footer.sdk"), url: "/sdk" },
            { label: t("footer.cli"), url: "/cli" },
            { label: t("nav.docs"), url: "/docs", plain: true },
            { label: t("roadmappage.title"), url: "/roadmap" },
            { label: "llms.txt", url: "/llms.txt", external: true },
        ],
    },
    {
        title: t("footer.compare"),
        links: [
            { label: t("footer.vsSupabase"), url: "/rebase-vs-supabase" },
            { label: t("footer.vsPayload"), url: "/rebase-vs-payload" },
            { label: t("footer.vsDirectus"), url: "/rebase-vs-directus" },
            { label: t("footer.vsStrapi"), url: "/rebase-vs-strapi" },
            { label: t("footer.vsRetool"), url: "/rebase-vs-retool" },
            { label: t("footer.vsFirebase"), url: "/rebase-vs-firebase" },
            { label: t("footer.vsHasura"), url: "/rebase-vs-hasura" },
            { label: t("footer.vsDjango"), url: "/rebase-vs-django" },
            { label: t("footer.allComparisons"), url: "/compare" },
        ],
    },
    {
        title: t("footer.company"),
        links: [
            { label: t("footer.about"), url: "/about" },
            { label: t("footer.blog"), url: "/blog", plain: true },
            { label: t("footer.startups"), url: "/startups" },
            { label: t("footer.agencies"), url: "/agencies" },
            { label: t("footer.europe"), url: "/europe" },
            { label: t("footer.contact"), url: "/contact" },
            { label: t("footer.kitDigital"), url: "/kit-digital" },
            { label: t("footer.bookCall"), url: "https://calendar.app.google/UDSmMagx6AEwar8P8", external: true },
        ],
    },
    {
        title: t("footer.legal"),
        links: [
            // The policy pages are not localized — they exist only at the root, so
            // `plain` keeps translatePath from prefixing a language segment that 404s.
            { label: t("footer.privacy"), url: "/policy/privacy_policy", plain: true },
            { label: t("footer.terms"), url: "/policy/terms_conditions", plain: true },
            { label: t("footer.cookies"), url: "/policy/cookies_policy", plain: true },
            // `plain` so the mailto: is emitted verbatim — translatePath would
            // otherwise prefix it with the language segment.
            { label: t("footer.reportVulnerability"), url: "mailto:security@rebase.pro", plain: true },
        ],
    },
];
---

<footer class="p-4 sm:p-6 bg-page-ground py-16 sm:py-24 border-t border-surface-800">
    <div class="mx-auto max-w-6xl">
        <div class="flex flex-col md:flex-row md:justify-between gap-8">
            <div>
                <div class="mb-6 md:mb-0">
                    <a href={translatePath("/")} class="flex items-center">
                        <span class="self-center text-lg font-semibold whitespace-nowrap text-white">Rebase</span>
                    </a>
                </div>
                <div class="text-surface-400 mt-4 text-sm">
                    {t("footer.tagline")}
                </div>
                <a href={translatePath("/manifesto")}
                   class="inline-flex items-center gap-1.5 mt-4 text-sm text-surface-400 hover:text-primary transition-colors duration-200 group">
                    {t("footer.manifesto")}
                    <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                </a>

                <form
                    id="footer-waitlist"
                    class="mt-8 max-w-xs"
                    novalidate
                    data-sending={t("footer.waitlistSending")}
                    data-success={t("footer.waitlistSuccess")}
                    data-invalid={t("footer.waitlistInvalid")}
                    data-error={t("footer.waitlistError")}
                >
                    <p class="text-sm font-semibold text-white">{t("footer.waitlistTitle")}</p>
                    <p class="mt-1 text-sm text-surface-400">{t("cloud.status")}</p>
                    <div class="mt-3 flex gap-2">
                        <label for="footer-waitlist-email" class="sr-only">{t("footer.waitlistPlaceholder")}</label>
                        <input
                            id="footer-waitlist-email"
                            type="email"
                            name="email"
                            autocomplete="email"
                            placeholder={t("footer.waitlistPlaceholder")}
                            class="min-w-0 flex-1 rounded-lg border border-surface-800 bg-surface-900 px-3 py-2 text-sm text-white placeholder:text-surface-500 focus:border-primary focus:outline-none"
                        />
                        <button
                            type="submit"
                            id="footer-waitlist-submit"
                            data-track
                            class="shrink-0 inline-flex items-center justify-center rounded-lg bg-primary border border-transparent px-4 py-0 min-h-(--control-medium) text-sm font-semibold text-white transition-colors hover:bg-primary-light disabled:opacity-60"
                        >
                            {t("footer.waitlistCta")}
                        </button>
                    </div>
                    <p id="footer-waitlist-status" class="mt-2 text-sm text-surface-400" role="status" aria-live="polite"></p>
                </form>
            </div>
            <div class="grid grid-cols-2 gap-8 sm:gap-6 sm:grid-cols-3 lg:grid-cols-6 xl:gap-8">
                {footerNavs.map((nav) => (
                    <div>
                        <p class="mb-6 text-sm font-semibold uppercase text-white">{nav.title}</p>
                        <ul class="text-surface-400 space-y-3">
                            {nav.links.map((link) => (
                                <li>
                                    <a
                                        href={link.external || link.plain ? link.url : translatePath(link.url)}
                                        target={link.external ? "_blank" : "_self"}
                                        rel={link.external ? "noopener noreferrer" : ""}
                                        class="hover:underline hover:text-primary-light transition-colors duration-200"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>
        <div class="mt-8 pt-8 ">
            <div class="sm:flex sm:items-center sm:justify-between">
                <span class="text-sm sm:text-center text-surface-400">{t("footer.rights")}</span>
                <div class="flex gap-6 mt-4 sm:mt-0">
                    <a href="https://github.com/rebasepro/rebase" target="_blank" rel="noopener noreferrer"
                       data-track
                       id="footer-github"
                       class="text-surface-400 hover:text-primary transition-colors">
                        <span class="sr-only">GitHub</span>
                        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                            <path fill-rule="evenodd"
                                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                                  clip-rule="evenodd"/>
                        </svg>
                    </a>
                    <a href="https://discord.gg/fxy7xsQm3m" target="_blank" rel="noopener noreferrer"
                       data-track
                       id="footer-discord"
                       class="text-surface-400 hover:text-primary transition-colors">
                        <span class="sr-only">Discord</span>
                        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</footer>

<script>
    // Astro hoists this into its own module, so it cannot see the component's
    // `t()` — the localized copy travels on the form's data-* attributes.
    const form = document.getElementById("footer-waitlist") as HTMLFormElement | null;

    if (form) {
        const emailEl = document.getElementById("footer-waitlist-email") as HTMLInputElement;
        const submitEl = document.getElementById("footer-waitlist-submit") as HTMLButtonElement;
        const statusEl = document.getElementById("footer-waitlist-status") as HTMLElement;
        const msg = form.dataset as Record<string, string>;

        const setStatus = (text: string, isError: boolean) => {
            statusEl.textContent = text;
            statusEl.className = `mt-2 text-sm ${isError ? "text-red-400" : "text-surface-400"}`;
        };

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            const email = emailEl.value.trim();

            // Loose on purpose, and matched to the server's own check: a false
            // rejection here costs a signup, which is worse than a bounce.
            if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                setStatus(msg.invalid, true);
                return;
            }

            submitEl.disabled = true;
            setStatus(msg.sending, false);

            try {
                const res = await fetch("https://app.rebase.pro/api/functions/waitlist", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ email, source: "website-footer" }),
                });
                const body = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(body?.error?.message || msg.error);

                // The endpoint is idempotent, so a repeat signup reports success
                // rather than an error the visitor cannot act on.
                form.querySelector(".flex")?.remove();
                setStatus(msg.success, false);
            } catch (err) {
                submitEl.disabled = false;
                setStatus(err instanceof Error ? err.message : msg.error, true);
            }
        });
    }
</script>
