---
interface Props {
  icon: any;
  title: string;
  description: string;
  link?: {
    href: string;
    text: string;
  };
}

const { icon: Icon, title, description, link } = Astro.props;
const Component = link ? 'a' : 'div';
---

<Component
  href={link?.href}
  class="group relative overflow-hidden rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800 transition-all duration-300 hover:ring-primary/30 block animate-on-scroll scale-in"
  data-spotlight-card>
  <!-- Mouse spotlight effect -->
  <div class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100" data-spotlight></div>
  <!-- Gradient border effect -->
  <div class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background: linear-gradient(135deg, transparent 0%, rgba(56, 189, 248, 0.1) 50%, transparent 100%); mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; padding: 1px;"></div>

  <div class="relative z-10">
    <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20">
      <Icon class="text-primary w-5 h-5" />
    </div>
    <h3 class="text-xl font-semibold text-white mb-4">{title}</h3>
    <p class="text-surface-400 mb-6">{description}</p>
    {link && (
      <span class="inline-flex items-center gap-x-2 text-primary-light group-hover:text-primary font-semibold transition-colors">
        {link.text}
        
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

      </span>
    )}
  </div>
  <!--<div class="pointer-events-none absolute -right-16 -bottom-16 h-56 w-56 rounded-full bg-primary/10 blur-3xl"></div>-->
</Component>

