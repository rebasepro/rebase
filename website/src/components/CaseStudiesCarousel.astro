---
/**
 * Client projects carousel.
 *
 * Peek-style track: each card is 2/3 of the content width, so the next one is
 * always partially visible. Native scroll-snap does the scrolling (touch swipe,
 * trackpad and momentum come for free); the script only wires the arrow pill,
 * pointer-drag on desktop, keyboard, and the counter.
 */
const { t } = Astro.props;

const cases = [
    {
        id: "dadaki",
        image: "/img/showcase/dadaki.webp",
        key: "case0",
        href: "https://dadaki.com",
        host: "dadaki.com",
        // The app mark from dadaki.com/logo.svg — a square tile rather than a
        // wordmark, so it is sized to sit level with the wordmarks beside it.
        logo: "/img/logos/dadaki.svg" as string | null,
        logoClass: "h-9 sm:h-10",
        logoIsMark: true,
        glow: "from-violet-500/25 via-primary/15 to-transparent"
    },
    {
        id: "medicalmotion",
        image: "/img/showcase/medicalmotion.webp",
        key: "case2",
        href: "https://medicalmotion.com",
        host: "medicalmotion.com",
        logo: "/img/logos/medicalmotion_white.svg",
        // Artwork is tightly cropped in its viewBox.
        logoClass: "h-7 sm:h-8",
        glow: "from-rose-500/25 via-primary/15 to-transparent"
    },
    {
        id: "sustentalent",
        image: "/img/showcase/sustentalent.webp",
        key: "case",
        href: "https://sustentalent.com",
        host: "sustentalent.com",
        logo: "/img/logos/sustentalent_white.svg",
        // Artwork occupies only the middle 50% of its viewBox, so it needs
        // roughly double the box height to read at the same optical size.
        logoClass: "h-14 sm:h-16 -my-3",
        glow: "from-emerald-500/25 via-primary/15 to-transparent"
    },
    {
        id: "presupuestos",
        image: "/img/showcase/presupuestos.webp",
        key: "case3",
        href: "https://presupuestos.rebase.website",
        host: "presupuestos.rebase.website",
        // The app's own favicon: a square mark, so it is sized to sit level
        // with the wordmarks the way dadaki's does.
        logo: "/img/logos/presupuestos.svg" as string | null,
        logoClass: "h-9 sm:h-10",
        logoIsMark: true,
        glow: "from-amber-500/25 via-primary/15 to-transparent"
    },
    {
        id: "prospector",
        image: "/img/showcase/prospector.webp",
        key: "case4",
        href: "https://prospector.rebase.website",
        host: "prospector.rebase.website",
        logo: null as string | null,
        logoClass: "",
        glow: "from-primary/25 via-violet-500/15 to-transparent"
    },
    {
        id: "unfeigned",
        image: "/img/showcase/unfeigned.webp",
        key: "case5",
        href: "https://unfeignedgear.com",
        host: "unfeignedgear.com",
        logo: null as string | null,
        logoClass: "",
        glow: "from-cyan-500/25 via-primary/15 to-transparent"
    },
    {
        id: "edith",
        // No public address, so nothing to photograph: this one keeps a
        // drawn figure. See the note on `href` below.
        image: null as string | null,
        key: "case6",
        // A client's internal tool: there is no public address to send a reader
        // to, so this card carries no link and `host` labels the chrome instead
        // of naming a domain that does not answer.
        href: null as string | null,
        host: "internal · edith",
        logo: null as string | null,
        logoClass: "",
        glow: "from-indigo-500/25 via-primary/15 to-transparent"
    }
];
---

{/* Closes the sequence, so it carries the numeral like every other chapter —
    the eyebrow already said "08" while nothing else on the section did. Cyan
    returns here from beat 01: the page opens and closes on the same hue. */}
<section id="s-case-study" class="chapter relative z-0 py-28 sm:py-36">

    <!-- Header: heading left, supporting copy right -->
    <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid gap-x-12 gap-y-6 lg:grid-cols-2 animate-on-scroll fade-in-up">
            <div>
                <p class="eyebrow">
                    <span class="font-mono">06</span><span
                        class="mx-2 text-surface-700">·</span>{t("showcase.badge")}
                </p>
                <h2 class="mt-4 font-headers text-display-2 text-white text-balance">
                    {t("showcase.title.part1")} {t("showcase.title.part2")}
                </h2>
            </div>
            <p class="text-lg leading-8 text-surface-400 lg:self-end lg:pb-1"
               set:html={t("showcase.subtitle")}></p>
        </div>
    </div>

    <div class="cs-carousel mt-14 sm:mt-16 animate-on-scroll fade-in-up delay-100"
         role="region"
         aria-roledescription="carousel"
         aria-label={t("showcase.title.part1") + " " + t("showcase.title.part2")}>

        <div class="cs-track" id="case-track" tabindex="0">
            {cases.map((c, i) => (
                <article class="cs-slide group" aria-roledescription="slide"
                         aria-label={`${i + 1} / ${cases.length}`}>

                    <!-- 16:9 media -->
                    <div class="cs-media">
                        <div class={`pointer-events-none absolute -inset-8 bg-gradient-to-tr ${c.glow} blur-3xl opacity-60`}></div>

                        <div class="relative h-full w-full flex flex-col rounded-2xl overflow-hidden ring-1 ring-white/10 bg-surface-950/90 shadow-[0_24px_60px_-15px_rgba(0,0,0,0.7)]">
                            <!-- browser chrome -->
                            <div class="flex-none px-4 py-2.5 border-b border-white/5 flex items-center gap-2 bg-surface-900/60">
                                <div class="ml-4 text-xs font-mono text-surface-500 truncate">{c.host}</div>
                            </div>

                            {/* The real product, photographed. These were six
                                hand-built HTML pastiches of each app — invented
                                rows, invented copy, invented numbers — under a
                                chrome bar naming a real host. A section headed
                                "Teams ship faster with Rebase" is evidence or it
                                is nothing, and a drawing of an app is not
                                evidence that the app exists.

                                object-top, not center: the crop tightens as the
                                card narrows, and what a screenshot can afford to
                                lose is its footer, never its masthead. */}
                            {c.image && (
                                <img src={c.image}
                                     alt={`${t(`showcase.${c.key}.title`)} running at ${c.host}`}
                                     class="min-h-0 flex-1 w-full object-cover object-top"
                                     loading="lazy" decoding="async"
                                     width="1600" height="1000"/>
                            )}

                            {/* ── Edith ────────────────────────────────────────
                                The automation canvas: a trigger, a branch and the
                                actions it fans out to. Node keys are taken from
                                the app's own catalogue. */}
                            {c.id === "edith" && (
                                <div class="relative min-h-0 flex-1 flex bg-gradient-to-b from-surface-900/40 to-transparent">
                                    <div class="flex-1 min-w-0 p-4 flex flex-col">
                                        <div class="flex items-center justify-between">
                                            <span class="text-sm font-semibold text-white">Stale deal follow-up</span>
                                            <span class="text-3xs px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-300 ring-1 ring-indigo-500/20">enabled</span>
                                        </div>

                                        <div class="mt-3 flex-1 min-h-0 flex flex-col justify-evenly">
                                            <div class="rounded-lg border border-indigo-500/30 bg-indigo-500/10 px-2.5 py-1.5 w-fit">
                                                <div class="text-3xs font-mono text-indigo-300">cron_trigger</div>
                                                <div class="text-3xs text-surface-400">every weekday · 08:00</div>
                                            </div>
                                            <div class="ml-4 h-2.5 w-px bg-white/10"></div>
                                            <div class="rounded-lg border border-white/10 bg-surface-900/60 px-2.5 py-1.5 w-fit">
                                                <div class="text-3xs font-mono text-white">conditional_switch</div>
                                                <div class="text-3xs text-surface-500">last_activity &gt; 14 days</div>
                                            </div>
                                            <div class="ml-4 h-2.5 w-px bg-white/10"></div>
                                            <div class="rounded-lg border border-white/10 bg-surface-900/60 px-2.5 py-1.5 w-fit">
                                                <div class="text-3xs font-mono text-white">delay</div>
                                                <div class="text-3xs text-surface-500">2 hours</div>
                                            </div>
                                            <div class="ml-4 h-2.5 w-px bg-white/10"></div>
                                            <div class="ml-4 flex flex-wrap gap-1.5">
                                                <span class="rounded-md border border-white/10 bg-surface-900/60 px-2 py-1 text-3xs font-mono text-surface-300">create_task</span>
                                                <span class="rounded-md border border-white/10 bg-surface-900/60 px-2 py-1 text-3xs font-mono text-surface-300">add_tag</span>
                                                <span class="rounded-md border border-white/10 bg-surface-900/60 px-2 py-1 text-3xs font-mono text-surface-300">create_activity</span>
                                            </div>
                                        </div>

                                        <div class="mt-3 flex items-center gap-2 border-t border-white/5 pt-2.5 text-3xs text-surface-500">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                                            <span>last run 08:00 · 12 items · 0 errors</span>
                                        </div>
                                    </div>
                                    <div class="w-2/5 flex-none border-l border-white/5 p-4 bg-surface-950/40 hidden sm:flex flex-col">
                                        <div class="text-3xs uppercase tracking-[0.18em] text-surface-500">Node catalogue</div>
                                        <div class="mt-1 text-2xl font-semibold text-white tabular-nums">25</div>
                                        <p class="mt-2 text-3xs leading-relaxed text-surface-500">Triggers, branches, delays and actions — all of them rows, so the team adds one without a deploy.</p>
                                        {/* The catalogue's own seven groups and their real counts —
                                            config/node-catalog.ts. */}
                                        <div class="mt-4 space-y-1.5" aria-hidden="true">
                                            {[
                                                { g: "Triggers", n: 5 },
                                                { g: "Logic", n: 5 },
                                                { g: "Data", n: 5 },
                                                { g: "Pipeline", n: 4 },
                                                { g: "Integration", n: 3 }
                                            ].map(r => (
                                                <div class="flex items-center gap-2">
                                                    <span class="w-20 shrink-0 text-3xs text-surface-500">{r.g}</span>
                                                    <span class="h-1.5 flex-1 rounded-full bg-white/5 overflow-hidden">
                                                        <span class="block h-full rounded-full bg-indigo-400/60" style={`width:${Math.round((r.n / 5) * 100)}%`}></span>
                                                    </span>
                                                    <span class="w-5 text-right text-3xs text-surface-500 tabular-nums">{r.n}</span>
                                                </div>
                                            ))}
                                        </div>
                                        <div class="mt-auto space-y-2.5 border-t border-white/5 pt-4">
                                            <div class="flex items-baseline justify-between">
                                                <span class="text-3xs text-surface-500">Collections</span>
                                                <span class="text-xs text-white tabular-nums">23</span>
                                            </div>
                                            <div class="flex items-baseline justify-between">
                                                <span class="text-3xs text-surface-500">Admin screens written</span>
                                                <span class="text-xs text-emerald-400 tabular-nums">0</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-8 bg-gradient-to-t from-surface-950 to-transparent"></div>
                                </div>
                            )}
                        </div>
                    </div>

                    <!-- Text column, deliberately narrower than the media -->
                    <div class="mt-7 max-w-xl">
                        <p class="text-xs font-medium tracking-[0.14em] uppercase text-surface-500">
                            {t(`showcase.${c.key}.badge`)}
                        </p>

                        <h3 class="mt-3 flex items-center gap-3 min-h-9">
                            {c.logo && (
                                <img src={c.logo} alt={(c as any).logoIsMark ? "" : t(`showcase.${c.key}.title`)}
                                     aria-hidden={(c as any).logoIsMark ? "true" : undefined}
                                     class={`${c.logoClass} w-auto`} loading="lazy"/>
                            )}
                            {(!c.logo || (c as any).logoIsMark) && (
                                <span class="text-2xl font-semibold text-white tracking-tight">
                                    {t(`showcase.${c.key}.title`)}
                                </span>
                            )}
                        </h3>

                        <p class="mt-4 text-base leading-relaxed text-surface-400">
                            {t(`showcase.${c.key}.desc`)}
                        </p>

                        {/* A card without an `href` is a tool with no public
                            address. It still gets a line here, as plain text —
                            an anchor with no destination is worse than none. */}
                        {c.href ? (
                            <a href={c.href} target="_blank" rel="noopener noreferrer"
                               class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-white/80 hover:text-primary transition-colors">
                                {c.host.replace(/^app\.|^talent\./, "")}
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true"
                                     class="transition-transform group-hover:translate-x-0.5">
                                    <path d="M7 7h10v10"/>
                                    <path d="M7 17 17 7"/>
                                </svg>
                            </a>
                        ) : (
                            <p class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-surface-500">
                                {t("showcase.nolink")}
                            </p>
                        )}
                    </div>
                </article>
            ))}
        </div>

        <!-- Controls, aligned to the content gutter -->
        <div class="cs-controls">
            <div class="inline-flex items-center rounded-full border border-surface-700/70 bg-surface-900/70 p-1 backdrop-blur-sm">
                <button id="case-prev" type="button"
                        class="cs-arrow" aria-controls="case-track" aria-label="Previous project">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                </button>
                <button id="case-next" type="button"
                        class="cs-arrow" aria-controls="case-track" aria-label="Next project">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="m9 18 6-6-6-6"/>
                    </svg>
                </button>
            </div>

            <p class="text-sm font-mono text-surface-500 tabular-nums">
                <span id="case-current" class="text-white">01</span>
                <span class="mx-1 text-surface-700">/</span>
                <span>{String(cases.length).padStart(2, "0")}</span>
            </p>
        </div>

        <p class="sr-only" aria-live="polite" id="case-live"></p>
    </div>
</section>

<style>
    .cs-carousel {
        /* Distance from the viewport edge to the content column, so the track's
           first card lines up with every other section on the page. */
        --cs-gutter: max(1.5rem, calc((100vw - 80rem) / 2 + 2rem));
        --cs-gap: 1.5rem;
        --cs-content: min(76rem, calc(100vw - var(--cs-gutter) * 2));
        --cs-slide: min(85vw, 30rem);
    }

    @media (min-width: 768px) {
        .cs-carousel {
            --cs-slide: min(calc(var(--cs-content) * 0.6667 - var(--cs-gap)), 46rem);
        }
    }

    @media (min-width: 1024px) {
        .cs-carousel {
            --cs-gutter: max(2rem, calc((100vw - 80rem) / 2 + 2rem));
            --cs-gap: 3rem;
        }
    }

    .cs-track {
        display: flex;
        gap: var(--cs-gap);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        padding-inline: var(--cs-gutter);
        scroll-padding-inline-start: var(--cs-gutter);
        /* room for the card shadows */
        padding-block: 1rem;
        margin-block: -1rem;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .cs-track::-webkit-scrollbar {
        display: none;
    }

    /* Trailing spacer so the last card can scroll all the way to the left
       gutter. 100% resolves against the track's content box, which is exactly
       the content column width. */
    .cs-track::after {
        content: "";
        flex: 0 0 max(0px, calc(100% - var(--cs-slide) - var(--cs-gap)));
    }

    .cs-slide {
        flex: 0 0 var(--cs-slide);
        scroll-snap-align: start;
    }

    .cs-media {
        position: relative;
        /* Narrow cards get a taller frame. This used to be about the mocked
           UIs needing rows; with real screenshots it earns its keep for the
           opposite reason — 16/9 on a phone-width card leaves a letterbox too
           short to read a masthead in, and object-top would crop everything
           below it away. */
        aspect-ratio: 4 / 3;
    }

    @media (min-width: 768px) {
        .cs-media {
            aspect-ratio: 16 / 9;
        }
    }

    .cs-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 2.5rem;
        padding-inline: var(--cs-gutter);
    }

    .cs-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.25rem;
        border-radius: 9999px;
        color: white;
        transition: background-color 150ms ease, color 150ms ease, opacity 150ms ease;
    }

    .cs-arrow:hover:not(:disabled) {
        background-color: var(--color-surface-800, #27272a);
    }

    .cs-arrow:disabled {
        opacity: 0.25;
        cursor: default;
    }

    /* While pointer-dragging, snapping and smooth scrolling would fight the drag. */
    .cs-track.is-dragging {
        scroll-snap-type: none;
        scroll-behavior: auto;
        cursor: grabbing;
        user-select: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .cs-track {
            scroll-behavior: auto;
        }
    }
</style>

<script>
    const setupCaseCarousel = () => {
        const track = document.getElementById("case-track");
        const prevBtn = document.getElementById("case-prev") as HTMLButtonElement | null;
        const nextBtn = document.getElementById("case-next") as HTMLButtonElement | null;
        const current = document.getElementById("case-current");
        const live = document.getElementById("case-live");

        if (!track || !prevBtn || !nextBtn || !current || !live) return;

        const slides = Array.from(track.querySelectorAll<HTMLElement>(".cs-slide"));
        if (slides.length === 0) return;

        const origin = () => slides[0].offsetLeft;
        const offsetOf = (i: number) => slides[i].offsetLeft - origin();

        const nearestIndex = () => {
            const x = track.scrollLeft;
            let best = 0;
            let bestDist = Infinity;
            slides.forEach((_, i) => {
                const dist = Math.abs(offsetOf(i) - x);
                if (dist < bestDist) {
                    bestDist = dist;
                    best = i;
                }
            });
            return best;
        };

        let index = 0;

        const render = () => {
            current.textContent = String(index + 1).padStart(2, "0");
            live.textContent = `Slide ${index + 1} of ${slides.length}`;
            prevBtn.disabled = index === 0;
            nextBtn.disabled = index === slides.length - 1;
        };

        const goTo = (i: number) => {
            const clamped = Math.max(0, Math.min(i, slides.length - 1));
            // Reflect the target straight away — the scroll listener would only
            // catch up once the smooth scroll is under way.
            index = clamped;
            render();
            track.scrollTo({ left: offsetOf(clamped) });
        };

        prevBtn.addEventListener("click", () => goTo(nearestIndex() - 1));
        nextBtn.addEventListener("click", () => goTo(nearestIndex() + 1));

        // Only sync once scrolling settles. Sampling every frame would report
        // the outgoing slide as "nearest" mid-animation and flick the counter
        // backwards before it lands.
        let settle = 0;
        track.addEventListener("scroll", () => {
            clearTimeout(settle);
            settle = window.setTimeout(() => {
                index = nearestIndex();
                render();
            }, 120);
        }, { passive: true });

        track.addEventListener("keydown", (event) => {
            if (event.key === "ArrowRight") {
                event.preventDefault();
                goTo(nearestIndex() + 1);
            } else if (event.key === "ArrowLeft") {
                event.preventDefault();
                goTo(nearestIndex() - 1);
            }
        });

        // Pointer drag for mouse users; touch already scrolls natively.
        let dragging = false;
        let startX = 0;
        let startScroll = 0;
        let moved = 0;

        track.addEventListener("pointerdown", (event) => {
            if (event.pointerType === "touch" || event.button !== 0) return;
            dragging = true;
            moved = 0;
            startX = event.clientX;
            startScroll = track.scrollLeft;
            track.classList.add("is-dragging");
        });

        track.addEventListener("pointermove", (event) => {
            if (!dragging) return;
            const dx = event.clientX - startX;
            moved = Math.max(moved, Math.abs(dx));
            if (moved > 4) track.setPointerCapture(event.pointerId);
            track.scrollLeft = startScroll - dx;
        });

        const endDrag = () => {
            if (!dragging) return;
            dragging = false;
            track.classList.remove("is-dragging");
            goTo(nearestIndex());
        };

        track.addEventListener("pointerup", endDrag);
        track.addEventListener("pointercancel", endDrag);

        // A drag that ends on a link must not navigate.
        track.addEventListener("click", (event) => {
            if (moved > 4) {
                event.preventDefault();
                event.stopPropagation();
                moved = 0;
            }
        }, true);

        // Card widths are viewport-derived, so offsets change on resize.
        window.addEventListener("resize", () => {
            goTo(index);
            render();
        });

        render();
    };

    setupCaseCarousel();
    document.addEventListener("astro:after-swap", setupCaseCarousel);
</script>
