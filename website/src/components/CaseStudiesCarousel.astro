<style>
    .cs-carousel {
        /* Distance from the viewport edge to the content column, so the track's
           first card lines up with every other section on the page. */
        --cs-gutter: max(1.5rem, calc((100vw - 80rem) / 2 + 2rem));
        --cs-gap: 1.5rem;
        --cs-content: min(76rem, calc(100vw - var(--cs-gutter) * 2));
        --cs-slide: min(85vw, 30rem);
    }

    @media (min-width: 768px) {
        .cs-carousel {
            --cs-slide: min(calc(var(--cs-content) * 0.6667 - var(--cs-gap)), 46rem);
        }
    }

    @media (min-width: 1024px) {
        .cs-carousel {
            --cs-gutter: max(2rem, calc((100vw - 80rem) / 2 + 2rem));
            --cs-gap: 3rem;
        }
    }

    .cs-track {
        display: flex;
        gap: var(--cs-gap);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        padding-inline: var(--cs-gutter);
        scroll-padding-inline-start: var(--cs-gutter);
        /* room for the card shadows */
        padding-block: 1rem;
        margin-block: -1rem;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .cs-track::-webkit-scrollbar {
        display: none;
    }

    /* Trailing spacer so the last card can scroll all the way to the left
       gutter. 100% resolves against the track's content box, which is exactly
       the content column width. */
    .cs-track::after {
        content: "";
        flex: 0 0 max(0px, calc(100% - var(--cs-slide) - var(--cs-gap)));
    }

    .cs-slide {
        flex: 0 0 var(--cs-slide);
        scroll-snap-align: start;
    }

    .cs-media {
        position: relative;
        /* Narrow cards get a taller frame, otherwise the mocked UIs are
           squeezed to a couple of rows. */
        aspect-ratio: 4 / 3;
    }

    @media (min-width: 768px) {
        .cs-media {
            aspect-ratio: 16 / 9;
        }
    }

    .cs-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 2.5rem;
        padding-inline: var(--cs-gutter);
    }

    .cs-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.25rem;
        border-radius: 9999px;
        color: white;
        transition: background-color 150ms ease, color 150ms ease, opacity 150ms ease;
    }

    .cs-arrow:hover:not(:disabled) {
        background-color: var(--color-surface-800, #27272a);
    }

    .cs-arrow:disabled {
        opacity: 0.25;
        cursor: default;
    }

    /* While pointer-dragging, snapping and smooth scrolling would fight the drag. */
    .cs-track.is-dragging {
        scroll-snap-type: none;
        scroll-behavior: auto;
        cursor: grabbing;
        user-select: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .cs-track {
            scroll-behavior: auto;
        }
    }
</style>

<script>
    const setupCaseCarousel = () => {
        const track = document.getElementById("case-track");
        const prevBtn = document.getElementById("case-prev") as HTMLButtonElement | null;
        const nextBtn = document.getElementById("case-next") as HTMLButtonElement | null;
        const current = document.getElementById("case-current");
        const live = document.getElementById("case-live");

        if (!track || !prevBtn || !nextBtn || !current || !live) return;

        const slides = Array.from(track.querySelectorAll<HTMLElement>(".cs-slide"));
        if (slides.length === 0) return;

        const origin = () => slides[0].offsetLeft;
        const offsetOf = (i: number) => slides[i].offsetLeft - origin();

        const nearestIndex = () => {
            const x = track.scrollLeft;
            let best = 0;
            let bestDist = Infinity;
            slides.forEach((_, i) => {
                const dist = Math.abs(offsetOf(i) - x);
                if (dist < bestDist) {
                    bestDist = dist;
                    best = i;
                }
            });
            return best;
        };

        let index = 0;

        const render = () => {
            current.textContent = String(index + 1).padStart(2, "0");
            live.textContent = `Slide ${index + 1} of ${slides.length}`;
            prevBtn.disabled = index === 0;
            nextBtn.disabled = index === slides.length - 1;
        };

        const goTo = (i: number) => {
            const clamped = Math.max(0, Math.min(i, slides.length - 1));
            // Reflect the target straight away — the scroll listener would only
            // catch up once the smooth scroll is under way.
            index = clamped;
            render();
            track.scrollTo({ left: offsetOf(clamped) });
        };

        prevBtn.addEventListener("click", () => goTo(nearestIndex() - 1));
        nextBtn.addEventListener("click", () => goTo(nearestIndex() + 1));

        // Only sync once scrolling settles. Sampling every frame would report
        // the outgoing slide as "nearest" mid-animation and flick the counter
        // backwards before it lands.
        let settle = 0;
        track.addEventListener("scroll", () => {
            clearTimeout(settle);
            settle = window.setTimeout(() => {
                index = nearestIndex();
                render();
            }, 120);
        }, { passive: true });

        track.addEventListener("keydown", (event) => {
            if (event.key === "ArrowRight") {
                event.preventDefault();
                goTo(nearestIndex() + 1);
            } else if (event.key === "ArrowLeft") {
                event.preventDefault();
                goTo(nearestIndex() - 1);
            }
        });

        // Pointer drag for mouse users; touch already scrolls natively.
        let dragging = false;
        let startX = 0;
        let startScroll = 0;
        let moved = 0;

        track.addEventListener("pointerdown", (event) => {
            if (event.pointerType === "touch" || event.button !== 0) return;
            dragging = true;
            moved = 0;
            startX = event.clientX;
            startScroll = track.scrollLeft;
            track.classList.add("is-dragging");
        });

        track.addEventListener("pointermove", (event) => {
            if (!dragging) return;
            const dx = event.clientX - startX;
            moved = Math.max(moved, Math.abs(dx));
            if (moved > 4) track.setPointerCapture(event.pointerId);
            track.scrollLeft = startScroll - dx;
        });

        const endDrag = () => {
            if (!dragging) return;
            dragging = false;
            track.classList.remove("is-dragging");
            goTo(nearestIndex());
        };

        track.addEventListener("pointerup", endDrag);
        track.addEventListener("pointercancel", endDrag);

        // A drag that ends on a link must not navigate.
        track.addEventListener("click", (event) => {
            if (moved > 4) {
                event.preventDefault();
                event.stopPropagation();
                moved = 0;
            }
        }, true);

        // Card widths are viewport-derived, so offsets change on resize.
        window.addEventListener("resize", () => {
            goTo(index);
            render();
        });

        render();
    };

    setupCaseCarousel();
    document.addEventListener("astro:after-swap", setupCaseCarousel);
</script>
