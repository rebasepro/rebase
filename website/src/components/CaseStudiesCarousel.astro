---
/**
 * Client projects carousel.
 *
 * Peek-style track: each card is 2/3 of the content width, so the next one is
 * always partially visible. Native scroll-snap does the scrolling (touch swipe,
 * trackpad and momentum come for free); the script only wires the arrow pill,
 * pointer-drag on desktop, keyboard, and the counter.
 */
const { t } = Astro.props;

const cases = [
    {
        id: "dadaki",
        key: "case0",
        href: "https://dadaki.com",
        host: "dadaki.com",
        // The app mark from dadaki.com/logo.svg — a square tile rather than a
        // wordmark, so it is sized to sit level with the wordmarks beside it.
        logo: "/img/logos/dadaki.svg" as string | null,
        logoClass: "h-9 sm:h-10",
        logoIsMark: true,
        glow: "from-violet-500/25 via-primary/15 to-transparent"
    },
    {
        id: "medicalmotion",
        key: "case2",
        href: "https://medicalmotion.com",
        host: "app.medicalmotion.com",
        logo: "/img/logos/medicalmotion_white.svg",
        // Artwork is tightly cropped in its viewBox.
        logoClass: "h-7 sm:h-8",
        glow: "from-rose-500/25 via-primary/15 to-transparent"
    },
    {
        id: "sustentalent",
        key: "case",
        href: "https://sustentalent.com",
        host: "talent.sustentalent.com",
        logo: "/img/logos/sustentalent_white.svg",
        // Artwork occupies only the middle 50% of its viewBox, so it needs
        // roughly double the box height to read at the same optical size.
        logoClass: "h-14 sm:h-16 -my-3",
        glow: "from-emerald-500/25 via-primary/15 to-transparent"
    },
    {
        id: "presupuestos",
        key: "case3",
        href: "https://presupuestos.rebase.website",
        host: "presupuestos.rebase.website",
        // The app's own favicon: a square mark, so it is sized to sit level
        // with the wordmarks the way dadaki's does.
        logo: "/img/logos/presupuestos.svg" as string | null,
        logoClass: "h-9 sm:h-10",
        logoIsMark: true,
        glow: "from-amber-500/25 via-primary/15 to-transparent"
    },
    {
        id: "prospector",
        key: "case4",
        href: "https://prospector.rebase.website",
        host: "prospector.rebase.website",
        logo: null as string | null,
        logoClass: "",
        glow: "from-primary/25 via-violet-500/15 to-transparent"
    },
    {
        id: "unfeigned",
        key: "case5",
        href: "https://unfeigned.com",
        host: "unfeigned.com",
        logo: null as string | null,
        logoClass: "",
        glow: "from-cyan-500/25 via-primary/15 to-transparent"
    },
    {
        id: "edith",
        key: "case6",
        // A client's internal tool: there is no public address to send a reader
        // to, so this card carries no link and `host` labels the chrome instead
        // of naming a domain that does not answer.
        href: null as string | null,
        host: "internal · edith",
        logo: null as string | null,
        logoClass: "",
        glow: "from-indigo-500/25 via-primary/15 to-transparent"
    }
];
---

<section id="s-case-study" class="relative z-0 py-28 sm:py-36">

    <!-- Header: heading left, supporting copy right -->
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid gap-x-12 gap-y-6 lg:grid-cols-2 animate-on-scroll fade-in-up">
            <div>
                <p class="text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                    <span class="font-mono text-surface-500">08</span><span
                        class="mx-2 text-surface-600">·</span>{t("showcase.badge")}
                </p>
                <h2 class="mt-4 text-3xl sm:text-5xl font-semibold tracking-tight text-white text-balance">
                    {t("showcase.title.part1")} {t("showcase.title.part2")}
                </h2>
            </div>
            <p class="text-lg leading-8 text-surface-400 lg:self-end lg:pb-1"
               set:html={t("showcase.subtitle")}></p>
        </div>
    </div>

    <div class="cs-carousel mt-14 sm:mt-16 animate-on-scroll fade-in-up delay-100"
         role="region"
         aria-roledescription="carousel"
         aria-label={t("showcase.title.part1") + " " + t("showcase.title.part2")}>

        <div class="cs-track" id="case-track" tabindex="0">
            {cases.map((c, i) => (
                <article class="cs-slide group" aria-roledescription="slide"
                         aria-label={`${i + 1} / ${cases.length}`}>

                    <!-- 16:9 media -->
                    <div class="cs-media">
                        <div class={`pointer-events-none absolute -inset-8 bg-gradient-to-tr ${c.glow} blur-3xl opacity-60`}></div>

                        <div class="relative h-full w-full flex flex-col rounded-2xl overflow-hidden ring-1 ring-white/10 bg-surface-950/90 shadow-[0_24px_60px_-15px_rgba(0,0,0,0.7)]">
                            <!-- browser chrome -->
                            <div class="flex-none px-4 py-2.5 border-b border-white/5 flex items-center gap-2 bg-surface-900/60">
                                <div class="ml-4 text-xs font-mono text-surface-500 truncate">{c.host}</div>
                            </div>

                            {c.id === "dadaki" && (
                                <img src="/img/showcase/dadaki_editor.png"
                                     alt="The Dadaki vector editor running in the browser"
                                     class="min-h-0 flex-1 w-full object-cover object-top"
                                     loading="lazy" width="1600" height="1000"/>
                            )}

                            {c.id === "medicalmotion" && (
                                <div class="relative min-h-0 flex-1 flex bg-gradient-to-b from-surface-900/40 to-transparent">
                                    <div class="flex-1 min-w-0 p-4 flex flex-col gap-2.5">
                                        <div class="flex items-center justify-between">
                                            <span class="text-sm font-semibold text-white">Today's Therapy</span>
                                            <span class="text-3xs px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-400 ring-1 ring-rose-500/20">3 pending</span>
                                        </div>
                                        <div class="rounded-lg border border-white/5 bg-surface-900/60 p-2.5 flex items-center gap-3">
                                            <div class="h-8 w-8 rounded-lg bg-rose-500/10 flex items-center justify-center flex-none">
                                                <span class="text-rose-400 text-xs font-semibold">N</span>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="text-xs font-medium text-white truncate">Neck Mobility Routine</div>
                                                <div class="text-3xs text-surface-500">10 mins · Video guide</div>
                                            </div>
                                            <span class="text-3xs px-1.5 py-0.5 rounded bg-primary/10 text-primary ring-1 ring-primary/20">Start</span>
                                        </div>
                                        <div class="rounded-lg border border-white/5 bg-surface-900/60 p-2.5 flex items-center gap-3">
                                            <div class="h-8 w-8 rounded-lg bg-primary/10 flex items-center justify-center flex-none">
                                                <span class="text-primary text-xs font-semibold">P</span>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="text-xs font-medium text-white truncate">Posture Correction</div>
                                                <div class="text-3xs text-surface-500">5 mins · Audio guide</div>
                                            </div>
                                            <span class="text-3xs px-1.5 py-0.5 rounded bg-surface-800 text-surface-400 ring-1 ring-white/10">Next</span>
                                        </div>
                                        <div class="rounded-lg border border-white/5 bg-surface-900/60 p-2.5 flex items-center gap-3">
                                            <div class="h-8 w-8 rounded-lg bg-violet-500/10 flex items-center justify-center flex-none">
                                                <span class="text-violet-400 text-xs font-semibold">L</span>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="text-xs font-medium text-white truncate">Lower Back Release</div>
                                                <div class="text-3xs text-surface-500">12 mins · Video guide</div>
                                            </div>
                                            <span class="text-3xs px-1.5 py-0.5 rounded bg-surface-800 text-surface-400 ring-1 ring-white/10">Next</span>
                                        </div>

                                        <div class="rounded-lg border border-white/5 bg-surface-900/60 p-2.5 flex items-center gap-3">
                                            <div class="h-8 w-8 rounded-lg bg-emerald-500/10 flex items-center justify-center flex-none">
                                                <span class="text-emerald-400 text-xs font-semibold">S</span>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="text-xs font-medium text-white truncate">Shoulder Stability</div>
                                                <div class="text-3xs text-surface-500">8 mins · Video guide</div>
                                            </div>
                                            <span class="text-3xs px-1.5 py-0.5 rounded bg-surface-800 text-surface-400 ring-1 ring-white/10">Next</span>
                                        </div>

                                        <div class="mt-auto pt-1">
                                            <div class="flex items-center justify-between text-3xs text-surface-500 mb-1.5">
                                                <span>Weekly goal</span>
                                                <span class="tabular-nums">4 / 6 sessions</span>
                                            </div>
                                            <div class="h-1.5 rounded-full bg-surface-800 overflow-hidden">
                                                <div class="h-full w-2/3 rounded-full bg-primary"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="w-2/5 flex-none border-l border-white/5 p-4 bg-surface-950/40 hidden sm:flex flex-col">
                                        <div class="text-3xs uppercase tracking-[0.18em] text-surface-500">Adherence</div>
                                        <div class="mt-1 text-2xl font-semibold text-white tabular-nums">87<span class="text-surface-500 text-base">%</span></div>
                                        <div class="mt-4 h-16 flex items-end gap-1.5">
                                            <div class="flex-1 rounded-sm bg-primary/25" style="height:45%"></div>
                                            <div class="flex-1 rounded-sm bg-primary/35" style="height:65%"></div>
                                            <div class="flex-1 rounded-sm bg-primary/25" style="height:40%"></div>
                                            <div class="flex-1 rounded-sm bg-primary/55" style="height:85%"></div>
                                            <div class="flex-1 rounded-sm bg-primary/40" style="height:70%"></div>
                                            <div class="flex-1 rounded-sm bg-primary" style="height:100%"></div>
                                        </div>
                                        <div class="mt-2 text-3xs text-surface-500">Last 6 weeks</div>

                                        <div class="mt-auto pt-4 space-y-2.5 border-t border-white/5">
                                            <div class="flex items-baseline justify-between">
                                                <span class="text-3xs text-surface-500">Sessions</span>
                                                <span class="text-xs text-white tabular-nums">128</span>
                                            </div>
                                            <div class="flex items-baseline justify-between">
                                                <span class="text-3xs text-surface-500">Avg. pain score</span>
                                                <span class="text-xs text-emerald-400 tabular-nums">−38%</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Fades any row the frame cuts off, so it
                                         reads as a scrolled view, not a crop. -->
                                    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-8 bg-gradient-to-t from-surface-950 to-transparent"></div>
                                </div>
                            )}

                            {c.id === "sustentalent" && (
                                <div class="relative min-h-0 flex-1 flex flex-col bg-gradient-to-b from-surface-900/40 to-transparent">
                                    <div class="flex-none px-4 py-3 flex items-center justify-between">
                                        <span class="text-sm font-semibold text-white">Companies</span>
                                        <span class="text-3xs px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 ring-1 ring-emerald-500/20">12 new</span>
                                    </div>
                                    <div class="flex-none px-4 py-2 flex items-center gap-4 text-3xs font-medium text-surface-500 border-y border-white/5 bg-surface-950/40">
                                        <span class="flex-1">Talent</span>
                                        <span class="w-24">CV</span>
                                        <span class="w-14 text-right">Score</span>
                                    </div>
                                    <div class="min-h-0 flex-1 divide-y divide-white/5">
                                        <div class="px-4 py-2.5 flex items-center gap-4">
                                            <span class="flex-1 text-xs text-white truncate">Ana Ruiz Moreno</span>
                                            <span class="w-24"><span class="text-3xs px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400">Parsed</span></span>
                                            <span class="w-14 text-right text-xs text-surface-400 tabular-nums">86</span>
                                        </div>
                                        <div class="px-4 py-2.5 flex items-center gap-4">
                                            <span class="flex-1 text-xs text-white truncate">Marc Oliveras</span>
                                            <span class="w-24"><span class="text-3xs px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400">Parsed</span></span>
                                            <span class="w-14 text-right text-xs text-surface-400 tabular-nums">74</span>
                                        </div>
                                        <div class="px-4 py-2.5 flex items-center gap-4 bg-primary/5">
                                            <span class="flex-1 text-xs text-white truncate">Laura Iglesias</span>
                                            <span class="w-24"><span class="text-3xs px-1.5 py-0.5 rounded bg-primary/15 text-primary-light">Importing…</span></span>
                                            <span class="w-14 text-right text-xs text-surface-600 tabular-nums">—</span>
                                        </div>
                                    </div>
                                    <!-- The point of the shot: a custom entity action, written in
                                         React with @rebasepro/ui primitives, living inside the
                                         generated panel. SustenTalent ships two — ImportCvAction
                                         and ExtractJobAction. -->
                                    <div class="border-t border-white/5 px-4 py-3">
                                        <div class="flex items-center gap-2">
                                            <span class="inline-flex h-5 w-5 items-center justify-center rounded bg-primary/15 text-primary-light">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3-3 3 3"/></svg>
                                            </span>
                                            <span class="text-2xs text-white">Import CV</span>
                                            <span class="text-3xs text-surface-500">entity action · custom React</span>
                                        </div>
                                        <div class="mt-2 flex items-center gap-2">
                                            <span class="text-3xs font-mono text-surface-500 truncate">laura-iglesias-cv.pdf</span>
                                            <span class="h-1 flex-1 rounded-full bg-white/8 overflow-hidden">
                                                <span class="block h-full w-2/3 rounded-full bg-primary/70"></span>
                                            </span>
                                        </div>
                                        <div class="mt-2 flex flex-wrap gap-1">
                                            <span class="text-3xs px-1.5 py-0.5 rounded bg-white/5 text-surface-400 font-mono">full_name</span>
                                            <span class="text-3xs px-1.5 py-0.5 rounded bg-white/5 text-surface-400 font-mono">location</span>
                                            <span class="text-3xs px-1.5 py-0.5 rounded bg-white/5 text-surface-400 font-mono">professional_objective</span>
                                            <span class="text-3xs px-1.5 py-0.5 rounded bg-white/5 text-surface-400 font-mono">strength_score</span>
                                        </div>
                                    </div>

                                    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-8 bg-gradient-to-t from-surface-950 to-transparent"></div>
                                </div>
                            )}

                            {/* ── Presupuestos ─────────────────────────────────
                                The page itself, reduced: the headline figure and
                                the top of the flow. Bands, figures and hues are
                                the live ones for 2024 (Hacienda / IGAE / Eurostat
                                via the app), not invented numbers. */}
                            {c.id === "presupuestos" && (
                                <div class="relative min-h-0 flex-1 flex flex-col bg-gradient-to-b from-surface-900/40 to-transparent px-4 py-3.5">
                                    <div class="flex items-start justify-between gap-3">
                                        <div>
                                            <div class="text-2xl font-semibold text-white tabular-nums leading-none">725.001 M€</div>
                                            <div class="mt-1 text-3xs text-surface-500">gastados por toda España en 2024</div>
                                        </div>
                                        <span class="text-3xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-300 ring-1 ring-amber-500/20 whitespace-nowrap">Todo el gasto</span>
                                    </div>

                                    {/* The four largest COFOG groups for 2024, read
                                        off the live app. Bar widths are the real
                                        ratios against the largest — if a figure is
                                        going to be on a marketing page it may as
                                        well be the figure. */}
                                    <div class="mt-3 flex-1 min-h-0 flex flex-col justify-evenly">
                                        <div>
                                            <div class="flex items-baseline justify-between text-3xs">
                                                <span class="text-surface-300">Protección social</span>
                                                <span class="text-surface-500 tabular-nums">297.532 M€</span>
                                            </div>
                                            <div class="mt-1 h-2.5 rounded-sm bg-[#e0a458]" style="width:100%"></div>
                                        </div>
                                        <div>
                                            <div class="flex items-baseline justify-between text-3xs">
                                                <span class="text-surface-300">Sanidad</span>
                                                <span class="text-surface-500 tabular-nums">102.942 M€</span>
                                            </div>
                                            <div class="mt-1 h-2.5 rounded-sm bg-[#4a9d7c]" style="width:35%"></div>
                                        </div>
                                        <div>
                                            <div class="flex items-baseline justify-between text-3xs">
                                                <span class="text-surface-300">Servicios públicos generales</span>
                                                <span class="text-surface-500 tabular-nums">92.551 M€</span>
                                            </div>
                                            <div class="mt-1 h-2.5 rounded-sm bg-[#c25b52]" style="width:31%"></div>
                                        </div>
                                        <div>
                                            <div class="flex items-baseline justify-between text-3xs">
                                                <span class="text-surface-300">Asuntos económicos</span>
                                                <span class="text-surface-500 tabular-nums">80.908 M€</span>
                                            </div>
                                            <div class="mt-1 h-2.5 rounded-sm bg-[#5b8ca8]" style="width:27%"></div>
                                        </div>
                                    </div>

                                    {/* The point of the shot: the page holds no
                                        database connection at all. */}
                                    <div class="mt-3 flex flex-wrap items-center gap-1.5 border-t border-white/5 pt-2.5">
                                        <span class="text-3xs px-1.5 py-0.5 rounded bg-white/5 text-surface-400 font-mono">cron · monthly</span>
                                        <span class="text-3xs px-1.5 py-0.5 rounded bg-white/5 text-surface-400 font-mono">storage · *.json</span>
                                        <span class="text-3xs px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono">0 API calls</span>
                                    </div>
                                </div>
                            )}

                            {/* ── Prospector ───────────────────────────────────
                                One agent run, top to bottom, and the draft it
                                stops at. Statuses are the real ones from the
                                `messages` enum — which has no `sent`. */}
                            {c.id === "prospector" && (
                                <div class="relative min-h-0 flex-1 flex bg-gradient-to-b from-surface-900/40 to-transparent">
                                    <div class="flex-1 min-w-0 p-4 flex flex-col gap-2">
                                        <div class="flex items-center justify-between">
                                            <span class="text-sm font-semibold text-white">Agent run</span>
                                            <span class="text-3xs px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 ring-1 ring-emerald-500/20">done · 4m 12s</span>
                                        </div>
                                        {[
                                            { step: "Read the site → ICP", n: "1 page" },
                                            { step: "Planned audiences", n: "5 segments" },
                                            { step: "Found companies", n: "68 · 31 verified" },
                                            { step: "Named people", n: "44 contacts" }
                                        ].map(r => (
                                            <div class="flex items-center gap-2.5 text-3xs">
                                                <span class="inline-flex h-4 w-4 flex-none items-center justify-center rounded-full bg-emerald-500/15 text-emerald-400">
                                                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                                                </span>
                                                <span class="flex-1 text-surface-300 truncate">{r.step}</span>
                                                <span class="text-surface-500 tabular-nums whitespace-nowrap">{r.n}</span>
                                            </div>
                                        ))}
                                        <div class="mt-1 flex-1 min-h-0 flex flex-col gap-2 justify-center">
                                            <div class="rounded-lg border border-white/5 bg-surface-900/60 p-2.5">
                                                <div class="flex items-center justify-between gap-2">
                                                    <span class="text-2xs text-white truncate">Re: procurement for 400 field techs</span>
                                                    <span class="text-3xs px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-300 whitespace-nowrap">needs_review</span>
                                                </div>
                                                <p class="mt-1.5 text-3xs leading-relaxed text-surface-500 line-clamp-2">Saw your careers page is hiring six regional service managers — usually that means the dispatch spreadsheet has stopped scaling…</p>
                                            </div>
                                            <div class="rounded-lg border border-white/5 bg-surface-900/60 p-2.5">
                                                <div class="flex items-center justify-between gap-2">
                                                    <span class="text-2xs text-white truncate">Your ISO 27001 audit, in March</span>
                                                    <span class="text-3xs px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 whitespace-nowrap">approved</span>
                                                </div>
                                                <p class="mt-1.5 text-3xs leading-relaxed text-surface-500 line-clamp-2">Your trust page went up in January and the SOC 2 badge is still pending — if the auditor asked for evidence collection…</p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-1.5 pt-1">
                                            <span class="text-3xs px-1.5 py-0.5 rounded bg-white/5 text-surface-400 font-mono">status: no `sent` value</span>
                                            <span class="text-3xs text-surface-600">— a human sends, or nobody does</span>
                                        </div>
                                    </div>
                                    <div class="w-2/5 flex-none border-l border-white/5 p-4 bg-surface-950/40 hidden sm:flex flex-col">
                                        <div class="text-3xs uppercase tracking-[0.18em] text-surface-500">Verified</div>
                                        <div class="mt-1 text-2xl font-semibold text-white tabular-nums">31<span class="text-surface-500 text-base">/68</span></div>
                                        <p class="mt-2 text-3xs leading-relaxed text-surface-500">Every company the model proposes is checked by fetching its own site. Roughly half do not survive it.</p>
                                        <div class="mt-4 h-16 flex items-end gap-1.5" aria-hidden="true">
                                            <div class="flex-1 rounded-sm bg-primary/25" style="height:38%"></div>
                                            <div class="flex-1 rounded-sm bg-primary/40" style="height:62%"></div>
                                            <div class="flex-1 rounded-sm bg-primary/30" style="height:48%"></div>
                                            <div class="flex-1 rounded-sm bg-primary/55" style="height:80%"></div>
                                            <div class="flex-1 rounded-sm bg-primary/45" style="height:66%"></div>
                                            <div class="flex-1 rounded-sm bg-primary" style="height:100%"></div>
                                        </div>
                                        <div class="mt-2 text-3xs text-surface-500">Contacts, last 6 runs</div>
                                        <div class="mt-auto space-y-2.5 border-t border-white/5 pt-4">
                                            <div class="flex items-baseline justify-between">
                                                <span class="text-3xs text-surface-500">Crons</span>
                                                <span class="text-xs text-white tabular-nums">7</span>
                                            </div>
                                            <div class="flex items-baseline justify-between">
                                                <span class="text-3xs text-surface-500">Emails sent</span>
                                                <span class="text-xs text-emerald-400 tabular-nums">0</span>
                                            </div>
                                        </div>
                                    </div>
