                    </div>
                </article>
            ))}
        </div>

        <!-- Controls, aligned to the content gutter -->
        <div class="cs-controls">
            <div class="inline-flex items-center rounded-full border border-surface-700/70 bg-surface-900/70 p-1 backdrop-blur-sm">
                <button id="case-prev" type="button"
                        class="cs-arrow" aria-controls="case-track" aria-label="Previous project">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                </button>
                <button id="case-next" type="button"
                        class="cs-arrow" aria-controls="case-track" aria-label="Next project">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="m9 18 6-6-6-6"/>
                    </svg>
                </button>
            </div>

            <p class="text-sm font-mono text-surface-500 tabular-nums">
                <span id="case-current" class="text-white">01</span>
                <span class="mx-1 text-surface-700">/</span>
                <span>{String(cases.length).padStart(2, "0")}</span>
            </p>
        </div>

