---
import { getLangFromUrl, getUnlocalizedPath } from '../i18n/utils';
import { languages } from '../i18n/ui';

const currentLang = getLangFromUrl(Astro.url);
const currentUnlocalizedPath = getUnlocalizedPath(Astro.url);

export interface Props {
    iconOnly?: boolean;
}

const { iconOnly = false } = Astro.props;
---

{iconOnly ? (
    <div class="relative w-9 h-9 flex items-center justify-center rounded-md hover:bg-white/10 transition-colors cursor-pointer" title="Change language">
        <svg class="w-4 h-4 text-surface-300 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
        </svg>
        <rebase-lang-select>
            <select
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                    aria-label="Change language"
            >
                {Object.entries(languages).map(([code, label]) => (
                        <option
                                value={code === "en" ? currentUnlocalizedPath : `/${code}${currentUnlocalizedPath}`}
                                data-lang={code}
                                selected={code === currentLang}
                        >
                            {label}
                        </option>
                ))}
            </select>
        </rebase-lang-select>
    </div>
) : (
<div class="inline-flex relative">
    <rebase-lang-select>
        <div class="relative items-center">
            <svg class="absolute left-2.5 top-1/2 -mt-2 w-4 h-4 text-surface-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
            </svg>
            <select
                    aria-label="Change language"
                    class="appearance-none bg-page-ground border border-surface-800 text-surface-400 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full outline-none pl-9 pr-8 py-2 hover:bg-surface-900 transition-colors cursor-pointer"
            >
                {Object.entries(languages).map(([code, label]) => (
                        <option
                                value={code === "en" ? currentUnlocalizedPath : `/${code}${currentUnlocalizedPath}`}
                                data-lang={code}
                                selected={code === currentLang}
                        >
                            {label}
                        </option>
                ))}
            </select>
            <svg class="absolute right-2.5 top-1/2 -mt-2 w-4 h-4 text-surface-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
        </div>
    </rebase-lang-select>
</div>
)}

<script>
    class RebaseLanguageSelect extends HTMLElement {
        constructor() {
            super();
            const select = this.querySelector('select');
            if (!select) return;

            // Show the language actually being rendered, not the one the URL implies
            this._syncToRenderedLang(select);

            select.addEventListener('change', (e) => {
                if (e.currentTarget instanceof HTMLSelectElement) {
                    const option = e.currentTarget.selectedOptions[0];
                    const targetPath = e.currentTarget.value;
                    this._persistLang(option?.dataset.lang);
                    window.location.pathname = targetPath;
                }
            });

            // On bfcache restore, sync to current URL instead of resetting to
            // server-rendered markup value (which reflects Firebase's auto-detection,
            // not the user's explicit choice)
            window.addEventListener('pageshow', (event) => {
                if (!event.persisted) return;
                this._syncToRenderedLang(select);
            });
        }

        // Firebase Hosting content-negotiates "/" against Accept-Language (the
        // `i18n` block in firebase.json), so a Spanish phone gets Spanish HTML at
        // the English URL. `firebase-language-override` is the documented way to
        // pin that: without it, picking "English" navigates to "/" and Firebase
        // negotiates straight back to Spanish, with no way out of the loop.
        _persistLang(lang: string | undefined) {
            if (!lang) return;
            try {
                const secure = window.location.protocol === 'https:' ? '; secure' : '';
                document.cookie = `firebase-language-override=${lang}; path=/; max-age=31536000; samesite=lax${secure}`;
            } catch (_) {}
        }

        // The URL is not the source of truth while negotiation is on: "/" can render
        // any locale. What was actually served is, so read it off <html lang>.
        _syncToRenderedLang(select: HTMLSelectElement) {
            const rendered = document.documentElement.lang;
            if (rendered) {
                for (let i = 0; i < select.options.length; i++) {
                    if (select.options[i].dataset.lang === rendered) {
                        select.selectedIndex = i;
                        return;
                    }
                }
            }
            this._syncToCurrentPath(select);
        }

        _syncToCurrentPath(select: HTMLSelectElement) {
            const currentPath = window.location.pathname;
            // Find the option whose value best matches the current path
            let bestIndex = 0;
            let bestMatch = 0;
            for (let i = 0; i < select.options.length; i++) {
                const optVal = select.options[i].value;
                // Exact match
                if (optVal === currentPath) {
                    bestIndex = i;
                    break;
                }
                // Prefix match (e.g. option "/pt/" matches "/pt/docs/...")
                if (currentPath.startsWith(optVal) && optVal.length > bestMatch) {
                    bestMatch = optVal.length;
                    bestIndex = i;
                }
            }
            select.selectedIndex = bestIndex;
        }
    }
    customElements.define('rebase-lang-select', RebaseLanguageSelect);
</script>
