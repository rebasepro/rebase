---
// ScrollSyncShowcase.astro
// A two-column scroll-sync section with a sticky index on the left
// Uses Tailwind classes available in the site. Pure placeholders.

import { EntityViewDemo } from './demos/EntityViewDemo';
import { SchemaEditorDemo } from './SchemaEditorDemo';
import { SQLEditorDemo } from './demos/SQLEditorDemo';

import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="scroll-sync-showcase" class="relative isolate py-chapter">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <!-- Section Title - independent but aligned with left menu -->
        <div class="w-full lg:w-[400px] mb-36 mt-16">
            <p class="mb-label text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">{t('showcase.sync.badge')}</p>
            <h2 class="text-3xl sm:text-4xl text-white" set:html={t('showcase.sync.title')}></h2>
            <p class="mt-lead text-lg leading-8 text-surface-400">{t('showcase.sync.subtitle')}</p>
        </div>

        <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
            <!-- Left: Sticky index/menu - hidden on mobile -->
            <aside class="hidden lg:block lg:w-[400px] flex-shrink-0">
                <nav class="sticky top-48">
                    <ol class="space-y-8">
                        <li>
                            <a href="#screen-1" data-index-item class="group block" data-active="false">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl sm:text-3xl text-white transition-opacity group-data-[active=false]:opacity-40 group-data-[active=true]:opacity-100">{t('showcase.sync.tab1.title')}</span>
                                </div>
                                <div class="overflow-hidden transition-all duration-300 ease-out group-data-[active=false]:max-h-0 group-data-[active=true]:max-h-60">
                                    <p class="text-base text-surface-400 pt-2 pb-1 opacity-0 group-data-[active=true]:opacity-100 transition-opacity duration-300 delay-75">
                                        {t('showcase.sync.tab1.desc')}
                                    </p>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="#screen-2" data-index-item class="group block" data-active="false">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl sm:text-3xl text-white transition-opacity group-data-[active=false]:opacity-40 group-data-[active=true]:opacity-100">{t('showcase.sync.tab2.title')}</span>
                                </div>
                                <div class="overflow-hidden transition-all duration-300 ease-out group-data-[active=false]:max-h-0 group-data-[active=true]:max-h-60">
                                     <p class="text-base text-surface-400 pt-2 pb-1 opacity-0 group-data-[active=true]:opacity-100 transition-opacity duration-300 delay-75">
                                        {t('showcase.sync.tab2.desc')}
                                    </p>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="#screen-3" data-index-item class="group block" data-active="false">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl sm:text-3xl text-white transition-opacity group-data-[active=false]:opacity-40 group-data-[active=true]:opacity-100">{t('showcase.sync.tab3.title')}</span>
                                </div>
                                <div class="overflow-hidden transition-all duration-300 ease-out group-data-[active=false]:max-h-0 group-data-[active=true]:max-h-60">
                                    <p class="text-base text-surface-400 pt-2 pb-1 opacity-0 group-data-[active=true]:opacity-100 transition-opacity duration-300 delay-75">
                                        {t('showcase.sync.tab3.desc')}
                                    </p>
                                </div>
                            </a>
                        </li>

                    </ol>
                </nav>
            </aside>

            <!-- Right: Content area with fixed size (can overflow) -->
            <div class="flex-1 w-full lg:min-w-0">
                <div class="w-full lg:w-[1240px] space-y-32">
                    <!-- Screen 1: Collection views (table / cards / list / Kanban) -->
                    <div id="screen-1" class="scroll-mt-32">
                        <h3 class="lg:hidden text-2xl text-white mb-6">{t('showcase.sync.tab1.title')}</h3>
                        <section data-screen class="w-full will-change-transform" inert aria-hidden="true">
                            <div class="relative rounded-2xl p-[1px]">
                                <div class="relative rounded-2xl overflow-hidden ring-1 ring-white/10 bg-surface-950">
                                    <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-primary/10 blur-3xl"></div>
                                    <EntityViewDemo client:visible />
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- Screen 2: Built-in SQL editor -->
                    <div id="screen-2" class="scroll-mt-32">
                        <h3 class="lg:hidden text-2xl text-white mb-6">{t('showcase.sync.tab2.title')}</h3>
                        <section data-screen class="w-full will-change-transform" inert aria-hidden="true">
                            <div class="relative rounded-2xl p-[1px]">
                                <div class="relative rounded-2xl overflow-hidden ring-1 ring-white/10 bg-surface-950">
                                    <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-primary/10 blur-3xl"></div>
                                    <SQLEditorDemo client:load />
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- Screen 3: Schema Builder -->
                    <div id="screen-3" class="scroll-mt-32">
                        <h3 class="lg:hidden text-2xl text-white mb-6">{t('showcase.sync.tab3.title')}</h3>
                        <section data-screen class="w-full will-change-transform" inert aria-hidden="true">
                            <div class="relative rounded-2xl p-[1px]">
                                <div class="relative rounded-2xl overflow-hidden ring-1 ring-white/10 bg-surface-950">
                                    <SchemaEditorDemo client:load />
                                </div>
                            </div>
                        </section>
                    </div>



                </div>
            </div>
        </div>
    </div>

    <script>
        function initScrollSync() {
            const root = document.getElementById("scroll-sync-showcase");
            if (!root) return;

            const wrappers = root.querySelectorAll("[id^='screen-']") as NodeListOf<HTMLElement>;
            const screens = root.querySelectorAll("[data-screen]") as NodeListOf<HTMLElement>;
            const indexItems = root.querySelectorAll("[data-index-item]") as NodeListOf<HTMLAnchorElement>;

            if (!wrappers.length || !screens.length || !indexItems.length) return;

            const byId = new Map<string, HTMLAnchorElement>();
            indexItems.forEach((a) => {
                const id = a.getAttribute("href")?.replace("#", "") || "";
                if (id) byId.set(id, a);
                a.addEventListener("click", (e) => {
                    e.preventDefault();
                    const target = document.getElementById(id);
                    if (target) {
                        const targetRect = target.getBoundingClientRect();
                        const scrollMargin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
                        const targetY = window.scrollY + targetRect.top - scrollMargin;
                        window.scrollTo({
                            top: targetY,
                            behavior: "smooth"
                        });
                    }
                });
            });

            let currentActive = "";

            const activate = (id: string) => {
                if (currentActive === id) return;
                currentActive = id;
                indexItems.forEach((a) => a.setAttribute("data-active", "false"));
                const el = byId.get(id);
                if (el) el.setAttribute("data-active", "true");
            };

            // Activate first item immediately
            const firstId = wrappers[0]?.id;
            if (firstId) activate(firstId);

            const intersectionState = new Map<string, IntersectionObserverEntry>();
            let updateTimeout: number | null = null;

            const updateActiveSection = () => {
                let bestEntry: IntersectionObserverEntry | null = null;
                let bestRatio = 0;

                intersectionState.forEach((entry) => {
                    if (entry.isIntersecting && entry.intersectionRatio > bestRatio) {
                        bestRatio = entry.intersectionRatio;
                        bestEntry = entry;
                    }
                });

                if (bestEntry) {
                    const target = (bestEntry as IntersectionObserverEntry).target;
                    if (target instanceof HTMLElement) {
                        activate(target.id);
                    }
                }
            };

            const io = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        intersectionState.set(entry.target.id, entry);
                    });
                    if (updateTimeout) clearTimeout(updateTimeout);
                    updateTimeout = window.setTimeout(updateActiveSection, 50);
                },
                {
                    rootMargin: "-10% 0px -20% 0px",
                    threshold: [0, 0.1, 0.25, 0.5, 0.75]
                }
            );
            wrappers.forEach((w) => io.observe(w));

            // Scroll-bound animation
            const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            const maxOffsetPx = 32;
            const minOpacity = 0.25;

            const clamp = (v: number, min: number, max: number): number => Math.max(min, Math.min(max, v));

            const update = () => {
                const vh = window.innerHeight || 1;
                const start = vh * 0.2;
                const end = vh * 0.6;
                const span = Math.max(1, end - start);

                screens.forEach((s) => {
                    const rect = s.getBoundingClientRect();
                    if (prefersReduced) {
                        s.style.opacity = "1";
                        s.style.transform = "translate3d(0,0,0)";
                        return;
                    }
                    const p = clamp((end - rect.top) / span, 0, 1);
                    const tx = (1 - p) * maxOffsetPx;
                    const op = minOpacity + p * (1 - minOpacity);
                    s.style.opacity = String(op);
                    s.style.transform = `translate3d(${tx}px, 0, 0)`;
                });
            };

            let ticking = false;
            const requestTick = () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(() => {
                    update();
                    ticking = false;
                });
            };

            window.addEventListener("scroll", requestTick, { passive: true });
            window.addEventListener("resize", requestTick);
            requestTick();
        }

        // Run on initial load and after view transition navigation
        document.addEventListener("astro:page-load", initScrollSync);
    </script>
</section>
