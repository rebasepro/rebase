---
import PitchSlide from '../PitchSlide.astro';
const TOTAL = 12;
---
<PitchSlide id="slide-tech" slideNumber={9} totalSlides={TOTAL}>
    <p class="text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase mb-4">Technology & Innovation</p>
    <h2 class="text-4xl font-semibold text-white mb-8">Schema as the single source of truth.</h2>
    <div class="grid grid-cols-2 gap-8">
        <div>
            <h3 class="text-white font-semibold mb-4 text-lg">Architecture</h3>
            <div class="space-y-3">
                <div class="flex items-start gap-3">
                    <a href="https://rebase.pro/studio" target="_blank" rel="noopener" class="text-3xs font-semibold px-2 py-1 rounded bg-primary/20 text-primary whitespace-nowrap hover:opacity-80 transition-opacity">Schema Layer</a>
                    <p class="text-surface-300 text-xs">TypeScript definitions with AST-based visual editor (Rebase Studio)</p>
                </div>
                <div class="flex items-start gap-3">
                    <a href="https://hono.dev" target="_blank" rel="noopener" class="text-3xs font-semibold px-2 py-1 rounded bg-emerald-500/20 text-emerald-400 whitespace-nowrap hover:opacity-80 transition-opacity">Backend</a>
                    <p class="text-surface-300 text-xs">Hono-based Node.js server — REST, WebSocket, crons, functions</p>
                </div>
                <div class="flex items-start gap-3">
                    <a href="https://react.dev" target="_blank" rel="noopener" class="text-3xs font-semibold px-2 py-1 rounded bg-violet-500/20 text-violet-400 whitespace-nowrap hover:opacity-80 transition-opacity">The panel</a>
                    <p class="text-surface-300 text-xs">React 19 SPA — table/kanban/gallery views, rich-text editor, inline editing</p>
                </div>
                <div class="flex items-start gap-3">
                    <a href="https://rebase.pro/sdk" target="_blank" rel="noopener" class="text-3xs font-semibold px-2 py-1 rounded bg-amber-500/20 text-amber-400 whitespace-nowrap hover:opacity-80 transition-opacity">Client SDK</a>
                    <p class="text-surface-300 text-xs">Fully typed TypeScript SDK with auth, queries, subscriptions, storage</p>
                </div>
                <div class="flex items-start gap-3">
                    <a href="https://www.postgresql.org" target="_blank" rel="noopener" class="text-3xs font-semibold px-2 py-1 rounded bg-cyan-500/20 text-cyan-400 whitespace-nowrap hover:opacity-80 transition-opacity">Database</a>
                    <p class="text-surface-300 text-xs">PostgreSQL — connects to YOUR existing database, no migration required</p>
                </div>
            </div>
        </div>
        <div>
            <h3 class="text-white font-semibold mb-4 text-lg">Key Innovations</h3>
            <div class="space-y-4">
                <a href="https://rebase.pro/docs/architecture/schema-as-code" target="_blank" rel="noopener" class="rounded-xl border border-surface-700 bg-surface-900/40 p-4 block hover:border-surface-600 transition-colors">
                    <div class="flex items-center gap-2 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
                        <h4 class="text-white text-sm font-semibold">Schema Introspection</h4>
                    </div>
                    <p class="text-surface-300 text-xs">Connect any Postgres DB → auto-generate full admin + APIs. Zero config.</p>
                </a>
                <a href="https://rebase.pro/studio" target="_blank" rel="noopener" class="rounded-xl border border-surface-700 bg-surface-900/40 p-4 block hover:border-surface-600 transition-colors">
                    <div class="flex items-center gap-2 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-violet-400"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/></svg>
                        <h4 class="text-white text-sm font-semibold">Visual Schema Editor (Studio)</h4>
                    </div>
                    <p class="text-surface-300 text-xs">Design your data model visually — every change writes back to TypeScript files via AST.</p>
                </a>
                <a href="https://rebase.pro/ai" target="_blank" rel="noopener" class="rounded-xl border border-surface-700 bg-surface-900/40 p-4 block hover:border-surface-600 transition-colors">
                    <div class="flex items-center gap-2 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
                        <h4 class="text-white text-sm font-semibold">AI & MCP Integration</h4>
                    </div>
                    <p class="text-surface-300 text-xs">AI autofill, natural language queries, and MCP server for AI agent integration.</p>
                </a>
            </div>
        </div>
    </div>
</PitchSlide>
