---
import PitchSlide from '../PitchSlide.astro';
const TOTAL = 13;

const founders = [
    {
        name: "Francesco Gatti",
        role: "CEO & Co-Founder",
        photo: "/img/avatars/francesco_avatar.jpg",
        photoSize: 512,
        initials: "FG",
        bio: "10+ years building developer tools and open-source products. Creator of FireCMS, used by 10,000+ projects worldwide. Full-stack engineer with deep expertise in React, Firebase, and cloud infrastructure.",
        links: { linkedin: "https://www.linkedin.com/in/fgatti675/", github: "https://github.com/fgatti675" },
    },
    {
        name: "Marian Moldovan",
        role: "CTO & Co-Founder",
        photo: "/img/avatars/marian_avatar.jpeg",
        photoSize: 800,
        initials: "MM",
        bio: "Full-stack architect and systems engineer. Expert in database design, real-time infrastructure, and scalable backend systems. Co-architect of the Rebase platform and its multi-database engine.",
        links: { linkedin: "https://www.linkedin.com/in/marianmoldovan/", github: "https://github.com/marianmoldovan" },
    },
];
---
<PitchSlide id="slide-team" slideNumber={2} totalSlides={TOTAL}>
    <p class="text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase mb-4">The Team</p>
    <h2 class="text-4xl font-semibold text-white mb-3">Built by developers who've <span class="text-primary">shipped at scale.</span></h2>
    <p class="text-surface-300 text-sm mb-8 max-w-3xl">The team behind <a href="https://firecms.co" target="_blank" rel="noopener" class="text-white font-semibold hover:text-primary transition-colors">FireCMS</a> (10,000+ projects, 1,200+ GitHub stars). Now building the next-generation open-source app platform for Europe.</p>

    <div class="grid grid-cols-2 gap-8 mb-8">
        {founders.map(f => (
            <div class="rounded-2xl border border-surface-700 bg-surface-900/40 p-6 flex gap-5 items-start">
                {/* Photo placeholder */}
                <div class="flex-shrink-0">
                    {f.photo ? (
                        <img src={f.photo} alt={f.name} width={f.photoSize} height={f.photoSize} class="w-20 h-20 rounded-xl object-cover ring-2 ring-surface-700" />
                    ) : (
                        <div class="w-20 h-20 rounded-xl bg-surface-800 ring-2 ring-surface-700 flex items-center justify-center">
                            <span class="text-2xl font-semibold text-surface-400">{f.initials}</span>
                        </div>
                    )}
                </div>
                <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                        <h3 class="text-white font-semibold text-lg">{f.name}</h3>
                    </div>
                    <p class="text-primary text-xs font-semibold uppercase tracking-wider mb-2">{f.role}</p>
                    <p class="text-surface-300 text-xs leading-relaxed">{f.bio}</p>
                    <div class="flex gap-3 mt-3">
                        <a href={f.links.linkedin} target="_blank" rel="noopener" class="text-surface-400 hover:text-white transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                        </a>
                        <a href={f.links.github} target="_blank" rel="noopener" class="text-surface-400 hover:text-white transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        ))}
    </div>

    <div class="grid grid-cols-4 gap-4">
        <div class="rounded-xl border border-surface-700 bg-surface-900/30 p-4 text-center">
            <div class="text-2xl font-semibold text-primary mb-1">5+</div>
            <p class="text-xs text-surface-300">Years building dev tools</p>
        </div>
        <div class="rounded-xl border border-surface-700 bg-surface-900/30 p-4 text-center">
            <div class="text-2xl font-semibold text-emerald-400 mb-1">10K+</div>
            <p class="text-xs text-surface-300">FireCMS projects shipped</p>
        </div>
        <div class="rounded-xl border border-surface-700 bg-surface-900/30 p-4 text-center">
            <div class="text-2xl font-semibold text-amber-400 mb-1">🇪🇺</div>
            <p class="text-xs text-surface-300">HQ in Spain</p>
        </div>
        <div class="rounded-xl border border-surface-700 bg-surface-900/30 p-4 text-center">
            <div class="text-2xl font-semibold text-violet-400 mb-1">8–12</div>
            <p class="text-xs text-surface-300">Planned EU hires</p>
        </div>
    </div>
</PitchSlide>
