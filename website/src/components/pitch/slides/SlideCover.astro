---
import PitchSlide from '../PitchSlide.astro';
const TOTAL = 13;
---
<PitchSlide id="slide-cover" slideNumber={1} totalSlides={TOTAL}>
    <div class="flex flex-col items-center justify-center text-center gap-8">
        <a href="https://eic.ec.europa.eu/eic-funding-opportunities/eic-accelerator_en" target="_blank" rel="noopener" class="flex items-center gap-2 px-4 py-1.5 rounded-full border border-primary/30 bg-primary/10 text-primary text-sm font-medium hover:bg-primary/20 transition-colors">
            🇪🇺 EIC Accelerator 2026
        </a>
        <a href="https://rebase.pro" target="_blank" rel="noopener"><img src="/favicon.svg" width="448" height="448" alt="Rebase" class="h-20 w-20" /></a>
        <h1 class="text-5xl md:text-7xl font-semibold text-white tracking-tight">Rebase</h1>
        <p class="text-xl md:text-2xl text-surface-300 max-w-2xl">The open-source platform that lets European teams ship software <span class="text-primary font-semibold">in days, not months</span><br/>— without depending on US cloud services.</p>
        <p class="text-sm text-surface-300 mt-2">From the makers of <a href="https://firecms.co" target="_blank" rel="noopener" class="text-white font-semibold hover:text-primary transition-colors">FireCMS</a> — powering <strong class="text-white">10,000+ projects</strong> worldwide</p>
        <div class="flex items-center gap-6 mt-4 text-sm text-surface-300">
            <span><a href="https://github.com/firecmsco/firecms" target="_blank" rel="noopener" class="hover:text-white transition-colors">Open Source</a> · <a href="https://opensource.org/license/mit" target="_blank" rel="noopener" class="hover:text-white transition-colors">MIT Licensed</a></span>
            <span>·</span>
            <span>Built in 🇪🇺 Europe</span>
        </div>
        <p class="text-surface-400 text-sm mt-8"><a href="https://rebase.pro" target="_blank" rel="noopener" class="hover:text-white transition-colors">rebase.pro</a> · May 2026</p>
    </div>
</PitchSlide>
