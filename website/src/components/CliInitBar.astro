---
/**
 * Interactive CLI init command bar with a pnpm / npm runner switcher and
 * one-click clipboard copy.
 *
 * Rebase CLI matches whichever package manager invoked it (`pnpm dlx` vs
 * `npx`), so letting visitors toggle right inside the command removes the
 * hesitation of developers who do not have pnpm installed globally. All bars on
 * the page stay in sync via `page-effects.ts` and persist the choice in
 * `localStorage`.
 *
 * Copy feedback follows the `copy-button` pattern: the `role="status"` live
 * region sits OUTSIDE the button so screen readers reliably announce both
 * success and failure, and the button itself is never disabled during feedback.
 */
import { getLangFromUrl, useTranslations } from "../i18n/ui";

interface Props {
    /** Distinguishes copy events per section in GA4 (`data-track-copy`). */
    trackId: string;
    /** `hero` matches `--control-large` beside primary buttons; `compact` fits lanes and ClosingCta. */
    variant?: "hero" | "compact";
    /** Optional extra classes on the outer wrapper. */
    class?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
    trackId,
    variant = "hero",
    class: className = "",
} = Astro.props;

const isHero = variant === "hero";
const DEFAULT_COMMAND = "pnpm dlx @rebasepro/cli init";
---

<div
    class:list={[
        "cli-init-bar inline-flex max-w-full items-stretch rounded-lg border transition-colors",
        isHero
            ? "min-h-(--control-large) border-tone-max/15 bg-surface-frame/85 backdrop-blur-sm shadow-[0_8px_28px_-12px_rgb(0_0_0/0.45)]"
            : "w-full min-h-[42px] border-tone-max/12 bg-tone-max/[0.03]",
        className,
    ]}
    data-cli-init-bar
    data-cli-package="@rebasepro/cli"
    data-cli-verb="init"
>
    <div
        class:list={[
            "cli-init-switch flex shrink-0 items-center gap-0.5 border-r border-tone-max/10 p-1 font-mono text-2xs",
            isHero ? "px-1.5" : "px-1",
        ]}
        role="group"
        aria-label={t("cli.runner.label")}
    >
        <button
            type="button"
            data-cli-runner="pnpm"
            aria-pressed="true"
            class="cli-runner-btn min-h-[28px] rounded-md px-2 py-1 font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary"
        >
            pnpm
        </button>
        <button
            type="button"
            data-cli-runner="npm"
            aria-pressed="false"
            class="cli-runner-btn min-h-[28px] rounded-md px-2 py-1 font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary"
        >
            npm
        </button>
    </div>

    <button
        type="button"
        data-track-copy={trackId}
        data-command={DEFAULT_COMMAND}
        data-copy-done-label={t("copy.command.done")}
        data-copy-fail-label={t("copy.command.failed")}
        class:list={[
            "copy-btn cli-init-copy group flex min-w-0 flex-1 items-center justify-between gap-3 rounded-r-lg font-mono transition-colors hover:bg-tone-max/[0.05] data-copied:bg-emerald-400/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
            isHero ? "px-4 text-sm" : "px-3 text-xs",
        ]}
        title={t("copy.command")}
    >
        <span class="flex min-w-0 items-center gap-2 truncate">
            <span class="select-none text-tone-500" aria-hidden="true">$</span>
            <code class="truncate">
                <span class="cli-init-runner-text" data-cli-runner-text>pnpm dlx</span>{" "}
                <span class="cli-init-pkg-text">@rebasepro/cli</span>{" "}
                <span class="text-tone-max">init</span>
            </code>
        </span>

        <span
            class:list={[
                "cli-init-chip inline-flex shrink-0 items-center gap-1.5 rounded-md border border-tone-max/10 bg-tone-max/[0.06] font-mono uppercase tracking-[0.12em] text-tone-300 transition-colors group-hover:border-tone-max/20 group-hover:text-tone-max",
                isHero ? "px-2 py-1 text-2xs" : "px-1.5 py-0.5 text-3xs",
            ]}
        >
            <svg data-copy-idle class="h-3.5 w-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
            <svg data-copy-done hidden class="h-3.5 w-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5"/>
            </svg>
            <span class="grid text-center">
                <span data-copy-label class="col-start-1 row-start-1">{t("copy.command")}</span>
                <span aria-hidden="true" class="invisible col-start-1 row-start-1">{t("copy.command.done")}</span>
            </span>
        </span>
    </button>

    {/* Dedicated live region outside the button so assistive technology
        reliably announces copy success and failure. */}
    <span class="sr-only" role="status" data-copy-status></span>
</div>
