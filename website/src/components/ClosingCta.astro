---
/**
 * The closing CTA every page owes the reader.
 *
 * SITE-STORY §5: "Each page must answer its question, carry at least one live
 * demo, and end with the same CTA pair: Try the demo + `pnpm dlx @rebasepro/cli
 * init`." Twenty-four of thirty pages were ending without the command — every
 * `rebase-vs-*` page among them, which is where a developer arrives from a
 * search with the most intent in the whole funnel.
 *
 * Extracted from the hand-rolled block on /backend so the six pages that got it
 * right and the rest converge on one implementation. Heading and blurb are props
 * because each page closes in its own voice; the command and the demo link are
 * not, because that is the part the contract fixes.
 *
 * Drawn as a drafted chapter, like every section above it: the rule and its
 * label, the claim on the left, and the hero's own pair on the right — the
 * demo button and the command as a copy chip.
 */
import { getLangFromUrl, useTranslatedPath, useTranslations } from "../i18n/ui";
import { DEMO_URL } from "../utils/links";
import ChapterRule from "./ChapterRule.astro";

interface Props {
    /** Closing headline. Keep it a claim, not a label. */
    title?: string;
    /** One line under it. Say what happens next, concretely. */
    blurb?: string;
    /** Distinguishes copy events per page in analytics. */
    trackId?: string;
    /**
     * Where "Try the demo" goes. One destination site-wide: the hosted panel
     * itself. There is no interstitial page to land on first.
     */
    demoHref?: string;
}

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

const {
    title = "Point it at your database.",
    blurb = "Scaffold a project against a Postgres database you already run — no account, nothing to provision.",
    trackId = "page",
    demoHref = DEMO_URL,
} = Astro.props;
const COMMAND = "pnpm dlx @rebasepro/cli init";
const [RUNNER, PACKAGE, VERB] = COMMAND.match(/^(\S+ \S+) (\S+) (\S+)$/)!.slice(1);
---

<section class="py-chapter">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <ChapterRule label={t("cta.eyebrow")} dot="text-cyan-300" />
        <div class="mt-lead grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end">
            <div class="lg:col-span-6">
                <h2 class="text-3xl sm:text-4xl text-white">{title}</h2>
                <p class="mt-4 max-w-xl text-lg text-surface-400">{blurb}</p>
            </div>

            <div class="lg:col-span-6 flex flex-col gap-5 lg:items-end">
                <button
                    type="button"
                    data-track-copy={`${trackId}-cta`}
                    data-command={COMMAND}
                    data-copy-done-label={t("copy.command.done")}
                    class="copy-btn group inline-flex max-w-full items-center gap-3 rounded-lg border border-white/12 bg-white/[0.03] px-5 min-h-(--control-large) font-mono text-sm text-surface-200 transition-colors hover:border-white/25 hover:bg-white/[0.06] data-copied:border-emerald-400/60 data-copied:bg-emerald-400/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                    aria-label={`Copy "${COMMAND}" to the clipboard`}
                    title="Copy to clipboard"
                >
                    <span class="select-none text-surface-500">$</span>
                    <span class="truncate"><span class="text-emerald-400">{RUNNER}</span> <span class="text-primary-light">{PACKAGE}</span> <span class="text-white">{VERB}</span></span>
                    <span data-copy-label class="ml-2 rounded-md border border-white/10 bg-white/[0.06] px-2 py-0.5 font-mono text-2xs uppercase tracking-[0.14em] text-surface-400">{t("copy.command")}</span>
                </button>

                <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                    <a href={demoHref} target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 min-h-(--control-large) text-base font-semibold text-white shadow-[0_8px_28px_-6px_rgb(0_112_244/0.65)] transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                       data-track id={`${trackId}-cta-demo`}>
                        {t("cta.button.demo")}
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                    <a href={translatePath("/docs")}
                       class="inline-flex items-center gap-x-2 text-white hover:text-primary-light transition-colors font-semibold"
                       data-track id={`${trackId}-cta-docs`}>
                        {t("cta.button.docs")}
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
