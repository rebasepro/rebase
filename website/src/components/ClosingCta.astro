---
/**
 * The closing CTA every page owes the reader.
 *
 * SITE-STORY §5: every deep page closes with the CLI init command (with pnpm /
 * npm toggle) and an immediately actionable primary CTA. While Rebase Cloud is
 * in private beta (`!CLOUD_FLAGS.selfServe`), the primary button opens the live
 * demo and Rebase Cloud stays a secondary link; once self-serve opens, Cloud
 * takes the primary slot automatically.
 */
import { getLangFromUrl, useTranslatedPath, useTranslations } from "../i18n/ui";
import { DEMO_URL } from "../utils/links";
import { CLOUD_FLAGS, offerKey } from "../data/cloud-offer";
import ChapterRule from "./ChapterRule.astro";
import CliInitBar from "./CliInitBar.astro";

interface Props {
    /** Closing headline. Keep it a claim, not a label. */
    title?: string;
    /** One line under it. Say what happens next, concretely. */
    blurb?: string;
    /** Distinguishes copy events per page in analytics. */
    trackId?: string;
    /**
     * Where "Try live demo" goes. One destination site-wide: the hosted panel
     * itself. There is no interstitial page to land on first.
     */
    demoHref?: string;
}

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);
const isCloudPage = Astro.url.pathname.replace(/\/$/, "").endsWith("/cloud");

const {
    title = t(offerKey("cta.title")),
    blurb = t(offerKey("cta.closing.blurb")),
    trackId = "page",
    demoHref = DEMO_URL,
} = Astro.props;
---

<section class="py-chapter">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <ChapterRule label={t("cta.eyebrow")} dot="text-cyan-300" />
        <div class="mt-lead grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end">
            <div class="lg:col-span-6">
                <h2 class="text-3xl sm:text-4xl text-tone-max">{title}</h2>
                <p class="mt-4 max-w-xl text-lg text-tone-400">{blurb}</p>
            </div>

            <div class="lg:col-span-6 flex flex-col gap-4 lg:items-end">
                <div class="flex w-full flex-col gap-2 lg:max-w-lg lg:items-end">
                    <CliInitBar variant="hero" trackId={`${trackId}-cta`} class="w-full" />
                    <p class="font-mono text-2xs text-tone-400">
                        {t("hero.cli.reassurance")}
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                    {CLOUD_FLAGS.selfServe ? (
                        <>
                            <a href={translatePath("/cloud")}
                               class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 min-h-(--control-large) text-base font-semibold text-white shadow-[0_8px_28px_-6px_rgb(0_112_244/0.65)] transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                               data-track id={`${trackId}-cta-cloud`}>
                                {t("cta.button.cloud")}
                                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14"/>
                                    <path d="m12 5 7 7-7 7"/>
                                </svg>
                            </a>
                            <a href={translatePath("/docs")}
                               class="inline-flex items-center gap-x-2 text-tone-max hover:text-primary-light transition-colors font-semibold"
                               data-track id={`${trackId}-cta-docs`}>
                                {t("cta.button.docs")}
                                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14"/>
                                    <path d="m12 5 7 7-7 7"/>
                                </svg>
                            </a>
                            <a href={demoHref} target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-x-2 text-tone-400 hover:text-tone-max transition-colors text-sm font-semibold"
                               data-track id={`${trackId}-cta-demo`}>
                                {t("cta.button.demo")}
                            </a>
                        </>
                    ) : (
                        <>
                            <a href={demoHref} target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-x-2.5 rounded-lg bg-primary px-6 min-h-(--control-large) text-base font-semibold text-white shadow-[0_8px_28px_-6px_rgb(0_112_244/0.65)] transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                               data-track id={`${trackId}-cta-demo`}>
                                <span class="dot text-emerald-300" aria-hidden="true"></span>
                                {t("cta.button.demo")}
                                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14"/>
                                    <path d="m12 5 7 7-7 7"/>
                                </svg>
                            </a>
                            <a href={translatePath("/docs/getting-started/quickstart")}
                               class="inline-flex items-center gap-x-2 text-tone-max hover:text-primary-light transition-colors font-semibold"
                               data-track id={`${trackId}-cta-docs`}>
                                {t("cta.lane.local.link")}
                                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14"/>
                                    <path d="m12 5 7 7-7 7"/>
                                </svg>
                            </a>
                            {!isCloudPage && (
                                <a href={translatePath("/cloud")}
                                   class="inline-flex items-center gap-x-2 text-tone-400 hover:text-tone-max transition-colors text-sm font-semibold"
                                   data-track id={`${trackId}-cta-cloud`}>
                                    {t("cloud.home.link.explore")}
                                </a>
                            )}
                        </>
                    )}
                </div>
            </div>
        </div>
    </div>
</section>
