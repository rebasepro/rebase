---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<style>
    #manifesto-banner {
        max-height: 200px;
        transition: max-height 350ms cubic-bezier(0.4, 0, 0.2, 1), 
                    min-height 350ms cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 250ms cubic-bezier(0.4, 0, 0.2, 1), 
                    padding 350ms cubic-bezier(0.4, 0, 0.2, 1);
        opacity: 1;
        overflow: hidden;
    }

    #manifesto-banner.dismissing {
        max-height: 0 !important;
        min-height: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        opacity: 0 !important;
    }

    .banner-grid-pattern {
        background-image: 
            linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
        background-size: 24px 24px;
        background-position: center;
    }
</style>

<div
    id="manifesto-banner"
    class="relative w-full bg-[#0070f4] border-b border-white/10 z-50 text-white select-none py-3"
    role="complementary"
    aria-label="Rebase Manifesto"
>
    <div class="absolute inset-0 banner-grid-pattern pointer-events-none opacity-30"></div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 flex items-center justify-center gap-x-4 gap-y-1 flex-wrap pr-12 text-center">
        <p class="text-sm sm:text-base leading-6 text-white">
            <span set:html={t("banner.title.control")} />
        </p>

        <a
            href={translatePath("/manifesto")}
            id="manifesto-banner-cta"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white transition-colors whitespace-nowrap"
        >
            {t("banner.cta")}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
        </a>
    </div>

    <button
        id="manifesto-banner-close"
        type="button"
        class="absolute top-1/2 -translate-y-1/2 right-3 sm:right-5 text-white/70 hover:text-white hover:bg-white/15 p-1.5 rounded-full transition-all duration-200 focus-visible:ring-2 focus-visible:ring-white outline-none focus:outline-none cursor-pointer z-50"
        aria-label="Dismiss banner"
    >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
             stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
</div>

<script>
    function initializeManifestoBanner() {
        const banner = document.getElementById("manifesto-banner");
        const cta = document.getElementById("manifesto-banner-cta");
        const close = document.getElementById("manifesto-banner-close");

        if (!banner) return;

        // Re-apply dismissed state after Astro view transitions reset html classes
        if (localStorage.getItem("rb_manifesto_banner_dismissed") === "true") {
            document.documentElement.classList.add("banner-dismissed-instant");
            return;
        }

        function dismiss() {
            banner?.classList.add("dismissing");
            localStorage.setItem("rb_manifesto_banner_dismissed", "true");
            setTimeout(() => {
                document.documentElement.classList.add("banner-dismissed-instant");
            }, 300);
        }

        if (cta) {
            cta.addEventListener("click", () => {
                localStorage.setItem("rb_manifesto_banner_dismissed", "true");
            });
        }

        if (close) {
            close.addEventListener("click", () => {
                dismiss();
            });
        }
    }

    // Run on page load
    initializeManifestoBanner();

    // Re-initialize after Astro view transitions
    document.addEventListener("astro:page-load", initializeManifestoBanner);
</script>
