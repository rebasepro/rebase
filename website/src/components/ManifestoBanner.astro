---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/ui";
import ABVariant from "./ABVariant.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<style>
    #manifesto-banner {
        max-height: 800px;
        transition: max-height 350ms cubic-bezier(0.4, 0, 0.2, 1), 
                    min-height 350ms cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 250ms cubic-bezier(0.4, 0, 0.2, 1), 
                    padding 350ms cubic-bezier(0.4, 0, 0.2, 1);
        opacity: 1;
        overflow: hidden;
    }

    #manifesto-banner.dismissing {
        max-height: 0 !important;
        min-height: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        opacity: 0 !important;
    }

    .banner-grid-pattern {
        background-image: 
            linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
        background-size: 24px 24px;
        background-position: center;
    }
</style>

<div 
    id="manifesto-banner" 
    class="relative w-full min-h-[45vh] sm:min-h-[50vh] flex flex-col justify-center bg-[#0070f4] border-b border-white/10 z-50 text-white select-none py-16 sm:py-24 md:py-28"
    role="complementary"
    aria-label="Rebase Manifesto"
>
    <!-- Background subtle grid pattern for a high-fidelity visual look -->
    <div class="absolute inset-0 banner-grid-pattern pointer-events-none opacity-40"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-primary-dark/30 via-transparent to-primary-dark/30 pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 flex flex-col items-center text-center gap-6 sm:gap-8">
        

        <!-- Large Editorial Banner Text -->
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight text-white max-w-3xl mx-auto font-sans">
            <ABVariant experiment="manifesto-banner-text" variant="control" class="inline">
                {t("banner.title.control")}
            </ABVariant>
            <ABVariant experiment="manifesto-banner-text" variant="mission" class="inline">
                {t("banner.title.mission")}
            </ABVariant>
            <ABVariant experiment="manifesto-banner-text" variant="founders" class="inline">
                {t("banner.title.founders")}
            </ABVariant>
        </h2>
        
        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-white/85 max-w-2xl mx-auto font-normal leading-relaxed">
            {t("banner.subtitle")}
        </p>

        <!-- Call to Action -->
        <a
            href={translatePath("/manifesto")}
            id="manifesto-banner-cta"
            class="inline-flex items-center justify-center gap-2 bg-white text-[#0070f4] hover:bg-neutral-50 font-extrabold px-6 py-3.5 rounded-xl text-sm sm:text-base shadow-lg transition-all duration-200 hover:scale-[1.03] active:scale-[0.98] cursor-pointer"
        >
            {t("banner.cta")}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
        </a>
    </div>

    <!-- Absolute-positioned Dismiss Button -->
    <button
        id="manifesto-banner-close"
        type="button"
        class="absolute top-4 right-4 sm:top-6 sm:right-6 text-white/70 hover:text-white hover:bg-white/15 p-2.5 rounded-full transition-all duration-200 focus-visible:ring-2 focus-visible:ring-white outline-none focus:outline-none cursor-pointer z-50"
        aria-label="Dismiss banner"
    >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>
</div>

<script>
    function initializeManifestoBanner() {
        const banner = document.getElementById("manifesto-banner");
        const cta = document.getElementById("manifesto-banner-cta");
        const close = document.getElementById("manifesto-banner-close");

        if (!banner) return;

        function dismiss() {
            banner?.classList.add("dismissing");
            localStorage.setItem("rb_manifesto_banner_dismissed", "true");
            setTimeout(() => {
                document.documentElement.classList.add("banner-dismissed-instant");
            }, 300);
        }

        if (cta) {
            cta.addEventListener("click", () => {
                localStorage.setItem("rb_manifesto_banner_dismissed", "true");
                if (typeof (window as any).trackConversion === "function") {
                    (window as any).trackConversion("manifesto-banner-text", "cta_click");
                }
            });
        }

        if (close) {
            close.addEventListener("click", () => {
                dismiss();
            });
        }
    }

    // Run on page load
    initializeManifestoBanner();

    // Re-initialize after Astro view transitions
    document.addEventListener("astro:page-load", initializeManifestoBanner);
</script>
