---
/*
 * Home page — what 0.29 adds, between the agent chapter (04) and the
 * customers (05). Unnumbered, like the rls-check band: it is a release, not a
 * new claim, and the chapter numbers promise ideas the page already ranks.
 *
 * Say it once (SITE-STORY §1): chapter 01 owns "the panel your team works in"
 * and chapter 04 owns "an agent works under scoped keys and RLS". This
 * section depends on both and restates neither. What it adds is new in 0.29:
 * Claude draws the admin's own views and writes apps from its parts, the
 * parts are yours for your own pages, and every hook hands the server's row.
 *
 * "Try" means show, and what 0.29 adds happens in a conversation, so the
 * figure IS one (2026-11-09: side-by-side code and preview "must look like a
 * conversation in claude and it doesnt"): a person asks, Claude answers with
 * the app inline, and the app card has Preview and Code tabs. The preview is
 * the UI kit's own KpiTile and BarChart on sample figures the frame names as
 * such; the code is the order desk exactly as it typechecks against the 0.29
 * sources. The list and the form need a running backend, so they are not
 * drawn rather than drawn as a mock. No Claude logo — the speaker is named.
 */
import { Code } from "astro:components";
import { ArrowRight, ArrowUp, Plug } from "lucide-react";
import { OrderDeskPreview } from "./demos/OrderDeskPreview";
import { useTranslatedPath } from "../i18n/ui";

const { lang, t } = Astro.props;
const translatePath = useTranslatedPath(lang);

// The order desk, as the blog post prints it. Every prop and hook here is
// checked against packages/{app,cms,ui}/src; keep them in step when one of
// those APIs moves. `style` rather than `h-[560px]` because show_app builds
// Tailwind's standard utilities only, and this file is meant to paste there.
const ORDER_DESK = `import { useState } from "react";
import { useAggregate, useRowCount, useRowWrites } from "@rebasepro/app";
import { CollectionPanel, RecordForm } from "@rebasepro/cms";
import {
  BarChart, Button, ChartCard, KpiGrid, KpiTile, SplitView,
} from "@rebasepro/ui";

export function OrderDesk() {
  const [openId, setOpenId] = useState<string>();
  const pending = useRowCount("orders", { status: ["==", "pending"] });
  const byStatus = useAggregate("orders", {
    select: [{ fn: "count" }],
    groupBy: ["status"],
    orderBy: ["count", "desc"],
  });
  const bars = (byStatus.result ?? []).map((r) => ({
    key: String(r.status), label: String(r.status),
    value: Number(r.count),
  }));
  const { update, saving } = useRowWrites();

  const list = (
    <CollectionPanel collection="orders" toolbar="compact"
      where={{ status: ["==", "pending"] }} orderBy="placed_at:desc"
      fields={["number", "customer", "total"]}
      highlightedIds={openId ? [openId] : []}
      onRowClick={(row, id) => setOpenId(id)}
      rowActions={(row, id) => (
        <Button size="small" disabled={saving}
          onClick={() => update("orders", id, { status: "shipped" })}>
          Ship
        </Button>
      )} />
  );

  return (
    <div className="flex flex-col gap-4">
      <KpiGrid>
        <KpiTile label="Pending"
          value={pending.count} loading={pending.loading} />
      </KpiGrid>
      <ChartCard title="Orders by status">
        <BarChart bars={bars} loading={byStatus.loading} />
      </ChartCard>
      <div style={{ height: 560 }}>
        <SplitView master={list} selected={openId}
          onClearSelection={() => setOpenId(undefined)}
          detail={
            <RecordForm key={openId} collection="orders" id={openId}
              compact fields={["status", "tracking_number", "notes"]} />
          } />
      </div>
    </div>
  );
}`;

const COLUMNS = [
    { tag: "whatsnew.claude.tag", title: "whatsnew.claude.title", desc: "whatsnew.claude.desc", handle: "show_collection · show_record · show_app" },
    { tag: "whatsnew.parts.tag", title: "whatsnew.parts.title", desc: "whatsnew.parts.desc", handle: "@rebasepro/cms · @rebasepro/ui" },
    { tag: "whatsnew.rows.tag", title: "whatsnew.rows.title", desc: "whatsnew.rows.desc", handle: "@rebasepro/app" },
] as const;
---
<section class="chapter relative ground-raised py-chapter">
    <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
        <div class="max-w-[42rem] animate-on-scroll fade-in-up">
            <p class="eyebrow">{t("whatsnew.badge")}</p>
            <h2 class="mt-label font-headers text-display-2 text-balance">
                {t("whatsnew.title")}
            </h2>
            <p class="mt-lead max-w-[38rem] text-page-copy leading-relaxed" set:html={t("whatsnew.p1")}></p>
        </div>

        <div class="mt-content frame animate-on-scroll fade-in-up" data-chat-demo>
            <div class="frame-head">
                <span>Claude</span>
                <span class="ml-auto truncate">{t("whatsnew.preview.caption")}</span>
            </div>
            <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 py-6 sm:py-8 flex flex-col gap-6">
                <div class="flex justify-end">
                    <p class="max-w-[32rem] rounded-2xl bg-white/[0.07] px-4 py-2.5 text-sm leading-relaxed text-surface-100">
                        {t("whatsnew.chat.ask")}
                    </p>
                </div>

                <div class="min-w-0">
                    <p class="text-xs font-medium text-surface-400">Claude</p>
                    <p class="mt-2 inline-flex items-center gap-2 rounded-lg border border-white/8 bg-white/[0.03] px-2.5 py-1 font-mono text-2xs text-surface-400">
                        <Plug size={12} aria-hidden="true" />
                        Rebase · show_app
                    </p>
                    <p class="mt-3 text-sm leading-relaxed text-page-copy">{t("whatsnew.chat.reply")}</p>

                    <div class="mt-4 rounded-xl border border-white/10 bg-surface-frame overflow-hidden">
                        <div class="flex items-center gap-1 border-b border-white/8 px-2 py-1.5" role="tablist" aria-label="OrderDesk">
                            <button type="button" role="tab" aria-selected="true" data-tab="preview"
                                    class="chat-tab rounded-md px-2.5 py-1 text-xs font-medium">
                                {t("whatsnew.chat.preview")}
                            </button>
                            <button type="button" role="tab" aria-selected="false" data-tab="code"
                                    class="chat-tab rounded-md px-2.5 py-1 text-xs font-medium">
                                {t("whatsnew.chat.code")}
                            </button>
                            <span class="ml-auto truncate pr-1 font-mono text-2xs text-surface-500">OrderDesk.tsx</span>
                        </div>
                        <div role="tabpanel" data-panel="preview">
                            <OrderDeskPreview client:visible />
                        </div>
                        <div role="tabpanel" data-panel="code" hidden>
                            <p class="px-4 pt-3 font-mono text-2xs text-surface-500">{t("whatsnew.code.caption")}</p>
                            <div class="release-code max-h-[30rem] overflow-auto px-4 py-3 text-[12px] leading-[1.6]">
                                <Code code={ORDER_DESK} lang="tsx" theme="github-dark" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] pl-4 pr-2 py-2" aria-hidden="true">
                    <span class="flex-1 text-sm text-surface-500">{t("whatsnew.chat.composer")}</span>
                    <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-white/10 text-surface-400">
                        <ArrowUp size={14} />
                    </span>
                </div>
            </div>
        </div>

        <div class="mt-content grid grid-cols-1 md:grid-cols-3 border-t border-white/8">
            {COLUMNS.map(({ tag, title, desc, handle }, i) => (
                <div class:list={[
                    "py-10",
                    i === 0 && "md:border-r border-white/8 md:pr-8",
                    i === 1 && "md:border-r border-white/8 md:px-8 border-t md:border-t-0",
                    i === 2 && "md:pl-8 border-t md:border-t-0 border-white/8",
                ]}>
                    <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-500">{t(tag)}</p>
                    <h3 class="mt-3 font-headers text-lg">{t(title)}</h3>
                    <p class="mt-2 text-sm text-page-copy leading-relaxed" set:html={t(desc)}></p>
                    <p class="mt-4 font-mono text-2xs text-surface-400">{handle}</p>
                </div>
            ))}
        </div>

        <div class="mt-4 flex flex-col items-start gap-4 lg:flex-row lg:items-center lg:gap-10">
            <a href={translatePath("/docs/frontend/panels")} class="accent-link shrink-0">
                {t("whatsnew.link.panels")}
                <ArrowRight size={15} />
            </a>
            <a href={translatePath("/docs/ai/remote-mcp")} class="accent-link shrink-0">
                {t("whatsnew.link.mcp")}
                <ArrowRight size={15} />
            </a>
            <a
                href="/blog/2026-11-09-rebase-0-29-your-admin-panel-in-parts"
                class="group inline-flex items-start gap-2.5 text-sm text-surface-400 hover:text-white transition-colors"
            >
                <span class="mt-px inline-flex flex-none items-center rounded px-1.5 py-0.5 text-2xs font-semibold uppercase tracking-wider bg-white/5 text-surface-300 ring-1 ring-white/10">
                    {t("label.blog")}
                </span>
                <span class="max-w-[30rem] leading-relaxed group-hover:underline underline-offset-4 decoration-white/30">
                    {t("whatsnew.postLink")}
                </span>
            </a>
        </div>
    </div>
</section>

<script>
    // Preview / Code on the app card. Re-bound on every page load: the site
    // navigates with the ClientRouter, so a module script runs only once.
    function initChatTabs() {
        document.querySelectorAll<HTMLElement>("[data-chat-demo]").forEach((root) => {
            const tabs = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
            const panels = root.querySelectorAll<HTMLElement>("[data-panel]");
            tabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    tabs.forEach((other) => other.setAttribute("aria-selected", String(other === tab)));
                    panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== tab.dataset.tab; });
                });
            });
        });
    }
    document.addEventListener("astro:page-load", initChatTabs);
</script>

<style>
    .chat-tab {
        color: var(--color-surface-400);
        transition: color 150ms, background-color 150ms;
    }
    .chat-tab:hover { color: #fff; }
    .chat-tab[aria-selected="true"] {
        color: #fff;
        background: rgb(255 255 255 / 0.08);
    }
    /* Shiki paints its theme's ground on the <pre>; the frame is the ground. */
    .release-code :global(pre.astro-code) {
        background-color: transparent !important;
        margin: 0;
        padding: 0;
        overflow: visible;
        font-size: inherit;
        line-height: inherit;
    }
    /* No ligatures: `==` and `=>` are what a reader will type. */
    .release-code :global(code) {
        font-family: var(--font-mono);
        font-variant-ligatures: none;
    }
    /* Inline code in the copy beside it: the mono face, no chip. */
    section :global(p code) {
        font-family: var(--font-mono);
        font-size: 0.92em;
        color: var(--color-surface-200);
    }
</style>
