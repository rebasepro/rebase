---
/*
 * Home page — what 0.29 adds, between the agent chapter (04) and the
 * customers (05). Unnumbered, like the rls-check band: it is a release, not a
 * new claim, and the chapter numbers promise ideas the page already ranks.
 *
 * Say it once (SITE-STORY §1): chapter 01 owns "the panel your team works in"
 * and chapter 04 owns "an agent works under scoped keys and RLS". This
 * section depends on both and restates neither. What it adds is new in 0.29:
 * Claude draws the admin's own views and writes apps from its parts, the
 * parts are yours for your own pages, and every hook hands the server's row.
 *
 * "Try" means show, and what 0.29 adds happens in a conversation, so the
 * figure IS one (2026-11-09: side-by-side code and preview "must look like a
 * conversation in claude and it doesnt"): a person asks, Claude answers with
 * the app in an artifact panel beside the chat, as Claude opens one. Its code
 * is a small icon switch in the artifact's header, not a second column.
 *
 * The artifact is live: KPIs, two charts, a table and a form beside it, all
 * the UI kit's own components on sample figures the header names as such.
 * Ship or a saved status moves the row, the KPIs and the status chart
 * together. The code is the order desk as it typechecks against the 0.29
 * sources, where the table and form are CollectionPanel and RecordForm over a
 * real backend. No Claude logo — the speaker is named.
 */
import { Code } from "astro:components";
import { ArrowRight, ArrowUp, ChevronDown, ChevronRight, Code2, Copy, Eye, Plus, RotateCcw, SlidersHorizontal, ThumbsDown, ThumbsUp, X } from "lucide-react";
import { OrderDeskPreview } from "./demos/OrderDeskPreview";
import { useTranslatedPath } from "../i18n/ui";

const { lang, t } = Astro.props;
const translatePath = useTranslatedPath(lang);

// The order desk, as the blog post prints it. Every prop and hook here is
// checked against packages/{app,cms,ui}/src; keep them in step when one of
// those APIs moves. `style` rather than `h-[560px]` because show_app builds
// Tailwind's standard utilities only, and this file is meant to paste there.
const ORDER_DESK = `import { useState } from "react";
import { useAggregate, useRowWrites } from "@rebasepro/app";
import { CollectionPanel, RecordForm } from "@rebasepro/cms";
import {
  BarChart, Button, ChartCard, KpiGrid, KpiTile, SplitView, TimeSeriesChart,
} from "@rebasepro/ui";

export function OrderDesk() {
  const [openId, setOpenId] = useState<string>();
  const { update, saving } = useRowWrites();

  const byStatus = useAggregate("orders", {
    select: [{ fn: "count" }, { fn: "sum", field: "total" }],
    groupBy: ["status"],
    orderBy: ["count", "desc"],
  });
  const perDay = useAggregate("orders", {
    select: [{ fn: "sum", field: "total" }],
    groupBy: [{ field: "placed_at", transform: "day" }],
  });

  const groups = byStatus.result ?? [];
  const count = (status: string) =>
    Number(groups.find((g) => g.status === status)?.count ?? 0);
  const revenue = groups.reduce((sum, g) => sum + Number(g.sum_total ?? 0), 0);

  const list = (
    <CollectionPanel collection="orders" toolbar="compact"
      orderBy="placed_at:desc"
      fields={["number", "customer", "total", "status"]}
      highlightedIds={openId ? [openId] : []}
      onRowClick={(row, id) => setOpenId(id)}
      rowActions={(row, id) => (
        <Button size="small" disabled={saving}
          onClick={() => update("orders", id, { status: "shipped" })}>
          Ship
        </Button>
      )} />
  );

  return (
    <div className="flex flex-col gap-4">
      <KpiGrid>
        <KpiTile label="Pending" value={count("pending")} loading={byStatus.loading} />
        <KpiTile label="Shipped" value={count("shipped")} loading={byStatus.loading} />
        <KpiTile label="Revenue" value={revenue} loading={byStatus.loading}
          format={{ style: "currency", currency: "USD", notation: "compact" }} />
      </KpiGrid>
      <div className="grid grid-cols-2 gap-4">
        <ChartCard title="Revenue per day">
          <TimeSeriesChart loading={perDay.loading} series={[{
            id: "revenue", label: "Revenue",
            points: (perDay.result ?? []).map((r) => ({
              at: String(r.day_placed_at), value: Number(r.sum_total),
            })),
          }]} />
        </ChartCard>
        <ChartCard title="Orders by status">
          <BarChart loading={byStatus.loading} bars={groups.map((g) => ({
            key: String(g.status), label: String(g.status), value: Number(g.count),
          }))} />
        </ChartCard>
      </div>
      <div style={{ height: 520 }}>
        <SplitView master={list} selected={openId}
          onClearSelection={() => setOpenId(undefined)}
          detail={
            <RecordForm key={openId} collection="orders" id={openId}
              compact fields={["status", "tracking_number", "notes"]} />
          } />
      </div>
    </div>
  );
}`;

const COLUMNS = [
    { tag: "whatsnew.claude.tag", title: "whatsnew.claude.title", desc: "whatsnew.claude.desc", handle: "show_collection · show_record · show_app" },
    { tag: "whatsnew.parts.tag", title: "whatsnew.parts.title", desc: "whatsnew.parts.desc", handle: "@rebasepro/cms · @rebasepro/ui" },
    { tag: "whatsnew.rows.tag", title: "whatsnew.rows.title", desc: "whatsnew.rows.desc", handle: "@rebasepro/app" },
] as const;
---
<section class="chapter drafted relative ground-raised py-chapter">
    <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
        {/* Unnumbered — a release, not a chapter — so its index is the version. */}
        <div class="chapter-rule">
            <p class="eyebrow flex items-center gap-2.5"><span class="dot text-emerald-400" aria-hidden="true"></span>{t("whatsnew.badge")}</p>
            <span class="chapter-index">v0.29</span>
        </div>
        <div class="mt-lead max-w-[42rem] animate-on-scroll fade-in-up">
            <h2 class="font-headers text-display-2 text-balance">
                {t("whatsnew.title")}
            </h2>
            <p class="mt-lead max-w-[38rem] text-page-copy leading-relaxed" set:html={t("whatsnew.p1")}></p>
        </div>

        {/* Claude with an artifact open, drawn in Claude's own register: its
            warm dark ground, the reply set in a serif, the tool call as a
            collapsed row, the artifact card, the reply's actions, the composer
            with its model picker and orange send. No Claude logo — the
            speaker is named. The artifact's two views share one fixed-height
            box and each scrolls inside it, so switching moves nothing. */}
        <div class="claude-window mt-content grid grid-cols-1 lg:grid-cols-[22rem_minmax(0,1fr)] animate-on-scroll fade-in-up" data-chat-demo>
            <div class="claude-chat flex flex-col min-w-0">
                <div class="flex items-center gap-1.5 px-5 h-12 text-sm claude-ink">
                    <span class="truncate">{t("whatsnew.chat.artifact")}</span>
                    <ChevronDown size={14} class="claude-ink-3 flex-none" aria-hidden="true" />
                </div>
                <div class="flex flex-col gap-5 px-5 pb-5 flex-1">
                    <div class="flex justify-end">
                        <p class="claude-user rounded-xl px-4 py-2.5 text-[15px] leading-relaxed">
                            {t("whatsnew.chat.ask")}
                        </p>
                    </div>
                    <div class="min-w-0">
                        <p class="claude-tool inline-flex items-center gap-1.5 text-[13px]">
                            <ChevronRight size={14} aria-hidden="true" />
                            Rebase · show_app
                        </p>
                        <p class="claude-reply mt-2">{t("whatsnew.chat.reply")}</p>
                        <div class="claude-card mt-3 flex items-center gap-3 rounded-xl px-3 py-2.5">
                            <span class="claude-card-icon flex h-9 w-9 flex-none items-center justify-center rounded-lg">
                                <Code2 size={16} aria-hidden="true" />
                            </span>
                            <span class="min-w-0">
                                <span class="block truncate text-sm claude-ink">{t("whatsnew.chat.artifact")}</span>
                                <span class="block text-xs claude-ink-3">{t("whatsnew.chat.artifactKind")}</span>
                            </span>
                        </div>
                        <div class="mt-2 flex items-center gap-0.5 claude-ink-3" aria-hidden="true">
                            <span class="claude-action"><Copy size={14} /></span>
                            <span class="claude-action"><ThumbsUp size={14} /></span>
                            <span class="claude-action"><ThumbsDown size={14} /></span>
                            <span class="claude-action"><RotateCcw size={14} /></span>
                        </div>
                    </div>
                    <div class="claude-composer mt-auto rounded-2xl px-3.5 pt-3 pb-2.5" aria-hidden="true">
                        <p class="text-[15px] claude-ink-3">{t("whatsnew.chat.composer")}</p>
                        <div class="mt-3 flex items-center gap-1.5">
                            <span class="claude-icon-btn"><Plus size={15} /></span>
                            <span class="claude-icon-btn"><SlidersHorizontal size={14} /></span>
                            <span class="ml-auto inline-flex items-center gap-1 text-xs claude-ink-2">Opus 5.5 <ChevronDown size={12} /></span>
                            <span class="claude-send flex h-8 w-8 items-center justify-center rounded-lg"><ArrowUp size={15} /></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="claude-artifact min-w-0 flex flex-col">
                <div class="flex items-center gap-3 px-3 h-12">
                    <div class="claude-toggle flex flex-none items-center rounded-lg p-0.5" role="group" aria-label={t("whatsnew.chat.artifact")}>
                        <button type="button" data-view="preview" aria-pressed="true" title={t("whatsnew.chat.preview")}
                                class="artifact-view flex h-7 w-8 items-center justify-center rounded-md">
                            <Eye size={14} aria-hidden="true" />
                            <span class="sr-only">{t("whatsnew.chat.preview")}</span>
                        </button>
                        <button type="button" data-view="code" aria-pressed="false" title={t("whatsnew.chat.code")}
                                class="artifact-view flex h-7 w-8 items-center justify-center rounded-md">
                            <Code2 size={14} aria-hidden="true" />
                            <span class="sr-only">{t("whatsnew.chat.code")}</span>
                        </button>
                    </div>
                    <span class="text-sm claude-ink truncate">{t("whatsnew.chat.artifact")}</span>
                    <div class="ml-auto flex flex-none items-center gap-1 claude-ink-2" aria-hidden="true">
                        <span class="claude-copy inline-flex items-center gap-1.5 rounded-lg px-2.5 h-7 text-xs">
                            <Copy size={13} /> {t("whatsnew.chat.copy")}
                        </span>
                        <span class="claude-icon-btn"><X size={15} /></span>
                    </div>
                </div>
                <div class="relative h-[44rem] bg-surface-frame">
                    <div data-panel="preview" class="absolute inset-0 overflow-y-auto">
                        <OrderDeskPreview client:visible />
                    </div>
                    <div data-panel="code" class="absolute inset-0 overflow-auto" hidden>
                        <div class="release-code px-4 py-4 text-[12px] leading-[1.6]">
                            <Code code={ORDER_DESK} lang="tsx" theme="github-dark" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <p class="mt-3 font-mono text-2xs text-surface-500">
            OrderDesk.tsx · {t("whatsnew.code.caption")} · {t("whatsnew.preview.caption")}
        </p>

        <div class="mt-content grid grid-cols-1 md:grid-cols-3 border-t border-white/8">
            {COLUMNS.map(({ tag, title, desc, handle }, i) => (
                <div class:list={[
                    "py-10",
                    i === 0 && "md:border-r border-white/8 md:pr-8",
                    i === 1 && "md:border-r border-white/8 md:px-8 border-t md:border-t-0",
                    i === 2 && "md:pl-8 border-t md:border-t-0 border-white/8",
                ]}>
                    <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-500">{t(tag)}</p>
                    <h3 class="mt-3 font-headers text-lg">{t(title)}</h3>
                    <p class="mt-2 text-sm text-page-copy leading-relaxed" set:html={t(desc)}></p>
                    <p class="mt-4 font-mono text-2xs text-surface-400">{handle}</p>
                </div>
            ))}
        </div>

        <div class="mt-4 flex flex-col items-start gap-4 lg:flex-row lg:items-center lg:gap-10">
            <a href={translatePath("/docs/frontend/panels")} class="accent-link shrink-0">
                {t("whatsnew.link.panels")}
                <ArrowRight size={15} />
            </a>
            <a href={translatePath("/docs/ai/remote-mcp")} class="accent-link shrink-0">
                {t("whatsnew.link.mcp")}
                <ArrowRight size={15} />
            </a>
            <a
                href="/blog/2026-11-09-rebase-0-29-your-admin-panel-in-parts"
                class="group inline-flex items-start gap-2.5 text-sm text-surface-400 hover:text-white transition-colors"
            >
                <span class="mt-px inline-flex flex-none items-center rounded px-1.5 py-0.5 text-2xs font-semibold uppercase tracking-wider bg-white/5 text-surface-300 ring-1 ring-white/10">
                    {t("label.blog")}
                </span>
                <span class="max-w-[30rem] leading-relaxed group-hover:underline underline-offset-4 decoration-white/30">
                    {t("whatsnew.postLink")}
                </span>
            </a>
        </div>
    </div>
</section>

<script>
    // The artifact's Preview / Code switch. Re-bound on every page load: the
    // site navigates with the ClientRouter, so a module script runs once.
    function initArtifactViews() {
        document.querySelectorAll<HTMLElement>("[data-chat-demo]").forEach((root) => {
            const buttons = root.querySelectorAll<HTMLButtonElement>("[data-view]");
            const panels = root.querySelectorAll<HTMLElement>("[data-panel]");
            buttons.forEach((button) => {
                button.addEventListener("click", () => {
                    buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
                    panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== button.dataset.view; });
                });
            });
        });
    }
    document.addEventListener("astro:page-load", initArtifactViews);
</script>

<style>
    /* Claude's dark register, approximated: a warm near-black ground, warm
       off-white ink at three strengths, warm hairlines, and its terracotta for
       the send button. Scoped to this window; nothing else on the site uses
       these values. */
    .claude-window {
        --claude-bg: #262624;
        --claude-panel: #1f1e1d;
        --claude-user: #141413;
        --claude-raised: #30302e;
        --claude-line: rgb(222 220 209 / 0.15);
        --claude-ink: #faf9f5;
        --claude-ink-2: #c2c0b6;
        --claude-ink-3: #9c9a92;
        --claude-accent: #c96442;
        background: var(--claude-bg);
        border: 1px solid var(--claude-line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
    }
    .claude-ink { color: var(--claude-ink); }
    .claude-ink-2 { color: var(--claude-ink-2); }
    .claude-ink-3 { color: var(--claude-ink-3); }
    .claude-chat { border-bottom: 1px solid var(--claude-line); }
    @media (min-width: 64rem) {
        .claude-chat { border-bottom: 0; border-right: 1px solid var(--claude-line); }
    }
    .claude-user { background: var(--claude-user); color: var(--claude-ink); }
    .claude-tool { color: var(--claude-ink-3); }
    .claude-reply {
        font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
        font-size: 16px;
        line-height: 1.6;
        color: var(--claude-ink);
    }
    .claude-card { border: 1px solid var(--claude-line); background: var(--claude-panel); }
    .claude-card-icon { background: var(--claude-raised); color: var(--claude-ink-2); }
    .claude-action { display: inline-flex; padding: 6px; border-radius: 6px; }
    .claude-composer { background: var(--claude-raised); border: 1px solid var(--claude-line); }
    .claude-icon-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 28px; height: 28px; border-radius: 8px;
        border: 1px solid var(--claude-line); color: var(--claude-ink-2);
    }
    .claude-send { background: var(--claude-accent); color: #fff; }
    .claude-artifact { background: var(--claude-panel); }
    .claude-artifact > div:first-child { border-bottom: 1px solid var(--claude-line); }
    .claude-toggle { background: var(--claude-bg); border: 1px solid var(--claude-line); }
    .claude-copy { border: 1px solid var(--claude-line); }
    .artifact-view {
        color: var(--claude-ink-3);
        transition: color 150ms, background-color 150ms;
    }
    .artifact-view:hover { color: var(--claude-ink); }
    .artifact-view[aria-pressed="true"] {
        color: var(--claude-ink);
        background: var(--claude-raised);
    }
    /* Shiki paints its theme's ground on the <pre>; the frame is the ground. */
    .release-code :global(pre.astro-code) {
        background-color: transparent !important;
        margin: 0;
        padding: 0;
        overflow: visible;
        font-size: inherit;
        line-height: inherit;
    }
    /* No ligatures: `==` and `=>` are what a reader will type. */
    .release-code :global(code) {
        font-family: var(--font-mono);
        font-variant-ligatures: none;
    }
    /* Inline code in the copy beside it: the mono face, no chip. */
    section :global(p code) {
        font-family: var(--font-mono);
        font-size: 0.92em;
        color: var(--color-surface-200);
    }
</style>
