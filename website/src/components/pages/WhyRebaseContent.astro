---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';

import { NeatBackground } from '../../components/NeatBackground';
import ClientLogos from '../../components/ClientLogos.astro';
import SpotlightCard from '../../components/SpotlightCard.astro';
import { ApiMiniDemo } from '../../components/demos/ApiMiniDemo';
import { DeveloperPlayground } from '../../components/demos/DeveloperPlayground';
---

<div class="flex flex-col isolate">

    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 1 — HERO
         ═══════════════════════════════════════════════════════════════ -->
 <section class="relative isolate overflow-hidden -mt-20 pt-52 pb-24 sm:pt-56 sm:pb-28 lg:pt-60 lg:pb-32">
        <!-- Radial glow for readability -->
        <NeatBackground client:idle />

        <div class="px-4 mx-auto max-w-7xl text-center lg:px-8 relative z-10 mt-8">
            <!-- Badge -->
            <div class="mb-8 flex items-center justify-center gap-3 animate-on-scroll fade-in">
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-surface-700 bg-surface-900/60 text-xs font-medium text-surface-400">
                    <img src="/img/postgresql-logo.svg" alt="PostgreSQL" class="h-4 w-auto" />
                    Open-source · Postgres-native · Built in Europe
                </span>
            </div>

            <!-- Headline -->
            <div class="relative">
                <h1 class="relative mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.08] text-white animate-on-scroll fade-in-up">
                    Why developers choose<br /><span class="text-primary subtle-shimmer">Rebase</span>
                </h1>
            </div>
            <p class="mb-4 text-lg leading-8 text-surface-400 lg:text-xl sm:px-10 xl:px-40 animate-on-scroll fade-in-up">
                Connect your existing Postgres database.<br class="hidden sm:inline" />
                Get a full admin panel, SQL editor, and RLS management — without giving up control of your data or code.
            </p>

            <!-- CLI command widget -->
            <div class="mt-12 max-w-md mx-auto animate-on-scroll fade-in-up">
                <div class="group relative">
                    <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-0 group-hover:opacity-100 blur-lg transition-opacity duration-500"
                         aria-hidden="true"></div>
                    <div class="relative rounded-xl bg-surface-900/80 border border-surface-700/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_16px_48px_rgba(0,0,0,0.5)] overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                        <div class="px-5 py-4 flex items-center justify-between">
                            <div class="font-mono text-sm sm:text-base flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                <span class="text-primary font-bold mr-3">~</span>
                                <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                            </div>
                            <button data-track-copy="why-hero" data-command="pnpm dlx @rebasepro/cli init"
                                    class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                    aria-label="Copy command" title="Copy to clipboard">
                                <svg class="lucide lucide-copy" xmlns="http://www.w3.org/2000/svg" width="18"
                                     height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                                </svg>
                            </button>
                        </div>
                        <div class="px-5 pb-3 -mt-1">
                            <span class="font-mono text-xs text-surface-400">or: npx @rebasepro/cli init</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hero CTAs -->
            <div class="mt-8 mb-10 flex flex-wrap items-center justify-center gap-y-4 gap-x-6 sm:gap-x-8 animate-on-scroll fade-in-up">
                <a href="https://demo.rebase.pro"
                   target="_blank" rel="noopener noreferrer"
                   id="why-hero-try-demo"
                   class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-all duration-200 ease-in-out btn-glow">
                    Try the Demo
                    <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                </a>
                <a href="https://github.com/rebasepro/rebase"
                   target="_blank" rel="noopener noreferrer"
                   id="why-hero-view-github"
                   class="inline-flex items-center gap-x-2 rounded-lg border border-white/10 bg-white/5 px-6 py-3 text-base font-semibold text-white hover:bg-white/10 hover:border-white/20 transition-all duration-200 ease-in-out">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
                    View on GitHub
                </a>
            </div>
        </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 2 — SOCIAL PROOF
         ═══════════════════════════════════════════════════════════════ -->
 <section id="why-social-proof" class="relative z-0 py-20 sm:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <p class="text-center text-sm text-surface-400 mb-8 animate-on-scroll fade-in">Trusted by developers and teams at</p>
            <ClientLogos />
        </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 3 — NEAT GRADIENT DIVIDER
         ═══════════════════════════════════════════════════════════════ -->
    <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden" style="z-index: -1; height: 600px;">
        <NeatBackground variant="a" client:visible />
    </div>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 4 — "SEE IT IN ACTION" — PRODUCT SHOWCASE BENTO GRID
         ═══════════════════════════════════════════════════════════════ -->
 <section id="why-showcase" class="relative z-0 py-28 sm:py-36 overflow-hidden">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-2xl text-center mb-16 animate-on-scroll fade-in-up">
                <h2 class="text-xs font-semibold tracking-[0.25em] text-primary/70 uppercase">See it in action</h2>
                <p class="mt-4 text-3xl md:text-5xl font-semibold tracking-tight text-white">Everything you need,<br />out of the box</p>
                <p class="mt-5 text-base sm:text-lg text-surface-400 leading-relaxed">
                    A full admin panel, SQL editor, schema builder, and API layer — auto-generated from your Postgres database.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5 max-w-5xl mx-auto">

                <!-- Card: Admin Panel (span-4) -->
                <div class="md:col-span-2 lg:col-span-4 group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300" aria-hidden="true" style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10 flex flex-col aspect-[5/3] overflow-hidden bg-surface-950 pointer-events-none border-b border-surface-800/80">
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50 backdrop-blur-sm">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                            <div class="ml-2 text-[10px] font-mono text-surface-400">admin.rebase.pro</div>
                        </div>
                        <div class="relative flex-1 w-full overflow-hidden">
                            <img src="/img/demo_products.png" alt="Rebase admin panel showing a products table with inline editing" width="800" height="600" loading="lazy" class="w-full h-full object-cover object-top" />
                        </div>
                    </div>
                    <div class="relative z-10 p-5 flex flex-col justify-between h-full min-h-[140px]">
                        <div>
                            <div class="flex items-center gap-2 mb-2">
                                <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20">
                                    <svg class="lucide lucide-layout-dashboard text-primary" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1" /><rect width="7" height="5" x="14" y="3" rx="1" /><rect width="7" height="9" x="14" y="12" rx="1" /><rect width="7" height="5" x="3" y="16" rx="1" /></svg>
                                </div>
                                <h3 class="text-base font-semibold text-white">Complete Admin Panel</h3>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-medium ring-1 ring-primary/20 ml-auto">Auto-generated</span>
                            </div>
                            <p class="text-surface-400 text-sm leading-relaxed">Point Rebase at your Postgres database and get a fully functional admin panel instantly. No schemas to define, no config files to write.</p>
                        </div>
                    </div>
                </div>

                <!-- Card: REST API (span-2) -->
                <div class="lg:col-span-2 group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up delay-100">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300" aria-hidden="true" style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10 flex flex-col aspect-[5/3] overflow-hidden bg-surface-950 pointer-events-none border-b border-surface-800/80">
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50 backdrop-blur-sm">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                            <div class="ml-2 text-[10px] font-mono text-surface-400">api.demo.rebase.dev</div>
                        </div>
                        <div class="relative flex-1 w-full overflow-hidden flex items-center justify-center">
                            <ApiMiniDemo client:load />
                        </div>
                    </div>
                    <div class="relative z-10 p-5 flex flex-col justify-between h-full min-h-[140px]">
                        <div>
                            <div class="flex items-center gap-2 mb-2">
                                <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20">
                                    <svg class="lucide lucide-webhook text-primary" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 16.98h-5.99c-1.1 0-1.95.94-2.48 1.9A4 4 0 0 1 2 17c.01-.7.2-1.4.57-2" /><path d="m6 17 3.13-5.78c.53-.97.1-2.18-.5-3.1a4 4 0 1 1 6.89-4.06" /><path d="m12 6 3.13 5.73C15.66 12.7 16.9 13 18 13a4 4 0 0 1 0 8" /></svg>
                                </div>
                                <h3 class="text-base font-semibold text-white">Instant REST APIs</h3>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-medium ring-1 ring-primary/20 ml-auto">Auto-generated</span>
                            </div>
                            <p class="text-surface-400 text-sm leading-relaxed">Every collection gets type-safe REST endpoints automatically. Filtering, sorting, pagination — zero config.</p>
                        </div>
                    </div>
                </div>

                <!-- Card: Entity Detail View (span-3) -->
                <div class="lg:col-span-3 group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up delay-200">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300" aria-hidden="true" style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10 flex flex-col aspect-[4/3] overflow-hidden bg-surface-950 border-b border-surface-800/80">
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50 backdrop-blur-sm">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                        </div>
                        <div class="relative flex-1 w-full overflow-hidden">
                            <img src="/img/product_details_view.webp" alt="Rich entity detail view showing product information with images and fields" width="800" height="600" loading="lazy" class="w-full h-full object-cover object-top" />
                        </div>
                    </div>
                    <div class="relative z-10 p-5">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20">
                                <svg class="lucide lucide-file-text text-primary" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" /></svg>
                            </div>
                            <h3 class="text-base font-semibold text-white">Rich Entity Views</h3>
                        </div>
                        <p class="text-surface-400 text-sm leading-relaxed">Beautiful detail pages with images, rich text, relations, and 30+ field types. Fully customizable with React.</p>
                    </div>
                </div>

                <!-- Card: Custom Fields (span-3) -->
                <div class="lg:col-span-3 group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up delay-300">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300" aria-hidden="true" style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10 flex flex-col aspect-[4/3] overflow-hidden bg-surface-950 border-b border-surface-800/80">
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50 backdrop-blur-sm">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                        </div>
                        <div class="relative flex-1 w-full overflow-hidden">
                            <video class="w-full h-full object-cover object-top" style="pointer-events: none;" width="800" height="600" loop autoplay muted playsinline>
                                <source src="/img/custom_fields_dark.mp4" type="video/mp4" />
                            </video>
                        </div>
                    </div>
                    <div class="relative z-10 p-5">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20">
                                <svg class="lucide lucide-puzzle text-primary" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z" /></svg>
                            </div>
                            <h3 class="text-base font-semibold text-white">Extreme Customization</h3>
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-medium ring-1 ring-primary/20 ml-auto">React</span>
                        </div>
                        <p class="text-surface-400 text-sm leading-relaxed">Not a low-code black box. Custom fields, entity views, or entire pages — build it in React, drop it into Rebase.</p>
                    </div>
                </div>

            </div>

            <!-- Interactive developer playground -->
            <div class="mt-16 max-w-6xl mx-auto animate-on-scroll fade-in-up">
                <div class="text-center mb-8">
                    <h3 class="text-2xl font-semibold tracking-tight text-white">Don't take our word for it — poke at it.</h3>
                    <p class="mt-2 text-surface-400">Schema-as-code, the typed SDK, custom fields and visual RLS, in one interactive tour.</p>
                </div>
                <DeveloperPlayground client:visible />
            </div>
        </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 5 — DATA OWNERSHIP: "YOUR POSTGRES. YOUR RULES."
         ═══════════════════════════════════════════════════════════════ -->
 <section id="why-data-ownership" class="relative z-0 py-28 sm:py-36 overflow-hidden">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 items-center">
                <!-- Text side -->
                <div class="lg:col-span-5 animate-on-scroll fade-in-up">
                    <h2 class="text-xs font-semibold tracking-[0.25em] text-primary/70 uppercase mb-4">Data ownership</h2>
                    <p class="text-3xl md:text-4xl font-semibold tracking-tight text-white mb-4">Your Postgres.<br />Your rules.</p>
                    <p class="text-lg text-surface-400 mb-8 leading-relaxed">Rebase connects directly to your database. No hidden middle-tier, no vendor lock-in, no data copying. Your data never leaves your infrastructure.</p>
                    <ul class="space-y-5">
                        <li class="flex gap-4 items-start">
                            <div class="h-9 w-9 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center flex-none ring-1 ring-primary/20 mt-0.5">
                                <svg class="lucide lucide-database text-primary" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5V19A9 3 0 0 0 21 19V5" /><path d="M3 12A9 3 0 0 0 21 12" /></svg>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold text-sm">Direct connection</h4>
                                <p class="text-surface-400 text-sm">Connect to your existing PostgreSQL — no data migration needed</p>
                            </div>
                        </li>
                        <li class="flex gap-4 items-start">
                            <div class="h-9 w-9 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center flex-none ring-1 ring-primary/20 mt-0.5">
                                <svg class="lucide lucide-shield-check text-primary" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" /></svg>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold text-sm">Built-in RLS policy editor</h4>
                                <p class="text-surface-400 text-sm">Manage row-level security policies from a visual UI</p>
                            </div>
                        </li>
                        <li class="flex gap-4 items-start">
                            <div class="h-9 w-9 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center flex-none ring-1 ring-primary/20 mt-0.5">
                                <svg class="lucide lucide-server text-primary" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2" /><rect width="20" height="8" x="2" y="14" rx="2" ry="2" /><line x1="6" x2="6.01" y1="6" y2="6" /><line x1="6" x2="6.01" y1="18" y2="18" /></svg>
                            </div>
                            <div>
