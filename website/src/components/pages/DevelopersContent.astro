---
const { lang, t } = Astro.props;

import { NeatBackground } from '../../components/NeatBackground';
import { TerminalInit } from '../../components/demos/TerminalInit.tsx';
import { ArchitectureDiagram } from '../../components/demos/ArchitectureDiagram.tsx';
import { DeveloperPlayground } from '../../components/demos/DeveloperPlayground.tsx';
import { useTranslatedPath } from '../../i18n/ui';
import "../../styles/editor.css";

const translatePath = useTranslatedPath(lang);

// The daily loop, in the order you actually run it.
const loop = [
    {
        cmd: "rebase init",
        title: "Scaffold, or adopt what exists",
        desc: "Creates the three packages and wires them together. Already have a database? rebase schema introspect writes collections from your tables instead.",
    },
    {
        cmd: "rebase db push",
        title: "Move the schema",
        desc: "Diffs your collections against the database and applies the change. db generate + db migrate when you want the SQL in version control.",
    },
    {
        cmd: "rebase generate-sdk",
        title: "Regenerate the types",
        desc: "Writes database.types.ts. From here a renamed column is a compile error in your app, not a runtime surprise.",
    },
    {
        cmd: "rebase dev",
        title: "Run both halves",
        desc: "Backend and admin panel together with hot reload — the API on :3001, the panel on :5173.",
    },
];

const projectTree = `<span class="text-white">my-app/</span>
├── <span class="text-primary-light">config/collections/</span>   <span class="text-surface-500"># the source of truth</span>
│   ├── index.ts
│   └── orders.ts           <span class="text-surface-500"># properties · relations · securityRules · admin</span>
│
├── <span class="text-primary-light">backend/</span>              <span class="text-surface-500"># Hono server</span>
│   ├── src/index.ts        <span class="text-surface-500"># initializeRebaseBackend(…)</span>
│   ├── src/schema.generated.ts  <span class="text-surface-500"># Drizzle, generated</span>
│   └── functions/          <span class="text-surface-500"># your own routes, auto-mounted</span>
│
├── <span class="text-primary-light">frontend/</span>             <span class="text-surface-500"># the admin panel — delete it and nothing breaks</span>
│   └── src/App.tsx
│
└── .env                    <span class="text-surface-500"># DATABASE_URL, JWT_SECRET, …</span>`;

const callbackCode = `<span class="text-primary-light">export const</span> <span class="text-white">orders</span> = {
  slug: <span class="text-green-400">"orders"</span>,

  <span class="text-blue-300">callbacks</span>: {
    <span class="text-amber-400">onPreSave</span>: <span class="text-primary-light">async</span> ({ values, context }) =&gt; {
      values.total = <span class="text-amber-400">recalculate</span>(values.items);
      <span class="text-primary-light">return</span> values;
    },
    <span class="text-amber-400">onSaveSuccess</span>: <span class="text-primary-light">async</span> ({ entity, context }) =&gt; {
      <span class="text-primary-light">await</span> context.rebase.<span class="text-amber-400">sql</span>(
        <span class="text-green-400">"INSERT INTO ledger (order_id) VALUES ($1)"</span>,
        { params: [entity.id] },
      );
    },
  },
};`;

const functionCode = `<span class="text-surface-500">// backend/functions/checkout.ts</span>
<span class="text-blue-400">import</span> { Hono } <span class="text-blue-400">from</span> <span class="text-green-400">"hono"</span>;

<span class="text-blue-400">const</span> app = <span class="text-primary-light">new</span> <span class="text-amber-400">Hono</span>();

app.<span class="text-amber-400">post</span>(<span class="text-green-400">"/"</span>, <span class="text-primary-light">async</span> (c) =&gt; {
  <span class="text-blue-400">const</span> { user, rebase } = c.<span class="text-amber-400">get</span>(<span class="text-green-400">"rebase"</span>);
  <span class="text-surface-500">// same auth context, same RLS as every other request</span>
  <span class="text-primary-light">return</span> c.<span class="text-amber-400">json</span>({ ok: <span class="text-primary-light">true</span> });
});

<span class="text-blue-400">export default</span> app;
<span class="text-surface-500">// → POST /api/functions/checkout</span>`;

const deployTargets = [
    { name: "Docker", note: "A Dockerfile ships with every scaffolded backend." },
    { name: "Railway", note: "Push the repo, set DATABASE_URL, done." },
    { name: "Fly.io", note: "One process, one region or several." },
    { name: "Hetzner · bare metal", note: "It is a Node server. Run it the way you run Node." },
    { name: "AWS · GCP · Azure · Scaleway", note: "A deployment guide per provider in the docs." },
    { name: "Your existing Hono app", note: "Mount the backend as a sub-app instead of deploying it separately." },
];
---

<div class="flex flex-col isolate">

    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative isolate overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
        <NeatBackground client:idle/>

        <div class="px-6 lg:px-8 mx-auto max-w-6xl relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
                <div class="lg:col-span-6">
                    <div class="inline-flex items-center py-1.5 px-3 mb-6 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10">
                        <span class="text-sm font-medium">TypeScript · Postgres · your editor</span>
                    </div>
                    <h1 class="mb-6 text-display-2 text-white">
                        Schema as code.<br/>Everything else follows.
                    </h1>
                    <p class="mb-8 text-lg leading-8 text-surface-300">
                        You write collections in TypeScript and run four commands. Rebase keeps the database, the
                        API, the types and — if you opted in — the admin panel in agreement with that one file.
                        No generated code to babysit, no UI to re-draw.
                    </p>
                    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                        <a href="/docs/getting-started/quickstart"
                           class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all btn-glow"
                           data-track id="dev-hero-quickstart">
                            Quickstart
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>
                        </a>
                        <a href="https://github.com/rebasepro/rebase" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold">
                            Read the source
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                </div>
                <div class="lg:col-span-6">
                    <TerminalInit client:load/>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 01 · THE LOOP ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="max-w-3xl mb-12 animate-on-scroll fade-in-up">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                    The loop
                </p>
                <h2 class="text-3xl sm:text-4xl text-white">
                    Four commands, and then you are just writing TypeScript
                </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl overflow-hidden border border-surface-800/80 bg-surface-800/60">
                {loop.map((step, i) => (
                        <div class="bg-surface-950 p-7 relative">
                            <div class="pointer-events-none absolute inset-0" aria-hidden="true"
                                 style="background: radial-gradient(300px 160px at 50% 0%, rgba(0,112,244,0.06), transparent 70%);"></div>
                            <div class="relative">
                                <p class="font-mono text-xs text-surface-600 mb-3">0{i + 1}</p>
                                <code class="block font-mono text-sm text-primary-light mb-3">{step.cmd}</code>
                                <h3 class="text-base font-semibold text-white mb-2">{step.title}</h3>
                                <p class="text-sm text-surface-400 leading-relaxed">{step.desc}</p>
                            </div>
                        </div>
                ))}
            </div>

            <div class="mt-6">
                <a href={translatePath("/cli")}
                   class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                    The whole CLI, command by command
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 02 · THE PROJECT ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
                <div class="lg:col-span-5">
                    <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                        The project
                    </p>
                    <h2 class="text-3xl sm:text-4xl text-white mb-5">
                        Three folders, and one of them is optional
                    </h2>
                    <p class="text-base text-surface-400 leading-relaxed mb-4">
                        <code class="font-mono text-surface-300">config/collections/</code> is the only place your
                        data model is described. The backend reads it to serve APIs and generate the Drizzle
                        schema; the panel reads the same files to render itself.
                    </p>
                    <p class="text-base text-surface-400 leading-relaxed">
                        Delete <code class="font-mono text-surface-300">frontend/</code> and you have a headless
                        backend. Nothing under <code class="font-mono text-surface-300">backend/</code> imports
                        React, and the type system enforces it — an
                        <code class="font-mono text-surface-300">admin</code> key in a project that never opted in
                        is a compile error.
                    </p>
                </div>
                <div class="lg:col-span-7">
                    <div class="frame overflow-hidden">
                        <div class="px-4 py-3 flex items-center gap-1.5 border-b border-surface-800/80 bg-surface-900/50">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                            <span class="ml-2 font-mono text-xs text-surface-400">after rebase init</span>
                        </div>
                        <pre class="p-6 overflow-x-auto text-2xs sm:text-xs leading-relaxed font-mono text-surface-400"><code set:html={projectTree}></code></pre>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>

    <!-- ═══════════════════════ 03 · WHERE YOUR CODE GOES ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="max-w-3xl mb-12 animate-on-scroll fade-in-up">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                    Your code
                </p>
                <h2 class="text-3xl sm:text-4xl text-white">
                    Generated does not mean closed
                </h2>
                <p class="mt-5 text-lg leading-8 text-surface-400">
                    Every generated surface has a seam you can open: callbacks around writes, your own routes on
                    the server, your own React in the panel, and raw SQL when the abstraction is in the way.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="frame overflow-hidden flex flex-col">
                    <div class="px-4 py-3 border-b border-surface-800/80 bg-surface-900/50 flex items-center justify-between">
                        <span class="font-mono text-xs text-surface-400">config/collections/orders.ts</span>
                        <span class="text-3xs font-medium px-2 py-0.5 rounded-full bg-surface-800 text-surface-400">callbacks</span>
                    </div>
                    <pre class="p-5 overflow-x-auto text-2xs sm:text-xs leading-relaxed font-mono text-surface-300 flex-1"><code set:html={callbackCode}></code></pre>
                    <p class="px-5 pb-5 text-sm text-surface-400">
                        Business logic runs on the server, on every write path — including writes made from the
                        admin panel.
                    </p>
                </div>

                <div class="frame overflow-hidden flex flex-col">
                    <div class="px-4 py-3 border-b border-surface-800/80 bg-surface-900/50 flex items-center justify-between">
                        <span class="font-mono text-xs text-surface-400">backend/functions/checkout.ts</span>
                        <span class="text-3xs font-medium px-2 py-0.5 rounded-full bg-surface-800 text-surface-400">custom routes</span>
                    </div>
                    <pre class="p-5 overflow-x-auto text-2xs sm:text-xs leading-relaxed font-mono text-surface-300 flex-1"><code set:html={functionCode}></code></pre>
                    <p class="px-5 pb-5 text-sm text-surface-400">
                        Drop a file in <code class="font-mono text-surface-300">functions/</code> and it is mounted,
                        authenticated and RLS-scoped with no registration step.
                    </p>
                </div>
            </div>

            <div class="mt-10">
                <DeveloperPlayground client:visible/>
            </div>

            <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-8">
                <a href={translatePath("/cms")}
                   class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                    Custom React inside the panel
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
                <a href={translatePath("/ui")}
                   class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                    The component library
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
                <a href={translatePath("/sdk")}
                   class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                    The client SDK
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 04 · ARCHITECTURE ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-12">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                    Architecture
                </p>
                <h2 class="text-3xl sm:text-4xl text-white">
                    Where every piece actually runs
                </h2>
                <p class="mt-5 text-lg leading-8 text-surface-400">
                    Your browser, your server, your database. Nothing routes through us — there is no us in the
                    request path.
                </p>
            </div>
            <ArchitectureDiagram client:visible/>
        </div>
    </section>

    <!-- ═══════════════════════ 05 · SHIP IT ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
                <div class="lg:col-span-5">
                    <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                        Ship it
                    </p>
                    <h2 class="text-3xl sm:text-4xl text-white mb-5">
                        It deploys like the Node app it is
                    </h2>
                    <p class="text-base text-surface-400 leading-relaxed mb-4">
                        The backend builds to a bundle and runs behind whatever you already use. The admin panel
                        is a static SPA — serve it from the same process or from a CDN.
                    </p>
                    <p class="text-base text-surface-400 leading-relaxed mb-6">
                        Rebase Cloud, our managed hosting, has not launched yet. Until it does, every deployment
                        is yours: your database, your machine, your logs.
                    </p>
                    <a href="/docs/deployment/self-hosting"
                       class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                        Self-hosting guide
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
                <div class="lg:col-span-7">
                    <div class="rounded-2xl border border-surface-800/80 bg-surface-950/60 overflow-hidden">
                        <ul class="divide-y divide-surface-800/60">
                            {deployTargets.map(target => (
                                    <li class="px-7 py-4 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6">
                                        <span class="text-sm font-semibold text-white sm:w-60 shrink-0">{target.name}</span>
                                        <span class="text-sm text-surface-400 leading-relaxed">{target.note}</span>
                                    </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 06 · AGENTS ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
            <div class="rounded-2xl border border-surface-700/80 bg-surface-900/40 p-8 sm:p-12">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                    Your agents, too
                </p>
                <h2 class="text-2xl sm:text-3xl text-white mb-5">
                    Teach your coding agent the framework
                </h2>
                <p class="text-base text-surface-400 leading-relaxed mb-6">
                    <code class="font-mono text-surface-300">rebase skills install</code> writes packaged
                    instructions into Claude Code, Cursor, Windsurf or Gemini, so an agent working in your repo
                    already knows how collections, policies and the panel fit together. The MCP server gives it
                    tools — schema introspection, migrations, queries, storage, cron — under a scoped key that
                    row-level security still applies to.
                </p>
                <div class="group relative max-w-md mb-6">
                    <div class="relative rounded-xl bg-surface-950/80 border border-surface-700/80 overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                        <div class="px-5 py-4 flex items-center justify-between">
                            <div class="font-mono text-sm flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                <span class="text-primary mr-3">~</span>
                                <span class="text-white">rebase skills install</span>
                            </div>
                            <button data-track-copy="dev-skills" data-command="rebase skills install"
                                    class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                    aria-label="Copy command" title="Copy to clipboard">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
                <a href={translatePath("/ai")}
                   class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                    The agent story in full
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ CTA ═══════════════════════ -->
    <section class="py-24 sm:py-32">
        <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
            <h2 class="text-3xl sm:text-4xl text-white mb-4">Ready to build?</h2>
            <p class="text-lg text-surface-400 mb-10">
                One command scaffolds the whole thing. It runs against a local Postgres, or the one you already
                have.
            </p>

            <div class="group relative max-w-md mx-auto mb-10">
                <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-0 group-hover:opacity-100 blur-lg transition-opacity duration-500"
                     aria-hidden="true"></div>
                <div class="relative rounded-xl bg-surface-900/80 border border-surface-700/80 overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                    <div class="px-5 py-4 flex items-center justify-between">
                        <div class="font-mono text-sm sm:text-base flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                            <span class="text-primary mr-3">~</span>
                            <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                        </div>
                        <button data-track-copy="dev-cta" data-command="pnpm dlx @rebasepro/cli init"
                                class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                aria-label="Copy command" title="Copy to clipboard">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
                <a href="/docs"
                   class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all btn-glow"
                   data-track id="dev-cta-docs">
                    Read the docs
