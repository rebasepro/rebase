---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';
import { CodeBlock } from '../../components/CodeBlock.tsx';
import ClientLogos from '../../components/ClientLogos.astro';
import { NeatBackground } from '../../components/NeatBackground';
import AlternativesComparison from '../AlternativesComparison.astro';

import { SchemaBuilderMiniDemo } from '../../components/demos/SchemaBuilderMiniDemo.tsx';
import { SdkMiniDemo } from '../../components/demos/SdkMiniDemo.tsx';
import { ApiMiniDemo } from '../../components/demos/ApiMiniDemo.tsx';
import { CustomFieldsDemo } from '../../components/demos/CustomFieldsDemo.tsx';
import { RLSEditorDemo } from '../../components/demos/RLSEditorDemo.tsx';
import ClientUIComponentsTeaser from '../../components/ClientUIComponentsTeaser.tsx';
import { RealtimeMiniDemo } from '../../components/demos/RealtimeMiniDemo.tsx';
import { TerminalInit } from '../../components/demos/TerminalInit.tsx';
import { ArchitectureDiagram } from '../../components/demos/ArchitectureDiagram.tsx';
import "../../styles/editor.css";

const cliCommands = [
  { cmd: "rebase init", desc: "Scaffold a new project with Postgres, auth, and admin panel", badge: "setup", color: "emerald" },
  { cmd: "rebase schema generate", desc: "Generate Drizzle ORM schema from your TypeScript collections", badge: "schema", color: "blue" },
  { cmd: "rebase schema introspect", desc: "Introspect an existing Postgres database into collection definitions", badge: "schema", color: "blue" },
  { cmd: "rebase db push", desc: "Apply schema changes directly to the database (dev shortcut)", badge: "db", color: "amber" },
  { cmd: "rebase db generate", desc: "Generate SQL migration files from schema diff", badge: "db", color: "amber" },
  { cmd: "rebase db migrate", desc: "Run all pending migrations against the database", badge: "db", color: "amber" },
  { cmd: "rebase generate-sdk", desc: "Generate a typed database.types.ts for end-to-end type safety", badge: "sdk", color: "purple" },
  { cmd: "rebase dev", desc: "Start frontend + backend concurrently with hot reload", badge: "dev", color: "pink" },
];

const productDetailPreviewCode = `export function ProductDetailPreview({ modifiedValues }: {
    modifiedValues?: EntityValues<Product>;
}) {
    const snackbarController = useSnackbarController();
    const [quantity, setQuantity] = React.useState(1);

    if (!modifiedValues) {
        return <CenteredView>Please add some data to see the preview</CenteredView>;
    }

    const { name, price, description, images } = modifiedValues;
    const mainImage = images?.[0];

    return (
        <div className="p-8">
            <div className="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                {/* Product Image */}
                {mainImage && (
                    <img alt="Product" className="aspect-square object-cover w-full rounded-lg" src={mainImage} />
                )}
                {/* Details */}
                <div className="grid gap-4 content-center">
                    <h1 className="text-3xl font-bold">{name ?? "Product name"}</h1>
                    <div className="text-3xl font-semibold">\\\${price}</div>
                    <Markdown source={description ?? ""} />
                    <QuantitySelect onSelected={(qty) => snackbarController.open({
                        type: "success",
                        message: \\\`Added \\\${qty} items to cart\\\`
                    })}/>
                </div>
            </div>
        </div>
    );
}`;
---

<div class="bg-black text-surface-300 overflow-hidden font-sans flex flex-col isolate">
    
    <!-- -- HERO SECTION -- -->
 <section class="relative isolate overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
     <NeatBackground client:idle />

        <!-- Background accents and subtle grid -->
        <div class="px-4 mx-auto max-w-7xl text-center lg:px-12 relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-xs font-semibold mb-6 animate-pulse">
                <span>*</span> The Open-Source Backend for Postgres
            </div>
            <h1 class="mb-6 text-3xl font-semibold tracking-tight md:text-4xl lg:text-5xl text-white">
                Stop writing CRUD.<br class="hidden sm:inline"/> Ship the whole backend.
            </h1>
            <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48">
                Point Rebase at your Postgres — or define your schema in pure TypeScript — and get migrations,
                typed APIs, and a premium React admin console. Authorization is enforced by the database,
                not by middleware you have to remember to write.
            </p>
            <div class="flex justify-center items-center">
                <div class="relative rounded-lg border border-surface-800/80 bg-surface-900/40 hover:border-primary/30 transition-all duration-200 px-4 py-3.5 flex items-center justify-between gap-3 text-sm font-mono text-white min-w-[260px] sm:min-w-[280px]">
                    <div class="flex items-center gap-2">
                        <span class="text-primary font-bold select-none">&gt;</span>
                        <span class="text-white select-all">pnpm dlx @rebasepro/cli init</span>
                    </div>
                    <button data-track-copy="developers-hero" data-command="pnpm dlx @rebasepro/cli init" class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors cursor-pointer" aria-label="Copy command" title="Copy to clipboard">
                        <svg class="lucide lucide-copy w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- -- CLIENT LOGOS SECTION -- -->
 <section class="relative isolate py-12 border-b border-surface-800/40">
        <div class="mx-auto max-w-7xl px-8 lg:px-12">
            <h2 class="text-center text-xs font-bold leading-8 text-surface-500 uppercase tracking-widest">
                Teams shipping products on our tools — Rebase and FireCMS
            </h2>
            <div class="mx-auto mt-4">
                <ClientLogos/>
            </div>
        </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden" style="z-index: -1; height: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>

    <!-- -- CORE DEVELOPER COMPONENTS SHOWCASE -- -->
 <section id="schema" class="py-20 sm:py-28 relative z-0 border-b border-surface-800/40">
        <div class="pointer-events-none absolute inset-0 -z-10">
            <div class="absolute top-1/3 left-10 w-[600px] h-[600px] rounded-full bg-blue-500/5 blur-3xl opacity-30"></div>
            <div class="absolute bottom-1/3 right-10 w-[600px] h-[600px] rounded-full bg-primary/5 blur-3xl opacity-20"></div>
        </div>

        <div class="mx-auto max-w-7xl px-6 lg:px-8 space-y-32">
            
            <!-- -- FEATURE 1: TYPE-SAFE SDK & INSTANT API -- -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-7 rounded-2xl border border-surface-800 bg-surface-950/80 shadow-2xl overflow-hidden order-last lg:order-first">
                    <div class="flex items-center justify-between px-4 py-2.5 border-b border-surface-800/60 bg-surface-900/30 text-[10px] font-mono text-surface-500">
                        <span>Universal SDK autocomplete & API response</span>
                        <span class="text-blue-400 font-bold bg-blue-500/10 px-1.5 py-0.5 rounded border border-blue-500/20 text-[8px]">Type-Safe</span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-12">
                        <!-- Typing Console -->
                        <div class="md:col-span-7 min-h-[280px] border-r border-surface-800/40">
                            <SdkMiniDemo client:only="react" />
                        </div>
                        <!-- JSON Payload Inspector -->
                        <div class="md:col-span-5 min-h-[280px]">
                            <ApiMiniDemo client:only="react" />
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-5 space-y-6">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-400 text-xs font-semibold">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        Isomorphic Drizzle-Like SDK
                    </div>
                    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
                        A Truly Typed SDK
                    </h2>
                    <p class="text-base text-surface-400">
                        Query database records cleanly with deep relational joins, zero N+1 query loops, and compile-time type validation mapping your database schemas.
                    </p>
                </div>
            </div>

            <!-- -- FEATURE 2: SCHEMA-AS-CODE -- -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-5 space-y-6">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-xs font-semibold">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                        AST Code Mutation
                    </div>
                    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
                        Schema-as-Code & Sync
                    </h2>
                    <p class="text-base text-surface-400">
                        Define collections in pure TypeScript schema models. Visual additions automatically execute AST mutations, writing code directly back to your repository.
                    </p>
                    <div class="text-[11px] text-surface-500 font-mono bg-surface-900/40 p-3 rounded border border-surface-800/40">
                        <span>Active Driver: </span>
                        <code class="text-amber-400 font-bold">drizzle-kit push:pg</code>
                    </div>
                </div>

                <div class="lg:col-span-7 rounded-2xl border border-surface-800 bg-surface-950/80 shadow-2xl overflow-hidden">
                    <div class="flex items-center px-4 py-2.5 border-b border-surface-800/60 bg-surface-900/30 text-[10px] font-mono text-surface-500">
                        schema/posts.ts
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2">
                        <!-- TypeScript Editor Mock -->
                        <div class="p-5 bg-[#0f0f11] font-mono text-[10.5px] leading-relaxed border-r border-surface-800/40 whitespace-pre-wrap"><span class="text-purple-400">import</span> &#123; <span class="text-blue-300">buildCollection</span>, <span class="text-blue-300">buildProperty</span> &#125; <span class="text-purple-400">from</span> <span class="text-green-400">"@rebasepro/common"</span>;

<span class="text-purple-400">export const</span> posts = <span class="text-blue-400">buildCollection</span>(&#123;
  name: <span class="text-green-400">"Posts"</span>,
  properties: &#123;
    id: <span class="text-blue-400">buildProperty</span>(&#123; type: <span class="text-green-400">"string"</span> &#125;),
    title: <span class="text-blue-400">buildProperty</span>(&#123; type: <span class="text-green-400">"string"</span> &#125;),
<span class="text-green-300/80 bg-green-500/5 pl-1 border-l-2 border-green-500 inline-block w-full">    status: <span class="text-blue-400">buildProperty</span>(&#123; type: <span class="text-green-400">"string"</span> &#125;)</span>
  &#125;
&#125;);</div>
                        <!-- Live visual builder preview -->
                        <div class="p-5 bg-[#09090b] flex flex-col justify-center">
                            <SchemaBuilderMiniDemo client:only="react" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- -- FEATURE 3: REALTIME ENGINE -- -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-5 space-y-6">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-500/30 bg-cyan-500/10 text-cyan-400 text-xs font-semibold">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        WebSocket Realtime
                    </div>
                    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
                        Live Data. Zero Polling.
                    </h2>
                    <p class="text-base text-surface-400">
                        Subscribe to table changes, broadcast to channels, and track user presence — all through the typed SDK. Changes propagate instantly via WebSocket with automatic reconnection and RLS enforcement.
                    </p>
                    <div class="rounded-xl bg-[#09090b] border border-surface-800/40 p-4 font-mono text-[11px] leading-relaxed">
                        <div class="text-surface-500 mb-1">// Subscribe to live changes</div>
                        <div><span class="text-[#569cd6]">const</span> <span class="text-[#9cdcfe]">unsub</span> = <span class="text-[#9cdcfe]">rebase</span>.<span class="text-[#9cdcfe]">data</span>.<span class="text-[#9cdcfe]">users</span></div>
                        <div class="ml-2">.<span class="text-[#dcdcaa]">listen</span>((<span class="text-[#9cdcfe]">event</span>) => {"{"}</div>
                        <div class="ml-4"><span class="text-surface-500">// INSERT | UPDATE | DELETE</span></div>
                        <div class="ml-4"><span class="text-[#9cdcfe]">console</span>.<span class="text-[#dcdcaa]">log</span>(<span class="text-[#9cdcfe]">event</span>.<span class="text-[#9cdcfe]">type</span>, <span class="text-[#9cdcfe]">event</span>.<span class="text-[#9cdcfe]">record</span>);</div>
                        <div class="ml-2">{"}"});</div>
                        <div class="mt-3 text-surface-500">// Broadcast channels</div>
                        <div><span class="text-[#569cd6]">const</span> <span class="text-[#9cdcfe]">channel</span> = <span class="text-[#9cdcfe]">rebase</span>.<span class="text-[#9cdcfe]">realtime</span></div>
                        <div class="ml-2">.<span class="text-[#dcdcaa]">channel</span>(<span class="text-[#ce9178]">"room:lobby"</span>)</div>
                        <div class="ml-2">.<span class="text-[#dcdcaa]">on</span>(<span class="text-[#ce9178]">"message"</span>, <span class="text-[#9cdcfe]">handler</span>)</div>
                        <div class="ml-2">.<span class="text-[#dcdcaa]">subscribe</span>();</div>
                    </div>
                </div>

                <div class="lg:col-span-7 rounded-2xl border border-surface-800 bg-surface-950/80 shadow-2xl overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-2.5 border-b border-surface-800/60 bg-surface-900/30 text-[10px] font-mono text-surface-500">
                        <span>Live data preview</span>
                        <span class="text-cyan-400 font-bold bg-cyan-500/10 px-1.5 py-0.5 rounded border border-cyan-500/20 text-[8px]">Realtime</span>
                    </div>
                    <div class="h-[300px]">
                        <RealtimeMiniDemo client:only="react" />
                    </div>
                </div>
            </div>

            <!-- -- FEATURE 4: VISUAL RLS EDITOR -- -->
            <div class="space-y-8">
                <div class="max-w-3xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-semibold mb-4">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                        Postgres Row-Level Security
                    </div>
                    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
                        Visual Database Security Policies
                    </h2>
                    <p class="mt-4 text-base text-surface-400">
                        Write database security rules visually inside the admin console. Presets automatically compile to Postgres-compliant SQL and sync live with Postgres.
                    </p>
                </div>
                
                <!-- Browser Frame for RLS editor -->
                <div class="w-full rounded-2xl border border-surface-800 bg-surface-950/90 shadow-2xl overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-3 border-b border-surface-800/60 bg-surface-900/30">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                            <span class="text-[11px] font-mono text-surface-500 ml-3">rebase-console / policies_manager.sql</span>
                        </div>
                        <span class="text-[10px] font-mono text-emerald-400 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            Security Engine Active
                        </span>
                    </div>
                    <div class="p-6 bg-[#09090b]">
                        <RLSEditorDemo client:only="react" />
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- -- ISOMORPHIC SDK ARCHITECTURE -- -->
 <section id="sdk-architecture" class="relative isolate py-20 sm:py-28 overflow-hidden border-b border-surface-800/40">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-16">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary-light text-xs font-semibold mb-6">
                    <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                    Isomorphic Architecture
                </div>
                <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">One SDK. Every environment.</h2>
                <p class="mt-4 text-base text-surface-400">
                    The same <code class="text-xs bg-surface-900 border border-surface-800 px-2 py-0.5 rounded text-surface-300 font-mono">@rebasepro/client</code> runs natively in your serverless functions, your user-facing apps, and your Node.js backend. Zero wrappers. Pure developer ergonomics.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
                <!-- Card 1: Serverless & Edge -->
                <div class="group relative rounded-2xl bg-surface-900/40 border border-surface-800/60 hover:border-primary/40 transition-all duration-300 p-6 flex flex-col justify-between">
                    <div class="flex items-center gap-3 mb-5">
                        <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-blue-500/10 border border-blue-500/20">
                            <!-- Corrected Astro class styling + direct size attributes for icon -->
                            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-white">Serverless & Edge</div>
                            <div class="text-[10px] text-surface-500 font-medium">Cloudflare Workers, Vercel Edge</div>
                        </div>
                    </div>
                    <div class="rounded-xl bg-[#09090b] border border-surface-800/40 p-4 font-mono text-[11px] leading-relaxed">
                        <div class="text-surface-500 mb-1">// Run on serverless runtime</div>
                        <div><span class="text-[#569cd6]">const</span> <span class="text-[#d4d4d4]">{"{ data } ="}</span> <span class="text-[#c586c0]">await</span></div>
                        <div class="ml-2"><span class="text-[#9cdcfe]">rebase</span>.<span class="text-[#9cdcfe]">data</span>.<span class="text-[#9cdcfe]">posts</span>.<span class="text-[#dcdcaa]">find</span>({"{"}</div>
                        <div class="ml-4"><span class="text-[#9cdcfe]">orderBy</span>: <span class="text-[#ce9178]">"createdAt:desc"</span></div>
                        <div class="ml-2">{"}"});</div>
                    </div>
                </div>

                <!-- Card 2: Frontend App -->
                <div class="group relative rounded-2xl bg-surface-900/40 border border-surface-800/60 hover:border-primary/40 transition-all duration-300 p-6 flex flex-col justify-between">
                    <div class="flex items-center gap-3 mb-5">
                        <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/10 border border-emerald-500/20">
                            <!-- Corrected Astro class styling + direct size attributes for icon -->
                            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-white">Frontend Apps</div>
                            <div class="text-[10px] text-surface-500 font-medium">React, Next.js, Remix, Astro</div>
                        </div>
                    </div>
                    <div class="rounded-xl bg-[#09090b] border border-surface-800/40 p-4 font-mono text-[11px] leading-relaxed">
                        <div class="text-surface-500 mb-1">// Client-side app data query</div>
                        <div><span class="text-[#569cd6]">const</span> <span class="text-[#d4d4d4]">{"{ data } ="}</span> <span class="text-[#c586c0]">await</span></div>
                        <div class="ml-2"><span class="text-[#9cdcfe]">rebase</span>.<span class="text-[#9cdcfe]">data</span>.<span class="text-[#9cdcfe]">posts</span>.<span class="text-[#dcdcaa]">find</span>({"{"}</div>
                        <div class="ml-4"><span class="text-[#9cdcfe]">orderBy</span>: <span class="text-[#ce9178]">"createdAt:desc"</span></div>
                        <div class="ml-2">{"}"});</div>
                    </div>
                </div>

                <!-- Card 3: Backend Service -->
                <div class="group relative rounded-2xl bg-surface-900/40 border border-surface-800/60 hover:border-primary/40 transition-all duration-300 p-6 flex flex-col justify-between">
                    <div class="flex items-center gap-3 mb-5">
                        <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/10 border border-amber-500/20">
                            <!-- Corrected Astro class styling + direct size attributes for icon -->
                            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                        </div>
