  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" />
  <path d="M14 2v5a1 1 0 0 0 1 1h5" />
  <path d="M10 9H8" />
  <path d="M16 13H8" />
  <path d="M16 17H8" />
</svg>

                            <h5 class="font-semibold text-white m-0">Simplified Data Subject Requests</h5>
                        </div>
                        <p class="text-surface-400 text-sm">Fulfill access and deletion requests directly from your
                            database.</p>
                    </div>
                    <div class="p-6 rounded-lg border bg-surface-900/50 border-surface-800">
                        <div class="flex items-center mb-3">
                            
<svg
  class="lucide lucide-database"
