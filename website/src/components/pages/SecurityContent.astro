</svg>

                        <h3 class="text-3xl font-bold text-white mb-2">99.9%</h3>
                        <p class="text-surface-400">Infrastructure Uptime</p>
                    </div>
                    <div class="p-6 rounded-xl border bg-surface-900/50 text-center border-surface-800">
                        
<svg
  class="lucide lucide-user-check"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m16 11 2 2 4-4" />
  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
  <circle cx="9" cy="7" r="4" />
