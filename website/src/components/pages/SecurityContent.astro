---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';

import { NeatBackground } from '../../components/NeatBackground';
import HeroConnectionWidget from '../demos/HeroConnectionWidget';
import { RLSEditorDemo } from '../demos/RLSEditorDemo.tsx';
import { RbacMiniDemo } from '../demos/RbacMiniDemo.tsx';
import ClosingCta from "../ClosingCta.astro";
---


    <div class="flex flex-col isolate">
        <!-- Hero Section -->
 <section
 class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24 lg:pb-24">
            <NeatBackground client:idle transition:persist="neat-hero" />

            <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
                <p class="mb-5 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase" set:html={t("securitypage.00")}></p>
                <div class="inline-flex items-center py-1.5 px-3 mb-6 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10">
                    <span class="text-sm font-medium">{t("securitypage.01")}</span>
                </div>
                <h1 class="mb-6 text-display-2 text-white" set:html={t("securitypage.02")}></h1>
                <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl" set:html={t("securitypage.03")}></p>
                <div class="flex flex-col sm:flex-row gap-4 justify-start">
                    <a href="#rls"
                       class="inline-flex items-center justify-start gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all btn-glow">
                        {t("securitypage.90")}
                        <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                    </a>
                    <a href="/demo"
                       class="inline-flex items-center justify-start gap-x-2 rounded-lg border border-surface-700 bg-surface-800 px-6 py-3 text-base font-semibold text-white hover:bg-surface-700 transition-all">{t("securitypage.81")}</a>
                </div>
            </div>
        </section>


        <!-- Free tool: rls-check -->
        <section class="relative z-0 py-16 sm:py-24">
            <div class="mx-auto max-w-4xl px-6 lg:px-8">
                <div class="rounded-2xl border border-surface-700/80 bg-surface-900/60 px-6 py-10 sm:px-10 sm:py-12">
                    <div class="text-center">
                        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-xs font-medium text-primary">{t("securitypage.04")}</span>
                        <h2 class="mt-5 text-2xl sm:text-3xl text-white">{t("securitypage.05")}</h2>
                        <p class="mt-4 text-base leading-7 text-surface-400" set:html={t("securitypage.06")}></p>
                    </div>

                    <div class="mt-8 group relative">
                        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-0 group-hover:opacity-100 blur-lg transition-opacity duration-500"
                             aria-hidden="true"></div>
                        <div class="relative rounded-xl bg-surface-950/80 border border-surface-700/80 overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                            <div class="px-5 py-4 flex items-center justify-between">
                                <div class="font-mono text-sm sm:text-base flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                    <span class="text-primary mr-3">~</span>
                                    <span class="text-white">{t("securitypage.07")}</span>
                                </div>
                                <button data-track-copy="security-rls-check" data-command="npx @rebasepro/rls-check"
                                        class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                        aria-label="Copy command" title="Copy to clipboard">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <p class="mt-5 text-center text-xs leading-6 text-surface-500">{t("securitypage.08")}</p>

                    <div class="mt-6 text-center">
                        <a href="/rls-check"
                           class="inline-flex items-center gap-x-2 text-sm font-medium text-primary hover:underline">
                            {t("rlscheck.cta")}
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Row-Level Security Section -->
 <section id="rls" class="relative z-0 py-16 sm:py-24">
            <div class="mx-auto max-w-6xl px-6 lg:px-8">
                <div class="space-y-8">
                    <div class="max-w-3xl">
                        <div class="inline-flex items-center gap-2 py-1.5 px-3 mb-4 text-xs rounded-full bg-orange-500/10 text-orange-400 ring-1 ring-inset ring-orange-500/20 font-medium">
                            <svg class="lucide lucide-shield-check" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" /></svg>
                            Enforced by the database
                        </div>
                        <h2 class="text-3xl sm:text-4xl text-white">{t("securitypage.09")}</h2>
                        <p class="mt-4 text-base text-surface-400 max-w-2xl">{t("securitypage.10")}</p>
                    </div>

                    <!-- Browser chrome frame -->
                    <div class="w-full rounded-2xl border border-surface-800 bg-surface-950/90 shadow-2xl overflow-hidden">
                        <div class="flex items-center justify-between px-4 py-3 border-b border-surface-800/60 bg-surface-900/30">
                            <div class="flex items-center gap-1.5">
                                <span class="text-2xs font-mono text-surface-500 ml-3">{t("securitypage.11")}</span>
                            </div>
                            <span class="text-3xs font-mono text-emerald-400 flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                {t("securitypage.12")}
                            </span>
                        </div>
                        <div class="p-6 bg-[#09090b]">
                            <RLSEditorDemo client:only="react" />
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- Fail closed -->
        <section class="py-16 sm:py-24">
            <div class="mx-auto max-w-6xl px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
                    <div class="lg:col-span-5">
                        <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">{t("securitypage.82")}</p>
                        <h2 class="text-3xl sm:text-4xl text-white mb-5">{t("securitypage.13")}</h2>
                        <p class="text-base text-surface-400 leading-relaxed mb-4">{t("securitypage.14")}</p>
                        <p class="text-base text-surface-400 leading-relaxed">{t("securitypage.15")}</p>
                    </div>
                    <div class="lg:col-span-7">
                        <div class="rounded-2xl border border-surface-800/80 bg-surface-950/60 overflow-hidden">
                            <ul class="divide-y divide-surface-800/60">
                                <li class="px-7 py-5">
                                    <p class="text-sm font-semibold text-white mb-1">{t("securitypage.16")}</p>
                                    <p class="text-sm text-surface-400 leading-relaxed">{t("securitypage.17")}</p>
                                </li>
                                <li class="px-7 py-5">
                                    <p class="text-sm font-semibold text-white mb-1">{t("securitypage.18")}</p>
                                    <p class="text-sm text-surface-400 leading-relaxed">{t("securitypage.19")}</p>
                                </li>
                                <li class="px-7 py-5">
                                    <p class="text-sm font-semibold text-white mb-1">{t("securitypage.20")}</p>
                                    <p class="text-sm text-surface-400 leading-relaxed">{t("securitypage.21")}</p>
                                </li>
                                <li class="px-7 py-5">
                                    <p class="text-sm font-semibold text-white mb-1">{t("securitypage.22")}</p>
                                    <p class="text-sm text-surface-400 leading-relaxed">{t("securitypage.23")}</p>
                                </li>
                                <li class="px-7 py-5">
                                    <p class="text-sm font-semibold text-white mb-1">{t("securitypage.24")}</p>
                                    <p class="text-sm text-surface-400 leading-relaxed" set:html={t("securitypage.25")}></p>
                                </li>
                                <li class="px-7 py-5">
                                    <p class="text-sm font-semibold text-white mb-1">{t("securitypage.26")}</p>
                                    <p class="text-sm text-surface-400 leading-relaxed">{t("securitypage.27")}</p>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- RBAC Section -->
 <section class="py-16 sm:py-24">
            <div class="mx-auto max-w-6xl px-6 lg:px-8">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="inline-flex items-center gap-2 py-1.5 px-3 mb-4 text-xs rounded-full bg-violet-500/10 text-violet-400 ring-1 ring-inset ring-violet-500/20 font-medium">
                            <svg class="lucide lucide-users" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><path d="M16 3.128a4 4 0 0 1 0 7.744" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><circle cx="9" cy="7" r="4" /></svg>
                            Roles and permissions
                        </div>
                        <h2 class="text-3xl sm:text-4xl text-white mb-4">{t("securitypage.28")}</h2>
                        <p class="text-lg text-surface-300 mb-8">{t("securitypage.29")}</p>
                        <div class="space-y-4">
                            <div class="flex items-start gap-3">
                                <svg class="lucide lucide-circle-check-big text-emerald-400 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335" /><path d="m9 11 3 3L22 4" /></svg>
                                <p class="text-surface-400" set:html={t("securitypage.30")}></p>
                            </div>
                            <div class="flex items-start gap-3">
                                <svg class="lucide lucide-circle-check-big text-emerald-400 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335" /><path d="m9 11 3 3L22 4" /></svg>
                                <p class="text-surface-400" set:html={t("securitypage.31")}></p>
                            </div>
                            <div class="flex items-start gap-3">
                                <svg class="lucide lucide-circle-check-big text-emerald-400 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335" /><path d="m9 11 3 3L22 4" /></svg>
                                <p class="text-surface-400" set:html={t("securitypage.32")}></p>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center justify-center">
                        <div class="w-full max-w-md rounded-2xl border border-surface-800 bg-surface-950/90 shadow-2xl overflow-hidden">
                            <div class="flex items-center justify-between px-4 py-3 border-b border-surface-800/60 bg-surface-900/30">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-2xs font-mono text-surface-500 ml-3">roles</span>
                                </div>
                            </div>
                            <div class="p-6 bg-[#09090b]">
                                <RbacMiniDemo client:load />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Neat gradient divider -->
        <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
            <NeatBackground variant="a" client:visible/>
        </div>

        {/* The three "Security Principles" cards stood here. Two of them are
            now rows in the fail-closed list above — which is where the page
            actually argues — and the third restated it in Title Case. */}

    <!-- Neat gradient divider -->
        <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
            <NeatBackground variant="b" client:visible/>
        </div>

        <!-- Data Sovereignty Section -->
 <section class="relative z-0 py-16 sm:py-24">
            <div class="mx-auto max-w-6xl px-6 lg:px-8">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="inline-flex items-center gap-2 py-1.5 px-3 mb-4 text-xs rounded-full bg-blue-500/10 text-blue-400 ring-1 ring-inset ring-blue-500/20 font-medium">
                            <svg class="lucide lucide-database" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5V19A9 3 0 0 0 21 19V5" /><path d="M3 12A9 3 0 0 0 21 12" /></svg>
                            Data sovereignty · self-hosted
                        </div>
                        <h2 class="text-3xl sm:text-4xl text-white mb-4">{t("securitypage.33")}</h2>
                        <p class="text-lg text-surface-300 mb-8" set:html={t("securitypage.34")}></p>
                        <div class="space-y-6">
                            <div class="flex items-start gap-3">
                                <svg class="lucide lucide-circle-check-big text-emerald-400 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335" /><path d="m9 11 3 3L22 4" /></svg>
                                <div>
                                    <h4 class="font-semibold text-white">{t("securitypage.35")}</h4>
                                    <p class="text-surface-400">{t("securitypage.36")}</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <svg class="lucide lucide-circle-check-big text-emerald-400 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335" /><path d="m9 11 3 3L22 4" /></svg>
                                <div>
                                    <h4 class="font-semibold text-white">{t("securitypage.37")}</h4>
                                    <p class="text-surface-400">{t("securitypage.38")}</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <svg class="lucide lucide-circle-check-big text-emerald-400 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335" /><path d="m9 11 3 3L22 4" /></svg>
                                <div>
                                    <h4 class="font-semibold text-white">{t("securitypage.39")}</h4>
                                    <p class="text-surface-400">{t("securitypage.40")}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="w-full">
                        <HeroConnectionWidget client:load />
                    </div>
                </div>
            </div>
        </section>

        <!-- Self-Hosted Architecture Section -->
 <section class="relative z-0 py-16 sm:py-24">
            <div class="mx-auto max-w-6xl px-6 lg:px-8">
                <div class="mx-auto max-w-3xl text-center mb-16">
                    <div class="inline-flex items-center gap-2 py-1.5 px-3 mb-4 text-xs rounded-full bg-emerald-500/10 text-emerald-400 ring-1 ring-inset ring-emerald-500/20 font-medium mx-auto">
                        <svg class="lucide lucide-server" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2" /><rect width="20" height="8" x="2" y="14" rx="2" ry="2" /><line x1="6" x2="6.01" y1="6" y2="6" /><line x1="6" x2="6.01" y1="18" y2="18" /></svg>
                        Self-Hosted
                    </div>
                    <h2 class="text-3xl sm:text-4xl text-white">{t("securitypage.41")}</h2>
                    <p class="mt-4 text-lg leading-8 text-surface-400">{t("securitypage.42")}</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800">
                        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-blue-500/10 mb-6">
                            <svg class="lucide lucide-database text-blue-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5V19A9 3 0 0 0 21 19V5" /><path d="M3 12A9 3 0 0 0 21 12" /></svg>
                        </div>
                        <h3 class="text-xl font-semibold text-white mb-3">{t("securitypage.83")}</h3>
                        <p class="text-surface-400 text-sm">{t("securitypage.43")}</p>
                    </div>
                    <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800">
                        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-orange-500/10 mb-6">
                            <svg class="lucide lucide-container text-orange-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="14" rx="2" /><rect width="20" height="8" x="2" y="2" rx="2" /><line x1="6" x2="6.01" y1="6" y2="6" /><line x1="6" x2="6.01" y1="18" y2="18" /></svg>
                        </div>
                        <h3 class="text-xl font-semibold text-white mb-3">{t("securitypage.84")}</h3>
                        <p class="text-surface-400 text-sm">{t("securitypage.44")}</p>
                    </div>
                    <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800">
                        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-violet-500/10 mb-6">
                            <svg class="lucide lucide-git-branch text-violet-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" x2="6" y1="3" y2="15" /><circle cx="18" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M18 9a9 9 0 0 1-9 9" /></svg>
                        </div>
                        <h3 class="text-xl font-semibold text-white mb-3">{t("securitypage.85")}</h3>
                        <p class="text-surface-400 text-sm">{t("securitypage.45")}</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Neat gradient divider -->
        <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
            <NeatBackground variant="a" client:visible/>
        </div>

        <!-- Deployment Models Section -->
        <section class="py-16 sm:py-24">
            <div class="mx-auto max-w-6xl px-6 lg:px-8">
                <div class="mx-auto max-w-3xl text-center mb-12">
                    <h2 class="text-3xl sm:text-4xl text-white">{t("securitypage.46")}</h2>
                    <p class="mt-4 text-lg leading-8 text-surface-400" set:html={t("securitypage.47")}></p>
                </div>
                <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
                    <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800">
                        <div class="inline-flex items-center gap-2 py-1.5 px-3 mb-4 text-xs rounded-full bg-emerald-500/10 text-emerald-400 ring-1 ring-inset ring-emerald-500/20 font-medium">
                            <svg class="lucide lucide-server" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2" /><rect width="20" height="8" x="2" y="14" rx="2" ry="2" /><line x1="6" x2="6.01" y1="6" y2="6" /><line x1="6" x2="6.01" y1="18" y2="18" /></svg>
                            Self-hosted / open source
                        </div>
                        <h3 class="text-2xl font-semibold text-white mb-4">{t("securitypage.48")}</h3>
                        <p class="text-surface-400 mb-4">{t("securitypage.49")}</p>
                        <p class="text-surface-500 text-sm">{t("securitypage.50")}</p>
                    </div>
                    <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800">
                        <div class="inline-flex items-center gap-2 py-1.5 px-3 mb-4 text-xs rounded-full bg-blue-500/10 text-blue-400 ring-1 ring-inset ring-blue-500/20 font-medium">
                            <svg class="lucide lucide-cloud" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9" /></svg>
                            Rebase Cloud · Private beta
