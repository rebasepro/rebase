                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                                <svg data-copy-done hidden class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 6 9 17l-5-5"/>
                                </svg>
                                <span data-copy-label>{t("copy.command")}</span>
                            </button>
                        </div>
                        <a href={translatePath("/docs/deployment")} class="accent-link mt-5">
                            {t("cta.lane.selfhost.link")} <ArrowRight size={14} />
                        </a>
                    </div>
                    <div class="py-10 md:pl-8 border-t md:border-t-0 border-white/10">
                        <h3 class="text-base flex items-center gap-3">
                            {t("cta.lane.cloud.title")}
                            <span class="rounded-md bg-white/10 px-2 py-1 font-mono text-3xs uppercase tracking-[0.1em] text-surface-300">
                                {t("cta.lane.cloud.badge")}
                            </span>
                        </h3>
                        <p class="mt-3 text-sm text-[#b4b8bd] leading-relaxed">{t("cta.lane.cloud.desc")}</p>
                        {/* Cloud is not open yet, so the lane's link asks for an
                            address rather than sending a reader to a price list
