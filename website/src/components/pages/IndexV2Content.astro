                            <button
                                type="button"
                                data-track-copy="cta-lane-selfhost"
                                data-command={SELFHOST_COMMAND}
                                data-copy-done-label={t("copy.command.done")}
                                class="copy-btn inline-flex shrink-0 items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.055] px-2 py-1 font-sans text-2xs font-medium text-surface-400 transition-colors hover:border-white/20 hover:bg-white/[0.09] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                aria-label={`Copy "${SELFHOST_COMMAND}" to the clipboard`}
