---
import { NeatBackground } from "../NeatBackground";
import ABVariant from "../ABVariant.astro";
import CollectionPowerSection from "../CollectionPowerSection.astro";
import ClientLogos from "../ClientLogos.astro";
import PolicyPathsFigure from "../PolicyPathsFigure.astro";
import CaseStudiesCarousel from "../CaseStudiesCarousel.astro";
import { ApiMiniDemo } from "../demos/ApiMiniDemo";
import { SdkMiniDemo } from "../demos/SdkMiniDemo";
import { RealtimeMiniDemo } from "../demos/RealtimeMiniDemo";
import { AdminDemoCarousel } from "../demos/AdminDemoCarousel";
import { AgentConsoleDemo } from "../demos/AgentConsoleDemo";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/ui";
import { ArrowRight, Database, LayoutDashboard, TerminalSquare } from "lucide-react";

// Rendered by the home route, which supplies both; falls back for the dev route.
const { lang: langProp, t: tProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = tProp ?? useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// No argument: the tool reads DATABASE_URL (or POSTGRES_URL, or .env) itself.
// A connection string on the command line is readable in `ps` by every other
// user on the box, and lands in shell history — this is the form we can put in
// front of someone about to paste a production credential.
const RLS_CHECK_COMMAND = "npx @rebasepro/rls-check";

// One source for the command the hero shows and the copy button writes, so
// the two can never drift apart.
const INSTALL_COMMAND = "pnpm dlx @rebasepro/cli init";
const SELFHOST_COMMAND = "docker compose up -d";

---
<div class="isolate text-white">
    {/* ============================================================
        HOME PAGE SPINE — five numbered chapters, one close.

          hero      the claim, with the artifact
          01        MECHANISM — the collection file and what it fans out to
          02        SECURITY — the claim ranked highest, then the free audit
                    that lets a reader check it rather than read it
          03        WHAT YOU GET — the engine and the panel, one chapter
          04        AGENT ERA
          05        CUSTOMERS
          close     the three lanes, the terms, and the ask

        Colour is spent twice and only twice: the blue slab on 02 and the coral
        close. Both carry a claim whose subject is the ABSENCE of an event, which
        no demo beside them can show. Everything else runs on the page ground or
        on `ground-raised`.
        ============================================================ */}

        <!-- ============================================================
             HERO — under test as `hero-register` (scripts/ab-testing.ts).
             control: Neat is composition, not wallpaper — the art dimmed to a
             quarter and held at 0.55 behind the type, a second pass of the
             same canvas multiplying over the letterforms.
             loud: Neat is the picture — the blog's register (full brightness,
             full opacity), the band split the way a blog hero is: art behind
             the nav and a taller band above the headline, a scrim under the
             reading copy and the terminal, a shadow under the headline.
             One section, one hero canvas. The canvas reads its register from
             the wrapper (`data-neat-tone-experiment`); the padding is
             `.hero-home` in global.css; the rest is <ABVariant>.
             ============================================================ -->
        {/* `hero-under-nav` starts the section behind the transparent bar so the
            Neat canvas fills that band too (global.css). The top scale it comes
            with is the site's — this hero keeps its own, per register, in
            `.hero-home`, which sits after it in the components layer and so
            wins. Both scales add the header's height back for the same reason
            the shared class does: the negative margin has to be paid for, or
            every line below rides 60px too high. Both are bounded by the fold
            on a 1440x900 window, the smallest laptop size that still matters:
            in the loud register the terminal bottoms out at ~812px. */}
        <section class="hero-home relative isolate overflow-hidden flex items-center hero-under-nav">
            {/* The wrapper is the page's element and declares the register;
                the island inside it persists across pages and reads it. */}
            <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true"
                 data-neat-tone="subtle" data-neat-tone-experiment="hero-register">
                <NeatBackground client:idle transition:persist="neat-hero" />
            </div>
            <!-- control: the multiply pass over the type. Hidden in the loud arm,
                 where NeatBackground sees a 0x0 canvas and never compiles it. -->
            <ABVariant experiment="hero-register" variant="control" class="neat-over absolute inset-0 pointer-events-none">
                <NeatBackground client:idle transition:persist="neat-hero-over" />
            </ABVariant>
            <!-- loud: the scrim. Same z-index as the canvas, later in the DOM, so
                 it paints over the art and under everything else. The stops
                 live in global.css next to the register they serve. -->
            <ABVariant experiment="hero-register" variant="loud" class="hero-scrim absolute inset-0 -z-10 pointer-events-none" />

            {/* The headline is full width and the row beneath it is the split,
                rather than the headline living in one half. At display-1 a
                6-column column gives about seven characters a line: the type
                wrapped to six lines, pushed the terminal down and put both CTAs
                below the fold — big, but not bold. Full width it sets in three,
                and the product artifact stays where SITE-STORY §5 requires it. */}
            <div class="relative w-full mx-auto max-w-6xl px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
                    <div class="lg:col-span-12">
                        <!-- The Postgres mark the old hero carried: it says what the
                             product runs on before the headline has to. -->
                        <span class="inline-flex items-center gap-2 rounded-full border border-surface-700 bg-surface-900/60 px-3 py-1 text-xs font-medium text-surface-400">
                            <img src="/img/postgresql-logo.svg" alt="PostgreSQL" width="432" height="445" class="h-4 w-auto" />
                            {t("hero.badge")}
                        </span>
                        {/* One <h1> with two block spans, not two headings and not
                            four — the copy is two translated sentences, and any
                            finer split would have to guess where a line breaks,
                            which differs per locale. `leading-[1.02]` is gone:
                            `text-display-1` carries its own 0.94, and the two
                            were fighting. */}
                        <h1 class="animate-on-scroll animate-immediate mt-5 font-headers text-display-1 text-balance">
                            <span class="hero-line">{t("hero.title.part1")}</span>
                            <span class="hero-line">{t("hero.title.part2")}</span>
                        </h1>
                    </div>

                    {/* Row two: the argument on the left, the artifact on the
                        right. The sub keeps its 34rem measure from §6 — the
                        headline got wider, the reading line did not. */}
                    <div class="lg:col-span-5">
                        <p class="max-w-[34rem] text-base sm:text-lg leading-relaxed text-[#b4b8bd]">
                            {t("hero.subtitle")}
                        </p>
                        <div class="mt-8 flex flex-wrap items-center gap-3">
                            {/* The click every arm of an experiment counts as a
                                conversion (analytics.ts reads the attribute). */}
                            <a
                                href={translatePath("/demo")}
                                data-ab-conversion="hero_cta_click"
                                class="inline-flex items-center justify-start gap-2 rounded-lg bg-primary px-6 min-h-(--control-large) text-sm font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                            >
                                {t("hero.cta.demo")}
                            </a>
                        </div>
                    </div>

                    <!-- The hero carries a product artifact. SITE-STORY §5 records that
                         the WebGL-plus-type hero was replaced for exactly this reason;
                         dropping it again left the right half of the frame empty. The
                         install command lives here now, once, with its real output. -->
                    <div class="lg:col-span-7">
                        <div class="frame group/term">
                            <div class="frame-head">
                                <span class="h-2 w-2 rounded-full bg-rose-500/70"></span>
                                <span class="h-2 w-2 rounded-full bg-amber-400/70"></span>
                                <span class="h-2 w-2 rounded-full bg-emerald-400/70"></span>
                                <span class="ml-2 truncate">zsh · ~/work</span>
                                {/* The command is the one thing in this frame a reader
                                    actually needs to take away, so it gets a real
                                    button — labelled, always visible, with a state —
                                    rather than an icon that appears on hover. */}
                                <button
                                    type="button"
                                    data-track-copy="hero-terminal"
                                    data-command={INSTALL_COMMAND}
                                    data-copy-done-label={t("copy.command.done")}
                                    class="copy-btn ml-auto inline-flex items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.055] px-2 py-1 font-sans text-2xs font-medium text-surface-400 transition-colors hover:border-white/20 hover:bg-white/[0.09] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                    aria-label={`Copy "${INSTALL_COMMAND}" to the clipboard`}
                                    title="Copy to clipboard"
                                >
                                    <svg data-copy-idle class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                    </svg>
                                    <svg data-copy-done hidden class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20 6 9 17l-5-5"/>
                                    </svg>
                                    <span data-copy-label>{t("copy.command")}</span>
                                </button>
                            </div>
                            {/* A terminal does not reflow a command across two lines. At 390px these
                                lines are wider than the frame, so they scroll sideways instead of
                                wrapping — `$ pnpm dlx @rebasepro/cli init` stays one line, which is
                                the whole point of showing it in a terminal. */}
                            <div class="px-5 py-5 font-mono text-xs sm:text-sm leading-[2] text-surface-300 overflow-x-auto whitespace-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <p><span class="select-none text-surface-500">$</span> <span class="select-all text-white">{INSTALL_COMMAND}</span></p>
                                <p class="text-emerald-400">{t("demo.init")}</p>
                                <p class="text-emerald-400">{t("demo.pull")}</p>
                                {/* The page's strongest claim, said once in the
                                    first screen: the policies are compiled, not
                                    remembered. Chapter 02 argues it at length. */}
                                <p class="text-emerald-400">{t("demo.rls")}</p>
                                <p class="text-emerald-400">{t("demo.dev")}</p>
                                <p class="mt-3 text-surface-500" set:html={t("demo.ports")}></p>
                                <p class="mt-1"><span class="select-none text-surface-500">$</span> <span class="terminal-caret inline-block h-4 w-[7px] translate-y-[2px] bg-primary"></span></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Logo wall — the short beat, straight after the tallest one.
             `border-t` only: chapter 01 below opens with its own border-t at
             white/8, and nothing sits between them, so the two rules would
             touch and paint as one 2px line. -->
        <div class="border-t border-white/5 py-strip">
            {/* The caption is the qualifier PRODUCT.md mandates — and, since
                2026-09-02, the heritage argument: FireCMS's 10,000+ projects are
                the credibility a star count cannot supply. The campaign pages
                render the same key above their walls; the home wall had none. */}
            <p class="mb-8 text-center text-sm text-surface-400">{t("social.title")}</p>
            <ClientLogos />
        </div>

        <!-- No divider between the wall and chapter 01, in either arm of the
             hero experiment. There was one — the faded register, bled behind
             both — and it read as a second, weaker copy of the hero's art
             peeking out from under the logos (Francesco, 2026-09-10: "remove
             the gradient behind the logos"). The wall sits on bare ground; the
             next divider is chapter 03's. -->

        <!-- CHAPTER 01 — MECHANISM. The collection file in the middle and the
             five artifacts it fans out to. -->
        <div>
            <CollectionPowerSection index="01" />
        </div>

        <!-- ============================================================
             CHAPTER 02 — SECURITY. The one chapter whose accent is the brand
             blue, because it carries the highest-ranked claim.
             ============================================================ -->
        <div>
            {/* CHAPTER 02 — a STRUCTURAL guarantee, and one of only two coloured
                grounds on the page.

                It qualifies because its claim is the absence of an event: "not by
                middleware someone has to remember to call". The figure beside
                it shows five paths and one check; it cannot show that nobody forgot. The colour
                carries the half of the argument the demo cannot.

                Brand blue deepened, because this promise holds by construction —
                it is what Rebase is. See `ground-chroma` for the rule and for
                why the raw #0070F4 cannot be used here. */}
            <section class="chapter ground-chroma ground-claim py-chapter" style="--hue: var(--color-primary)">
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
                        <div class="lg:col-span-5">
                            {/* No `text-[#b4b8bd]` inside a slab. That grey is
                                tuned for the near-black page ground; on a
                                coloured one it reads as dirt. The slab sets its
                                own `color` and everything here inherits it. */}
                            <p class="eyebrow">
                                <span class="font-mono">02</span>
                                <span class="mx-2 opacity-40">·</span>{t("security.badge")}
                            </p>
                            <h2 class="mt-label font-headers text-display-2 text-balance">
                                {t("security.title")}
                            </h2>
                            <p class="mt-lead max-w-[38rem] leading-relaxed">{t("security.desc")}</p>
                            <div class="mt-10 flex flex-col items-start gap-3">
                                <a href={translatePath("/security")} class="accent-link">
                                    {t("security.link")}
                                    <ArrowRight size={15} />
                                </a>
                                <!-- The argument behind the demo above. The section
                                     shows RLS being edited; this is why it is generated
                                     rather than hand-written in the first place. -->
                                <a
                                    href="/blog/2026-08-23-security-that-does-not-depend-on-remembering"
                                    class="group inline-flex items-start gap-2.5 text-sm text-surface-400 hover:text-white transition-colors"
                                >
                                    <span class="mt-px inline-flex flex-none items-center rounded px-1.5 py-0.5 text-2xs font-semibold uppercase tracking-wider bg-white/5 text-surface-300 ring-1 ring-white/10">
                                        {t("label.blog")}
                                    </span>
                                    <span class="max-w-[34rem] leading-relaxed group-hover:underline underline-offset-4 decoration-white/30">
                                        {t("security.postLink")}
                                    </span>
                                </a>
                            </div>
                        </div>
                        {/* The villain and the fix in one frame: five ways into
                            the same table with the rule in one of them, folding
                            into the policy as Postgres holds it. The RLS editor
                            that stood here lives on /security and /studio; a demo
                            appears on the home page and at most one deep page,
                            and it was on two. */}
                        <div class="lg:col-span-7 lg:bleed-right animate-on-scroll fade-in-up delay-100">
                            <PolicyPathsFigure lang={lang} t={t} />
                        </div>
                    </div>

                </div>
            </section>
        </div>

        {/* PROOF — the free audit, directly under the security claim, and part
            of the same chapter.

            Chapter 02 asserts that authorization belongs in the database. This
            is the one place on the page where that claim can be checked rather
            than read: a published, read-only tool that audits ANY Postgres,
            needs no account, and does not care whether you use Rebase.

            It carries no numeral of its own on purpose. It is the evidence for
            the chapter above it, not a sixth beat, and it is deliberately
            compact — `RlsCheckReport` renders a full terminal, and this follows
            a coloured slab that already carries a demo. The whole job here is
            "this exists, go and run it".

            The band is grey, asked for explicitly (2026-09-04). Between a
            coloured slab above and the page ground below, no ground at all
            simply disappears; `ground-raised` is the same grey the page's other
            bands use, so the proof point separates itself without claiming a
            chapter number or a second colour. */}
        <section class="chapter relative ground-raised border-y border-white/8 py-band">
            <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
                    <div class="max-w-xl">
                        <h2 class="font-headers text-2xl sm:text-3xl text-balance">
                            {t("rlscheck.title")}
                        </h2>
                        <p class="mt-lead text-sm text-[#b4b8bd] leading-relaxed" set:html={t("rlscheck.subtitle")}></p>
                        <a href={translatePath("/rls-check")} class="accent-link mt-8">
                            {t("rlscheck.cta")}
                            <ArrowRight size={15} />
                        </a>
                    </div>

                    <div class="flex-none lg:max-w-md w-full">
                        <div class="flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.02] pl-3 pr-1.5 py-2 font-mono text-xs text-surface-200">
                            <code class="select-all flex-1 truncate">{RLS_CHECK_COMMAND}</code>
                            <button
                                type="button"
                                data-track-copy="home-rls-check"
                                data-command={RLS_CHECK_COMMAND}
                                class="copy-btn flex-none rounded-md p-1.5 text-surface-500 hover:text-white hover:bg-white/5 transition-colors"
                                aria-label="Copy command"
                                title="Copy to clipboard"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                            </button>
                        </div>
                        <p class="mt-3 text-2xs leading-5 text-surface-500">{t("rlscheck.note")}</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- NEAT DIVIDER → chapter 03, gold. -->
        <div class="neat-divider relative pointer-events-none overflow-hidden"
             style="z-index: -1; --divider-h: 600px;">
            <NeatBackground variant="a" client:visible />
        </div>

        <!-- CHAPTER 03 — WHAT YOU GET. One chapter, two halves: the engine
             (SDK, REST, realtime — three live demos) and then the panel that
             ships on top of it. They used to be two numbered beats either side
             of the security slab, which made the page state its feature list
             twice. The engine's `ground-raised` plate went with the merge: the
             security slab and the proof band above are already two grounds in a
             row, and a third would leave the page with no ground at all. -->
        <div>
            {/* No `overflow-hidden` here and no z-0: the gold divider above
                bleeds THROUGH this section by design (§6). */}
            <section class="chapter relative py-chapter">
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="max-w-[42rem] animate-on-scroll fade-in-up">
                        <p class="eyebrow">
                            <span class="font-mono">03</span>
                            <span class="mx-2 text-surface-700">·</span>{t("engine.badge")}
                        </p>
                        <h2 class="mt-label font-headers text-display-2 text-balance">
                            {t("engine.title")}
                        </h2>
                        <p class="mt-lead max-w-[38rem] text-[#b4b8bd] leading-relaxed">{t("engine.subtitle")}</p>
                    </div>

                    <!-- The demos were 232px postage stamps inside a hairline grid.
                         They are the most interesting thing on the page, so they get
                         the room: one wide frame, then two half-width ones. -->
                    <div class="mt-block animate-on-scroll fade-in-up">
                        <div class="frame">
                            <div class="frame-head">
                                <span class="h-2 w-2 rounded-full bg-rose-500/70"></span>
                                <span class="h-2 w-2 rounded-full bg-amber-400/70"></span>
                                <span class="h-2 w-2 rounded-full bg-emerald-400/70"></span>
                                <span class="ml-2">{t("index.diag.app")}</span>
                                <span class="ml-auto">live · try it</span>
                            </div>
                            <div class="h-[330px] overflow-hidden flex items-center justify-center">
                                <SdkMiniDemo client:visible />
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="animate-on-scroll fade-in-up delay-100">
                            <div class="frame">
                                <div class="frame-head"><span>{t("index.diag.rest")}</span><span class="ml-auto">live · send a request</span></div>
                                <div class="h-[340px] overflow-hidden flex items-center justify-center">
                                    <ApiMiniDemo client:visible />
                                </div>
                            </div>
                        </div>
                        <div class="animate-on-scroll fade-in-up delay-200">
                            <div class="frame">
                                <div class="frame-head"><span>{t("index.diag.realtime")}</span><span class="ml-auto">live</span></div>
                                <div class="h-[340px] overflow-hidden flex items-center justify-center">
                                    <RealtimeMiniDemo client:visible />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- What is left over is a line of text, not a fourth panel. -->
                    <div class="mt-12 flex flex-wrap items-baseline gap-x-8 gap-y-3 border-t border-white/8 pt-8">
                        <p class="text-sm text-[#b4b8bd] max-w-2xl">
                            {t("engine.plus")}
                        </p>
                        <a href={translatePath("/backend")} class="accent-link ml-auto">
                            {t("engine.link")}
                            <ArrowRight size={15} />
                        </a>
                    </div>

                    <!-- The panel half. A sub-heading, not a second eyebrow: the
                         panel is part of what you get, not a chapter of its own.
                         The carousel shows it; the three columns under it say
                         what it is made of and that the API does not move
                         without it. -->
                    <h3 class="mt-block font-headers text-2xl sm:text-3xl text-balance">{t("panel.title")}</h3>
                    <p class="mt-lead max-w-[38rem] text-[#b4b8bd] leading-relaxed">{t("modes.subtitle")}</p>
                    {/* No `.frame`: the carousel draws the panel's own edge, and
                        §6 allows a demo one frame, not two. The view toggle is page
                        furniture and sits outside the product's edge.

                        `lg:bleed-x`: the panel is the two-pane view the bleed
                        doctrine's second test is written for — a list beside a
                        record, where every extra pixel is another field on the
                        form. A capped step past both gutters, so the frame reads
                        as the product and not as a figure in the column. */}
                    <div class="mt-block lg:bleed-x animate-on-scroll fade-in-up">
                        <AdminDemoCarousel client:visible height={620} />
                    </div>
                    <div class="mt-block grid grid-cols-1 md:grid-cols-3 border-t border-white/8">
                        <div class="md:border-r border-white/8 py-10 md:pr-8">
                            <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-500">{t("modes.baas.tag")}</p>
                            <h3 class="mt-3 font-headers text-lg">{t("modes.baas.title")}</h3>
                            <p class="mt-2 text-sm text-[#b4b8bd] leading-relaxed">{t("modes.baas.desc")}</p>
                            <p class="mt-4 font-mono text-2xs text-surface-600">@rebasepro/server</p>
                        </div>
                        <div class="md:border-r border-white/8 py-10 md:px-8 border-t md:border-t-0">
                            <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-500">{t("modes.cms.tag")}</p>
                            <h3 class="mt-3 font-headers text-lg">{t("modes.cms.title")}</h3>
                            <p class="mt-2 text-sm text-[#b4b8bd] leading-relaxed">{t("modes.cms.desc")}</p>
                            <p class="mt-4 font-mono text-2xs text-surface-600">@rebasepro/cms</p>
                        </div>
                        <div class="py-10 md:pl-8 border-t md:border-t-0 border-white/8">
                            <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-500">{t("modes.full.tag")}</p>
                            <h3 class="mt-3 font-headers text-lg">{t("modes.full.title")}</h3>
                            <p class="mt-2 text-sm text-[#b4b8bd] leading-relaxed">{t("modes.full.desc")}</p>
                            <p class="mt-4 font-mono text-2xs text-surface-600">@rebasepro/app</p>
                        </div>
                    </div>
                    <a href={translatePath("/cms")} class="accent-link mt-10">
                        {t("showcase.exploreCms")}
                        <ArrowRight size={15} />
                    </a>
                </div>
            </section>
        </div>

        {/* CHAPTER 04 — a HAZARD guarantee.

            Same test as 02, the other side of it. The claim is again the absence
            of an event — "an agent can't screw up" — and again unshowable: the
            console beside it demonstrates what an agent CAN reach, never that it
            failed to do damage. It runs on `ground-raised` rather than a second
            coloured slab: the page spends chroma twice, on 02 and on the close.

            The divider that used to introduce this chapter is gone. A ground
            change is the same gesture, and running both would have two devices
            doing one job. */}
        <div>
            <section class="chapter ground-raised relative border-y border-white/8 py-chapter">
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
                        <div class="lg:col-span-5">
                            <p class="eyebrow">
                                <span class="font-mono">04</span>
                                <span class="mx-2 opacity-40">·</span>{t("agentera.badge")}
                            </p>
                            <h2 class="mt-label font-headers text-display-2 text-balance">
                                {t("agentera.title")}.
                            </h2>
                            <p class="mt-lead leading-relaxed" set:html={t("agentera.p1")}></p>
                            <a href={translatePath("/ai")} class="accent-link mt-10">
                                {t("agentera.link")}
                                <ArrowRight size={15} />
                            </a>
                        </div>
                        {/* Bleeds toward the viewport edge. Boxed into seven of
                            twelve columns the console read as a thumbnail of the
                            product rather than the product; the copy column
                            stays on the shell, so the left edge is unaffected. */}
                        <div class="lg:col-span-7 lg:bleed-right animate-on-scroll fade-in-up delay-100">
                            <AgentConsoleDemo client:visible />
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- CHAPTER 05 — CUSTOMERS. The carousel renders its own eyebrow, title
             and subtitle; wrapping it in a second header duplicated all three.
             It also renders its own `py-28 sm:py-36`, and this wrapper used to
             add `py-24 sm:py-32` on top — 272px of ground above the heading and
             272px below it, against ~128px everywhere else, which is what left
             most of a screen empty between the customers and the close. The
             wrapper keeps only the hairline. -->
        <div class="chapter border-t border-white/8">
            <CaseStudiesCarousel t={t} />
        </div>

        {/* The roadmap used to run here. It is not in SITE-STORY's beat table,
            and it sat between the real customers and the close — a list of
            things that do not exist yet, in the last screen before the ask, on
            a page whose rule is proof over assertion. It still ships on /about,
            where "what are you building next" is the page's own question. */}

        {/* FINAL CTA — the three lanes, as one band, and the page's second and
            last chroma ground.

            It used to run a Neat canvas under a gradient that ended at `#000`,
            so the page faded to pure black at the exact moment it asked for the
            click: the strongest position on the page was its weakest frame. The
            ask is now the loudest thing after the claim, and the reader arrives
            here having seen colour exactly once before.

            The canvas goes with it. That is deliberate rather than a saving —
            the page opens in art and closes in colour, which is a register
            change the reader can feel: atmosphere while you are being
            persuaded, flat colour when you are being asked.

            Ownership (claim 5) is folded in here rather than standing as its own
            beat. A fact about the terms is worth nothing to a reader who has not
            yet decided the product is good, and worth more than any other to one
            who has — which is exactly who is standing here. It is a paragraph
            under the ask, not a chapter before it. */}
        <section class="chapter ground-chroma ground-close relative isolate overflow-hidden" style="--hue: var(--color-chroma-coral)">
            <div class="mx-auto max-w-6xl px-6 lg:px-8 py-chapter">
