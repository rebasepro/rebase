---
import { NeatBackground } from "../NeatBackground";
import CollectionPowerSection from "../CollectionPowerSection.astro";
import RlsCheckReport from "../RlsCheckReport.astro";
import RoadmapSection from "../RoadmapSection.astro";
import ClientLogos from "../ClientLogos.astro";
import CaseStudiesCarousel from "../CaseStudiesCarousel.astro";
import { ApiMiniDemo } from "../demos/ApiMiniDemo";
import { SdkMiniDemo } from "../demos/SdkMiniDemo";
import { RealtimeMiniDemo } from "../demos/RealtimeMiniDemo";
import { RLSEditorDemo } from "../demos/RLSEditorDemo";
import { AdminDemoCarousel } from "../demos/AdminDemoCarousel";
import { AgentConsoleDemo } from "../demos/AgentConsoleDemo";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/ui";
import { ArrowRight, Database, LayoutDashboard, TerminalSquare } from "lucide-react";

// Rendered by the home route, which supplies both; falls back for the dev route.
const { lang: langProp, t: tProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = tProp ?? useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// One source for the command the hero shows and the copy button writes, so
// the two can never drift apart.
const INSTALL_COMMAND = "pnpm dlx @rebasepro/cli init";
const SELFHOST_COMMAND = "docker compose up -d";

---
<div class="isolate text-white">

        <!-- ============================================================
             HERO — Neat is the composition, not the wallpaper.
             The canvas holds the right of the frame at full opacity and the
             type sits in the dark half, so nothing is ever laid over the art.
             ============================================================ -->
        {/* Bottom padding trimmed from pb-40. The hero is ~310px taller than it
            was, and 160px of air under a headline this size reads as the page
            having stopped rather than as breathing room. */}
        {/* Top padding is what buys the CTA row its place above the fold on a
            1440x900 window — the smallest laptop size that still matters here.
            Measured, not guessed: at pt-28 the CTAs landed 42px under. */}
        <section class="relative isolate overflow-hidden flex items-center pt-20 pb-24 sm:pt-20 sm:pb-28">
            <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
                <NeatBackground client:idle randomize={false} />
            </div>
            <!-- A second pass of the same shape, over the type, multiplying at low
                 opacity: the ribbon darkens the letterforms where it crosses them
                 and leaves them alone everywhere else. -->
            <div class="neat-over absolute inset-0 pointer-events-none" aria-hidden="true">
                <NeatBackground client:idle randomize={false} />
            </div>

            {/* The headline is full width and the row beneath it is the split,
                rather than the headline living in one half. At display-1 a
                6-column column gives about seven characters a line: the type
                wrapped to six lines, pushed the terminal down and put both CTAs
                below the fold — big, but not bold. Full width it sets in three,
                and the product artifact stays where SITE-STORY §5 requires it. */}
            <div class="relative w-full mx-auto max-w-6xl px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
                    <div class="lg:col-span-12">
                        <!-- The Postgres mark the old hero carried: it says what the
                             product runs on before the headline has to. -->
                        <span class="inline-flex items-center gap-2 rounded-full border border-surface-700 bg-surface-900/60 px-3 py-1 text-xs font-medium text-surface-400">
                            <img src="/img/postgresql-logo.svg" alt="PostgreSQL" width="432" height="445" class="h-4 w-auto" />
                            {t("hero.badge")}
                        </span>
                        {/* One <h1> with two block spans, not two headings and not
                            four — the copy is two translated sentences, and any
                            finer split would have to guess where a line breaks,
                            which differs per locale. `leading-[1.02]` is gone:
                            `text-display-1` carries its own 0.94, and the two
                            were fighting. */}
                        <h1 class="animate-on-scroll animate-immediate mt-5 font-headers text-display-1 text-balance">
                            <span class="hero-line">{t("hero.title.part1")}</span>
                            <span class="hero-line">{t("hero.title.part2")}</span>
                        </h1>
                    </div>

                    {/* Row two: the argument on the left, the artifact on the
                        right. The sub keeps its 34rem measure from §6 — the
                        headline got wider, the reading line did not. */}
                    <div class="lg:col-span-5">
                        <p class="max-w-[34rem] text-base sm:text-lg leading-relaxed text-[#b4b8bd]">
                            {t("hero.subtitle")}
                        </p>
                        <div class="mt-8 flex flex-wrap items-center gap-3">
                            <a
                                href={translatePath("/demo")}
                                class="inline-flex items-center justify-start gap-2 rounded-lg bg-primary px-6 min-h-(--control-large) text-sm font-semibold text-white transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                            >
                                {t("hero.cta.demo")}
                            </a>
                            <a
                                href={translatePath("/docs")}
                                class="inline-flex items-center justify-start gap-2 rounded-lg border border-white/15 px-6 min-h-(--control-large) text-sm font-semibold text-white transition-colors hover:border-white/35"
                            >
                                {t("cta.button.docs")}
                            </a>
                        </div>
                    </div>

                    <!-- The hero carries a product artifact. SITE-STORY §5 records that
                         the WebGL-plus-type hero was replaced for exactly this reason;
                         dropping it again left the right half of the frame empty. The
                         install command lives here now, once, with its real output. -->
                    <div class="lg:col-span-7">
                        <div class="frame group/term">
                            <div class="frame-head">
                                <span class="h-2 w-2 rounded-full bg-rose-500/70"></span>
                                <span class="h-2 w-2 rounded-full bg-amber-400/70"></span>
                                <span class="h-2 w-2 rounded-full bg-emerald-400/70"></span>
                                <span class="ml-2 truncate">zsh · ~/work</span>
                                {/* The command is the one thing in this frame a reader
                                    actually needs to take away, so it gets a real
                                    button — labelled, always visible, with a state —
                                    rather than an icon that appears on hover. */}
                                <button
                                    type="button"
                                    data-track-copy="hero-terminal"
                                    data-command={INSTALL_COMMAND}
                                    data-copy-done-label={t("copy.command.done")}
                                    class="copy-btn ml-auto inline-flex items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.055] px-2 py-1 font-sans text-2xs font-medium text-surface-400 transition-colors hover:border-white/20 hover:bg-white/[0.09] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                    aria-label={`Copy "${INSTALL_COMMAND}" to the clipboard`}
                                    title="Copy to clipboard"
                                >
                                    <svg data-copy-idle class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                    </svg>
                                    <svg data-copy-done hidden class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20 6 9 17l-5-5"/>
                                    </svg>
                                    <span data-copy-label>{t("copy.command")}</span>
                                </button>
                            </div>
                            {/* A terminal does not reflow a command across two lines. At 390px these
                                lines are wider than the frame, so they scroll sideways instead of
                                wrapping — `$ pnpm dlx @rebasepro/cli init` stays one line, which is
                                the whole point of showing it in a terminal. */}
                            <div class="px-5 py-5 font-mono text-xs sm:text-sm leading-[2] text-surface-300 overflow-x-auto whitespace-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <p><span class="select-none text-surface-500">$</span> <span class="select-all text-white">{INSTALL_COMMAND}</span></p>
                                <p class="text-emerald-400">{t("demo.init")}</p>
                                <p class="text-emerald-400">{t("demo.pull")}</p>
                                <p class="text-emerald-400">{t("demo.dev")}</p>
                                <p class="mt-3 text-surface-500">
                                    API on <span class="text-surface-200">:3001</span> <span class="text-surface-700">·</span> panel on <span class="text-surface-200">:5173</span>
                                </p>
                                <p class="mt-1"><span class="select-none text-surface-500">$</span> <span class="terminal-caret inline-block h-4 w-[7px] translate-y-[2px] bg-primary"></span></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Logo wall — the short beat, straight after the tallest one. -->
        <div class="border-y border-white/5 py-10 sm:py-14">
            <ClientLogos />
        </div>

        <!-- ============================================================
             NEAT DIVIDER → chapter 01. The strip is the real canvas; the
             chapter below inherits its cyan on rules, eyebrow and link.
             ============================================================ -->
        <!-- Neat gradient divider, bled behind the sections either side -->
        <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden"
             style="z-index: -1; height: 600px;">
            <NeatBackground variant="b" client:visible />
        </div>

        <div>
            <CollectionPowerSection index="01" />

            <!-- The bento, with the content kept and the uniform card dropped:
                 hairline cells on one raised plate instead of six floating cards. -->
            <section class="chapter relative bg-surface-900/40 border-y border-white/8 py-24 sm:py-32" style="--hue: var(--color-chroma-yellow)">
                {/* The numeral is decoration only — the mono label below already
                    says "02", so this is aria-hidden and the digit is never read
                    twice. It is absolutely positioned and cropped by the
                    section's own edge, so it adds no height and reads as
                    structure rather than ornament. */}
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="max-w-[42rem] animate-on-scroll fade-in-up">
                        <p class="eyebrow">
                            <span class="font-mono" style="color: var(--hue)">02</span>
                            <span class="mx-2 text-surface-700">·</span>{t("engine.badge")}
                        </p>
                        <h2 class="mt-4 font-headers text-display-2 text-balance">
                            {t("engine.title")}
                        </h2>
                        <p class="mt-4 max-w-[38rem] text-[#b4b8bd] leading-relaxed">{t("engine.subtitle")}</p>
                    </div>

                    <!-- The demos were 232px postage stamps inside a hairline grid.
                         They are the most interesting thing on the page, so they get
                         the room: one wide frame, then two half-width ones. -->
                    <div class="mt-12 animate-on-scroll fade-in-up">
                        <div class="frame">
                            <div class="frame-head">
                                <span class="h-2 w-2 rounded-full bg-rose-500/70"></span>
                                <span class="h-2 w-2 rounded-full bg-amber-400/70"></span>
                                <span class="h-2 w-2 rounded-full bg-emerald-400/70"></span>
                                <span class="ml-2">app.ts — typed from your collections</span>
                                <span class="ml-auto">live · try it</span>
                            </div>
                            <div class="h-[330px] overflow-hidden flex items-center justify-center">
                                <SdkMiniDemo client:visible />
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="animate-on-scroll fade-in-up delay-100">
                            <div class="frame">
                                <div class="frame-head"><span>REST, over every table</span><span class="ml-auto">live · send a request</span></div>
                                <div class="h-[340px] overflow-hidden flex items-center justify-center">
                                    <ApiMiniDemo client:visible />
                                </div>
                            </div>
                        </div>
                        <div class="animate-on-scroll fade-in-up delay-200">
                            <div class="frame">
                                <div class="frame-head"><span>Realtime — LISTEN/NOTIFY</span><span class="ml-auto">live</span></div>
                                <div class="h-[340px] overflow-hidden flex items-center justify-center">
                                    <RealtimeMiniDemo client:visible />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- What is left over is a line of text, not a fourth panel. -->
                    <div class="mt-10 flex flex-wrap items-baseline gap-x-8 gap-y-3 border-t border-white/8 pt-6">
                        <p class="text-sm text-[#b4b8bd] max-w-2xl">
                            Plus auth and roles, S3-compatible storage, scheduled jobs, serverless
                            functions and backups — all against the database you already own, under
                            the same policies.
                        </p>
                        <a href={translatePath("/backend")} class="accent-link ml-auto">
                            {t("engine.link")}
                            <ArrowRight size={15} />
                        </a>
                    </div>
                </div>
            </section>
        </div>

        <!-- ============================================================
             CHAPTER 03 — SECURITY. The one chapter whose accent is the brand
             blue, because it carries the highest-ranked claim.
             ============================================================ -->
        <div>
            {/* CHAPTER 03. This was a solid ultramarine field and it is not any
                more. A flat background over a section the Neat dividers bleed
                through does not sit NEXT TO the art, it replaces it — and this
                is one of the largest regions on the page. The gradients are the
                thing the site is recognised by; a colour field is not worth
                trading them for.

                The chapter still owns its hue, through the numeral, the eyebrow
                and the rule. That was always the part that carried the chapter
                system; the field was the part that cost something. */}
            <section class="chapter relative py-24 sm:py-32" style="--hue: var(--color-chroma-ultramarine)">
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                        <div class="lg:col-span-5">
                            <p class="eyebrow">
                                <span class="font-mono" style="color: var(--color-primary-light)">03</span>
                                <span class="mx-2 text-surface-700">·</span>{t("security.badge")}
                            </p>
                            <h2 class="mt-4 font-headers text-display-2 text-balance">
                                {t("security.title")}
                            </h2>
                            <p class="mt-5 max-w-[38rem] text-[#b4b8bd] leading-relaxed">{t("security.desc")}</p>
                            <div class="mt-8 flex flex-col items-start gap-3">
                                <a href={translatePath("/studio")} class="accent-link">
                                    {t("security.link")}
                                    <ArrowRight size={15} />
                                </a>
                                <!-- The argument behind the demo above. The section
                                     shows RLS being edited; this is why it is generated
                                     rather than hand-written in the first place. -->
                                <a
                                    href={translatePath("/blog/2026-08-23-security-that-does-not-depend-on-remembering")}
                                    class="group inline-flex items-start gap-2.5 text-sm text-surface-400 hover:text-white transition-colors"
                                >
                                    <span class="mt-px inline-flex flex-none items-center rounded px-1.5 py-0.5 text-2xs font-semibold uppercase tracking-wider bg-white/5 text-surface-300 ring-1 ring-white/10">
                                        Blog
                                    </span>
                                    <span class="max-w-[34rem] leading-relaxed group-hover:underline underline-offset-4 decoration-white/30">
                                        {t("security.postLink")}
                                    </span>
                                </a>
                            </div>
                        </div>
                        <div class="lg:col-span-7 animate-on-scroll fade-in-up delay-100">
                            <div class="frame">
                                <div class="frame-head">studio · row-level security</div>
                                <!-- The demo reserves room for a longer policy list than it
                                     shows, which left a tall empty well under the last card. -->
                                <div class="p-4 bg-[#09090b] h-[430px] overflow-hidden">
                                    <RLSEditorDemo client:visible />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </section>
        </div>

        <!-- CHAPTER 04 — MODES. No Neat here, but it still carries the accent:
             an all-grey section between two coloured ones read as a dead zone. -->
        <section class="chapter relative border-y border-white/8 bg-surface-900/30" style="--hue: var(--color-chroma-violet)">
            <div class="relative mx-auto max-w-6xl px-6 lg:px-8 pt-20 pb-4">
                <div class="max-w-[42rem] animate-on-scroll fade-in-up">
                    <p class="eyebrow">
                        <span class="font-mono" style="color: var(--hue)">04</span>
                        <span class="mx-2 text-surface-700">·</span>{t("modes.badge")}
                    </p>
                    <h2 class="mt-4 font-headers text-display-2 text-balance">
                        Take only the half you actually need.
                    </h2>
                    <p class="mt-4 max-w-[38rem] text-[#b4b8bd] leading-relaxed">{t("modes.subtitle")}</p>
                </div>
            </div>
            <div class="mx-auto max-w-6xl px-6 lg:px-8 pb-4">
                <div class="grid grid-cols-1 md:grid-cols-3 border-t border-white/8 mt-10">
                    <div class="md:border-r border-white/8 py-10 md:pr-8">
                        <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-500">{t("modes.baas.tag")}</p>
                        <h3 class="mt-4 font-headers text-xl">{t("modes.baas.title")}</h3>
                        <p class="mt-3 text-sm text-[#b4b8bd] leading-relaxed">{t("modes.baas.desc")}</p>
                        <p class="mt-5 font-mono text-2xs text-surface-600">@rebasepro/server</p>
                    </div>
                    <div class="md:border-r border-white/8 py-10 md:px-8 border-t md:border-t-0">
                        <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-500">{t("modes.cms.tag")}</p>
                        <h3 class="mt-4 font-headers text-xl">{t("modes.cms.title")}</h3>
                        <p class="mt-3 text-sm text-[#b4b8bd] leading-relaxed">{t("modes.cms.desc")}</p>
                        <p class="mt-5 font-mono text-2xs text-surface-600">@rebasepro/admin</p>
                    </div>
                    <div class="py-10 md:pl-8 border-t md:border-t-0 border-white/8">
                        <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-500">{t("modes.full.tag")}</p>
                        <h3 class="mt-4 font-headers text-xl">{t("modes.full.title")}</h3>
                        <p class="mt-3 text-sm text-[#b4b8bd] leading-relaxed">{t("modes.full.desc")}</p>
                        <p class="mt-5 font-mono text-2xs text-surface-600">@rebasepro/app</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- NEAT DIVIDER → chapter 05, gold. -->
        <!-- Neat gradient divider, bled behind the sections either side -->
        <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden"
             style="z-index: -1; height: 600px;">
            <NeatBackground variant="a" client:visible />
        </div>

        <!-- CHAPTER 05 — THE PANEL. -->
        <div>
            {/* No `overflow-hidden` on this one, and no z-0: the gold divider
                above it bleeds THROUGH this section by design (§6), and a clip
                or a new stacking context would cut it off at the seam. The
                numeral is cropped by the section's own top edge anyway, because
                the divider sits behind it. */}
            <section class="chapter relative py-24 sm:py-32" style="--hue: var(--color-chroma-blush)">
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="max-w-[42rem] animate-on-scroll fade-in-up">
                        <p class="eyebrow">
                            <span class="font-mono" style="color: var(--hue)">05</span>
                            <span class="mx-2 text-surface-700">·</span>{t("showcase.sync.badge")}
                        </p>
                        <h2 class="mt-4 font-headers text-display-2 text-balance">
                            {t("showcase.sync.tab1.title")}
                        </h2>
                        <p class="mt-4 max-w-[38rem] text-[#b4b8bd] leading-relaxed">{t("showcase.sync.tab1.desc")}</p>
                    </div>
                    <div class="mt-12 animate-on-scroll fade-in-up">
                        <div class="frame">
                            <AdminDemoCarousel client:visible height={620} />
                        </div>
                    </div>
                    <a href={translatePath("/admin")} class="accent-link mt-8">
                        Explore the admin panel
                        <ArrowRight size={15} />
                    </a>
                </div>
            </section>
        </div>

        {/* CHAPTER 06 — PERSONAS. Prose and hairlines; the only place a person
            appears. It is the sequence's rest bar, so it takes a NEUTRAL numeral
            rather than a hue — but it does take one. Skipping it left the count
            reading 01-05, 07, 08, which is a gap a reader notices and cannot
            explain. Quiet is a different thing from absent. */}
        <section class="chapter relative border-t border-white/8 py-24 sm:py-32" style="--hue: var(--color-surface-700)">
            <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                <p class="eyebrow mb-4">
                    <span class="font-mono">06</span>
                    <span class="mx-2 text-surface-700">·</span>Who touches it
                </p>
                <h2 class="font-headers text-display-2 max-w-xl text-balance">
                    Three people touch this. None of them the same way.
                </h2>
                <div class="mt-12 grid grid-cols-1 md:grid-cols-3 border-t border-white/8">
                    <div class="md:border-r border-white/8 py-9 md:pr-8">
                        <h3 class="text-base font-semibold tracking-tight">The developer who owns the database</h3>
                        <p class="mt-3 text-sm text-[#b4b8bd] leading-relaxed">
                            Writes one collection file and gets a schema, REST, an SDK and policies.
                            Never leaves the editor, and never opens the panel.
                        </p>
                        <a href={translatePath("/backend")} class="accent-link mt-5 !text-surface-300 hover:!text-white">
                            The backend <ArrowRight size={14} />
                        </a>
                    </div>
                    <div class="md:border-r border-white/8 py-9 md:px-8 border-t md:border-t-0">
                        <h3 class="text-base font-semibold tracking-tight">The operator who lives in the panel</h3>
                        <p class="mt-3 text-sm text-[#b4b8bd] leading-relaxed">
                            Fixes a wrong address, refunds an order, moves a card. Did not choose Rebase
                            and will not read its docs — the panel answers to them.
                        </p>
                        <a href={translatePath("/admin")} class="accent-link mt-5 !text-surface-300 hover:!text-white">
                            The admin panel <ArrowRight size={14} />
                        </a>
                    </div>
                    <div class="py-9 md:pl-8 border-t md:border-t-0 border-white/8">
                        <h3 class="text-base font-semibold tracking-tight">The agent holding a scoped key</h3>
                        <p class="mt-3 text-sm text-[#b4b8bd] leading-relaxed">
                            Reads and writes through the same API under the same policies as the humans.
                            A first-class caller, not an integration.
                        </p>
                        <a href={translatePath("/ai")} class="accent-link mt-5 !text-surface-300 hover:!text-white">
                            AI &amp; agents <ArrowRight size={14} />
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- NEAT DIVIDER → chapter 07, violet. -->
        <!-- Neat gradient divider, bled behind the sections either side -->
        <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden"
             style="z-index: -1; height: 600px;">
            <NeatBackground variant="b" client:visible />
        </div>

        <!-- CHAPTER 07 — AGENT. -->
        <div>
            {/* CHAPTER 07. Was a solid coral field; reverted for the same reason
                as 03. The violet divider directly above this section bleeds down
                into it, and a flat background is exactly what stops that art
                arriving. The hue survives in the numeral and the eyebrow. */}
            <section class="chapter relative py-24 sm:py-32" style="--hue: var(--color-chroma-coral)">
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                        <div class="lg:col-span-5">
                            <p class="eyebrow">
                                <span class="font-mono" style="color: var(--hue)">07</span>
                                <span class="mx-2 text-surface-700">·</span>{t("agentera.badge")}
                            </p>
