---
const { lang, t } = Astro.props;

import { useTranslatedPath } from '../../i18n/ui';
import { NeatBackground } from '../../components/NeatBackground';
import HeroConnectionWidget from '../demos/HeroConnectionWidget';
import { SplitLayerDemo } from '../demos/SplitLayerDemo';
import { ApiMiniDemo } from '../demos/ApiMiniDemo';
import { SdkMiniDemo } from '../demos/SdkMiniDemo';
import { RealtimeMiniDemo } from '../demos/RealtimeMiniDemo';

const translatePath = useTranslatedPath(lang);

// Whitespace matters inside <pre>, so every sample lives in frontmatter.

const sdkCode = `<span class="text-surface-500">// generated once by \`rebase generate-sdk\`</span>
<span class="text-primary-light">import type</span> { Database } <span class="text-primary-light">from</span> <span class="text-green-400">"./generated/sdk/database.types"</span>;

<span class="text-primary-light">const</span> client = <span class="text-amber-400">createRebaseClient</span>&lt;Database&gt;({
  <span class="text-blue-300">baseUrl</span>: <span class="text-green-400">"https://api.example.com"</span>,
});

<span class="text-surface-500">// collection names, field names and return types all autocomplete</span>
<span class="text-primary-light">const</span> { data } = <span class="text-primary-light">await</span> client.data.orders
  .<span class="text-amber-400">find</span>({
    <span class="text-blue-300">filter</span>: { status: [<span class="text-green-400">"eq"</span>, <span class="text-green-400">"paid"</span>] },
    <span class="text-blue-300">include</span>: [<span class="text-green-400">"customer"</span>],
    <span class="text-blue-300">limit</span>: <span class="text-orange-300">50</span>,
  });`;

const restCode = `<span class="text-amber-400">GET</span>  /api/data/orders?status=eq.paid&amp;total=gt.100
<span class="text-amber-400">GET</span>  /api/data/orders?or=(status.eq.paid,total.gt.500)
<span class="text-amber-400">GET</span>  /api/data/orders/42?include=customer,items
<span class="text-amber-400">GET</span>  /api/data/customers/7/orders
<span class="text-amber-400">POST</span> /api/data/orders
<span class="text-amber-400">PUT</span>  /api/data/orders/42
<span class="text-amber-400">DEL</span>  /api/data/orders/42`;

const honoCode = `<span class="text-blue-400">import</span> { initializeRebaseBackend } <span class="text-blue-400">from</span> <span class="text-emerald-400">"@rebasepro/server"</span>;
<span class="text-blue-400">import</span> { createPostgresBootstrapper } <span class="text-blue-400">from</span> <span class="text-emerald-400">"@rebasepro/server-postgres"</span>;

<span class="text-blue-400">const</span> backend = <span class="text-blue-400">await</span> <span class="text-amber-400">initializeRebaseBackend</span>({
  server,
  app,
  bootstrappers: [
    <span class="text-amber-400">createPostgresBootstrapper</span>({
      connection: db,
      schema: { tables, enums, relations },
    })
  ],
  auth: { jwtSecret: process.env.<span class="text-amber-400">JWT_SECRET</span> },
  storage: { type: <span class="text-emerald-400">"local"</span>, basePath: <span class="text-emerald-400">"./uploads"</span> },
});
<span class="text-surface-500">// it's a Hono app — mount it, wrap it, add your own middleware</span>`;

const drizzleCode = `<span class="text-surface-500">// one collection, one relation</span>
<span class="text-blue-400">const</span> posts = {
  slug: <span class="text-emerald-400">"posts"</span>,
  properties: { title: { type: <span class="text-emerald-400">"string"</span> } },
  relations: [{
    relationName: <span class="text-emerald-400">"author"</span>,
    target: () =&gt; users,
    cardinality: <span class="text-emerald-400">"one-to-one"</span>
  }]
};

<span class="text-surface-500">// GET /api/data/posts?include=author</span>
<span class="text-surface-500">// → one query via db.query.findMany, not 1 + N</span>`;

const rulesCode = `<span class="text-primary-light">export const</span> <span class="text-white">orders</span> = {
  slug: <span class="text-green-400">"orders"</span>,
  table: <span class="text-green-400">"orders"</span>,

  <span class="text-blue-300">securityRules</span>: [
    <span class="text-surface-500">// customers see their own orders…</span>
    { operation: <span class="text-green-400">"select"</span>, ownerField: <span class="text-green-400">"customer_id"</span> },

    <span class="text-surface-500">// …support can read and update all of them</span>
    { operations: [<span class="text-green-400">"select"</span>, <span class="text-green-400">"update"</span>],
      roles: [<span class="text-green-400">"support"</span>] },
  ],
};`;

const policyCode = `<span class="text-surface-500">-- rebase schema generate → db push</span>
<span class="text-primary-light">ALTER TABLE</span> orders <span class="text-primary-light">ENABLE ROW LEVEL SECURITY</span>;

<span class="text-primary-light">CREATE POLICY</span> orders_select_1f4c9ab <span class="text-primary-light">ON</span> orders
  <span class="text-primary-light">FOR SELECT TO</span> rebase_user
  <span class="text-primary-light">USING</span> (customer_id = <span class="text-amber-400">rebase.uid</span>());

<span class="text-primary-light">CREATE POLICY</span> orders_update_8b02e13 <span class="text-primary-light">ON</span> orders
  <span class="text-primary-light">FOR UPDATE TO</span> rebase_user
  <span class="text-primary-light">USING</span> (<span class="text-amber-400">string_to_array</span>(<span class="text-amber-400">rebase.roles</span>(), <span class="text-green-400">','</span>)
         &amp;&amp; <span class="text-primary-light">ARRAY</span>[<span class="text-green-400">'support'</span>]);

<span class="text-surface-500">-- no policy for INSERT or DELETE:</span>
<span class="text-surface-500">-- nobody can insert or delete. Closed by default.</span>`;

// The routes the server actually mounts. Nothing aspirational in this list.
const routes = [
    { path: "/api/data/:collection", note: "CRUD, filters, sorting, pagination, relation includes, nested subcollections" },
    { path: "/api/auth/*", note: "sign-up, login, refresh, password reset, OAuth, MFA, roles" },
    { path: "/api/storage/*", note: "upload, download, signed access — local, S3-compatible or GCS" },
    { path: "/api/functions/:name", note: "your own Hono routes, auto-mounted from functions/" },
    { path: "/api/cron/*", note: "scheduled jobs with run history and manual triggers" },
    { path: "/api/docs · /api/swagger", note: "OpenAPI 3.0 spec, plus an explorer in dev" },
    { path: "/api/meta", note: "the runtime contract: collections, properties, capabilities" },
    { path: "/health", note: "readiness for your orchestrator — asserts the auth schema, not just TCP" },
    { path: "WebSocket", note: "row subscriptions, broadcast channels and presence on the same server" },
];

const alsoShipped = [
    { title: "Topics and jobs", desc: "Publish an event, subscribe by name. One durable row per subscriber, each retrying on its own schedule — and a publish inside a transaction that rolls back never happened." },
    { title: "Webhooks", desc: "HMAC-signed outbound calls on insert, update and delete, with retries." },
    { title: "Entity history", desc: "An audit trail per collection: who changed what, when, and a revert." },
    { title: "Database branching", desc: "Isolated copies of the whole database for a feature or a test run." },
    { title: "Email", desc: "SMTP for verification, password reset and your own transactional templates." },
    { title: "Backups", desc: "Role-complete dumps and restores, driven from the CLI or the admin API." },
    { title: "Multiple sources", desc: "Route different collections to different databases from one server." },
];
---

<div class="flex flex-col isolate">

    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24 lg:pb-24">
        <NeatBackground client:idle transition:persist="neat-hero" />

        <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
            <div class="inline-flex items-center py-1.5 px-3 mb-6 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10">
                <span class="text-sm font-medium">Hono · Drizzle · PostgreSQL · React-free</span>
            </div>
            <h1 class="mb-6 text-display-2 text-white">
                The backend,<br/>on its own.
            </h1>
            <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl">
                REST, a typed SDK, realtime over WebSocket, auth, storage and an OpenAPI spec — with every access
                rule enforced by the database itself. Point it at your own Postgres, or
                run <code class="font-mono text-surface-200">rebase dev</code> and get one without installing
                anything. No admin panel required. No React in the dependency tree.
            </p>
            <div class="mt-4 max-w-xl">
                <HeroConnectionWidget client:load/>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 01 · THE API APPEARS ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
                <div class="lg:col-span-5">
                    <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                        REST, without writing it
                    </p>
                    <h2 class="text-3xl sm:text-4xl text-white mb-5">
                        Every table you expose becomes an endpoint
                    </h2>
                    <p class="text-base text-surface-400 leading-relaxed mb-4">
                        No controllers, no serializers, no validation middleware. Filtering, sorting, pagination
                        and relation loading are query parameters, in a PostgREST-compatible syntax your team
                        probably already knows.
                    </p>
                    <p class="text-base text-surface-400 leading-relaxed">
                        Nested relations are addressable as paths, so a customer's orders are a URL rather than
                        a join you hand-wrote.
                    </p>
                </div>
                <div class="lg:col-span-7 space-y-5">
                    <div class="rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 shadow-[0_18px_60px_rgba(0,0,0,0.55)]">
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50">
                            <div class="ml-2 text-3xs font-mono text-surface-400">api.yourapp.com</div>
                        </div>
                        <div class="h-[260px] w-full overflow-hidden" inert aria-hidden="true">
                            <ApiMiniDemo client:visible/>
                        </div>
                    </div>
                    <div class="frame overflow-hidden">
                        <div class="px-4 py-3 border-b border-surface-800/80 bg-surface-900/50">
                            <span class="font-mono text-xs text-surface-400">the generated surface</span>
                        </div>
                        <pre class="p-5 overflow-x-auto text-2xs sm:text-xs leading-relaxed font-mono text-surface-300"><code set:html={restCode}></code></pre>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 02 · TYPED SDK ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
                <div class="lg:col-span-5 lg:order-last">
                    <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                        The typed client
                    </p>
                    <h2 class="text-3xl sm:text-4xl text-white mb-5">
                        Autocomplete that comes from your schema
                    </h2>
                    <p class="text-base text-surface-400 leading-relaxed mb-4">
                        <code class="font-mono text-surface-300">rebase generate-sdk</code> turns your collections
                        into a <code class="font-mono text-surface-300">Database</code> type. Pass it to the client and
                        collection names, field names, filter operators and return shapes are all checked at compile
                        time — including the fields you asked for in <code class="font-mono text-surface-300">include</code>.
                    </p>
                    <p class="text-base text-surface-400 leading-relaxed mb-6">
                        Rename a column in the collection and the call sites turn red before anything ships.
                        The repository that consumes the API does not need to be the one that defines
                        it: <code class="font-mono text-surface-300">--from &lt;url&gt;</code> generates the same client
                        from a running backend, in a project with no schema of its own. Your web app, admin and
                        mobile client each stay in their own repo, and CI catches a stale client before a user does.
                    </p>
                    <a href={translatePath("/sdk")}
                       class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                        The full SDK tour
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
                <div class="lg:col-span-7 space-y-5">
                    <div class="rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 shadow-[0_18px_60px_rgba(0,0,0,0.55)]">
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50">
                            <div class="ml-2 text-3xs font-mono text-surface-400">app.ts</div>
                        </div>
                        <div class="h-[260px] w-full flex items-center justify-center overflow-hidden" inert aria-hidden="true">
                            <SdkMiniDemo client:visible/>
                        </div>
                    </div>
                    <div class="frame overflow-hidden">
                        <div class="px-4 py-3 border-b border-surface-800/80 bg-surface-900/50">
                            <span class="font-mono text-xs text-surface-400">src/orders.ts</span>
                        </div>
                        <pre class="p-5 overflow-x-auto text-2xs sm:text-xs leading-relaxed font-mono text-surface-300"><code set:html={sdkCode}></code></pre>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>

    <!-- ═══════════════════════ 03 · REALTIME ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
                <div class="lg:col-span-5">
                    <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                        Realtime
                    </p>
                    <h2 class="text-3xl sm:text-4xl text-white mb-5">
                        Changes arrive, however they were made
                    </h2>
                    <p class="text-base text-surface-400 leading-relaxed mb-4">
                        <code class="font-mono text-surface-300">listen()</code> on any collection and every insert,
                        update and delete lands on the client over WebSocket. Subscriptions respect the same
                        row-level security as a read, so a subscriber is never pushed a row they could not have
                        fetched.
                    </p>
                    <p class="text-base text-surface-400 leading-relaxed">
                        Writes made outside the API count too — a row changed
                        from <code class="font-mono text-surface-300">psql</code>, a cron job or Studio's SQL editor emits
                        the same event, because change capture happens in the database. Across replicas, fan-out
                        rides Postgres <code class="font-mono text-surface-300">LISTEN/NOTIFY</code>.
                    </p>
                </div>
                <div class="lg:col-span-7">
                    <div class="rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 shadow-[0_18px_60px_rgba(0,0,0,0.55)]"
                         inert aria-hidden="true">
                        <RealtimeMiniDemo client:visible/>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 04 · AUTHORIZATION ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="max-w-3xl mb-12 animate-on-scroll fade-in-up">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                    Authorization
                </p>
                <h2 class="text-3xl sm:text-4xl text-white">
                    The rules live in Postgres, not in this server
                </h2>
                <p class="mt-5 text-lg leading-8 text-surface-400">
                    Requests execute as a restricted database role. Your <code class="font-mono text-surface-300">securityRules</code>{" "}
                    compile to real row-level security policies, so a query that should return nothing returns
                    nothing — whether it arrives through the SDK, a REST call, the admin panel, an agent's API key
                    or a psql session. A collection with no policy serves no rows: the default is closed, not open.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
                <div class="frame overflow-hidden flex flex-col">
                    <div class="px-4 py-3 border-b border-surface-800/80 bg-surface-900/50 flex items-center justify-between">
                        <span class="font-mono text-xs text-surface-400">config/collections/orders.ts</span>
                        <span class="text-3xs font-medium px-2 py-0.5 rounded-full bg-surface-800 text-surface-400">what you write</span>
                    </div>
                    <pre class="p-5 overflow-x-auto text-2xs sm:text-xs leading-relaxed font-mono text-surface-300 flex-1"><code set:html={rulesCode}></code></pre>
                </div>

                <div class="rounded-2xl border border-primary/20 bg-surface-950/80 overflow-hidden shadow-[0_10px_30px_rgba(0,0,0,0.45)] flex flex-col relative">
                    <div class="pointer-events-none absolute inset-0" aria-hidden="true"
                         style="background: radial-gradient(500px 260px at 70% 0%, rgba(0,112,244,0.10), transparent 70%);"></div>
                    <div class="relative px-4 py-3 border-b border-surface-800/80 bg-surface-900/50 flex items-center justify-between">
                        <span class="font-mono text-xs text-surface-400">psql — what the database enforces</span>
                        <span class="text-3xs font-medium px-2 py-0.5 rounded-full bg-primary/10 text-primary ring-1 ring-inset ring-primary/20">generated</span>
                    </div>
                    <pre class="relative p-5 overflow-x-auto text-2xs sm:text-xs leading-relaxed font-mono text-surface-300 flex-1"><code set:html={policyCode}></code></pre>
                </div>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
                <a href={translatePath("/security")}
                   class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                    The whole security model
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
                <span class="text-surface-700">·</span>
                <span class="text-sm text-surface-500">
                    Already on Postgres? <code class="font-mono text-surface-400">npx @rebasepro/rls-check $DATABASE_URL</code>{" "}
                    audits it without installing anything.
                </span>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 05 · WHAT'S MOUNTED ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
                <div class="lg:col-span-5">
                    <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                        One server
                    </p>
                    <h2 class="text-3xl sm:text-4xl text-white mb-5">
                        Everything mounted, nothing assembled
                    </h2>
                    <p class="text-base text-surface-400 leading-relaxed mb-4">
                        This is the routing table of a default project — one process, one deployment, no service
                        mesh to draw. Each of these exists because building it yourself is a week you would
                        rather spend elsewhere.
                    </p>
                    <p class="text-base text-surface-400 leading-relaxed mb-6">
                        One process is the default, not the ceiling. The same build also boots as an API, a
                        functions tier and a worker — one variable per process decides which routes mount, which
                        timers fire and which one owns the schema.
                    </p>
                    <div class="space-y-4">
                        {alsoShipped.map(item => (
                                <div class="flex gap-3">
                                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/60"></span>
                                    <p class="text-sm text-surface-400 leading-relaxed">
                                        <span class="text-white">{item.title}.</span> {item.desc}
                                    </p>
                                </div>
                        ))}
                    </div>
                </div>

                <div class="lg:col-span-7">
                    <div class="frame overflow-hidden">
                        <div class="px-4 py-3 flex items-center gap-1.5 border-b border-surface-800/80 bg-surface-900/50">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                            <span class="ml-2 font-mono text-xs text-surface-400">rebase dev — mounted routes</span>
                        </div>
                        <ul class="divide-y divide-surface-800/60">
                            {routes.map(route => (
                                    <li class="px-5 py-4 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-5 hover:bg-surface-900/40 transition-colors">
                                        <code class="font-mono text-xs sm:text-sm text-primary-light shrink-0 sm:w-[15.5rem]">{route.path}</code>
                                        <span class="text-sm text-surface-400 leading-relaxed">{route.note}</span>
                                    </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 06 · HONO + DRIZZLE ═══════════════════════ -->
    <section class="py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="max-w-3xl mb-12 animate-on-scroll fade-in-up">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                    Underneath
                </p>
                <h2 class="text-3xl sm:text-4xl text-white">
                    Boring technology, on purpose
                </h2>
                <p class="mt-5 text-lg leading-8 text-surface-400">
                    A Hono app and a Drizzle schema. Two things your team can read, debug and extend without
                    learning a framework — and without waiting for us to expose a hook.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="frame overflow-hidden flex flex-col">
                    <div class="px-4 py-3 border-b border-surface-800/80 bg-surface-900/50 flex items-center justify-between">
                        <span class="font-mono text-xs text-surface-400">backend/src/index.ts</span>
                        <span class="text-3xs font-medium px-2 py-0.5 rounded-full bg-orange-500/10 text-orange-400 ring-1 ring-inset ring-orange-500/20">Hono</span>
                    </div>
                    <pre class="p-5 overflow-x-auto text-2xs sm:text-xs leading-relaxed font-mono text-surface-300 flex-1"><code set:html={honoCode}></code></pre>
                    <ul class="px-5 pb-5 space-y-2 text-sm text-surface-400">
                        <li class="flex gap-2.5"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Mount it as a sub-app on a server you already run</li>
                        <li class="flex gap-2.5"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Your middleware, your routes, your error handling</li>
                        <li class="flex gap-2.5"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Node, Docker, Railway, Fly.io or bare metal</li>
                    </ul>
                </div>

                <div class="frame overflow-hidden flex flex-col">
                    <div class="px-4 py-3 border-b border-surface-800/80 bg-surface-900/50 flex items-center justify-between">
                        <span class="font-mono text-xs text-surface-400">relations, resolved in one query</span>
                        <span class="text-3xs font-medium px-2 py-0.5 rounded-full bg-green-500/10 text-green-400 ring-1 ring-inset ring-green-500/20">Drizzle</span>
                    </div>
                    <pre class="p-5 overflow-x-auto text-2xs sm:text-xs leading-relaxed font-mono text-surface-300 flex-1"><code set:html={drizzleCode}></code></pre>
                    <ul class="px-5 pb-5 space-y-2 text-sm text-surface-400">
                        <li class="flex gap-2.5"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> One-to-one, one-to-many and many-to-many</li>
                        <li class="flex gap-2.5"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Field selection — fetch the columns you asked for</li>
                        <li class="flex gap-2.5"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Cursor and offset pagination</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 07 · HEADLESS BY DEFAULT ═══════════════════════ -->
    <section class="py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-12">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                    The other half
                </p>
                <h2 class="text-3xl sm:text-4xl text-white">Headless by default</h2>
                <p class="mt-5 text-lg leading-8 text-surface-400">
                    The admin panel is a client of this API, not a layer inside it. It reads through the same policies your app does. Toggle it on below: the project gains one dependency
                    and a nested <code class="font-mono text-surface-300">admin</code> block, a back office appears —
                    and the API response on the right does not move.
                </p>
            </div>
            <SplitLayerDemo client:visible/>
            <div class="mt-10 text-center">
                <a href={translatePath("/cms")}
                   class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
