---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';
import { NeatBackground } from '../../components/NeatBackground';
import HeroConnectionWidget from '../demos/HeroConnectionWidget';




const honoCode = `<span class="text-blue-400">import</span> { initializeRebaseBackend } <span class="text-blue-400">from</span> <span class="text-emerald-400">"@rebasepro/server-core"</span>;
<span class="text-blue-400">import</span> { createPostgresBootstrapper } <span class="text-blue-400">from</span> <span class="text-emerald-400">"@rebasepro/server-postgresql"</span>;

<span class="text-blue-400">const</span> backend = <span class="text-blue-400">await</span> <span class="text-amber-400">initializeRebaseBackend</span>({
  server,
  app,
  bootstrappers: [
    <span class="text-amber-400">createPostgresBootstrapper</span>({
      connection: db,
      schema: { tables, enums, relations },
    })
  ],
  auth: {
    jwtSecret: process.env.<span class="text-amber-400">JWT_SECRET</span>,
  },
  storage: { type: <span class="text-emerald-400">"local"</span>, basePath: <span class="text-emerald-400">"./uploads"</span> },
});
<span class="text-surface-500">// ✅ REST, WebSocket, Auth, Storage — all ready</span>
<span class="text-surface-500">// Data:    /api/data/:collection</span>
<span class="text-surface-500">// Auth:    /api/auth/*</span>
<span class="text-surface-500">// Storage: /api/storage/*</span>`;

const drizzleCode = `<span class="text-surface-500">// Your collection definition:</span>
<span class="text-blue-400">const</span> postsCollection = {
  slug: <span class="text-emerald-400">"posts"</span>,
  properties: { title: { type: <span class="text-emerald-400">"string"</span> } },
  relations: [{
    relationName: <span class="text-emerald-400">"author"</span>,
    target: () =&gt; usersCollection,
    cardinality: <span class="text-emerald-400">"one-to-one"</span>
  }]
};

<span class="text-surface-500">// Generates Drizzle schema + REST API:</span>
<span class="text-amber-400">GET</span> /api/posts?include=author
<span class="text-surface-500">// → Single query, no N+1</span>`;
---

  <div class="flex flex-col isolate">
    <!-- Hero -->
 <section class="relative isolate overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
     <NeatBackground client:idle />

      <div class="px-4 mx-auto max-w-7xl text-center lg:px-12 relative z-10">
        <div class="inline-flex items-center py-1.5 px-3 mb-6 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10 mx-auto">
          <span class="text-sm font-medium">Hono · Drizzle · PostgreSQL</span>
        </div>
        <h1 class="mb-6 text-3xl font-semibold tracking-tight md:text-4xl lg:text-5xl text-white">
          Backend & APIs
        </h1>
        <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48">
          Define your collections in TypeScript. Get a production-ready API server with REST, GraphQL, WebSocket realtime, JWT auth, and auto-generated OpenAPI docs.
        </p>
        <div class="mt-4 max-w-xl mx-auto">
          <HeroConnectionWidget client:load />
        </div>
      </div>
    </section>

    <!-- Architecture Overview -->
 <section class="relative z-0 py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center mb-16">
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">One definition, four APIs</h2>
          <p class="mt-4 text-lg text-surface-400">Every collection you define automatically generates REST, GraphQL, WebSocket, and OpenAPI endpoints. Zero config.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
            <div class="mx-auto h-14 w-14 rounded-full bg-blue-500/10 flex items-center justify-center mb-4">
              
<svg
  class="lucide lucide-globe"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <circle cx="12" cy="12" r="10" />
  <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
  <path d="M2 12h20" />
</svg>

            </div>
            <h3 class="text-lg font-semibold text-white mb-2">REST API</h3>
            <p class="text-sm text-surface-400">Full CRUD endpoints with pagination, filtering, sorting, and relation loading.</p>
          </div>
          <div class="p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
            <div class="mx-auto h-14 w-14 rounded-full bg-pink-500/10 flex items-center justify-center mb-4">
              
<svg
  class="lucide lucide-braces"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1" />
  <path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1" />
</svg>

            </div>
            <h3 class="text-lg font-semibold text-white mb-2">GraphQL</h3>
            <p class="text-sm text-surface-400">Auto-generated schema with queries, mutations, and a built-in GraphiQL IDE.</p>
          </div>
          <div class="p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
            <div class="mx-auto h-14 w-14 rounded-full bg-emerald-500/10 flex items-center justify-center mb-4">
              
<svg
  class="lucide lucide-antenna"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M2 12 7 2" />
  <path d="m7 12 5-10" />
  <path d="m12 12 5-10" />
  <path d="m17 12 5-10" />
  <path d="M4.5 7h15" />
  <path d="M12 16v6" />
</svg>

            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Realtime Engine</h3>
            <p class="text-sm text-surface-400">Data subscriptions, broadcast channels, and presence tracking — with auth, RLS, and auto-reconnect built in.</p>
          </div>
          <div class="p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
            <div class="mx-auto h-14 w-14 rounded-full bg-amber-500/10 flex items-center justify-center mb-4">
              
<svg
  class="lucide lucide-file-text"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" />
  <path d="M14 2v5a1 1 0 0 0 1 1h5" />
  <path d="M10 9H8" />
  <path d="M16 13H8" />
  <path d="M16 17H8" />
</svg>

            </div>
            <h3 class="text-lg font-semibold text-white mb-2">OpenAPI/Swagger</h3>
            <p class="text-sm text-surface-400">Auto-generated OpenAPI 3.0 spec with a built-in Swagger UI for testing.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden" style="z-index: -1; height: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>

    <!-- Hono Server -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-orange-500/10 text-orange-400 ring-1 ring-inset ring-orange-500/20">
              Powered by Hono
            </div>
            <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">Built on Hono</h2>
            <p class="text-lg text-surface-400 mb-6">The Rebase backend is a composable Hono application. Mount it standalone or embed it into your existing app. Add custom middleware, routes, and business logic.</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="text-primary">✓</span> Composable middleware (CORS, secure headers, auth)</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> Mount as a sub-app on your existing Hono server</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> Deploy on Node.js, Docker, Railway, Fly.io, or bare metal</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> SPA static serving built in</li>
            </ul>
          </div>
          <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-900 p-6">
            <pre class="text-sm font-mono overflow-x-auto"><code class="text-surface-300" set:html={honoCode}/></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Drizzle ORM -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="lg:order-last">
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-green-500/10 text-green-400 ring-1 ring-inset ring-green-500/20">
              Zero N+1 Queries
            </div>
            <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">Drizzle Relational Queries</h2>
            <p class="text-lg text-surface-400 mb-6">Collections generate Drizzle ORM schemas with full relation support. The query engine uses <code class="text-sm bg-surface-800 px-1.5 py-0.5 rounded">db.query.findMany</code> with nested includes — zero N+1 queries, maximum performance.</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="text-primary">✓</span> Auto-generated Drizzle schema from collections</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> One-to-one, one-to-many, many-to-many relations</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> Field-level selection (only fetch what you need)</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> Cursor and offset pagination</li>
            </ul>
          </div>
          <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-900 p-6">
            <pre class="text-sm font-mono overflow-x-auto"><code class="text-surface-300" set:html={drizzleCode}/></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Storage & Email -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Batteries Included</h2>
          <p class="mt-4 text-lg text-surface-400">Storage, email, and auth — everything you need for production, built in.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
            
<svg
  class="lucide lucide-hard-drive"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M10 16h.01" />
  <path d="M2.212 11.577a2 2 0 0 0-.212.896V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5.527a2 2 0 0 0-.212-.896L18.55 5.11A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
  <path d="M21.946 12.013H2.054" />
  <path d="M6 16h.01" />
</svg>

            <h3 class="text-lg font-semibold text-white mb-2">File Storage</h3>
            <p class="text-sm text-surface-400">Local, S3-compatible, and GCS/Firebase Storage with multi-backend support. Route different fields to different storage backends.</p>
          </div>
          <div class="p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
            
<svg
  class="lucide lucide-mail"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
  <rect x="2" y="4" width="20" height="16" rx="2" />
</svg>

            <h3 class="text-lg font-semibold text-white mb-2">Email Service</h3>
            <p class="text-sm text-surface-400">Built-in SMTP integration for password reset, email verification, and custom transactional emails.</p>
          </div>
          <div class="p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
            
<svg
  class="lucide lucide-shield-check"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
  <path d="m9 12 2 2 4-4" />
</svg>

            <h3 class="text-lg font-semibold text-white mb-2">JWT Authentication</h3>
            <p class="text-sm text-surface-400">Custom JWT auth with access/refresh tokens, Google OAuth, role-based access control, and session management.</p>
          </div>
          <div class="p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
            
<svg
  class="lucide lucide-git-branch"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M15 6a9 9 0 0 0-9 9V3" />
  <circle cx="18" cy="6" r="3" />
  <circle cx="6" cy="18" r="3" />
</svg>

            <h3 class="text-lg font-semibold text-white mb-2">Database Branching</h3>
            <p class="text-sm text-surface-400">Create instant, isolated copies of your entire database for dev, staging, or testing. Like git branches, but for your data.</p>
          </div>
          <div class="p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
            
<svg
  class="lucide lucide-zap"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />
</svg>

            <h3 class="text-lg font-semibold text-white mb-2">Custom Functions</h3>
            <p class="text-sm text-surface-400">Drop a Hono route file in <code class="text-xs bg-surface-800 px-1 py-0.5 rounded">functions/</code> and it auto-mounts at <code class="text-xs bg-surface-800 px-1 py-0.5 rounded">/api/functions/&lt;name&gt;</code>. Zero config.</p>
          </div>
          <div class="p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
            
<svg
  class="lucide lucide-history"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
  <path d="M3 3v5h5" />
  <path d="M12 7v5l4 2" />
</svg>

            <h3 class="text-lg font-semibold text-white mb-2">Entity History</h3>
            <p class="text-sm text-surface-400">Full audit trail for every data change. Track who changed what, when, and restore previous versions.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
 <section class="py-24 sm:py-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-8">Deploy your backend in minutes</h2>
        <div class="flex items-center justify-center gap-x-6">
          <a href="/developers"
             class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all duration-200 ease-in-out btn-glow">
            Developer Guide
            
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

          </a>
          <a href="/sdk" class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold">
            Client SDK
            
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

          </a>
        </div>
      </div>
    </section>
  </div>

