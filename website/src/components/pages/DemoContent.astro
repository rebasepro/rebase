---
const { lang, t } = Astro.props;
import InteractiveDemo from '../demos/InteractiveDemo';
import ClosingCta from "../ClosingCta.astro";
---

<div class="bg-page-ground text-white min-h-screen">
    <!-- Hero Section -->
 <section class="relative isolate overflow-hidden hero-under-nav pb-12 sm:pb-16 lg:pb-16">

        <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
            <h1 class="mb-4 text-display-2 text-white font-sans">
                {t('demo.page.title')}
            </h1>
            <p class="mb-6 text-base leading-7 text-surface-300 lg:text-lg">
                {t('demo.page.subtitle')}
            </p>
            <!-- The one place demo.rebase.pro is linked: this page is the demo,
                 so its escalation is the full hosted panel rather than itself. -->
            <a href="https://demo.rebase.pro" target="_blank" rel="noopener noreferrer"
               class="accent-link" data-track id="demo-hosted-panel">
                {t("demopage.openPanel")}
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14"/>
                    <path d="m12 5 7 7-7 7"/>
                </svg>
            </a>
        </div>
    </section>

    <!-- Demo Section -->
 <section class="pb-24 relative">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            <div class="relative">
                <InteractiveDemo client:load />
            </div>
        </div>
    </section>

    <ClosingCta title={t("close.demo.title")} blurb={t("close.demo.blurb")} trackId="demo" demoHref="https://demo.rebase.pro" />

</div>
