---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';



import { NeatBackground } from '../../components/NeatBackground';
import { ReactExtMiniDemo } from '../../components/demos/ReactExtMiniDemo.tsx';
import { UIReferenceView } from '@rebasepro/app';



import ClosingCta from "../ClosingCta.astro";
---


  <div>
    <!-- Hero Section -->
 <section class="relative isolate overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
     <NeatBackground client:idle />

      <div class="px-4 mx-auto max-w-7xl text-center lg:px-12 relative z-10">
        <p class="mb-5 text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase">
          <a href="/admin" class="hover:text-primary transition-colors">The admin panel</a>
          <span class="mx-2 text-surface-600">/</span><span class="text-surface-500">Component library</span>
        </p>
        <h1 class="mb-6 text-3xl font-semibold tracking-tight md:text-4xl lg:text-5xl text-white">
          The components<br/><span class="text-primary">the panel is built from.</span>
        </h1>
        <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48">
          <code class="font-mono text-surface-200">@rebasepro/ui</code> is the React library the admin panel renders
          itself with — and the one your custom fields, previews and entity views should use, so an extension looks
          like it belongs rather than like a bolt-on.
        </p>
        <div class="mx-auto max-w-md" inert aria-hidden="true">
          <ReactExtMiniDemo client:visible />
        </div>
      </div>
    </section>

    <!-- Install + pointer to the generated reference.
         The exhaustive per-component gallery that used to sit here is now the
         docs reference under /docs/ui — generated from the library's own types
         and render-verified examples, so it cannot drift from the package the
         way a hand-written gallery does. This page keeps the pitch and the
         real screens below; the reference lives where people look things up
         while building. -->
    <section class="py-16 sm:py-24 border-t border-surface-800">
      <div class="mx-auto max-w-4xl px-6 lg:px-8">
        <div class="grid gap-8 md:grid-cols-2 md:items-center">
          <div>
            <h2 class="text-2xl font-semibold tracking-tight text-white mb-3">Install it</h2>
            <p class="text-surface-400 mb-5">
              Already a dependency of every Rebase admin panel. Add it directly when you are
              building extensions in a separate package.
            </p>
            <pre class="rounded-lg border border-surface-800 bg-surface-950 px-4 py-3 font-mono text-sm text-surface-200 overflow-x-auto"><code>npm install @rebasepro/ui</code></pre>
          </div>
          <div>
            <h2 class="text-2xl font-semibold tracking-tight text-white mb-3">Component reference</h2>
            <p class="text-surface-400 mb-5">
              Every component, with its real prop types and a working example — searchable,
              and generated from the library itself.
            </p>
            <a href="/docs/ui/components/"
               class="inline-flex items-center justify-center gap-x-2 rounded-lg bg-primary border border-transparent px-6 py-0 min-h-(--control-large) text-base font-medium text-white hover:bg-primary-dark transition-colors">
              Browse the components
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>


    <!-- UI Reference View Section -->
 <section class="py-16 sm:py-24 border-t border-surface-800">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 mb-8">
        <h2 class="text-2xl font-semibold tracking-tight text-white mb-2">
          How the panel is composed
        </h2>
        <p class="text-surface-400 text-sm">
          The same components assembled into the screens the admin panel actually ships — drawer, app bar, tabs, management views. Per-component props and examples live in the <a href="/docs/ui/components/" class="text-primary hover:underline">docs reference</a>.
        </p>
      </div>
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="dark rounded-lg border border-surface-800 bg-surface-900" data-theme="dark">
          <UIReferenceView client:only="react" />
        </div>
      </div>
    </section>

  
    <ClosingCta title="Build your own fields on it." blurb="Scaffold a project and drop your React components into the panel wherever the default field isn't enough." trackId="ui" />

</div>


