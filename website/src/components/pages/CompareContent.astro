---
const { lang, t } = Astro.props;

import { NeatBackground } from '../../components/NeatBackground';
import { useTranslatedPath } from '../../i18n/ui';
import { RLSEditorDemo } from '../../components/demos/RLSEditorDemo';

const translatePath = useTranslatedPath(lang);

// Four archetypes, because "what is Rebase like?" has four different honest
// answers depending on which tool the visitor is already holding.
const families = [
    {
        kind: "A backend-as-a-service",
        blurb: "You want APIs, auth and realtime over a database without writing a server.",
        theirModel: "Postgres or a proprietary store, plus a dashboard built for you — the developer — not for the people who run the business.",
        ourModel: "The same APIs, plus an admin panel your non-technical team lives in, generated from the collections you already wrote.",
        tools: [
            { name: "Supabase", href: "/rebase-vs-supabase", logo: "/img/competitors/supabase-logo-wordmark-dark.svg", cls: "h-4" },
            { name: "Firebase", href: "/rebase-vs-firebase", logo: "/img/competitors/firebase-lockup-dark.svg", cls: "h-5" },
            { name: "Hasura", href: "/rebase-vs-hasura", logo: "/img/competitors/hasura-logo-primary-darkbg.svg", cls: "h-4" },
        ],
    },
    {
        kind: "A headless CMS",
        blurb: "You want editors to manage content without touching the database.",
        theirModel: "The CMS owns the schema. Your tables are its tables, in its shape, reachable through its API and its permission engine.",
        ourModel: "Your Postgres schema stays yours — including the tables that existed before Rebase. Access control is RLS on those tables, readable by any Postgres client.",
        tools: [
            { name: "Directus", href: "/rebase-vs-directus", logo: "/img/competitors/directus-logo-light.svg", cls: "h-5" },
            { name: "Strapi", href: "/rebase-vs-strapi", logo: "/img/competitors/strapi-full-logo-light.svg", cls: "h-5" },
            { name: "Payload", href: "/rebase-vs-payload", logo: "/img/competitors/payload-logo-light.svg", cls: "h-5" },
        ],
    },
    {
        kind: "An internal-tool builder",
        blurb: "You want a back office fast and you don't care how it's built.",
        theirModel: "A hosted canvas that connects to your database over a credential you hand it. Screens are drawn by hand, per screen, forever.",
        ourModel: "Screens are generated from the schema, so a new column shows up everywhere at once — and the tool runs on your infrastructure with no outbound connection.",
        tools: [
            { name: "Retool", href: "/rebase-vs-retool", logo: "/img/competitors/Retool_Logo_0.svg", cls: "h-5" },
        ],
    },
    {
        kind: "A framework admin",
        blurb: "You already have a backend and want the batteries-included admin that comes with it.",
        theirModel: "Excellent admin, tied to one language and one ORM. Your React frontend still needs an API you write and maintain by hand.",
        ourModel: "The admin and the typed API come from the same definition, and the API is a first-class product rather than an afterthought.",
        tools: [
            { name: "Django", href: "/rebase-vs-django", logo: "/img/competitors/django-logo-negative.svg", cls: "h-5" },
        ],
    },
];

// The axes where the answers genuinely differ. No feature checklists — every
// product in this market has tables, forms and an API.
const axes = [
    {
        axis: "Where authorization is enforced",
        rebase: "In Postgres. Every request runs as a restricted role under row-level security, generated from your collection definition.",
        others: "In the application layer, by a permission engine in front of the database. Reach the data another way and the rules are gone.",
    },
    {
        axis: "Who owns the schema",
        rebase: "You do. Point Rebase at a database that already exists; it reads your tables and never demands its own shape.",
        others: "Usually the tool. Content types are created through its UI, in its migration format, in tables it manages.",
    },
    {
        axis: "Who the back office is for",
        rebase: "Your team. Roles, media, workflows — and your own React components wherever the generated defaults don't fit.",
        others: "Either the developer (a database dashboard) or the editor (a CMS) — rarely both, and rarely extensible in the framework you already use.",
    },
    {
        axis: "How many copies of your data exist",
        rebase: "One. The panel talks to the same public API as your app, under the same policies. No sync, no mirror, no cache to reconcile.",
        others: "Often two: the source database and the tool's own store, kept in step by a connector you have to watch.",
    },
    {
        axis: "What happens if you stop using it",
        rebase: "The database keeps working — policies, constraints and data exactly where they were. The panel was a dependency you can delete.",
        others: "Depends how deep the tool went into your schema. If it created the tables, leaving means a migration.",
    },
];

const headToHead = [
    { name: "Supabase", href: "/rebase-vs-supabase" },
    { name: "Firebase", href: "/rebase-vs-firebase" },
    { name: "Hasura", href: "/rebase-vs-hasura" },
    { name: "Directus", href: "/rebase-vs-directus" },
    { name: "Strapi", href: "/rebase-vs-strapi" },
    { name: "Payload", href: "/rebase-vs-payload" },
    { name: "Retool", href: "/rebase-vs-retool" },
    { name: "Django", href: "/rebase-vs-django" },
];
import { imgDims } from "../../utils/imageDimensions";
import { ALTERNATIVES_PAGES } from "../../data/alternatives";
import ClosingCta from "../ClosingCta.astro";
---

<div class="flex flex-col isolate">

    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24 lg:pb-24">
        <NeatBackground client:idle transition:persist="neat-hero" />

        <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
            <p class="mb-6 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">Compare</p>
            <h1 class="mb-6 text-display-2 text-white">
                Rebase, next to<br/>the tool you already use.
            </h1>
            <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl">
                Most of these products are good. They are also solving a different problem than we are.
                Below: what actually differs, which tool wins in which situation, and the cases where
                you should not pick Rebase.
            </p>
        </div>
    </section>

    <!-- ═══════════════════════ FOUR FAMILIES ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="max-w-3xl mb-14 animate-on-scroll fade-in-up">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">Start here</p>
                <h2 class="text-3xl sm:text-4xl text-white">
                    What are you actually shopping for?
                </h2>
                <p class="mt-5 text-lg leading-8 text-surface-400">
                    Rebase sits across four categories, which is why one-line comparisons never land.
                    Find the row that matches what is open in your other tab.
                </p>
            </div>

            <div class="space-y-4">
                {families.map((family, i) => (
                        <div class="group relative overflow-hidden rounded-2xl border border-surface-800/80 bg-surface-950/60 animate-on-scroll fade-in-up">
                            <div class="grid grid-cols-1 lg:grid-cols-12">
                                <!-- Left: the archetype -->
                                <div class="lg:col-span-4 p-7 lg:border-r border-surface-800/80">
                                    <p class="font-mono text-xs text-surface-600 mb-2">0{i + 1}</p>
                                    <h3 class="text-xl font-semibold text-white mb-2">{family.kind}</h3>
                                    <p class="text-sm text-surface-400 leading-relaxed">{family.blurb}</p>
                                    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
                                        {family.tools.map(tool => (
                                                <a href={translatePath(tool.href)}
                                                   aria-label={`Rebase vs ${tool.name}`}
                                                   class="inline-flex items-center gap-2 opacity-60 hover:opacity-100 transition-opacity">
                                                    <img src={tool.logo} {...imgDims(tool.logo)} alt={tool.name} class={`${tool.cls} w-auto`}/>
                                                </a>
                                        ))}
                                    </div>
                                </div>

                                <!-- Middle: how they model it -->
                                <div class="lg:col-span-4 p-7 lg:border-r border-surface-800/80">
                                    <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-surface-500 mb-3">
                                        How they model it
                                    </p>
                                    <p class="text-sm text-surface-400 leading-relaxed">{family.theirModel}</p>
                                </div>

                                <!-- Right: how we model it -->
                                <div class="lg:col-span-4 p-7 relative">
                                    <div class="pointer-events-none absolute inset-0"
                                         aria-hidden="true"
                                         style="background: radial-gradient(420px 220px at 80% 0%, rgba(0,112,244,0.10), transparent 70%);"></div>
                                    <div class="relative">
                                        <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-surface-500 mb-3">
                                            How Rebase models it
                                        </p>
                                        <p class="text-sm text-surface-300 leading-relaxed">{family.ourModel}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                ))}
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
                <span class="text-surface-500">Head to head:</span>
                {headToHead.map(link => (
                        <a href={translatePath(link.href)}
                           class="text-primary hover:underline">Rebase vs {link.name}</a>
                ))}
            </div>
        </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>

    <!-- ═══════════════════════ THE FIVE AXES ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="max-w-3xl mb-12 animate-on-scroll fade-in-up">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">The real differences</p>
                <h2 class="text-3xl sm:text-4xl text-white">
                    Five questions, not a feature checklist
                </h2>
                <p class="mt-5 text-lg leading-8 text-surface-400">
                    Everything in this market has tables, forms and an API. These are the five answers
                    that change what your system looks like in two years.
                </p>
            </div>

            <div class="overflow-hidden rounded-2xl border border-surface-800/80 bg-surface-950/60">
                <div class="hidden md:grid grid-cols-12 border-b border-surface-800/80 bg-surface-900/40">
                    <p class="col-span-3 px-6 py-3 text-2xs font-semibold uppercase tracking-[0.18em] text-surface-500">The question</p>
                    <p class="col-span-4 px-6 py-3 text-2xs font-semibold uppercase tracking-[0.18em] text-surface-500">Most of the category</p>
                    <p class="col-span-5 px-6 py-3 text-2xs font-semibold uppercase tracking-[0.18em] text-surface-500">Rebase</p>
                </div>
                {axes.map((row, i) => (
                        <div class={`grid grid-cols-1 md:grid-cols-12 ${i > 0 ? "border-t border-surface-800/60" : ""}`}>
                            <div class="md:col-span-3 px-6 pt-5 pb-2 md:py-5">
                                <p class="text-sm font-semibold text-white">{row.axis}</p>
                            </div>
                            <div class="md:col-span-4 px-6 py-3 md:py-5 md:border-l border-surface-800/60">
                                <p class="text-sm text-surface-500 leading-relaxed">{row.others}</p>
                            </div>
                            <div class="md:col-span-5 px-6 pt-3 pb-5 md:py-5 md:border-l border-surface-800/60 bg-primary/[0.03]">
                                <p class="text-sm text-surface-300 leading-relaxed">{row.rebase}</p>
                            </div>
                        </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ THE PROOF ═══════════════════════ -->
    <section class="py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
                <div class="lg:col-span-4">
                    <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">Row one, in practice</p>
                    <h2 class="text-3xl sm:text-4xl text-white mb-5">
                        Policies are a file, not a setting
                    </h2>
                    <p class="text-base text-surface-400 leading-relaxed mb-4">
                        The first row of that table is the one that matters most, so here it is as a screen
                        rather than a claim. Access rules live next to the collection that owns them, compile
                        to real Postgres policies, and the editor tells you when the database and the code
                        have drifted apart.
                    </p>
                    <p class="text-base text-surface-400 leading-relaxed mb-6">
                        A tool that enforces permissions in its own middleware cannot show you this screen,
                        because the rules are not in the database to be shown.
                    </p>
                    <a href={translatePath("/security")}
                       class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                        How the security model works
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
                <div class="lg:col-span-8">
                    <div class="rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 shadow-[0_24px_80px_rgba(0,0,0,0.65)]">
                        <RLSEditorDemo client:visible/>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ WHEN NOT TO PICK US ═══════════════════════ -->
    <section class="py-16 sm:py-24">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
            <div class="rounded-2xl border border-surface-700/80 bg-surface-900/40 p-8 sm:p-12 animate-on-scroll fade-in-up">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">The honest part</p>
                <h2 class="text-2xl sm:text-3xl text-white mb-6">
                    Four times you should not pick Rebase
                </h2>
                <ul class="space-y-5 text-surface-400 leading-relaxed">
                    <li class="flex gap-4">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-surface-600"></span>
                        <span><span class="text-white">You are not on Postgres and don't intend to be.</span>{" "}
                            The whole security model is Postgres row-level security. On MySQL or Mongo, none of
                            the interesting part applies.</span>
                    </li>
                    <li class="flex gap-4">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-surface-600"></span>
                        <span><span class="text-white">You need a support contract today.</span>{" "}
                            Rebase Cloud is in private beta — it runs real tenants and opens in batches, so the
                            answer to "can I start on Monday" may be no. Self-hosted, this is software you run:
                            Docker, Railway, Fly.io or your own metal. If you need someone else on call this
                            quarter, a hosted competitor is the right answer.</span>
                    </li>
                    <li class="flex gap-4">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-surface-600"></span>
                        <span><span class="text-white">You need a marketing-website CMS.</span>{" "}
                            Page builders, visual layout and publishing workflows are what a content platform is
                            for. Rebase manages application data, not landing pages.</span>
                    </li>
                    <li class="flex gap-4">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-surface-600"></span>
                        <span><span class="text-white">You want to draw every screen by hand.</span>{" "}
                            Rebase generates the back office from your schema and lets you replace pieces with your
                            own React. If the point is a bespoke canvas per screen, an internal-tool builder will
                            feel better.</span>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ CTA ═══════════════════════ -->
    <section class="relative z-0 py-24 sm:py-32">
        <div class="mx-auto max-w-6xl px-6 lg:px-8 text-center">
            <h2 class="text-3xl sm:text-4xl text-white mb-4">
                Easier to try than to compare
            </h2>
            <p class="text-lg text-surface-400 mb-10 max-w-2xl mx-auto">
                The live demo is a real Rebase backend with its generated panel on top. No signup.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="https://demo.rebase.pro" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center justify-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all btn-glow"
                   data-track id="compare-cta-demo">
                    See the live demo
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
                <a href={translatePath("/product")}
                   class="inline-flex items-center justify-center gap-x-2 rounded-lg border border-surface-700 bg-surface-800 px-6 py-3 text-base font-semibold text-white hover:bg-surface-700 transition-all"
                   data-track id="compare-cta-product">
                    See what you get
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Round-ups.
         The head-to-heads above only work on somebody who already knows our
         name. These are the pages for the much larger group who do not: they
         start from the incumbent and the reason for leaving it, and Rebase is
         one entry among several. Generated from the same data as the pages
         themselves, so this list cannot advertise one that is not built. -->
    <section class="py-16 sm:py-24 border-t border-surface-900/60">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <h2 class="text-2xl sm:text-3xl font-semibold text-white mb-3">Or start from what you are replacing</h2>
            <p class="text-surface-400 mb-10 leading-relaxed max-w-2xl">
                Round-ups of the whole field around each incumbent — what else is out there, what each one is
                actually good at, and which to pick for the specific reason you are looking. Several of the
                recommendations are not us.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {ALTERNATIVES_PAGES.map((page) => (
                    <a href={translatePath(`/alternatives/${page.slug}`)}
                       class="frame group p-6 transition-colors hover:border-primary/30">
                        <h3 class="text-white font-semibold mb-2 flex items-center justify-between gap-2">
                            <span>{page.name} alternatives</span>
                            <span class="text-surface-600 group-hover:text-primary-light transition-colors">&rarr;</span>
                        </h3>
                        <p class="text-sm text-surface-400 leading-relaxed">
                            {page.alternatives.length} options, ordered by the reason you are leaving.
                        </p>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <ClosingCta title="Compare it on your own database." blurb="The only honest comparison is the one you run yourself. Point Rebase at a Postgres database you already have." trackId="compare" />

</div>
