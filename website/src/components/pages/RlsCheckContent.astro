---
const { lang, t } = Astro.props;
/**
 * The landing page for `@rebasepro/rls-check`.
 *
 * ── Why this page did not exist and had to ───────────────────────────────────
 * The tool is real, published, free, and needs no account — and its only
 * presence on this site was a terminal mock-up on the home page and a reference
 * page buried in the docs sidebar. The docs page is written for somebody who has
 * already decided to run it. Nothing was written for the person who has not
 * heard of it and is searching "check my Supabase RLS", which is the largest
 * group by a distance and the one closest to the ICP's number-one stated pain.
 *
 * It is also the cheapest credibility this project has. Every other page here
 * asks a developer to adopt a backend; this one hands them something useful in
 * one command, with nothing to install, no account, and no data leaving their
 * machine — and the thing it is useful at is precisely what Rebase claims to be
 * good at. If the audit is good, the claim is evidenced rather than asserted.
 *
 * ── The check catalogue is the body of the page, deliberately ────────────────
 * Fifteen named failures, each with the id the tool prints. Those ids are the
 * queries — "view bypasses RLS", "security definer search_path", "RLS enabled
 * no policies" — and each one is a question somebody types at the exact moment
 * they are worried. They come from `src/data/rls-checks.ts`, which is copied
 * from the tool's source rather than written here, so the page and the terminal
 * cannot describe the same check differently.
 */
import { RLS_CHECKS, SEVERITY_LABEL } from "../../data/rls-checks";
import RlsCheckReport from "../RlsCheckReport.astro";
import ComparisonFaq from "../ComparisonFaq.astro";
import ClosingCta from "../ClosingCta.astro";

// No connection string in the command: npm echoes its own command line before
// the program starts, and the shell records it, so an argument carries the
// password into two places rls-check cannot redact. `$DATABASE_URL` is not a
// fix — the shell expands it first. With no argument the tool reads
// DATABASE_URL, POSTGRES_URL, then a .env in the working directory.
const COMMAND = "npx @rebasepro/rls-check";
const PAGE_URL = "https://rebase.pro/rls-check";
const SOURCE_URL = "https://github.com/rebasepro/rebase/tree/main/packages/rls-check";
const NPM_URL = "https://www.npmjs.com/package/@rebasepro/rls-check";

// The output formats the terminal report does not show. Each command is one the
// tool's --help prints; the copy for each is in i18n (rlscheckpage.more.*).
const OUTPUTS = [
    { key: "html", command: "npx @rebasepro/rls-check --html rls-report.html" },
    { key: "agent", command: "npx @rebasepro/rls-check --format agent" },
    { key: "json", command: "npx @rebasepro/rls-check --json > rls-report.json" }
] as const;

// The same step the docs give under "In CI" (/docs/rls-check#in-ci). A string,
// because `${{ … }}` is not something an Astro template can hold literally.
const CI_YAML = `- name: Audit RLS
  run: npx @rebasepro/rls-check --fail-on high
  env:
    DATABASE_URL: \${{ secrets.DATABASE_URL }}`;

const bySeverity = (["critical", "high", "medium"] as const).map((severity) => ({
    severity,
    checks: RLS_CHECKS.filter((check) => check.severity === severity)
}));

const SEVERITY_STYLE: Record<string, string> = {
    critical: "text-rose-400 border-rose-500/25 bg-rose-500/10",
    high: "text-amber-300 border-amber-400/25 bg-amber-400/10",
    medium: "text-tone-300 border-tone-600 bg-tone-800/60"
};

// i18n KEYS, not sentences: ComparisonFaq resolves them per locale.
const faqs = [
    { q: "rlscheck.faq.safe.q", a: "rlscheck.faq.safe.a" },
    { q: "rlscheck.faq.rebase.q", a: "rlscheck.faq.rebase.a" },
    { q: "rlscheck.faq.role.q", a: "rlscheck.faq.role.a" },
    { q: "rlscheck.faq.linter.q", a: "rlscheck.faq.linter.a" },
    { q: "rlscheck.faq.ci.q", a: "rlscheck.faq.ci.a" },
    { q: "rlscheck.faq.why.q", a: "rlscheck.faq.why.a" }
];

const appSchema = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${PAGE_URL}#tool`,
    name: "@rebasepro/rls-check",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux, macOS, Windows",
    description:
        "A read-only Row-Level Security audit for any PostgreSQL database. Fifteen checks for the "
        + "failures that make Postgres leak in practice. One command, no account, no install.",
    url: PAGE_URL,
    downloadUrl: "https://www.npmjs.com/package/@rebasepro/rls-check",
    softwareHelp: "https://rebase.pro/docs/rls-check",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: RLS_CHECKS.map((check) => check.title)
};
import HeroBackdrop from "../HeroBackdrop.astro";
---

<div class="drafted-page flex flex-col isolate">
    <!-- Hero -->
    <section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24">
        <HeroBackdrop />

        <div class="mx-auto relative z-10 max-w-6xl px-6 lg:px-8">
            <span class="hero-badge">{t("rlscheckpage.00")}</span>
            <h1 class="mt-5 mb-6 text-display-2 text-tone-max">{t("rlscheckpage.01")}</h1>
            <p class="text-lg leading-8 text-tone-300 lg:text-xl max-w-3xl">{t("rlscheckpage.02")}</p>

            <div class="mt-10 group relative max-w-2xl">
                <div class="relative rounded-xl bg-tone-900/80 border border-tone-700/80 overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                    <div class="px-5 py-4 flex items-center justify-between gap-4">
                        <div class="font-mono text-xs sm:text-sm flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                            <span class="text-primary-light mr-3">~</span>
                            <span class="text-tone-max">{COMMAND}</span>
                        </div>
                        <button data-track-copy="rls-check-hero" data-command={COMMAND}
                                class="copy-btn shrink-0 text-tone-500 hover:text-tone-max transition-colors"
                                aria-label="Copy command" title="Copy to clipboard">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- The trust block. A stranger is about to point a binary at their
                 production database; the three things they need to know come
                 before anything persuasive. -->
            <dl class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6">
                <div>
                    <dt class="text-tone-max font-semibold text-sm mb-1">{t("rlscheckpage.trust.readonly")}</dt>
                    <dd class="text-sm text-tone-400 leading-relaxed">{t("rlscheckpage.07")}</dd>
                </div>
                <div>
                    <dt class="text-tone-max font-semibold text-sm mb-1">{t("rlscheckpage.08")}</dt>
                    <dd class="text-sm text-tone-400 leading-relaxed">{t("rlscheckpage.09")}</dd>
                </div>
                <div>
                    <dt class="text-tone-max font-semibold text-sm mb-1">{t("rlscheckpage.10")}</dt>
                    <dd class="text-sm text-tone-400 leading-relaxed">{t("rlscheckpage.11")}</dd>
                </div>
            </dl>

            <!-- A stranger deciding whether to trust a binary with production
                 credentials should be one click from every query it runs. -->
            <p class="mt-8 text-sm text-tone-400">
                {t("rlscheckpage.source")}
                <a href={SOURCE_URL} target="_blank" rel="noopener"
                   class="ml-1 text-primary-light hover:text-tone-max underline underline-offset-2">{t("rlscheckpage.source.github")}</a>
                <span class="text-tone-600 mx-1.5" aria-hidden="true">·</span>
                <a href={NPM_URL} target="_blank" rel="noopener"
                   class="text-primary-light hover:text-tone-max underline underline-offset-2">{t("rlscheckpage.source.npm")}</a>
            </p>
        </div>
    </section>

    <!-- What it finds -->
    <section class="relative z-0 py-chapter border-t border-tone-900/60">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
            <h2 class="text-2xl sm:text-3xl text-tone-max mb-3">{t("rlscheckpage.03")}</h2>
            <p class="text-tone-400 mb-12 leading-relaxed max-w-2xl">{t("rlscheckpage.04")}</p>

            {bySeverity.map(({ severity, checks }) => (
                <div class="mb-12 last:mb-0">
                    <div class="flex items-center gap-3 mb-5">
                        <span class={`inline-flex items-center px-2.5 py-1 rounded-full border text-2xs font-semibold uppercase tracking-wider ${SEVERITY_STYLE[severity]}`}>
                            {SEVERITY_LABEL[severity]}
                        </span>
                        <span class="text-tone-600 text-sm">{checks.length} check{checks.length === 1 ? "" : "s"}</span>
                    </div>

                    <div class="space-y-3">
                        {checks.map((check) => (
                            <div class="frame p-6" id={check.id}>
                                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                                    <h3 class="text-tone-max leading-snug">{check.title}</h3>
                                    <code class="flex-none font-mono text-2xs text-tone-500">{check.id}</code>
                                </div>
                                <p class="text-sm text-tone-400 leading-relaxed">{check.description}</p>
                                <a href={`/docs/rls-check#${check.id}`}
                                   class="mt-3 inline-block text-sm text-primary-light hover:text-tone-max underline underline-offset-2">
                                    {t("rlscheck.link.fix")}
                                </a>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- What it looks like -->
    <section class="relative z-0 py-chapter border-t border-tone-900/60">
        <div class="mx-auto max-w-5xl px-6 lg:px-8">
            <h2 class="text-2xl sm:text-3xl text-tone-max mb-3">{t("rlscheckpage.05")}</h2>
            <p class="text-tone-400 mb-10 leading-relaxed max-w-2xl">{t("rlscheckpage.06")}</p>
            <RlsCheckReport />
        </div>
    </section>

    <!-- Other shapes of the same scan -->
    <section class="relative z-0 py-chapter border-t border-tone-900/60">
        <div class="mx-auto max-w-5xl px-6 lg:px-8">
            <h2 class="text-2xl sm:text-3xl text-tone-max mb-3">{t("rlscheckpage.more.title")}</h2>
            <p class="text-tone-400 mb-10 leading-relaxed max-w-2xl">{t("rlscheckpage.more.lede")}</p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {OUTPUTS.map(({ key, command }) => (
                    <div class="frame p-6 flex flex-col">
                        <h3 class="text-tone-max leading-snug mb-2">{t(`rlscheckpage.more.${key}.title`)}</h3>
                        <p class="text-sm text-tone-400 leading-relaxed mb-5">{t(`rlscheckpage.more.${key}.body`)}</p>
                        <!-- The flag is the point of each card, so the command wraps
                             at its spaces rather than scrolling the flag out of view. -->
                        <div class="mt-auto self-stretch flex items-start justify-between gap-3 rounded-lg bg-tone-900/80 border border-tone-700/80 px-3 py-2.5">
                            <code class="font-mono text-2xs leading-relaxed text-tone-200 min-w-0">{command.split(" ").map((word, i) => (
                                <>{i > 0 && " "}<span class="whitespace-nowrap">{word}</span></>
                            ))}</code>
                            <button data-track-copy={`rls-check-${key}`} data-command={command}
                                    class="copy-btn shrink-0 text-tone-500 hover:text-tone-max transition-colors"
                                    aria-label={`Copy ${command}`} title="Copy to clipboard">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- CI: the FAQ said "yes"; this is the step to paste -->
    <section class="relative z-0 py-chapter border-t border-tone-900/60">
        <div class="mx-auto max-w-5xl px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
            <div>
                <h2 class="text-2xl sm:text-3xl text-tone-max mb-3">{t("rlscheckpage.ci.title")}</h2>
                <p class="text-tone-400 leading-relaxed mb-5">{t("rlscheckpage.ci.lede")}</p>
                <a href="/docs/rls-check#in-ci"
                   class="text-sm text-primary-light hover:text-tone-max underline underline-offset-2">{t("rlscheckpage.ci.docs")}</a>
            </div>
            <div class="rounded-2xl overflow-hidden ring-1 ring-tone-max/10 bg-[#09090b] island-dark">
                <div class="px-4 py-2.5 border-b border-tone-max/5 flex items-center justify-between gap-2 bg-tone-900/50">
                    <span class="text-xs font-mono text-tone-500">.github/workflows/ci.yml</span>
                    <button data-track-copy="rls-check-ci" data-command={CI_YAML}
                            class="copy-btn shrink-0 text-tone-500 hover:text-tone-max transition-colors"
                            aria-label="Copy the CI step" title="Copy to clipboard">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" aria-hidden="true">
                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                        </svg>
                    </button>
                </div>
                <pre class="p-5 overflow-x-auto font-mono text-xs leading-[1.7] text-tone-300">{CI_YAML}</pre>
            </div>
        </div>
    </section>

    <ComparisonFaq competitor="rls-check" heading={t("rlscheckpage.faq.heading")} faqs={faqs} pageUrl={PAGE_URL} />

    <ClosingCta
        title={t("close.rlscheck.title")}
        blurb={t("close.rlscheck.blurb")}
        trackId="rls-check"
    />
</div>

<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
