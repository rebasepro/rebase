---
/**
 * The landing page for `@rebasepro/rls-check`.
 *
 * ── Why this page did not exist and had to ───────────────────────────────────
 * The tool is real, published, free, and needs no account — and its only
 * presence on this site was a terminal mock-up on the home page and a reference
 * page buried in the docs sidebar. The docs page is written for somebody who has
 * already decided to run it. Nothing was written for the person who has not
 * heard of it and is searching "check my Supabase RLS", which is the largest
 * group by a distance and the one closest to the ICP's number-one stated pain.
 *
 * It is also the cheapest credibility this project has. Every other page here
 * asks a developer to adopt a backend; this one hands them something useful in
 * one command, with nothing to install, no account, and no data leaving their
 * machine — and the thing it is useful at is precisely what Rebase claims to be
 * good at. If the audit is good, the claim is evidenced rather than asserted.
 *
 * ── The check catalogue is the body of the page, deliberately ────────────────
 * Fourteen named failures, each with the id the tool prints. Those ids are the
 * queries — "view bypasses RLS", "security definer search_path", "RLS enabled
 * no policies" — and each one is a question somebody types at the exact moment
 * they are worried. They come from `src/data/rls-checks.ts`, which is copied
 * from the tool's source rather than written here, so the page and the terminal
 * cannot describe the same check differently.
 */
import { RLS_CHECKS, SEVERITY_LABEL } from "../../data/rls-checks";
import RlsCheckReport from "../RlsCheckReport.astro";
import ComparisonFaq from "../ComparisonFaq.astro";
import ClosingCta from "../ClosingCta.astro";

const COMMAND = 'npx @rebasepro/rls-check "postgresql://user:pass@host:5432/db"';
const PAGE_URL = "https://rebase.pro/rls-check";

const bySeverity = (["critical", "high", "medium"] as const).map((severity) => ({
    severity,
    checks: RLS_CHECKS.filter((check) => check.severity === severity)
}));

const SEVERITY_STYLE: Record<string, string> = {
    critical: "text-rose-400 border-rose-500/25 bg-rose-500/10",
    high: "text-amber-300 border-amber-400/25 bg-amber-400/10",
    medium: "text-surface-300 border-surface-600 bg-surface-800/60"
};

const faqs = [
    {
        q: "Is it safe to run against a production database?",
        a: "It is read-only, and narrowly so. It issues SELECTs against the system catalogues — pg_class, pg_policies, pg_proc, information_schema — and nothing else. It never reads your data, writes nothing, changes no setting, and makes no network request beyond the connection string you give it. There is no telemetry and no upload."
    },
    {
        q: "Do I need to be using Rebase?",
        a: "No. It knows nothing about your framework and asks nothing of your codebase — it reads the database. It works against Supabase, Neon, RDS, Cloud SQL, a container on your laptop, or anything else that speaks the Postgres wire protocol. Most people who run it are not Rebase users."
    },
    {
        q: "What does it need to connect as?",
        a: "A role that can read the catalogues — usually a superuser, the table owner, or something with BYPASSRLS. That is deliberate and the report says so at the top: the scan reads the true catalogue precisely because row-level security cannot constrain it, so the findings describe what *other* roles experience, not what this connection does."
    },
    {
        q: "How is this different from Supabase's own linter?",
        a: "There is real overlap on the obvious cases, and both are worth running. The checks here that tend not to appear elsewhere are the indirect ones: a view or materialized view reading past its base table's RLS because it runs as its owner, a many-to-many join table left unprotected between two protected endpoints, and a bare column inside an EXISTS subquery that Postgres binds to the inner table — which turns a tenant filter into a tautology while looking completely correct."
    },
    {
        q: "Can I run it in CI?",
        a: "Yes — that is the intended home for it. It exits non-zero when findings at or above a threshold you choose are present, emits JSON for machine consumption, and supports skipping individual checks by id so a deliberate exception does not fail every build. The ids are a stable public API for exactly this reason."
    },
    {
        q: "Why is a backend company giving away a security scanner?",
        a: "Because the argument Rebase makes is that authorization belongs in the database rather than in the layer in front of it, and a tool that audits Postgres RLS is that argument in a form you can run against your own data instead of read. It is genuinely useful whether or not you ever look at the rest of this site — and if it finds nothing, that is a good afternoon and you owe us nothing."
    }
];

const appSchema = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${PAGE_URL}#tool`,
    name: "@rebasepro/rls-check",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux, macOS, Windows",
    description:
        "A read-only Row-Level Security audit for any PostgreSQL database. Fourteen checks for the "
        + "failures that make Postgres leak in practice. One command, no account, no install.",
    url: PAGE_URL,
    downloadUrl: "https://www.npmjs.com/package/@rebasepro/rls-check",
    softwareHelp: "https://rebase.pro/docs/rls-check",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: RLS_CHECKS.map((check) => check.title)
};
---

<div class="flex flex-col isolate">
    <!-- Hero -->
    <section class="relative isolate overflow-hidden pt-24 pb-16 sm:pt-32 lg:pt-40">
        <div
            class="absolute inset-0 pointer-events-none"
            aria-hidden="true"
            style="background: radial-gradient(circle at 50% -10%, rgba(0, 112, 244, 0.12) 0%, transparent 60%);"
        ></div>

        <div class="px-6 mx-auto max-w-4xl lg:px-8 relative z-10">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-surface-700 bg-surface-900/60 text-xs font-medium text-surface-400 uppercase tracking-wider">
                Free tool · no account
            </span>
            <h1 class="mt-5 mb-6 text-display-2 text-white">
                Audit row-level security on any Postgres
            </h1>
            <p class="text-lg leading-8 text-surface-300 lg:text-xl max-w-3xl">
                Fourteen checks for the failures that make a Postgres database leak in practice — not the ones
                that are easy to check for. Works on Supabase, Neon, RDS, Cloud SQL, or a container on your
                laptop. One command, nothing to install, nothing to sign up for.
            </p>

            <div class="mt-10 group relative max-w-2xl">
                <div class="relative rounded-xl bg-surface-900/80 border border-surface-700/80 overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                    <div class="px-5 py-4 flex items-center justify-between gap-4">
                        <div class="font-mono text-xs sm:text-sm flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                            <span class="text-primary mr-3">~</span>
                            <span class="text-white">{COMMAND}</span>
                        </div>
                        <button data-track-copy="rls-check-hero" data-command={COMMAND}
                                class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                aria-label="Copy command" title="Copy to clipboard">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- The trust block. A stranger is about to point a binary at their
                 production database; the three things they need to know come
                 before anything persuasive. -->
            <dl class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6">
                <div>
                    <dt class="text-white font-semibold text-sm mb-1">Read-only</dt>
                    <dd class="text-sm text-surface-400 leading-relaxed">
                        SELECTs against the system catalogues and nothing else. It never reads your data.
                    </dd>
                </div>
                <div>
                    <dt class="text-white font-semibold text-sm mb-1">Nothing leaves the machine</dt>
                    <dd class="text-sm text-surface-400 leading-relaxed">
                        No telemetry, no upload, no network beyond the connection string you pass it.
                    </dd>
                </div>
                <div>
                    <dt class="text-white font-semibold text-sm mb-1">No Rebase required</dt>
                    <dd class="text-sm text-surface-400 leading-relaxed">
                        It reads the database, not your codebase. Most people who run it do not use Rebase.
                    </dd>
                </div>
            </dl>
        </div>
    </section>

    <!-- What it finds -->
    <section class="relative z-0 py-16 sm:py-24 border-t border-surface-900/60">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
            <h2 class="text-2xl sm:text-3xl font-semibold text-white mb-3">The fourteen checks</h2>
            <p class="text-surface-400 mb-12 leading-relaxed max-w-2xl">
                Each finding the tool prints carries the id below, the reason it matters, and the SQL that fixes
                it. Severity is the worst level a check can report — several grade themselves down depending on
                what they find.
            </p>

            {bySeverity.map(({ severity, checks }) => (
                <div class="mb-12 last:mb-0">
                    <div class="flex items-center gap-3 mb-5">
                        <span class={`inline-flex items-center px-2.5 py-1 rounded-full border text-2xs font-semibold uppercase tracking-wider ${SEVERITY_STYLE[severity]}`}>
                            {SEVERITY_LABEL[severity]}
                        </span>
                        <span class="text-surface-600 text-sm">{checks.length} check{checks.length === 1 ? "" : "s"}</span>
                    </div>

                    <div class="space-y-3">
                        {checks.map((check) => (
                            <div class="frame p-6" id={check.id}>
                                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                                    <h3 class="text-white font-medium leading-snug">{check.title}</h3>
                                    <code class="flex-none font-mono text-2xs text-surface-500">{check.id}</code>
                                </div>
                                <p class="text-sm text-surface-400 leading-relaxed">{check.description}</p>
                                <a href={`/docs/rls-check#${check.id}`}
                                   class="mt-3 inline-block text-sm text-primary-light hover:text-white underline underline-offset-2">
                                    How to fix it &rarr;
                                </a>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- What it looks like -->
    <section class="relative z-0 py-16 sm:py-24 border-t border-surface-900/60">
        <div class="mx-auto max-w-5xl px-6 lg:px-8">
            <h2 class="text-2xl sm:text-3xl font-semibold text-white mb-3">What a run looks like</h2>
            <p class="text-surface-400 mb-10 leading-relaxed max-w-2xl">
                Every finding names the relation, says who can reach it and what they would get, and prints the
                SQL that closes it. Exits non-zero above a severity you choose, so it belongs in CI.
            </p>
            <RlsCheckReport />
        </div>
    </section>

    <ComparisonFaq competitor="rls-check" heading="Questions about rls-check" faqs={faqs} pageUrl={PAGE_URL} />

    <ClosingCta
        title="Then fix it once, in code."
        blurb="A scanner tells you where the policies are wrong. Rebase compiles them from your collection definitions, so the next one is reviewed in a pull request before it ever reaches a database."
        trackId="rls-check"
    />
</div>

<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
