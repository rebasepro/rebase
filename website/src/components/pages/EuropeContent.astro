---
const { lang, t } = Astro.props;

import { useTranslatedPath } from '../../i18n/ui';
import { NeatBackground } from '../../components/NeatBackground';
import JurisdictionDemo, { JURISDICTION_STRINGS } from '../demos/JurisdictionDemo';
import DeployTargetDemo, { DEPLOY_TARGET_STRINGS } from '../demos/DeployTargetDemo';
import EuHostingCostDemo, { EU_HOSTING_COST_STRINGS } from '../demos/EuHostingCostDemo';
import EuropeMapDemo, { EUROPE_MAP_STRINGS } from '../demos/EuropeMapDemo';

const translatePath = useTranslatedPath(lang);

// Everything the runtime serves, self-hosted or not. This list is the "no lite
// tier" claim, so it has to match what `initializeRebaseBackend` actually mounts.
const surfaces = [
    { name: "REST API", detail: t("europe.s.rest") },
    { name: "Typed SDK", detail: t("europe.s.sdk") },
    { name: t("europe.s.rls.name"), detail: t("europe.s.rls") },
    { name: t("europe.s.auth.name"), detail: t("europe.s.auth") },
    { name: t("europe.s.storage.name"), detail: t("europe.s.storage") },
    { name: t("europe.s.realtime.name"), detail: t("europe.s.realtime") },
    { name: t("europe.s.functions.name"), detail: t("europe.s.functions") },
    { name: "Cron", detail: t("europe.s.cron") },
    { name: "OpenAPI", detail: t("europe.s.openapi") },
    { name: "Rebase CMS", detail: t("europe.s.cms") },
    { name: "Rebase Studio", detail: t("europe.s.studio") },
    { name: "MCP", detail: t("europe.s.mcp") },
];

const composeSnippet = `<span class="text-surface-500">// docker-compose.yml — the whole deployment</span>
<span class="text-blue-300">services</span>:
  <span class="text-blue-300">db</span>:
    <span class="text-blue-300">image</span>: <span class="text-green-400">postgres:18-alpine</span>

  <span class="text-blue-300">api</span>:
    <span class="text-blue-300">image</span>: <span class="text-green-400">rebasepro/server:0.17.3</span>
    <span class="text-blue-300">volumes</span>:
      - <span class="text-green-400">./dist-bundle:/bundle:ro</span>
    <span class="text-blue-300">environment</span>:
      <span class="text-blue-300">DATABASE_URL</span>: <span class="text-green-400">postgres://…@db:5432/rebase</span>
      <span class="text-blue-300">JWT_SECRET</span>: <span class="text-green-400">\${JWT_SECRET}</span>

<span class="text-surface-500">// that is the deployment. There is no application</span>
<span class="text-surface-500">// image to build — the runtime is published, and</span>
<span class="text-surface-500">// your project travels as a bundle.</span>`;
import ClosingCta from "../ClosingCta.astro";
---

<div class="flex flex-col isolate">

    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-20">
        <NeatBackground client:idle transition:persist="neat-hero" />

        {/* `px-6 lg:px-8`, not `px-4 lg:px-12`. This page was the only one on the
            site using its own shell padding, which put its left edge at 205px
            while every other page sits at 176px — §6 asks for one shell width
            precisely so those edges agree. */}
        <div class="relative z-10 mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-surface-800/40 px-3 py-1.5 text-sm text-surface-400 ring-1 ring-inset ring-white/10">
                <span class="font-medium">{t("europe.badge")}</span>
            </div>

            <h1 class="mb-6 text-display-2 text-white" set:html={t("europe.00")}></h1>

            {/* Measures, not padding. This carried `sm:px-16 … xl:px-40`, so on a
                wide screen 160px of left padding pushed the lead a third of the
                way across the page while the headline above it stayed on the
                shell edge — three different left edges in one block. §6's lead
                measure does the same job without moving the edge. */}
            <p class="mb-6 max-w-[38rem] text-lg leading-8 text-surface-300 lg:text-xl">{t("europe.01")}</p>
            <p class="mb-10 max-w-[38rem] text-base leading-7 text-surface-400" set:html={t("europe.02")}></p>

            {/* Left-aligned with everything above it. Centred, it was the only
                element in the hero not on the shell edge. */}
            <div class="max-w-xl overflow-hidden rounded-xl border border-surface-800 bg-[#0c0d10] font-mono text-xs shadow-2xl">
                <div class="flex items-center gap-1.5 border-b border-surface-800/80 bg-[#14151a] px-4 py-2.5">
                    <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
                    <span class="ml-auto text-3xs font-semibold tracking-wide text-surface-500">zsh</span>
                </div>
                <div class="flex items-center gap-2 p-5 text-left">
                    <span class="select-none font-semibold text-primary">&gt;</span>
                    <span class="select-all font-medium text-white">pnpm dlx @rebasepro/cli init</span>
                    <span class="inline-block h-4 w-1.5 animate-pulse bg-primary align-middle"></span>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ WHO HOLDS THE KEYS ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mb-12 max-w-[42rem]">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">{t("europe.03")}</p>
                <h2 class="mb-5 text-3xl sm:text-4xl text-white">{t("europe.04")}</h2>
                <p class="text-base leading-relaxed text-surface-400" set:html={t("europe.05")}></p>
                <p class="mt-4 text-base leading-relaxed text-surface-400" set:html={t("europe.06")}></p>
            </div>

            <div class="mx-auto max-w-6xl">
                <JurisdictionDemo client:visible s={Object.fromEntries(JURISDICTION_STRINGS.map((k) => [k, t(k)]))} />
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ WHAT YOU DEPLOY ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
                <div class="lg:col-span-5">
                    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">{t("europe.07")}</p>
                    <h2 class="mb-5 text-3xl sm:text-4xl text-white">{t("europe.08")}</h2>
                    <p class="mb-4 text-base leading-relaxed text-surface-400">{t("europe.09")}</p>
                    <p class="mb-4 text-base leading-relaxed text-surface-400" set:html={t("europe.10")}></p>
                    <p class="mb-6 text-base leading-relaxed text-surface-400">{t("europe.11")}</p>
                    <a href="/docs/deployment/self-hosting"
                       class="inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors hover:text-primary/80">
                        {t("europe.link.selfhost")}
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>

                <div class="lg:col-span-7">
                    <DeployTargetDemo client:visible s={Object.fromEntries(DEPLOY_TARGET_STRINGS.map((k) => [k, t(k)]))} />
                </div>
            </div>

            <div class="mx-auto mt-14 grid max-w-6xl grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
                <div class="lg:col-span-7 lg:order-last">
                    <div class="frame overflow-hidden">
                        <div class="border-b border-surface-800/80 bg-surface-900/50 px-4 py-3">
                            <span class="font-mono text-xs text-surface-400">docker-compose.yml</span>
                        </div>
                        <pre class="overflow-x-auto p-5 font-mono text-2xs leading-relaxed text-surface-300 sm:text-xs"><code set:html={composeSnippet}></code></pre>
                    </div>
                </div>
                <div class="lg:col-span-5">
                    <h3 class="mb-4 text-2xl font-semibold text-white">{t("europe.12")}</h3>
                    <p class="mb-4 text-base leading-relaxed text-surface-400" set:html={t("europe.13")}></p>
                    <p class="text-base leading-relaxed text-surface-400" set:html={t("europe.14")}></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative overflow-hidden pointer-events-none" style="z-index: -1; --divider-h: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>

    <!-- ═══════════════════════ THE BILL ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mb-12 max-w-[42rem]">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">{t("europe.eyebrow.bill")}</p>
                <h2 class="mb-5 text-3xl sm:text-4xl text-white">{t("europe.15")}</h2>
                <p class="text-base leading-relaxed text-surface-400">{t("europe.16")}</p>
                <p class="mt-4 text-base leading-relaxed text-surface-400">{t("europe.17")}</p>
            </div>

            <div class="mx-auto max-w-6xl">
                <EuHostingCostDemo client:visible lang={lang} s={Object.fromEntries(EU_HOSTING_COST_STRINGS.map((k) => [k, t(k)]))} />
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ NO LITE TIER ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mb-12 max-w-[42rem]">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">{t("europe.18")}</p>
                <h2 class="mb-5 text-3xl sm:text-4xl text-white">{t("europe.19")}</h2>
                <p class="text-base leading-relaxed text-surface-400">{t("europe.20")}</p>
            </div>

            <div class="frame p-6 sm:p-8">
                <div class="grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
                    {surfaces.map((s) => (
                        <div class="flex items-start gap-3">
                            <span class="mt-0.5 flex h-4 w-4 flex-none items-center justify-center rounded-full bg-primary text-white shadow-[0_0_14px_rgba(0,112,244,0.5)]">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m5 12 5 5L20 7"/>
                                </svg>
                            </span>
                            <span class="min-w-0">
                                <span class="block text-sm font-medium text-surface-200">{s.name}</span>
                                <span class="block text-xs text-surface-500">{s.detail}</span>
                            </span>
                        </div>
                    ))}
                </div>

                <p class="mt-8 border-t border-surface-800/60 pt-6 text-sm leading-relaxed text-surface-400">
                    {t("europe.panelNote")}
                    <a href={translatePath("/cms")} class="ml-1 text-primary hover:underline">{t("europe.link.panel")}</a>.
                </p>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ WHERE TO PUT IT ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mb-12 max-w-[42rem]">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">{t("europe.21")}</p>
                <h2 class="mb-5 text-3xl sm:text-4xl text-white">{t("europe.22")}</h2>
                <p class="text-base leading-relaxed text-surface-400">{t("europe.23")}</p>
            </div>

            <EuropeMapDemo client:visible s={Object.fromEntries(EUROPE_MAP_STRINGS.map((k) => [k, t(k)]))} />
        </div>
    </section>

    <!-- ═══════════════════════ PAPERWORK ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-5xl px-6 lg:px-8">
            <div class="mb-12 max-w-[42rem]">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">Paperwork</p>
                <h2 class="mb-5 text-3xl sm:text-4xl text-white">{t("europe.24")}</h2>
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div class="rounded-2xl border border-surface-800 bg-surface-900/50 p-8">
                    <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3 py-1.5 text-xs font-medium text-emerald-400 ring-1 ring-inset ring-emerald-500/20">
                        {t("europe.badge.selfhosted")}
                    </div>
                    <h3 class="mb-4 text-xl font-semibold text-white">{t("europe.25")}</h3>
                    <ul class="space-y-3 text-sm text-surface-400">
                        <li set:html={t("europe.26")}></li>
                        <li set:html={t("europe.27")}></li>
                        <li set:html={t("europe.28")}></li>
                    </ul>
                </div>

                <div class="rounded-2xl border border-surface-800 bg-surface-900/50 p-8">
                    <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-amber-500/10 px-3 py-1.5 text-xs font-medium text-amber-400 ring-1 ring-inset ring-amber-500/20">
                        {t("europe.badge.otherside")}
                    </div>
                    <h3 class="mb-4 text-xl font-semibold text-white">{t("europe.29")}</h3>
                    <p class="mb-4 text-sm leading-relaxed text-surface-400">{t("europe.30")}</p>
                    <ul class="space-y-3 text-sm text-surface-400">
                        <li set:html={t("europe.31")}></li>
                        <li set:html={t("europe.32")}></li>
                        <li set:html={t("europe.33")}></li>
                    </ul>
                    <p class="mt-5 text-sm leading-relaxed text-surface-500" set:html={t("europe.34")}></p>
                </div>
            </div>

            <p class="mt-8 max-w-[38rem] text-xs leading-relaxed text-surface-500">
                {t("europe.legal")}
                <a href={translatePath("/security")} class="text-surface-400 underline decoration-surface-700 underline-offset-2 hover:text-primary">{t("europe.link.security")}</a>{" "}
                {t("europe.legal2")}
            </p>
        </div>
    </section>



    <ClosingCta title={t("close.europe.title")} blurb={t("close.europe.blurb")} trackId="europe" />

</div>
