---
import HeroBackdrop from "../HeroBackdrop.astro";
import ClientLogos from "../ClientLogos.astro";
import PolicyPathsFigure from "../PolicyPathsFigure.astro";
import CaseStudiesCarousel from "../CaseStudiesCarousel.astro";
import ReleasePartsSection from "../ReleasePartsSection.astro";
import { ApiMiniDemo } from "../demos/ApiMiniDemo";
import { SdkMiniDemo } from "../demos/SdkMiniDemo";
import { RealtimeMiniDemo } from "../demos/RealtimeMiniDemo";
import { AdminDemoCarousel } from "../demos/AdminDemoCarousel";
import { AgentConsoleDemo } from "../demos/AgentConsoleDemo";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/ui";
import {
    ArrowRight, TerminalSquare,
    KeyRound, HardDrive, Code2, Clock, Sparkles, GitBranch, History, ArchiveRestore,
} from "lucide-react";
import { DEMO_URL } from "../../utils/links";

// Rendered by the home route, which supplies both; falls back for the dev route.
const { lang: langProp, t: tProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = tProp ?? useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// No argument: the tool reads DATABASE_URL (or POSTGRES_URL, or .env) itself.
// A connection string on the command line is readable in `ps` by every other
// user on the box, and lands in shell history — this is the form we can put in
// front of someone about to paste a production credential.
const RLS_CHECK_COMMAND = "npx @rebasepro/rls-check";

// One source for the command the hero shows and the copy button writes, so
// the two can never drift apart.
const INSTALL_COMMAND = "pnpm dlx @rebasepro/cli init";

// Chapter 02's capability grid. Only what ships in the published release goes
// here — preview deploys and branch merging are 0.26 and wait for it. Each
// handle is the real name a reader would type or search the docs for.
const ENGINE_CAPABILITIES = [
    { title: "engine.cap.auth.title", desc: "engine.cap.auth.desc", Icon: KeyRound, handle: "/api/auth" },
    { title: "engine.cap.storage.title", desc: "engine.cap.storage.desc", Icon: HardDrive, handle: "/api/storage" },
    { title: "engine.cap.functions.title", desc: "engine.cap.functions.desc", Icon: Code2, handle: "defineFunction()" },
    { title: "engine.cap.jobs.title", desc: "engine.cap.jobs.desc", Icon: Clock, handle: "defineCron() · jobQueue.enqueue()" },
    { title: "engine.cap.vector.title", desc: "engine.cap.vector.desc", Icon: Sparkles, handle: "?vector_search=embedding" },
    { title: "engine.cap.branches.title", desc: "engine.cap.branches.desc", Icon: GitBranch, handle: "rebase db branch create" },
    { title: "engine.cap.history.title", desc: "engine.cap.history.desc", Icon: History, handle: "history: true" },
    { title: "engine.cap.backups.title", desc: "engine.cap.backups.desc", Icon: ArchiveRestore, handle: "rebase db backup" },
] as const;

// The hero colours the command by role: the runner, the package, the verb.
const [INSTALL_RUNNER, INSTALL_PACKAGE, INSTALL_VERB] =
    INSTALL_COMMAND.match(/^(\S+ \S+) (\S+) (\S+)$/)!.slice(1);
const SELFHOST_COMMAND = "docker compose up -d";

---
<div class="isolate text-white">
    {/* ============================================================
        HOME PAGE SPINE — five numbered chapters, one close.

          hero      the AI-era backend for your Postgres — built for your team,
                    safe for your agents
          01        THE PANEL — the admin panel that ships with it, plus the
                    three ways to run Rebase (Backend, CMS, Studio) on `ground-raised`
          02        WHAT YOU GET — the engine (typed SDK, REST API, realtime
                    over LISTEN/NOTIFY) on the base ground above the gold divider
          03        SECURITY — the structural Postgres RLS claim on the brand
                    blue slab, then the free `rls-check` audit band
          04        AGENT ERA — MCP + CLI on the same security policy
          —         NEW IN 0.29 — Claude's apps and your pages from the admin's
                    own parts (ReleasePartsSection), unnumbered
          05        CUSTOMERS — case studies
          close     the three lanes, the terms, and the ask

        Colour is spent twice and only twice: the blue slab on 03 and the coral
        close. Both carry a claim whose subject is the ABSENCE of an event, which
        no demo beside them can show. Everything else runs on the page ground or
        on `ground-raised`.
        ============================================================ */}

        <!-- ============================================================
             HERO — the drafted instrument (2026-11-09).
             The art is NeatBackground's `glow` variant: a smooth full-colour
             field, masked into the page ground below the headline
             (`.hero-glow`). It replaced the `hero-register` experiment.
             The section is drafted like every chapter: rails at the shell's
             edges, a chapter rule with ticks where it meets them. Under the
             headline the argument and the two ways in sit on the left, and
             the consumers card on the right — what one table becomes,
             the job the three pillar cards used to do under the CTAs. The
             spec bar closes the hero above the fold. No window chrome
             (§6): the card is a drafted panel, not an app window.
             ============================================================ -->
        <section class="hero-home drafted relative isolate overflow-hidden hero-under-nav">
            {/* The glow and the grid over it; shared with every drafted hero. */}
            <HeroBackdrop />

            <div class="relative w-full mx-auto max-w-6xl px-6 lg:px-8">
                <div class="chapter-rule">
                    <span class="inline-flex min-w-0 items-center gap-2.5 rounded-full border border-white/12 bg-surface-frame/75 backdrop-blur-sm px-4 py-2 font-mono text-2xs uppercase tracking-[0.2em] text-surface-100">
                        <span class="dot text-cyan-300" aria-hidden="true"></span>
                        <span class="truncate">{t("hero.badge")}</span>
                    </span>
                    <span class="chapter-index hidden md:block">00 / {t("hero.index")}</span>
                </div>

                <h1 class="animate-on-scroll animate-immediate mt-lead font-headers text-display-1 text-balance">
                    {/* The two lines stay separate spans because the wipe delays
                        key off first and second child. */}
                    <span class="hero-line">{t("hero.title.part1")}</span>
                    <span class="hero-line">{t("hero.title.part2")}</span>
                </h1>

                <div class="mt-content grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_28rem] gap-10 lg:gap-16 items-end">
                    <div class="min-w-0">
                        {/* The three things a table compiles to are set
                            bright inside the sentence (`<strong>` in the copy). */}
                        <p class="hero-sub max-w-[38rem] text-base sm:text-lg leading-relaxed text-page-copy" set:html={t("hero.subtitle")}></p>
                        <div class="mt-8 flex flex-wrap items-center gap-3">
                            {/* The click every arm of an experiment counts as a
                                conversion (analytics.ts reads the attribute). */}
                            <a
                                href={DEMO_URL} target="_blank" rel="noopener noreferrer"
                                data-ab-conversion="hero_cta_click"
                                class="inline-flex items-center justify-start gap-2.5 rounded-lg bg-primary px-8 min-h-(--control-large) text-base font-semibold text-white shadow-[0_8px_28px_-6px_rgb(0_112_244/0.65)] transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                            >
                                {t("hero.cta.demo")}
                                <ArrowRight size={17} aria-hidden="true" />
                            </a>
                            <button
                                type="button"
                                data-track-copy="hero-command"
                                data-command={INSTALL_COMMAND}
                                data-copy-done-label={t("copy.command.done")}
                                class="copy-btn group inline-flex items-center gap-3 rounded-lg border border-white/12 bg-white/[0.03] px-5 min-h-(--control-large) font-mono text-sm text-surface-200 transition-colors hover:border-white/25 hover:bg-white/[0.06] data-copied:border-emerald-400/60 data-copied:bg-emerald-400/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                aria-label={`Copy "${INSTALL_COMMAND}" to the clipboard`}
                                title="Copy to clipboard"
                            >
                                <span class="select-none text-surface-500">$</span>
                                <span><span class="text-emerald-400">{INSTALL_RUNNER}</span> <span class="text-primary-light">{INSTALL_PACKAGE}</span> <span class="text-white">{INSTALL_VERB}</span></span>
                                <span data-copy-label class="ml-2 rounded-md border border-white/10 bg-white/[0.06] px-2 py-0.5 font-mono text-2xs uppercase tracking-[0.14em] text-surface-400">{t("copy.command")}</span>
                            </button>
                        </div>
                    </div>

                    {/* What one definition becomes, as a drafted panel. No
                        headings inside: the next heading after the h1 is
                        chapter 01's h2 (check_site reads the order). */}
                    <div>
                        <div class="rounded-xl border border-white/10 bg-surface-frame/85 backdrop-blur-md">
                            <div class="mx-4 flex items-center justify-between gap-3 border-b border-white/8 py-3.5">
                                <span class="flex min-w-0 items-center gap-2.5 font-mono text-2xs uppercase tracking-[0.16em] text-surface-200">
                                    <span class="dot text-emerald-400" aria-hidden="true"></span>
                                    <span>{t("hero.consumers.title")}</span>
                                </span>
                                <span class="hidden xl:block flex-none font-mono text-2xs text-surface-500">backend/schema/*.ts</span>
                            </div>
                            <ul class="flex flex-col gap-1.5 p-3">
                                <li class="flex items-center justify-between gap-4 rounded-lg bg-white/[0.035] px-3 py-2.5">
                                    <span class="flex items-center gap-2.5 text-sm text-surface-50"><span class="dot text-primary-light" aria-hidden="true"></span>{t("hero.pillar.app")}</span>
                                    <span class="text-right font-mono text-2xs text-surface-400">{t("hero.pillar.app.desc")}</span>
                                </li>
                                <li class="flex items-center justify-between gap-4 rounded-lg bg-white/[0.035] px-3 py-2.5">
                                    <span class="flex items-center gap-2.5 text-sm text-surface-50"><span class="dot text-cyan-300" aria-hidden="true"></span>{t("hero.pillar.team")}</span>
                                    <span class="text-right font-mono text-2xs text-surface-400">{t("hero.pillar.team.desc")}</span>
                                </li>
                                <li class="flex items-center justify-between gap-4 rounded-lg bg-white/[0.035] px-3 py-2.5">
                                    <span class="flex items-center gap-2.5 text-sm text-surface-50"><span class="dot text-[#FB5066]" aria-hidden="true"></span>{t("hero.pillar.agents")}</span>
                                    <span class="text-right font-mono text-2xs text-surface-400">{t("hero.pillar.agents.desc")}</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                {/* The title block of the drawing: four facts in mono, each one
                    checkable — the path every read takes to the request role,
                    the FireCMS lineage (the figure social.title states), the
                    free audit anyone can run, the licence. */}
                <dl class="spec-bar mt-7">
                    <div>
                        <dt>{t("hero.spec.data")}</dt>
                        <dd>withAuth → rebase_user → RLS</dd>
                    </div>
                    <div>
                        <dt>{t("hero.spec.heritage")}</dt>
                        <dd>{t("hero.spec.heritage.value")}</dd>
                    </div>
                    <div>
                        <dt>{t("hero.spec.audit")}</dt>
                        <dd class="text-cyan-300">npx @rebasepro/rls-check</dd>
                    </div>
                    <div>
                        <dt>{t("hero.spec.license")}</dt>
                        <dd class="text-white">{t("hero.spec.license.value")}</dd>
                    </div>
                </dl>
            </div>
        </section>

        <!-- Logo wall — the short beat, straight after the tallest one.
             `border-t` only: chapter 01 below opens with its own border-t at
             white/8, and nothing sits between them, so the two rules would
             touch and paint as one 2px line. -->
        <div class="drafted border-t border-white/5 py-strip">
            {/* The caption is the qualifier PRODUCT.md mandates — and, since
                2026-09-02, the heritage argument: FireCMS's 10,000+ projects are
                the credibility a star count cannot supply. The campaign pages
                render the same key above their walls; the home wall had none. */}
            <p class="mb-8 text-center text-sm text-surface-400">{t("social.title")}</p>
            <ClientLogos />
        </div>

        <!-- No divider between the wall and chapter 01, in either arm of the
             hero experiment. There was one — the faded register, bled behind
             both — and it read as a second, weaker copy of the hero's art
             peeking out from under the logos (Francesco, 2026-09-10: "remove
             the gradient behind the logos"). The wall sits on bare ground; the
             next divider is chapter 03's. -->

        <!-- CHAPTER 01 — THE ADMIN PANEL.
             Promoted to 01 on `ground-raised` so the 620px interactive
             AdminDemoCarousel — the richest visual artifact on the site — is
             the very first thing the reader sees after the hero and logo strip. -->
        <div>
            <section class="chapter drafted ground-raised border-y border-white/8 relative py-chapter">
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="chapter-rule">
                        <p class="eyebrow flex items-center gap-2.5"><span class="dot text-cyan-300" aria-hidden="true"></span>{t("panel.badge")}</p>
                        <span class="chapter-index">01 / 05</span>
                    </div>
                    <div class="mt-lead max-w-[42rem] animate-on-scroll fade-in-up">
                        <h2 class="font-headers text-display-2 text-balance">
                            {t("panel.title")}
                        </h2>
                        <p class="mt-lead max-w-[38rem] text-page-copy leading-relaxed">{t("modes.subtitle")}</p>
                    </div>
                    {/* No `.frame`: the carousel draws the panel's own edge, and
                        §6 allows a demo one frame, not two. The view toggle is page
                        furniture and sits outside the product's edge.

                        `lg:bleed-x`: the panel is the two-pane view the bleed
                        doctrine's second test is written for — a list beside a
                        record, where every extra pixel is another field on the
                        form. A capped step past both gutters, so the frame reads
                        as the product and not as a figure in the column. */}
                    <div class="mt-content lg:bleed-x animate-on-scroll fade-in-up">
                        <AdminDemoCarousel client:visible height={620} />
                    </div>
                    <div class="mt-content grid grid-cols-1 md:grid-cols-3 border-t border-white/8">
                        <div class="md:border-r border-white/8 py-10 md:pr-8">
                            <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-400">{t("modes.baas.tag")}</p>
                            <h3 class="mt-3 font-headers text-lg">{t("modes.baas.title")}</h3>
                            <p class="mt-2 text-sm text-page-copy leading-relaxed">{t("modes.baas.desc")}</p>
                            <p class="mt-4 font-mono text-2xs text-surface-400">@rebasepro/server</p>
                        </div>
                        <div class="md:border-r border-white/8 py-10 md:px-8 border-t md:border-t-0">
                            <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-400">{t("modes.cms.tag")}</p>
                            <h3 class="mt-3 font-headers text-lg">{t("modes.cms.title")}</h3>
                            <p class="mt-2 text-sm text-page-copy leading-relaxed">{t("modes.cms.desc")}</p>
                            <p class="mt-4 font-mono text-2xs text-surface-400">@rebasepro/cms</p>
                        </div>
                        <div class="py-10 md:pl-8 border-t md:border-t-0 border-white/8">
                            <p class="font-mono text-2xs uppercase tracking-[0.18em] text-surface-400">{t("modes.full.tag")}</p>
                            <h3 class="mt-3 font-headers text-lg">{t("modes.full.title")}</h3>
                            <p class="mt-2 text-sm text-page-copy leading-relaxed">{t("modes.full.desc")}</p>
                            <p class="mt-4 font-mono text-2xs text-surface-400">@rebasepro/app</p>
                        </div>
                    </div>
                    <a href={translatePath("/cms")} class="accent-link mt-10">
                        {t("showcase.exploreCms")}
                        <ArrowRight size={15} />
                    </a>
                </div>
            </section>
        </div>

        <!-- CHAPTER 02 — WHAT YOU GET (THE BACKEND).
             Sits on the transparent base ground without `overflow-hidden` or
             `z-0` so the gold divider below bleeds cleanly through into the
             Security slab (§6). -->
        <div>
            <section class="chapter drafted relative py-chapter">
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="chapter-rule">
                        <p class="eyebrow flex items-center gap-2.5"><span class="dot text-primary-light" aria-hidden="true"></span>{t("engine.badge")}</p>
                        <span class="chapter-index">02 / 05</span>
                    </div>
                    <div class="mt-lead max-w-[42rem] animate-on-scroll fade-in-up">
                        <h2 class="font-headers text-display-2 text-balance">
                            {t("engine.title")}
                        </h2>
                        <p class="mt-lead max-w-[38rem] text-page-copy leading-relaxed">{t("engine.subtitle")}</p>
                    </div>

                    <!-- The demos were 232px postage stamps inside a hairline grid.
                         They are the most interesting thing on the page, so they get
                         the room: one wide frame, then two half-width ones. -->
                    <div class="mt-content animate-on-scroll fade-in-up">
                        <div class="frame">
                            <div class="frame-head">
                                <span>{t("index.diag.app")}</span>
                                <span class="ml-auto">live · generated types</span>
                            </div>
                            <div class="h-[330px] overflow-hidden flex items-center justify-center">
                                <SdkMiniDemo client:visible />
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="animate-on-scroll fade-in-up delay-100">
                            <div class="frame">
                                <div class="frame-head"><span>{t("index.diag.rest")}</span><span class="ml-auto">live · click an endpoint</span></div>
                                <div class="h-[340px] overflow-hidden flex items-center justify-center">
                                    <ApiMiniDemo client:visible />
                                </div>
                            </div>
                        </div>
                        <div class="animate-on-scroll fade-in-up delay-200">
                            <div class="frame">
                                <div class="frame-head"><span>{t("index.diag.realtime")}</span><span class="ml-auto">live</span></div>
                                <div class="h-[340px] overflow-hidden flex items-center justify-center">
                                    <RealtimeMiniDemo client:visible />
                                </div>
                            </div>
                        </div>
                    </div>

                    {/* The rest of the backend, as a list someone can scan. It was one
                        sentence, and an evaluator came away believing Rebase had no
                        functions, branching or backups. Text cells, not a fourth
                        panel: each names the feature and the handle that turns it on. */}
                    <div class="mt-16 flex flex-wrap items-baseline gap-x-8 gap-y-3">
                        <p class="text-page-copy max-w-2xl">
                            {t("engine.plus")}
                        </p>
                        <a href={translatePath("/backend")} class="accent-link ml-auto">
                            {t("engine.link")}
                            <ArrowRight size={15} />
                        </a>
                    </div>
                    <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-white/8">
                        {ENGINE_CAPABILITIES.map(({ title, desc, Icon, handle }) => (
                            <li class="border-r border-b border-white/8 p-6">
                                <p class="flex items-center gap-2.5 font-headers text-base text-surface-100">
                                    <Icon size={16} class="shrink-0 text-surface-400" />
                                    {t(title)}
                                </p>
                                <p class="mt-2 text-sm text-page-copy leading-relaxed">{t(desc)}</p>
                                <p class="mt-4 font-mono text-2xs text-surface-400">{handle}</p>
                            </li>
                        ))}
                    </ul>
                </div>
            </section>
        </div>



        <!-- ============================================================
             CHAPTER 03 — SECURITY. The one chapter whose accent is the brand
             blue, because it carries the highest-ranked claim.
             ============================================================ -->
        <div>
            {/* CHAPTER 03 — a STRUCTURAL guarantee, and one of only two coloured
                grounds on the page.

                It qualifies because its claim is the absence of an event: "not by
                middleware someone has to remember to call". The figure beside
                it shows five paths and one check; it cannot show that nobody forgot. The colour
                carries the half of the argument the demo cannot.

                Brand blue deepened, because this promise holds by construction —
                it is what Rebase is. See `ground-chroma` for the rule and for
                why the raw #0070F4 cannot be used here. */}
            <section class="chapter drafted ground-chroma ground-claim py-chapter" style="--hue: var(--color-primary)">
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="chapter-rule">
                        <p class="eyebrow flex items-center gap-2.5"><span class="dot" aria-hidden="true"></span>{t("security.badge")}</p>
                        <span class="chapter-index">03 / 05</span>
                    </div>
                    <div class="mt-lead grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
                        <div class="lg:col-span-5">
                            {/* No `text-page-copy` inside a slab. That grey is
                                tuned for the near-black page ground; on a
                                coloured one it reads as dirt. The slab sets its
                                own `color` and everything here inherits it. */}
                            <h2 class="font-headers text-display-2 text-balance">
                                {t("security.title")}
                            </h2>
                            <p class="mt-lead max-w-[38rem] leading-relaxed">{t("security.desc")}</p>
                            <div class="mt-10 flex flex-col items-start gap-3">
                                <a href={translatePath("/security")} class="accent-link">
                                    {t("security.link")}
                                    <ArrowRight size={15} />
                                </a>
                                <!-- The argument behind the demo above. The section
                                     shows RLS being edited; this is why it is generated
                                     rather than hand-written in the first place. -->
                                <a
                                    href="/blog/2026-08-23-security-that-does-not-depend-on-remembering"
                                    class="group inline-flex items-start gap-2.5 text-sm text-surface-400 hover:text-white transition-colors"
                                >
                                    <span class="mt-px inline-flex flex-none items-center rounded px-1.5 py-0.5 text-2xs font-semibold uppercase tracking-wider bg-white/5 text-surface-300 ring-1 ring-white/10">
                                        {t("label.blog")}
                                    </span>
                                    <span class="max-w-[34rem] leading-relaxed group-hover:underline underline-offset-4 decoration-white/30">
                                        {t("security.postLink")}
                                    </span>
                                </a>
                            </div>
                        </div>
                        {/* The villain and the fix in one frame: five ways into
                            the same table with the rule in one of them, folding
                            into the policy as Postgres holds it. The RLS editor
                            that stood here lives on /security and /studio; a demo
                            appears on the home page and at most one deep page,
                            and it was on two. */}
                        <div class="lg:col-span-7 lg:bleed-right animate-on-scroll fade-in-up delay-100">
                            <PolicyPathsFigure lang={lang} t={t} />
                        </div>
                    </div>

                </div>
            </section>
        </div>

        {/* PROOF — the free audit, directly under the security claim, and part
            of the same chapter.

            Chapter 02 asserts that authorization belongs in the database. This
            is the one place on the page where that claim can be checked rather
            than read: a published, read-only tool that audits ANY Postgres,
            needs no account, and does not care whether you use Rebase.

            It carries no numeral of its own on purpose. It is the evidence for
            the chapter above it, not a sixth beat, and it is deliberately
            compact — `RlsCheckReport` renders a full terminal, and this follows
            a coloured slab that already carries a demo. The whole job here is
            "this exists, go and run it".

            The band is grey, asked for explicitly (2026-09-04). Between a
            coloured slab above and the page ground below, no ground at all
            simply disappears; `ground-raised` is the same grey the page's other
            bands use, so the proof point separates itself without claiming a
            chapter number or a second colour. */}
        <section class="chapter drafted relative ground-raised border-y border-white/8 py-band">
            <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
                    <div class="max-w-xl">
                        <h2 class="font-headers text-2xl sm:text-3xl text-balance">
                            {t("rlscheck.title")}
                        </h2>
                        <p class="mt-lead text-sm text-page-copy leading-relaxed" set:html={t("rlscheck.subtitle")}></p>
                        <a href={translatePath("/rls-check")} class="accent-link mt-8">
                            {t("rlscheck.cta")}
                            <ArrowRight size={15} />
                        </a>
                    </div>

                    <div class="flex-none lg:max-w-md w-full">
                        <div class="flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.02] pl-3 pr-1.5 py-2 font-mono text-xs text-surface-200">
                            <code class="select-all flex-1 truncate">{RLS_CHECK_COMMAND}</code>
                            <button
                                type="button"
                                data-track-copy="home-rls-check"
                                data-command={RLS_CHECK_COMMAND}
                                class="copy-btn flex-none rounded-md p-1.5 text-surface-500 hover:text-white hover:bg-white/5 transition-colors"
                                aria-label="Copy command"
                                title="Copy to clipboard"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                            </button>
                        </div>
                        <p class="mt-3 text-2xs leading-5 text-surface-400">{t("rlscheck.note")}</p>
                    </div>
                </div>
            </div>
        </section>
        {/* CHAPTER 04 — a HAZARD guarantee.

            Same test as 02, the other side of it. The claim is again the absence
            of an event — "an agent can't screw up" — and again unshowable: the
            console beside it demonstrates what an agent CAN reach, never that it
            failed to do damage. It runs on `ground-raised` rather than a second
            coloured slab: the page spends chroma twice, on 02 and on the close.

            The divider that used to introduce this chapter is gone. A ground
            change is the same gesture, and running both would have two devices
            doing one job.

            It ran on `ground-raised` until 2026-09-12, when chapter 02 moved
            above the security slab and took the page's only base ground with it
            — leaving the rls-check band (raised) butted straight against this
            one, two identical greys with the seam between them invisible. This
            chapter takes the page ground now and keeps its hairlines, so the
            alternation survives the reorder. */}
        <div>
            <section class="chapter drafted relative border-y border-white/8 py-chapter">
                <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
                    <div class="chapter-rule">
                        <p class="eyebrow flex items-center gap-2.5"><span class="dot text-amber-300" aria-hidden="true"></span>{t("agentera.badge")}</p>
                        <span class="chapter-index">04 / 05</span>
                    </div>
                    <div class="mt-lead grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
                        <div class="lg:col-span-5">
                            <h2 class="font-headers text-display-2 text-balance">
                                {t("agentera.title")}.
                            </h2>
                            <p class="mt-lead leading-relaxed" set:html={t("agentera.p1")}></p>
                            <a href={translatePath("/ai")} class="accent-link mt-10">
                                {t("agentera.link")}
                                <ArrowRight size={15} />
                            </a>
                        </div>
                        {/* Bleeds toward the viewport edge. Boxed into seven of
                            twelve columns the console read as a thumbnail of the
                            product rather than the product; the copy column
                            stays on the shell, so the left edge is unaffected. */}
                        <div class="lg:col-span-7 lg:bleed-right animate-on-scroll fade-in-up delay-100">
                            <AgentConsoleDemo client:visible />
                        </div>
                    </div>
                </div>
            </section>
        </div>

        {/* NEW IN 0.29 — unnumbered, on `ground-raised` between 04 (page ground)
            and 05 (page ground), so the alternation holds. No borders of its
            own: 04's bottom hairline and 05's top one already frame it, and a
            second pair would touch them and paint as 2px lines. What it may
            and may not say is at the top of the component. */}
        <ReleasePartsSection lang={lang} t={t} />

        <!-- CHAPTER 05 — CUSTOMERS. The carousel renders its own eyebrow, title
             and subtitle; wrapping it in a second header duplicated all three.
             It also renders its own `py-28 sm:py-36`, and this wrapper used to
             add `py-24 sm:py-32` on top — 272px of ground above the heading and
             272px below it, against ~128px everywhere else, which is what left
             most of a screen empty between the customers and the close. The
             wrapper keeps only the hairline. -->
        <div class="chapter border-t border-white/8">
            <CaseStudiesCarousel t={t} />
        </div>

        {/* The roadmap used to run here. It is not in SITE-STORY's beat table,
            and it sat between the real customers and the close — a list of
            things that do not exist yet, in the last screen before the ask, on
            a page whose rule is proof over assertion. It still ships on /about,
            where "what are you building next" is the page's own question. */}

        {/* FINAL CTA — the three lanes, as one band, and the page's second and
            last chroma ground.

            It used to run a Neat canvas under a gradient that ended at `#000`,
            so the page faded to pure black at the exact moment it asked for the
            click: the strongest position on the page was its weakest frame. The
            ask is now the loudest thing after the claim, and the reader arrives
            here having seen colour exactly once before.

            The canvas goes with it. That is deliberate rather than a saving —
            the page opens in art and closes in colour, which is a register
            change the reader can feel: atmosphere while you are being
            persuaded, flat colour when you are being asked.

            Ownership (claim 5) is folded in here rather than standing as its own
            beat. A fact about the terms is worth nothing to a reader who has not
            yet decided the product is good, and worth more than any other to one
            who has — which is exactly who is standing here. It is a paragraph
            under the ask, not a chapter before it. */}
        <section class="chapter drafted ground-chroma ground-close relative isolate overflow-hidden" style="--hue: var(--color-chroma-coral)">
            <div class="mx-auto max-w-6xl px-6 lg:px-8 py-chapter">
                <h2 class="font-headers text-2xl sm:text-3xl max-w-xl text-balance">
                    {t("cta.title")}
                </h2>
                <p class="mt-lead max-w-[38rem] text-sm leading-relaxed">{t("opensource.desc")}</p>
                <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3">
                    <a href={translatePath("/developers")} class="accent-link">
                        {t("opensource.link1")}
                        <ArrowRight size={15} />
                    </a>
                    <a href={translatePath("/compare")}
                       class="text-sm font-semibold text-surface-400 transition-colors hover:text-white">
                        {t("opensource.link2")}
                    </a>
                </div>

                <div class="mt-content grid grid-cols-1 md:grid-cols-3 border-y border-white/10">
                    <div class="md:border-r border-white/10 py-10 md:pr-8">
                        <h3 class="text-base">{t("cta.lane.local.title")}</h3>
                        <p class="mt-3 text-sm text-page-copy leading-relaxed">{t("cta.lane.local.desc")}</p>
                        <div class="mt-5 flex items-center gap-2 rounded-lg border border-white/10 pl-3 pr-1.5 py-1.5 font-mono text-xs text-surface-200">
                            <code class="select-all flex-1 truncate">{INSTALL_COMMAND}</code>
                            <button
                                type="button"
                                data-track-copy="cta-lane-local"
                                data-command={INSTALL_COMMAND}
                                data-copy-done-label={t("copy.command.done")}
                                class="copy-btn inline-flex shrink-0 items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.055] px-2 py-1 font-sans text-2xs font-medium text-surface-400 transition-colors hover:border-white/20 hover:bg-white/[0.09] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                aria-label={`Copy "${INSTALL_COMMAND}" to the clipboard`}
                                title="Copy to clipboard"
                            >
                                <svg data-copy-idle class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                                <svg data-copy-done hidden class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 6 9 17l-5-5"/>
                                </svg>
                                <span data-copy-label>{t("copy.command")}</span>
                            </button>
                        </div>
                        <a href={translatePath("/docs")} class="accent-link mt-5">
                            {t("cta.lane.local.link")} <ArrowRight size={14} />
                        </a>
                    </div>
                    <div class="md:border-r border-white/10 py-10 md:px-8 border-t md:border-t-0">
                        <h3 class="text-base">{t("cta.lane.selfhost.title")}</h3>
                        <p class="mt-3 text-sm text-page-copy leading-relaxed">{t("cta.lane.selfhost.desc")}</p>
                        <div class="mt-5 flex items-center gap-2 rounded-lg border border-white/10 pl-3 pr-1.5 py-1.5 font-mono text-xs text-surface-200">
                            <code class="select-all flex-1 truncate">{SELFHOST_COMMAND}</code>
                            <button
                                type="button"
                                data-track-copy="cta-lane-selfhost"
                                data-command={SELFHOST_COMMAND}
                                data-copy-done-label={t("copy.command.done")}
                                class="copy-btn inline-flex shrink-0 items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.055] px-2 py-1 font-sans text-2xs font-medium text-surface-400 transition-colors hover:border-white/20 hover:bg-white/[0.09] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                aria-label={`Copy "${SELFHOST_COMMAND}" to the clipboard`}
                                title="Copy to clipboard"
                            >
                                <svg data-copy-idle class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                                <svg data-copy-done hidden class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 6 9 17l-5-5"/>
                                </svg>
                                <span data-copy-label>{t("copy.command")}</span>
                            </button>
                        </div>
                        <a href={translatePath("/docs/deployment")} class="accent-link mt-5">
                            {t("cta.lane.selfhost.link")} <ArrowRight size={14} />
                        </a>
                    </div>
                    <div class="py-10 md:pl-8 border-t md:border-t-0 border-white/10">
                        <h3 class="text-base flex items-center gap-3">
                            {t("cta.lane.cloud.title")}
                            <span class="rounded-md bg-white/10 px-2 py-1 font-mono text-3xs uppercase tracking-[0.1em] text-surface-300">
                                {t("cta.lane.cloud.badge")}
                            </span>
                        </h3>
                        <p class="mt-3 text-sm text-page-copy leading-relaxed">{t("cta.lane.cloud.desc")}</p>
                        {/* Cloud is not open yet, so the lane's link asks for an
                            address rather than sending a reader to a price list
                            for something they cannot buy. The form is in the
                            footer of every page (Layout renders it). */}
                        <a href="#footer-waitlist" class="accent-link mt-5">
                            {t("cta.lane.cloud.link")} <ArrowRight size={14} />
                        </a>
                    </div>
                </div>

                <div class="mt-12 flex flex-wrap gap-3">
                    <a
                        href={DEMO_URL} target="_blank" rel="noopener noreferrer"
                        class="inline-flex items-center justify-center rounded-lg bg-primary px-6 min-h-(--control-large) text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
