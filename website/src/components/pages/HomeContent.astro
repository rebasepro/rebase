                    <a
                        href={translatePath("/docs")}
                        class="inline-flex items-center justify-center rounded-lg border border-white/15 px-6 min-h-(--control-large) text-sm font-semibold text-white transition-colors hover:border-white/35"
                    >
                        {t("cta.button.docs")}
                    </a>
                </div>
            </div>
        </section>
    </div>
