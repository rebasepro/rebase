                                            <span class="text-primary font-bold">~</span>
                                            <span class="text-white">npm run dev</span>
                                        </div>
                                        <button onclick="navigator.clipboard.writeText('npm run dev')" class="text-surface-500 hover:text-white transition-colors" aria-label="Copy command" title="Copy to clipboard">
                                            
<svg
  class="lucide lucide-copy"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
</svg>

                                        </button>
                                    </div>
                                    <div class="text-emerald-400/90 text-xs mt-1 ml-6">{t('demo.dev')}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="sticky top-20 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-10">
                <div class="w-full rounded-2xl overflow-hidden border border-surface-800/80 bg-surface-950 shadow-[0_0_0_1px_rgba(15,23,42,0.55),0_24px_120px_rgba(0,0,0,0.65)] pointer-events-none">
                    <!-- Browser Chrome -->
                    <div class="px-4 py-3 border-b border-surface-800/80 flex items-center gap-2 bg-surface-900/50 backdrop-blur-md">
                        <div class="flex gap-1.5 w-16">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                        </div>
                        <div class="flex-1 flex justify-center">
                            <div class="bg-surface-950/80 border border-surface-800/80 rounded-md px-3 py-1 text-[11px] font-mono text-surface-500 flex items-center gap-1.5">
                                
<svg
  class="lucide lucide-lock"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
</svg>

                                admin.yourdomain.com
                            </div>
                        </div>
                        <div class="w-16"></div> <!-- Balance the layout -->
                    </div>
                    <div class="relative w-full">
                        <EntityViewDemo client:load />
                    </div>
                </div>
                <p class="mt-4 text-center text-xs sm:text-sm text-surface-500 pb-20">
                    A quick tour of the generated Rebase admin panel.
                </p>
            </div>
        </section>

        <!-- Social proof -->
        <section class="bg-black py-12 sm:py-16">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <p class="text-center text-sm text-surface-500 mb-8 animate-on-scroll fade-in">{t('social.title')}</p>
                <ClientLogos />
            </div>
        </section>

        <!-- How it works -->
        <section class="relative py-24 sm:py-32 overflow-hidden bg-black">
            <div class="mx-auto max-w-7xl px-6 lg:px-12">
                <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 animate-on-scroll fade-in-up">
                    <h2 class="text-xs font-semibold tracking-[0.25em] text-primary/70 uppercase">{t('howitworks.badge')}</h2>
                    <p class="mt-4 text-3xl md:text-5xl font-semibold tracking-tight text-white" set:html={t('howitworks.title')}></p>
                    <p class="mt-5 text-base sm:text-lg text-surface-400 leading-relaxed">
                        {t('howitworks.subtitle')}
                    </p>
                </div>

                <div class="mx-auto max-w-5xl">
                    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
                        <!-- Step 1: Connect -->
                        <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-7 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up">
                            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300" aria-hidden="true" style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                            <div class="relative z-10 flex items-start gap-4">
                                <div class="h-10 w-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center flex-none ring-1 ring-primary/20">
                                    
<svg
  class="lucide lucide-database"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <ellipse cx="12" cy="5" rx="9" ry="3" />
  <path d="M3 5V19A9 3 0 0 0 21 19V5" />
  <path d="M3 12A9 3 0 0 0 21 12" />
</svg>

                                </div>
