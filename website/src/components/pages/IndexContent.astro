            </div>

            <!-- Trust row, at the moment the decision is actually made.
                 Strapi ships "Open source (MIT) · SOC 2 certified · GDPR Compliant"
                 directly under its install command and Directus carries SOC 2 / G2 /
                 GDPR in the footer. We cannot claim SOC 2 and must not imply it — but
                 the axis we actually win is the one their badges concede, so these
                 four say that instead. Every one of them is already asserted in prose
                 elsewhere on the site (cta.lane.local.desc, cta.lane.selfhost.desc,
                 opensource.desc, and the whole of /europe); this only concentrates
                 them where a reader is deciding. Nothing here may become a claim the
                 site cannot defend — no certification we do not hold, no uptime, no
                 customer count. -->
            <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 animate-on-scroll fade-in-up delay-200">
                {[
                    t("cta.trust.mit"),
                    t("cta.trust.selfhosted"),
                    t("cta.trust.processor"),
                    t("cta.trust.noaccount")
                ].map((label) => (
                    <li class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs text-surface-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"
                             stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5"/>
                        </svg>
                        {label}
                    </li>
                ))}
            </ul>
        </div>
    </section>


