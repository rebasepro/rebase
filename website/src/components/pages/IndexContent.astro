</svg>

                                </div>
                                <div>
                                    <h3 class="text-white font-semibold">{t('howitworks.step3.title')}</h3>
                                    <p class="mt-1 text-sm text-surface-400 leading-relaxed">
                                        {t('howitworks.step3.desc')}
