---
const {
    lang,
    t
} = Astro.props;
import { AdminDemoCarousel } from "../../components/demos/AdminDemoCarousel";
import { BodyPartsDemo } from "../../components/demos/BodyPartsDemo";
import { ApiMiniDemo } from "../../components/demos/ApiMiniDemo";
import { SdkMiniDemo } from "../../components/demos/SdkMiniDemo";
import { RealtimeMiniDemo } from "../../components/demos/RealtimeMiniDemo";
import { NeatBackground } from '../../components/NeatBackground';


import ClientLogos from "../../components/ClientLogos.astro";

import { useTranslatedPath } from "../../i18n/ui";

const translatePath = useTranslatedPath(lang);
---


<div class="flex flex-col isolate">

    <!-- Hero -->
 <section id="s-hero"
             class="relative isolate overflow-hidden -mt-20 pt-52 pb-24 sm:pt-56 sm:pb-28 lg:pt-60 lg:pb-32">
        <!-- Animated WebGL gradient background (Neat - funky preset) -->
        <NeatBackground client:idle randomize={false} />


        <div class="px-4 mx-auto max-w-7xl text-center lg:px-8 relative z-10 mt-8">
            <!-- Badge -->
            <div class="mb-8 flex items-center justify-center gap-3 animate-on-scroll fade-in">
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-surface-700 bg-surface-900/60 text-xs font-medium text-surface-400">
                        <img src="/img/postgresql-logo.svg" alt="PostgreSQL" class="h-4 w-auto"/>
                        {t("hero.badge")}
                    </span>
            </div>

            <!-- Headline -->
            <div class="relative">

                <h1 class="relative mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.08] text-white animate-on-scroll fade-in-up">
                    {t("hero.title.part1")}<br/><span class="text-primary subtle-shimmer">{t("hero.title.part2")}</span>
                </h1>
            </div>
            <p class="mb-4 text-lg leading-8 text-surface-400 lg:text-xl sm:px-10 xl:px-40 animate-on-scroll fade-in-up"
               set:html={t("hero.subtitle")}/>

            <!-- Hero primary CTA: zero-friction live demo -->
            <div class="mt-10 flex flex-col items-center gap-2.5 animate-on-scroll fade-in-up">
                <a href="https://demo.rebase.pro"
                   target="_blank" rel="noopener noreferrer"
                   id="hero-try-demo"
                   class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-7 py-3.5 text-base font-semibold text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-all duration-200 ease-in-out btn-glow">
                    {t("hero.cta.demo")}
                    <svg
                            class="lucide lucide-arrow-right"
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                    >
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
                <span class="text-xs text-surface-500">{t("hero.cta.demo.note")}</span>
            </div>

            <!-- Hero secondary path: run locally via CLI -->
            <div class="mt-10 mb-10 max-w-md mx-auto animate-on-scroll fade-in-up">
                <p class="mb-3 text-sm text-surface-400">{t("hero.cli.label")}</p>
                <div class="group relative">
                    <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-0 group-hover:opacity-100 blur-lg transition-opacity duration-500"
                         aria-hidden="true"></div>
                    <div class="relative rounded-xl bg-surface-900/80 border border-surface-700/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_16px_48px_rgba(0,0,0,0.5)] overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                        <div class="px-5 py-4 flex items-center justify-between">
                            <div class="font-mono text-sm sm:text-base flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                <span class="text-primary font-bold mr-3">~</span>
                                <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                            </div>
                            <button data-track-copy="hero" data-command="pnpm dlx @rebasepro/cli init"
                                    class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                    aria-label="Copy command" title="Copy to clipboard">
                                <svg class="lucide lucide-copy" xmlns="http://www.w3.org/2000/svg" width="18"
                                     height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                            </button>
                        </div>
                        <div class="px-5 pb-3 -mt-1">
                            <span class="font-mono text-xs text-surface-400">or: npx @rebasepro/cli init</span>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </section>

    <!-- Social proof -->
 <section id="s-social-proof" class="relative z-0 py-20 sm:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <p class="text-center text-sm text-surface-400 mb-8 animate-on-scroll fade-in">{t("social.title")}</p>
            <ClientLogos/>
        </div>
    </section>



    <!-- Neat gradient divider -->
    <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden" style="z-index: -1; height: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>


 <section id="s-demo-carousel" class="relative z-0 py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mx-auto text-center mb-12 animate-on-scroll fade-in-up">
                <p class="text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase">{t("see.badge")}</p>
                <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-5xl">{t("see.title")}</h2>
                <p class="mt-4 text-surface-400 text-base sm:text-lg leading-relaxed">{t("see.subtitle")}</p>
            </div>

            <div style="min-height: 700px;">
                <AdminDemoCarousel client:load/>
            </div>
            <p class="mt-2 text-center text-xs sm:text-sm text-surface-400">
                A quick tour of the generated Rebase admin panel.
            </p>
        </div>
    </section>




    <!-- Adoption modes: BaaS / CMS / Full -->
 <section id="s-modes" class="relative z-0 py-28 sm:py-36 overflow-hidden">
        <div class="mx-auto max-w-7xl px-6 lg:px-12">
            <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 animate-on-scroll fade-in-up">
                <h2 class="text-xs font-semibold tracking-[0.25em] text-primary/70 uppercase">{t("modes.badge")}</h2>
                <p class="mt-4 text-3xl md:text-5xl font-semibold tracking-tight text-white"
                   set:html={t("modes.title")}></p>
                <p class="mt-5 text-base sm:text-lg text-surface-400 leading-relaxed">
                    {t("modes.subtitle")}
                </p>
            </div>

            <div class="mx-auto max-w-5xl">
                <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
                    <!-- Mode 1: BaaS -->
                    <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-7 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up flex flex-col">
                        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                             aria-hidden="true"
                             style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                        <div class="relative z-10 flex-1">
                            <div class="h-10 w-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center ring-1 ring-primary/20 mb-4">
                                <svg class="lucide lucide-server" xmlns="http://www.w3.org/2000/svg" width="20"
                                     height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="20" height="8" x="2" y="2" rx="2" ry="2"/>
                                    <rect width="20" height="8" x="2" y="14" rx="2" ry="2"/>
                                    <line x1="6" x2="6.01" y1="6" y2="6"/>
                                    <line x1="6" x2="6.01" y1="18" y2="18"/>
                                </svg>
                            </div>
                            <h3 class="text-white font-semibold text-lg">{t("modes.baas.title")}</h3>
                            <p class="mt-2 text-sm text-surface-400 leading-relaxed">{t("modes.baas.desc")}</p>
                        </div>
                        <div class="relative z-10 mt-5 pt-4 border-t border-white/5">
                            <span class="text-xs text-surface-500">{t("modes.baas.tag")}</span>
                        </div>
                    </div>

                    <!-- Mode 2: CMS -->
                    <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-7 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up delay-100 flex flex-col">
                        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                             aria-hidden="true"
                             style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                        <div class="relative z-10 flex-1">
                            <div class="h-10 w-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center ring-1 ring-primary/20 mb-4">
                                <svg class="lucide lucide-layout-dashboard" xmlns="http://www.w3.org/2000/svg"
                                     width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="7" height="9" x="3" y="3" rx="1"/>
                                    <rect width="7" height="5" x="14" y="3" rx="1"/>
                                    <rect width="7" height="9" x="14" y="12" rx="1"/>
                                    <rect width="7" height="5" x="3" y="16" rx="1"/>
                                </svg>
                            </div>
                            <h3 class="text-white font-semibold text-lg">{t("modes.cms.title")}</h3>
                            <p class="mt-2 text-sm text-surface-400 leading-relaxed">{t("modes.cms.desc")}</p>
                        </div>
                        <div class="relative z-10 mt-5 pt-4 border-t border-white/5">
                            <span class="text-xs text-surface-500">{t("modes.cms.tag")}</span>
                        </div>
                    </div>

                    <!-- Mode 3: Full -->
                    <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-7 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up delay-200 flex flex-col">
                        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                             aria-hidden="true"
                             style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                        <div class="relative z-10 flex-1">
                            <div class="h-10 w-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center ring-1 ring-primary/20 mb-4">
                                <svg class="lucide lucide-layers" xmlns="http://www.w3.org/2000/svg" width="20"
                                     height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/>
                                    <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/>
                                    <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/>
                                </svg>
                            </div>
                            <h3 class="text-white font-semibold text-lg">{t("modes.full.title")}</h3>
                            <p class="mt-2 text-sm text-surface-400 leading-relaxed">{t("modes.full.desc")}</p>
                        </div>
                        <div class="relative z-10 mt-5 pt-4 border-t border-white/5">
                            <span class="text-xs text-surface-500">{t("modes.full.tag")}</span>
                        </div>
                    </div>
                </div>

                <div class="mt-10 text-center animate-on-scroll fade-in-up delay-300">
                    <a href={translatePath("/why-rebase")}
                       class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors group">
                        {t("modes.link")}
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="group-hover:translate-x-0.5 transition-transform">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>








    <!-- Two big punches — sell feelings, link to depth -->
 <section id="s-security" class="relative isolate py-28 sm:py-36 overflow-hidden">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

                <!-- Punch 1: Your database, your rules -->
                <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-10 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 flex flex-col justify-between animate-on-scroll fade-in-up">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%);"></div>
                    <div class="relative z-10">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-sm font-medium mb-6">

                            <svg
                                    class="lucide lucide-shield-check"
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                            >
                                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                                <path d="m9 12 2 2 4-4"/>
                            </svg>

                            {t("security.badge")}
                        </div>
                        <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl mb-4">
                            {t("security.title")}
                        </h2>
                        <p class="text-lg text-surface-400 leading-relaxed">
                            {t("security.desc")}
                        </p>

                    </div>
                    <div class="relative z-10 mt-8">
                        <a href={translatePath("/studio")}
                           class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-primary transition-colors">
                            {t("security.link")}

                            <svg
                                    class="lucide lucide-arrow-right"
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                            >
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>

                        </a>
                    </div>
                </div>

                <!-- Punch 2: Code you own, deploy anywhere -->
                <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-10 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 flex flex-col justify-between animate-on-scroll fade-in-up delay-100">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%);"></div>
                    <div class="relative z-10">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-sm font-medium mb-6">

                            <svg
                                    class="lucide lucide-git-fork"
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                            >
                                <circle cx="12" cy="18" r="3"/>
                                <circle cx="6" cy="6" r="3"/>
                                <circle cx="18" cy="6" r="3"/>
                                <path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/>
                                <path d="M12 12v3"/>
                            </svg>

                            {t("opensource.badge")}
                        </div>
                        <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl mb-4"
                            set:html={t("opensource.title")}>
                        </h2>
                        <p class="text-lg text-surface-400 leading-relaxed">
                            {t("opensource.desc")}
                        </p>

                    </div>
                    <div class="relative z-10 mt-8 flex items-center gap-6">
                        <a href={translatePath("/developers")}
                           class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-primary transition-colors">
                            {t("opensource.link1")}

                            <svg
                                    class="lucide lucide-arrow-right"
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                            >
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>

                        </a>
                        <a href={translatePath("/why-rebase")}
                           class="inline-flex items-center gap-2 text-sm font-semibold text-surface-400 hover:text-white transition-colors">
                            {t("opensource.link2")}
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- The Agent Era: why a fail-closed backend matters more now -->
 <section id="s-agent-era" class="relative isolate py-28 sm:py-36 overflow-hidden">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-16 animate-on-scroll fade-in-up">
                <p class="text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase">Built for the agent era</p>
                <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-5xl">
                    The backend an agent <span class="text-primary">can't screw up</span>
                </h2>
                <p class="mt-4 text-surface-400 text-base sm:text-lg leading-relaxed">
                    An AI agent can scaffold a backend in an hour. It can't tell you whether that backend is safe.
                    Agents are extremely good at producing <em>plausible</em> backends — and famously bad at
                    producing <em>secure</em> ones. Rebase makes the safe outcome the only outcome, by construction.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-6xl mx-auto animate-on-scroll fade-in-up delay-100">

                <!-- Fail-closed by construction -->
                <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 p-6">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 border border-primary/20 flex-none ring-1 ring-primary/20 text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" class="text-primary">
                                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                                    <path d="m9 12 2 2 4-4"/>
                                </svg>
                            </div>
                        </div>
                        <h3 class="text-lg font-semibold text-white mb-2">Fail-closed by construction</h3>
                        <p class="text-surface-400 text-sm leading-relaxed mb-4">
                            Authorization in Rebase is Postgres row-level security, enforced by the database itself —
                            not by hoping the agent wrote good middleware. A table without RLS is never served.
                            There is no auth check to forget, so there is nothing your agent can forget to write.
                        </p>
                        <div class="flex flex-wrap gap-1.5">
                            <span class="px-2 py-1 rounded-lg bg-surface-800/60 text-xs text-surface-300 ring-1 ring-surface-700/50">Enforced by Postgres</span>
                            <span class="px-2 py-1 rounded-lg bg-surface-800/60 text-xs text-surface-300 ring-1 ring-surface-700/50">Unprotected tables refused</span>
                        </div>
                    </div>
                </div>

                <!-- Agent-native, not agent-washed -->
                <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 p-6">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
