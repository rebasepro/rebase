---
const { lang, t } = Astro.props;
import ScrollSyncShowcase from '../../components/ScrollSyncShowcase.astro';
import CollectionPowerSection from '../../components/CollectionPowerSection.astro';
import RebaseMosaicDemo from '../../components/demos/RebaseMosaicDemo';
import SectionBackgroundAccents from '../../components/SectionBackgroundAccents.astro';
import { AdminDemoCarousel } from '../../components/demos/AdminDemoCarousel';
import { BodyPartsDemo } from '../../components/demos/BodyPartsDemo';
import { ApiMiniDemo } from '../../components/demos/ApiMiniDemo';
import { SdkMiniDemo } from '../../components/demos/SdkMiniDemo';
import { RealtimeMiniDemo } from '../../components/demos/RealtimeMiniDemo';
import RoadmapSection from '../../components/RoadmapSection.astro';
import ABVariant from '../../components/ABVariant.astro';

import ClientLogos from '../../components/ClientLogos.astro';

import { languages, defaultLang, useTranslations, useTranslatedPath } from '../../i18n/ui';

const translatePath = useTranslatedPath(lang);




---


    <main class="flex flex-col">

        <!-- Hero -->
        <section id="s-hero" class="relative isolate overflow-hidden bg-black pt-16 pb-24 sm:pt-20 sm:pb-28 lg:pt-24 lg:pb-32">
            <!-- Background gradient top shape -->
            <!-- Centered radial gradient glow -->
            <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background: radial-gradient(ellipse 45% 32% at 50% 35%, rgba(0, 112, 244, 0.18) 0%, rgba(0, 80, 200, 0.08) 45%, transparent 80%);"></div>

            <div class="px-4 mx-auto max-w-7xl text-center lg:px-12 relative z-10">
                <!-- Badge -->
                <div class="mb-8 flex items-center justify-center gap-3 animate-on-scroll fade-in">
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-surface-700 bg-surface-900/60 text-xs font-medium text-surface-400">
                        <span class="inline-block text-base">🐘</span>
                        {t('hero.badge')}
                    </span>
                </div>

                <!-- Headline -->
                <div class="relative">
                    <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(0, 112, 244, 0.10) 0%, rgba(0, 80, 200, 0.05) 45%, transparent 75%); filter: blur(20px);"></div>
                    <ABVariant experiment="hero-headline" variant="control">
                        <h1 class="relative mb-6 text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.08] text-white animate-on-scroll fade-in-up">
                            {t('hero.title.part1')}<br/><span class="text-primary subtle-shimmer">{t('hero.title.part2')}</span>
                        </h1>
                    </ABVariant>
                    <ABVariant experiment="hero-headline" variant="benefit">
                        <h1 class="relative mb-6 text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.08] text-white animate-on-scroll fade-in-up">
                            One TypeScript Schema.<br/><span class="text-primary subtle-shimmer">Your Entire Backend.</span>
                        </h1>
                    </ABVariant>
                    <ABVariant experiment="hero-headline" variant="action">
                        <h1 class="relative mb-6 text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.08] text-white animate-on-scroll fade-in-up">
                            Stop Building Plumbing.<br/><span class="text-primary subtle-shimmer">Start Shipping Product.</span>
                        </h1>
                    </ABVariant>
                </div>
                <p class="mb-4 text-lg leading-8 text-surface-400 lg:text-xl sm:px-10 xl:px-40 animate-on-scroll fade-in-up" set:html={t('hero.subtitle')} />
                <p class="mb-8 text-sm font-medium text-surface-500 tracking-wide animate-on-scroll fade-in-up">{t('hero.category')}</p>

                <!-- Hero CTA Buttons -->
                <div class="mt-8 mb-10 flex flex-wrap items-center justify-center gap-y-4 gap-x-6 sm:gap-x-8 animate-on-scroll fade-in-up">
                    <a href="https://demo.rebase.pro"
                       target="_blank" rel="noopener noreferrer"
                       id="hero-try-demo"
                       class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-all duration-200 ease-in-out btn-glow">
                        {t('hero.cta.demo')}
                        <svg
                          class="lucide lucide-arrow-right"
                          xmlns="http://www.w3.org/2000/svg"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M5 12h14" />
                          <path d="m12 5 7 7-7 7" />
                        </svg>
                    </a>
                    <a href="https://github.com/rebasepro/rebase"
                       target="_blank" rel="noopener noreferrer"
                       id="hero-view-github"
                       class="inline-flex items-center gap-x-2 rounded-lg border border-white/10 bg-white/5 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-white/10 hover:border-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/20 transition-all duration-200 ease-in-out">
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
                        {t('hero.cta.github')}
                    </a>
                </div>

                <!-- Hero CLI command -->
                <div class="mt-12 max-w-md mx-auto animate-on-scroll fade-in-up">
                    <div class="group relative">
                        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-0 group-hover:opacity-100 blur-lg transition-opacity duration-500" aria-hidden="true"></div>
                        <div class="relative rounded-xl bg-surface-900/80 border border-surface-700/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_16px_48px_rgba(0,0,0,0.5)] overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                            <div class="px-5 py-4 flex items-center justify-between">
                                <div class="font-mono text-sm sm:text-base flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                    <span class="text-primary font-bold mr-3">~</span>
                                    <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                                </div>
                                <button data-track-copy="hero" data-command="pnpm dlx @rebasepro/cli init" class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors" aria-label="Copy command" title="Copy to clipboard">
                                    <svg class="lucide lucide-copy" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
                                </button>
                            </div>
                            <div class="px-5 pb-3 -mt-1">
                                <span class="font-mono text-xs text-surface-500">or: npx @rebasepro/cli init</span>
                            </div>
                        </div>
                    </div>
                </div>



            </div>
        </section>

        <!-- Social proof -->
        <section id="s-social-proof" class="bg-black py-20 sm:py-28">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <p class="text-center text-sm text-surface-500 mb-8 animate-on-scroll fade-in">{t('social.title')}</p>
                <ClientLogos />
            </div>
        </section>


        <!-- Product demo -->
        <section id="s-demo-terminal" class="bg-black border-b border-surface-900 relative pt-32 pb-40 sm:pt-48 sm:pb-56">
            <!-- subtle separator line -->
            <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-surface-700/40 to-transparent"></div>

            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="max-w-3xl mx-auto text-center animate-on-scroll fade-in-up">
                    <p class="text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase">{t('demo.badge')}</p>
                    <h2 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-white">
                        {t('demo.title')}
                    </h2>
                    <div class="mt-8 max-w-2xl mx-auto">
                        <div class="rounded-2xl bg-surface-900/80 border border-surface-800/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_24px_80px_rgba(0,0,0,0.65)] text-left relative overflow-hidden group hover:border-primary/40 transition-colors duration-300">
                            <!-- Glow effect behind terminal -->
                            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-500" aria-hidden="true" style="background: radial-gradient(400px 200px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 0;"></div>
                            
                            <div class="relative z-10 flex items-center justify-between px-4 py-3 border-b border-surface-800/80 bg-surface-950/50">
                                <div class="flex items-center gap-1.5">
                                    <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                                    <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                                    <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                                </div>
                                <div class="text-[11px] font-mono font-medium text-surface-500 flex items-center gap-2">
                                    
<svg
  class="lucide lucide-terminal"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M12 19h8" />
  <path d="m4 17 6-6-6-6" />
</svg>

                                    bash
                                </div>
                                <div class="w-12"></div> <!-- spacer -->
                            </div>
                            
                            <div class="relative z-10 font-mono text-[13px] sm:text-sm text-surface-200 space-y-4 px-5 py-5 bg-gradient-to-b from-surface-900/50 to-transparent">
                                <div>
                                    <div class="flex gap-3 items-center justify-between">
                                        <div class="flex gap-3 items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                            <span class="text-primary font-bold">~</span>
                                            <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                                        </div>
                                        <button data-track-copy="demo-terminal" data-command="pnpm dlx @rebasepro/cli init" class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors" aria-label="Copy command" title="Copy to clipboard">
                                            
<svg
  class="lucide lucide-copy"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
</svg>

                                        </button>
                                    </div>
                                    <div class="text-surface-500 text-xs mt-1 ml-6">{t('demo.init')}</div>
                                </div>
                                
                                <div>
                                    <div class="flex gap-3 items-center justify-between">
                                        <div class="flex gap-3 items-center">
                                            <span class="text-primary font-bold">~</span>
                                            <span class="text-white">pnpm rebase introspect</span>
                                        </div>
                                        <button data-track-copy="demo-introspect" data-command="pnpm rebase introspect" class="copy-btn text-surface-500 hover:text-white transition-colors" aria-label="Copy command" title="Copy to clipboard">
                                            
<svg
  class="lucide lucide-copy"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
</svg>

                                        </button>
                                    </div>
                                    <div class="text-surface-500 text-xs mt-1 ml-6">{t('demo.pull')}</div>
                                </div>
                                
                                <div>
                                    <div class="flex gap-3 items-center justify-between">
                                        <div class="flex gap-3 items-center">
                                            <span class="text-primary font-bold">~</span>
                                            <span class="text-white">pnpm dev</span>
                                        </div>
                                        <button data-track-copy="demo-dev" data-command="pnpm dev" class="copy-btn text-surface-500 hover:text-white transition-colors" aria-label="Copy command" title="Copy to clipboard">
                                            
<svg
  class="lucide lucide-copy"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
</svg>

                                        </button>
                                    </div>
                                    <div class="text-emerald-400/90 text-xs mt-1 ml-6">{t('demo.dev')}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <section id="s-demo-carousel" class="bg-black relative py-24 sm:py-32">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-10 max-w-2xl mx-auto animate-on-scroll fade-in-up">
                    <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-white mb-3">
                        Automated React Admin UI
                    </h2>
                    <p class="text-surface-400 text-sm leading-relaxed max-w-xl mx-auto">
                        Your TypeScript schema generates a spreadsheet-like data manager, Kanban board, and list view instantly.
                    </p>
                </div>
                <div style="min-height: 700px;">
                    <AdminDemoCarousel client:load />
                </div>
                <p class="mt-2 text-center text-xs sm:text-sm text-surface-500">
                    A quick tour of the generated Rebase admin panel.
                </p>
                <div class="mt-6 flex items-center justify-center gap-2 text-xs text-surface-500 font-medium">
                    <svg class="h-3.5 w-3.5 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                    </svg>
                    <span>Alternative to</span>
                    <div class="flex items-center gap-3.5">
                        <span class="flex items-center gap-1 text-surface-400 hover:text-rose-400 transition-colors">
                            <svg class="h-3 w-auto fill-current" viewBox="0 0 24 24">
                                <path d="M11.992 1.966c-.434 0-.87.086-1.28.257L1.779 5.917c-.503.208-.49.908.012 1.116l8.982 3.558a3.266 3.266 0 0 0 2.454 0l8.982-3.558c.503-.196.503-.908.012-1.116l-8.957-3.694a3.255 3.255 0 0 0-1.272-.257zM23.4 8.056a.589.589 0 0 0-.222.045l-10.012 3.877a.612.612 0 0 0-.38.564v8.896a.6.6 0 0 0 .821.552L23.62 18.1a.583.583 0 0 0 .38-.551V8.653a.6.6 0 0 0-.6-.596zM.676 8.095a.644.644 0 0 0-.48.19C.086 8.396 0 8.53 0 8.69v8.355c0 .442.515.737.908.54l6.27-3.006.307-.147 2.969-1.436c.466-.22.43-.908-.061-1.092L.883 8.138a.57.57 0 0 0-.207-.044z"/>
                            </svg>
                            Airtable
                        </span>
                        <a href={translatePath("/rebase-vs-retool")} class="flex items-center gap-1 text-surface-400 hover:text-violet-500 transition-colors">
                            <svg class="h-3 w-auto fill-current" viewBox="0 0 24 24">
                                <path d="M0 2.2A2.2 2.2 0 0 1 2.2 0h8.6A2.2 2.2 0 0 1 13 2.2v1.7A1.1 1.1 0 0 1 11.9 5H1.1A1.1 1.1 0 0 1 0 3.9V2.2zm0 6.9A1.1 1.1 0 0 1 1.1 8h20.7a2.2 2.2 0 0 1 2.2 2.2v5.7a1.1 1.1 0 0 1-1.1 1.1H2.2A2.2 2.2 0 0 1 0 14.8V9.1zm11 12a1.1 1.1 0 0 1 1.1-1.1h10.8a1.1 1.1 0 0 1 1.1 1.1v.7a2.2 2.2 0 0 1-2.2 2.2h-8.6a2.2 2.2 0 0 1-2.2-2.2v-.7z"/>
                            </svg>
                            Retool
                        </a>
                        <a href={translatePath("/rebase-vs-directus")} class="flex items-center gap-1 text-surface-400 hover:text-blue-400 transition-colors">
                            <svg class="h-3 w-auto fill-current" viewBox="0 0 24 24">
                                <path d="M19.187 13.909a1.74 1.74 0 0 1-.286-.092.657.657 0 0 1-.203-.139c.056-.488 0-.912.047-1.392.184-1.862 1.355-1.272 2.406-1.577.655-.184 1.31-.562 1.475-1.336a13.528 13.528 0 0 0-2.397-2.204c-2.85-2.028-6.574-2.84-9.958-2.277a5.113 5.113 0 0 0 2.238 2.074s-.917 0-1.703-.587c-.23.092-.692.274-.913.384a5.094 5.094 0 0 0 6.63.37c-.01.017-.185.285-.397 1.4-.47 2.38-1.826 2.195-3.504 1.596-3.485-1.264-5.403-.093-7.145-2.49-.507.286-.82.82-.82 1.402 0 .599.331 1.106.81 1.383.262-.348.38-.446.836-.446-.706.4-.79.75-1.094 1.718-.368 1.171-.212 2.37-1.936 2.683-.913.046-.894.664-1.226 1.586-.415 1.199-.968 1.678-2.047 2.812.443.535.904.6 1.374.406.968-.406 1.715-1.66 2.415-2.471.784-.904 2.665-.517 4.085-1.402.977-.599 1.457-1.41.811-2.784a2.72 2.72 0 0 1 .701 1.66c1.641-.213 3.836 1.788 5.836 2.12a3.574 3.574 0 0 1-.488-.82c-.23-.554-.304-1.06-.258-1.503.184 1.097 1.29 2.507 3.07 2.637.452.036.95-.019 1.466-.176.618-.184 1.19-.424 1.872-.295.507.093.977.35 1.272.784.443.645 1.41.784 1.844-.009-.977-2.554-3.67-2.72-4.813-3.015z"/>
                            </svg>
                            Directus
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- How it works -->
        <section id="s-how-it-works" class="relative py-28 sm:py-36 overflow-hidden bg-black">
            <div class="mx-auto max-w-7xl px-6 lg:px-12">
                <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 animate-on-scroll fade-in-up">
                    <h2 class="text-xs font-semibold tracking-[0.25em] text-primary/70 uppercase">{t('howitworks.badge')}</h2>
                    <p class="mt-4 text-3xl md:text-5xl font-semibold tracking-tight text-white" set:html={t('howitworks.title')}></p>
                    <p class="mt-5 text-base sm:text-lg text-surface-400 leading-relaxed">
                        {t('howitworks.subtitle')}
                    </p>
                </div>

                <div class="mx-auto max-w-5xl">
                    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
                        <!-- Step 1: Connect -->
                        <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-7 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up">
                            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300" aria-hidden="true" style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                            <div class="relative z-10 flex items-start gap-4">
                                <div class="h-10 w-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center flex-none ring-1 ring-primary/20">
                                    
<svg
  class="lucide lucide-database"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <ellipse cx="12" cy="5" rx="9" ry="3" />
  <path d="M3 5V19A9 3 0 0 0 21 19V5" />
  <path d="M3 12A9 3 0 0 0 21 12" />
</svg>

                                </div>
                                <div>
                                    <h3 class="text-white font-semibold">{t('howitworks.step1.title')}</h3>
                                    <p class="mt-1 text-sm text-surface-400 leading-relaxed">
                                        {t('howitworks.step1.desc')}
                                    </p>
                                    <div class="mt-4 rounded-lg bg-surface-900/80 border border-surface-800/80 shadow-[0_4px_12px_rgba(0,0,0,0.2)] overflow-hidden relative z-10 group-hover:border-primary/40 transition-colors duration-300">
                                        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-500" aria-hidden="true" style="background: radial-gradient(120px 80px at 50% 100%, rgba(0,112,244,0.1), transparent 100%);"></div>
                                        <div class="flex items-center justify-between px-3 py-1.5 border-b border-surface-800/80 bg-surface-950/50">
                                            <div class="flex items-center gap-1.5">
