---
const {
    lang,
    t
} = Astro.props;
import { AdminDemoCarousel } from "../../components/demos/AdminDemoCarousel";
import { AdoptionStackDemo } from "../../components/demos/AdoptionStackDemo";
import { BodyPartsDemo } from "../../components/demos/BodyPartsDemo";
import { ApiMiniDemo } from "../../components/demos/ApiMiniDemo";
import { SdkMiniDemo } from "../../components/demos/SdkMiniDemo";
import { RealtimeMiniDemo } from "../../components/demos/RealtimeMiniDemo";
import { RLSEditorDemo } from "../../components/demos/RLSEditorDemo";
import AiAppDevelopmentDemo from "../../components/demos/AiAppDevelopmentDemo";
import { AgentConsoleDemo } from "../../components/demos/AgentConsoleDemo";
import RebaseMosaicDemo from "../../components/demos/RebaseMosaicDemo";
import CollectionPowerSection from "../../components/CollectionPowerSection.astro";
import RoadmapSection from "../../components/RoadmapSection.astro";
import { NeatBackground } from '../../components/NeatBackground';


import ClientLogos from "../../components/ClientLogos.astro";

import { useTranslatedPath } from "../../i18n/ui";

const translatePath = useTranslatedPath(lang);

---


<div class="flex flex-col isolate">

    <!-- Hero -->
 <section id="s-hero"
             class="relative isolate overflow-hidden -mt-20 pt-52 pb-24 sm:pt-56 sm:pb-28 lg:pt-60 lg:pb-32">
        <!-- Animated WebGL gradient background (Neat - funky preset) -->
        <NeatBackground client:idle randomize={false} />


        <div class="px-4 mx-auto max-w-7xl text-center lg:px-8 relative z-10 mt-8">
            <!-- Badge -->
            <div class="mb-8 flex items-center justify-center gap-3 animate-on-scroll fade-in">
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-surface-700 bg-surface-900/60 text-xs font-medium text-surface-400">
                        <img src="/img/postgresql-logo.svg" alt="PostgreSQL" class="h-4 w-auto"/>
                        {t("hero.badge")}
                    </span>
            </div>

            <!-- Headline -->
            <div class="relative">

                <h1 class="relative mb-6 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.08] text-white animate-on-scroll fade-in-up">
                    {t("hero.title.part1")}<br/><span class="text-primary">{t("hero.title.part2")}</span>
                </h1>
            </div>
            <p class="mb-4 text-lg leading-8 text-surface-400 lg:text-xl sm:px-10 xl:px-40 animate-on-scroll fade-in-up"
               set:html={t("hero.subtitle")}/>

            <!-- Hero primary CTA: zero-friction live demo -->
            <div class="mt-10 flex flex-col items-center gap-2.5 animate-on-scroll fade-in-up">
                <a href="https://demo.rebase.pro"
                   target="_blank" rel="noopener noreferrer"
                   id="hero-try-demo"
                   class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-7 py-3.5 text-base font-semibold text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-all duration-200 ease-in-out btn-glow">
                    {t("hero.cta.demo")}
                    <svg
                            class="lucide lucide-arrow-right"
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                    >
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
                <span class="text-xs text-surface-500">{t("hero.cta.demo.note")}</span>
            </div>

            <!-- Hero secondary path: run locally via CLI -->
            <div class="mt-10 mb-10 max-w-md mx-auto animate-on-scroll fade-in-up">
                <p class="mb-3 text-sm text-surface-400">{t("hero.cli.label")}</p>
                <div class="group relative">
                    <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-0 group-hover:opacity-100 blur-lg transition-opacity duration-500"
                         aria-hidden="true"></div>
                    <div class="relative rounded-xl bg-surface-900/80 border border-surface-700/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_16px_48px_rgba(0,0,0,0.5)] overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                        <div class="px-5 py-4 flex items-center justify-between">
                            <div class="font-mono text-sm sm:text-base flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                <span class="text-primary font-bold mr-3">~</span>
                                <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                            </div>
                            <button data-track-copy="hero" data-command="pnpm dlx @rebasepro/cli init"
                                    class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                    aria-label="Copy command" title="Copy to clipboard">
                                <svg class="lucide lucide-copy" xmlns="http://www.w3.org/2000/svg" width="18"
                                     height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                            </button>
                        </div>
                        <div class="px-5 pb-3 -mt-1">
                            <span class="font-mono text-xs text-surface-400">or: npx @rebasepro/cli init</span>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </section>

    <!-- Free tool — the zero-commitment entry point.
         Placed immediately after the hero and ahead of social proof on purpose:
         every other CTA on this page (live demo, GitHub, `cli init`) assumes the
         visitor already wants to adopt something. This one asks for nothing, runs
         against the database they already have, and turns the hero's claim about
         RLS into something testable in ten seconds. -->
 <section id="s-rls-check" class="relative z-10 py-16 sm:py-20">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
            <div class="rounded-2xl border border-surface-700/80 bg-surface-900/60 px-6 py-10 sm:px-10 sm:py-12 animate-on-scroll fade-in-up">
                <div class="text-center">
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-xs font-medium text-primary">
                        {t("rlscheck.badge")}
                    </span>
                    <h2 class="mt-5 text-2xl sm:text-3xl font-bold tracking-tight text-white">{t("rlscheck.title")}</h2>
                    <p class="mt-4 text-base leading-7 text-surface-400">{t("rlscheck.subtitle")}</p>
                </div>

                <!-- Same command-card idiom as the hero CLI block, deliberately -->
                <div class="mt-8 group relative">
                    <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-0 group-hover:opacity-100 blur-lg transition-opacity duration-500"
                         aria-hidden="true"></div>
                    <div class="relative rounded-xl bg-surface-950/80 border border-surface-700/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_16px_48px_rgba(0,0,0,0.5)] overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                        <div class="px-5 py-4 flex items-center justify-between">
                            <div class="font-mono text-sm sm:text-base flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                <span class="text-primary font-bold mr-3">~</span>
                                <span class="text-white">npx @rebasepro/rls-check $DATABASE_URL</span>
                            </div>
                            <button data-track-copy="rls-check" data-command="npx @rebasepro/rls-check $DATABASE_URL"
                                    class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                    aria-label="Copy command" title="Copy to clipboard">
                                <svg class="lucide lucide-copy" xmlns="http://www.w3.org/2000/svg" width="18"
                                     height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <p class="mt-5 text-center text-xs leading-6 text-surface-500">{t("rlscheck.note")}</p>

                <div class="mt-6 text-center">
                    <a href="https://github.com/rebasepro/rebase/tree/main/packages/rls-check"
                       target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-x-2 text-sm font-medium text-primary hover:underline">
                        {t("rlscheck.cta")}
                        <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="16"
                             height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Social proof -->
 <section id="s-social-proof" class="relative z-0 py-20 sm:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <p class="text-center text-sm text-surface-400 mb-8 animate-on-scroll fade-in">{t("social.title")}</p>
            <ClientLogos/>
        </div>
    </section>

    <!-- Product demo -->
 <section id="s-demo-terminal" class="relative z-0 pt-32 pb-40 sm:pt-48 sm:pb-56">

        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mx-auto text-center animate-on-scroll fade-in-up">
                <p class="text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase"><span class="font-mono text-surface-500">01</span><span class="mx-2 text-surface-600">·</span>{t("demo.badge")}</p>
                <h2 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-white">
                    {t("demo.title")}
                </h2>
                <div class="mt-8 max-w-2xl mx-auto">
                    <div class="rounded-2xl bg-surface-900/80 border border-surface-800/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_24px_80px_rgba(0,0,0,0.65)] text-left relative overflow-hidden group hover:border-primary/40 transition-colors duration-300">
                        <!-- Glow effect behind terminal -->
                        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-500"
                             aria-hidden="true"
                             style="background: radial-gradient(400px 200px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 0;"></div>

                        <div class="relative z-10 flex items-center justify-between px-4 py-3 border-b border-surface-800/80 bg-surface-950/50">
                            <div class="flex items-center gap-1.5">
                                <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                                <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                            </div>
                            <div class="text-[11px] font-mono font-medium text-surface-400 flex items-center gap-2">

                                <svg
                                        class="lucide lucide-terminal"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                >
                                    <path d="M12 19h8"/>
                                    <path d="m4 17 6-6-6-6"/>
                                </svg>

                                bash
                            </div>
                            <div class="w-12"></div> <!-- spacer -->
                        </div>

                        <div class="relative z-10 font-mono text-[13px] sm:text-sm text-surface-200 space-y-4 px-5 py-5 bg-gradient-to-b from-surface-900/50 to-transparent">
                            <div>
                                <div class="flex gap-3 items-center justify-between">
                                    <div class="flex gap-3 items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                        <span class="text-primary font-bold">~</span>
                                        <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                                    </div>
                                    <button data-track-copy="demo-terminal" data-command="pnpm dlx @rebasepro/cli init"
                                            class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                            aria-label="Copy command" title="Copy to clipboard">

                                        <svg
                                                class="lucide lucide-copy"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                        >
                                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                        </svg>

                                    </button>
                                </div>
                                <div class="text-surface-400 text-xs mt-1 ml-6">{t("demo.init")}</div>
                            </div>

                            <div>
                                <div class="flex gap-3 items-center justify-between">
                                    <div class="flex gap-3 items-center">
                                        <span class="text-primary font-bold">~</span>
                                        <span class="text-white">pnpm rebase db push</span>
                                    </div>
                                    <button data-track-copy="demo-db-push" data-command="pnpm rebase db push"
                                            class="copy-btn text-surface-500 hover:text-white transition-colors"
                                            aria-label="Copy command" title="Copy to clipboard">

                                        <svg
                                                class="lucide lucide-copy"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                        >
                                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                        </svg>

                                    </button>
                                </div>
                                <div class="text-surface-400 text-xs mt-1 ml-6">{t("demo.pull")}</div>
                            </div>

                            <div>
                                <div class="flex gap-3 items-center justify-between">
                                    <div class="flex gap-3 items-center">
                                        <span class="text-primary font-bold">~</span>
                                        <span class="text-white">pnpm dev</span>
                                    </div>
                                    <button data-track-copy="demo-dev" data-command="pnpm dev"
                                            class="copy-btn text-surface-500 hover:text-white transition-colors"
                                            aria-label="Copy command" title="Copy to clipboard">

                                        <svg
                                                class="lucide lucide-copy"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                        >
                                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                        </svg>

                                    </button>
                                </div>
                                <div class="text-emerald-400/90 text-xs mt-1 ml-6">{t("demo.dev")}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>



    <!-- Neat gradient divider -->
    <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden" style="z-index: -1; height: 600px;">
        <NeatBackground variant="b" client:visible/>
    </div>

    <div id="s-collection-power" class="relative z-0">
        <!-- One Collection. Everything. -->
        <CollectionPowerSection/>
    </div>

    <!-- The backend underneath: SDK / REST / realtime proof -->
 <section id="s-backend-engine" class="relative z-0 py-24 sm:py-32 overflow-hidden">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-14 animate-on-scroll fade-in-up">
                <p class="text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase"><span class="font-mono text-surface-500">03</span><span class="mx-2 text-surface-600">·</span>{t("engine.badge")}</p>
                <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-5xl">{t("engine.title")}</h2>
                <p class="mt-4 text-surface-400 text-base sm:text-lg leading-relaxed">{t("engine.subtitle")}</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5 max-w-5xl mx-auto">
                <!-- TypeScript SDK -->
                <div class="md:col-span-2 lg:col-span-4 group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10 flex flex-col aspect-[5/3] overflow-hidden bg-surface-950 pointer-events-none border-b border-surface-800/80">
                        <!-- Window controls -->
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50 backdrop-blur-sm">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                            <div class="ml-2 text-[10px] font-mono text-surface-400">app.ts</div>
                        </div>
                        <div class="relative flex-1 w-full overflow-hidden flex items-center justify-center" inert aria-hidden="true">
                            <SdkMiniDemo client:load/>
                        </div>
                    </div>
                    <div class="relative z-10 p-5 flex flex-col justify-between h-full min-h-[160px]">
                        <div>
                            <div class="flex items-center gap-2 mb-2">
                                <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20">
                                    <svg class="lucide lucide-code" xmlns="http://www.w3.org/2000/svg" width="20"
                                         height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m16 18 6-6-6-6"/>
                                        <path d="m8 6-6 6 6 6"/>
                                    </svg>
                                </div>
                                <h3 class="text-base font-semibold text-white">{t("features.sdk.title")}</h3>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-medium ring-1 ring-primary/20 ml-auto">
                                        {t("features.sdk.badge")}
                                    </span>
                            </div>
                            <p class="text-surface-400 text-sm leading-relaxed">{t("features.sdk.desc")}</p>
                        </div>

                    </div>
                </div>

                <!-- Data history & audit -->
                <div class="lg:col-span-2 group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in delay-100">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10 flex flex-col aspect-[4/3] overflow-hidden bg-surface-950 border-b border-surface-800/80">
                        <!-- Window controls -->
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50 backdrop-blur-sm">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                        </div>
                        <div class="relative flex-1 w-full overflow-hidden">
                            <img
                                    src="/img/history.webp"
                                    alt="Data history and audit view"
                                    width="800"
                                    height="600"
                                    loading="lazy"
                                    class="w-full h-full object-cover object-top"/>
                        </div>
                    </div>
                    <div class="relative z-10 p-5">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20">

                                <svg
                                        class="lucide lucide-history"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                >
                                    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                                    <path d="M3 3v5h5"/>
                                    <path d="M12 7v5l4 2"/>
                                </svg>

                            </div>
                            <h3 class="text-base font-semibold text-white">{t("features.history.title")}</h3>
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-medium ring-1 ring-primary/20 ml-auto">
                                    {t("features.history.badge")}
                                </span>
                        </div>
                        <p class="text-surface-400 text-sm leading-relaxed">{t("features.history.desc")}</p>
                    </div>
                </div>

                <!-- Import & export -->
                <div class="lg:col-span-2 group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in delay-200">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10 flex flex-col aspect-[4/3] overflow-hidden bg-surface-950 border-b border-surface-800/80">
                        <!-- Window controls -->
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50 backdrop-blur-sm">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
