---
const {
    lang,
    t
} = Astro.props;
import ScrollSyncShowcase from "../../components/ScrollSyncShowcase.astro";
import CollectionPowerSection from "../../components/CollectionPowerSection.astro";
import RebaseMosaicDemo from "../../components/demos/RebaseMosaicDemo";
import SectionBackgroundAccents from "../../components/SectionBackgroundAccents.astro";
import { AdminDemoCarousel } from "../../components/demos/AdminDemoCarousel";
import { BodyPartsDemo } from "../../components/demos/BodyPartsDemo";
import { ApiMiniDemo } from "../../components/demos/ApiMiniDemo";
import { SdkMiniDemo } from "../../components/demos/SdkMiniDemo";
import { RealtimeMiniDemo } from "../../components/demos/RealtimeMiniDemo";
import RoadmapSection from "../../components/RoadmapSection.astro";
import { NeatHeroBackground } from "../../components/NeatHeroBackground";
import { NeatSectionDivider } from "../../components/NeatSectionDivider";


import ClientLogos from "../../components/ClientLogos.astro";

import { useTranslatedPath } from "../../i18n/ui";

const translatePath = useTranslatedPath(lang);
---


<main class="flex flex-col">

    <!-- Hero -->
    <section id="s-hero"
             class="relative isolate overflow-hidden bg-black -mt-20 pt-52 pb-24 sm:pt-56 sm:pb-28 lg:pt-60 lg:pb-32">
        <!-- Animated WebGL gradient background (Neat - funky preset) -->
        <NeatHeroBackground client:load/>
        <!-- Subtle radial glow over the gradient for text readability -->
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
             style="background: radial-gradient(ellipse 45% 32% at 50% 55%, rgba(0, 112, 244, 0.18) 0%, rgba(0, 80, 200, 0.08) 45%, transparent 80%);"></div>

        <div class="px-4 mx-auto max-w-7xl text-center lg:px-8 relative z-10 mt-8">
            <!-- Badge -->
            <div class="mb-8 flex items-center justify-center gap-3 animate-on-scroll fade-in">
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-surface-700 bg-surface-900/60 text-xs font-medium text-surface-400">
                        <img src="/img/postgresql-logo.svg" alt="PostgreSQL" class="h-4 w-auto"/>
                        {t("hero.badge")}
                    </span>
            </div>

            <!-- Headline -->
            <div class="relative">
                <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
                     style="background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(0, 112, 244, 0.10) 0%, rgba(0, 80, 200, 0.05) 45%, transparent 75%); filter: blur(20px);"></div>
                <h1 class="relative mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.08] text-white animate-on-scroll fade-in-up">
                    {t("hero.title.part1")}<br/><span class="text-primary subtle-shimmer">{t("hero.title.part2")}</span>
                </h1>
            </div>
            <p class="mb-4 text-lg leading-8 text-surface-400 lg:text-xl sm:px-10 xl:px-40 animate-on-scroll fade-in-up"
               set:html={t("hero.subtitle")}/>
            <p class="mb-8 text-sm font-medium text-surface-500 tracking-wide animate-on-scroll fade-in-up">{t("hero.category")}</p>

            <!-- Hero CTA Buttons -->
            <div class="mt-8 mb-10 flex flex-wrap items-center justify-center gap-y-4 gap-x-6 sm:gap-x-8 animate-on-scroll fade-in-up">
                <a href="https://demo.rebase.pro"
                   target="_blank" rel="noopener noreferrer"
                   id="hero-try-demo"
                   class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-all duration-200 ease-in-out btn-glow">
                    {t("hero.cta.demo")}
                    <svg
                            class="lucide lucide-arrow-right"
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                    >
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
                <a href="https://github.com/rebasepro/rebase"
                   target="_blank" rel="noopener noreferrer"
                   id="hero-view-github"
                   class="inline-flex items-center gap-x-2 rounded-lg border border-white/10 bg-white/5 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-white/10 hover:border-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/20 transition-all duration-200 ease-in-out">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd"
                              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                              clip-rule="evenodd"/>
                    </svg>
                    {t("hero.cta.github")}
                </a>
            </div>

            <!-- Hero CLI command -->
            <div class="mt-12 max-w-md mx-auto animate-on-scroll fade-in-up">
                <div class="group relative">
                    <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-primary/20 via-primary/10 to-primary/20 opacity-0 group-hover:opacity-100 blur-lg transition-opacity duration-500"
                         aria-hidden="true"></div>
                    <div class="relative rounded-xl bg-surface-900/80 border border-surface-700/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_16px_48px_rgba(0,0,0,0.5)] overflow-hidden group-hover:border-primary/40 transition-colors duration-300">
                        <div class="px-5 py-4 flex items-center justify-between">
                            <div class="font-mono text-sm sm:text-base flex items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                <span class="text-primary font-bold mr-3">~</span>
                                <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                            </div>
                            <button data-track-copy="hero" data-command="pnpm dlx @rebasepro/cli init"
                                    class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                    aria-label="Copy command" title="Copy to clipboard">
                                <svg class="lucide lucide-copy" xmlns="http://www.w3.org/2000/svg" width="18"
                                     height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                            </button>
                        </div>
                        <div class="px-5 pb-3 -mt-1">
                            <span class="font-mono text-xs text-surface-500">or: npx @rebasepro/cli init</span>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </section>

    <!-- Social proof -->
    <section id="s-social-proof" class="relative z-0 bg-black py-20 sm:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <p class="text-center text-sm text-surface-500 mb-8 animate-on-scroll fade-in">{t("social.title")}</p>
            <ClientLogos/>
        </div>
    </section>


    <!-- Product demo -->
    <section id="s-demo-terminal" class="relative z-0 pt-32 pb-40 sm:pt-48 sm:pb-56">
        <!-- subtle separator line -->
        <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-surface-700/40 to-transparent"></div>

        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mx-auto text-center animate-on-scroll fade-in-up">
                <p class="text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase">{t("demo.badge")}</p>
                <h2 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-white">
                    {t("demo.title")}
                </h2>
                <div class="mt-8 max-w-2xl mx-auto">
                    <div class="rounded-2xl bg-surface-900/80 border border-surface-800/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_24px_80px_rgba(0,0,0,0.65)] text-left relative overflow-hidden group hover:border-primary/40 transition-colors duration-300">
                        <!-- Glow effect behind terminal -->
                        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-500"
                             aria-hidden="true"
                             style="background: radial-gradient(400px 200px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 0;"></div>

                        <div class="relative z-10 flex items-center justify-between px-4 py-3 border-b border-surface-800/80 bg-surface-950/50">
                            <div class="flex items-center gap-1.5">
                                <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                                <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                            </div>
                            <div class="text-[11px] font-mono font-medium text-surface-500 flex items-center gap-2">

                                <svg
                                        class="lucide lucide-terminal"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                >
                                    <path d="M12 19h8"/>
                                    <path d="m4 17 6-6-6-6"/>
                                </svg>

                                bash
                            </div>
                            <div class="w-12"></div> <!-- spacer -->
                        </div>

                        <div class="relative z-10 font-mono text-[13px] sm:text-sm text-surface-200 space-y-4 px-5 py-5 bg-gradient-to-b from-surface-900/50 to-transparent">
                            <div>
                                <div class="flex gap-3 items-center justify-between">
                                    <div class="flex gap-3 items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                        <span class="text-primary font-bold">~</span>
                                        <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                                    </div>
                                    <button data-track-copy="demo-terminal" data-command="pnpm dlx @rebasepro/cli init"
                                            class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                            aria-label="Copy command" title="Copy to clipboard">

                                        <svg
                                                class="lucide lucide-copy"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                        >
                                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                        </svg>

                                    </button>
                                </div>
                                <div class="text-surface-500 text-xs mt-1 ml-6">{t("demo.init")}</div>
                            </div>

                            <div>
                                <div class="flex gap-3 items-center justify-between">
                                    <div class="flex gap-3 items-center">
                                        <span class="text-primary font-bold">~</span>
                                        <span class="text-white">pnpm rebase introspect</span>
                                    </div>
                                    <button data-track-copy="demo-introspect" data-command="pnpm rebase introspect"
                                            class="copy-btn text-surface-500 hover:text-white transition-colors"
                                            aria-label="Copy command" title="Copy to clipboard">

                                        <svg
                                                class="lucide lucide-copy"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                        >
                                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                        </svg>

                                    </button>
                                </div>
                                <div class="text-surface-500 text-xs mt-1 ml-6">{t("demo.pull")}</div>
                            </div>

                            <div>
                                <div class="flex gap-3 items-center justify-between">
                                    <div class="flex gap-3 items-center">
                                        <span class="text-primary font-bold">~</span>
                                        <span class="text-white">pnpm dev</span>
                                    </div>
                                    <button data-track-copy="demo-dev" data-command="pnpm dev"
                                            class="copy-btn text-surface-500 hover:text-white transition-colors"
                                            aria-label="Copy command" title="Copy to clipboard">

                                        <svg
                                                class="lucide lucide-copy"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                        >
                                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                        </svg>

                                    </button>
                                </div>
                                <div class="text-emerald-400/90 text-xs mt-1 ml-6">{t("demo.dev")}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="relative -my-72 -z-10 pointer-events-none" style="height: 600px;">
        <NeatSectionDivider variant="a" client:visible/>
    </div>


    <section id="s-demo-carousel" class="relative z-0 py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

            <div style="min-height: 700px;">
                <AdminDemoCarousel client:load/>
            </div>
            <p class="mt-2 text-center text-xs sm:text-sm text-surface-500">
                A quick tour of the generated Rebase admin panel.
            </p>
        </div>
    </section>


    <!-- How it works -->
    <section id="s-how-it-works" class="relative z-0 py-28 sm:py-36 overflow-hidden bg-black">
        <div class="mx-auto max-w-7xl px-6 lg:px-12">
            <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 animate-on-scroll fade-in-up">
                <h2 class="text-xs font-semibold tracking-[0.25em] text-primary/70 uppercase">{t("howitworks.badge")}</h2>
                <p class="mt-4 text-3xl md:text-5xl font-semibold tracking-tight text-white"
                   set:html={t("howitworks.title")}></p>
                <p class="mt-5 text-base sm:text-lg text-surface-400 leading-relaxed">
                    {t("howitworks.subtitle")}
                </p>
            </div>

            <div class="mx-auto max-w-5xl">
                <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
                    <!-- Step 1: Connect -->
                    <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-7 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up">
                        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                             aria-hidden="true"
                             style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                        <div class="relative z-10 flex items-start gap-4">
                            <div class="h-10 w-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center flex-none ring-1 ring-primary/20">

                                <svg
                                        class="lucide lucide-database"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                >
                                    <ellipse cx="12" cy="5" rx="9" ry="3"/>
                                    <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
                                    <path d="M3 12A9 3 0 0 0 21 12"/>
                                </svg>

                            </div>
                            <div>
                                <h3 class="text-white font-semibold">{t("howitworks.step1.title")}</h3>
                                <p class="mt-1 text-sm text-surface-400 leading-relaxed">
                                    {t("howitworks.step1.desc")}
                                </p>
                                <div class="mt-4 rounded-lg bg-surface-900/80 border border-surface-800/80 shadow-[0_4px_12px_rgba(0,0,0,0.2)] overflow-hidden relative z-10 group-hover:border-primary/40 transition-colors duration-300">
                                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-500"
                                         aria-hidden="true"
                                         style="background: radial-gradient(120px 80px at 50% 100%, rgba(0,112,244,0.1), transparent 100%);"></div>
                                    <div class="flex items-center justify-between px-3 py-1.5 border-b border-surface-800/80 bg-surface-950/50">
                                        <div class="flex items-center gap-1.5">
                                            <span class="h-2 w-2 rounded-full bg-rose-500/80"></span>
                                            <span class="h-2 w-2 rounded-full bg-amber-400/80"></span>
                                            <span class="h-2 w-2 rounded-full bg-emerald-400/80"></span>
                                        </div>
                                        <span class="text-[10px] font-medium text-surface-500 font-mono flex items-center gap-1.5">

<svg
        class="lucide lucide-terminal"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
>
  <path d="M12 19h8"/>
  <path d="m4 17 6-6-6-6"/>
</svg>

                                                bash
                                            </span>
                                        <div class="w-8"></div> <!-- spacer -->
                                    </div>
                                    <div class="px-3 py-2 flex items-center justify-between bg-gradient-to-b from-surface-900/50 to-transparent">
                                        <div class="font-mono text-[13px] flex items-center gap-2 whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                            <span class="text-primary font-bold">~</span>
                                            <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                                        </div>
                                        <button data-track-copy="how-it-works"
                                                data-command="pnpm dlx @rebasepro/cli init"
                                                class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                                aria-label="Copy command" title="Copy to clipboard">

                                            <svg
                                                    class="lucide lucide-copy"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="20"
                                                    height="20"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                            >
                                                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                            </svg>

                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Get everything -->
                    <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-7 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up delay-100">
                        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                             aria-hidden="true"
                             style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                        <div class="relative z-10 flex items-start gap-4">
                            <div class="h-10 w-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center flex-none ring-1 ring-primary/20">

                                <svg
                                        class="lucide lucide-sparkles"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                >
                                    <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/>
                                    <path d="M20 2v4"/>
                                    <path d="M22 4h-4"/>
                                    <circle cx="4" cy="20" r="2"/>
                                </svg>

                            </div>
                            <div>
                                <h3 class="text-white font-semibold">{t("howitworks.step2.title")}</h3>
                                <p class="mt-1 text-sm text-surface-400 leading-relaxed">
                                    {t("howitworks.step2.desc")}
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Extend forever -->
                    <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-7 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in-up delay-200">
                        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                             aria-hidden="true"
