---
const {
    lang,
    t
} = Astro.props;
import { AdminDemoCarousel } from "../../components/demos/AdminDemoCarousel";
import { AdoptionStackDemo } from "../../components/demos/AdoptionStackDemo";
import { BodyPartsDemo } from "../../components/demos/BodyPartsDemo";
import { ApiMiniDemo } from "../../components/demos/ApiMiniDemo";
import { SdkMiniDemo } from "../../components/demos/SdkMiniDemo";
import { RealtimeMiniDemo } from "../../components/demos/RealtimeMiniDemo";
import AiAppDevelopmentDemo from "../../components/demos/AiAppDevelopmentDemo";
import { AgentConsoleDemo } from "../../components/demos/AgentConsoleDemo";
import CollectionPowerSection from "../../components/CollectionPowerSection.astro";
import SecuritySection from "../../components/SecuritySection.astro";
import { NeatBackground } from '../../components/NeatBackground';


import ClientLogos from "../../components/ClientLogos.astro";
import CaseStudiesCarousel from "../../components/CaseStudiesCarousel.astro";

import { useTranslatedPath } from "../../i18n/ui";

const translatePath = useTranslatedPath(lang);

// The FAQ is seven identically-shaped q/a pairs; the numbers index into i18n.
// `as const` matters: t() takes a literal key union, so the numbers have to stay
// literal for `faq.q${n}` to widen to "faq.q1" | ... rather than to string.
//
// Every answer now closes on the page that proves it. An FAQ that only asserts is
// the cheapest block on a landing page — "yes, it's open source" is worth nothing
// next to a link to the licence. `href` goes through translatePath so the localized
// docs routes stay correct; `external` entries leave the site and skip it.
const faqs = [
    { n: 1, href: "/docs/collections/properties" },
    { n: 2, href: "/compare" },
    { n: 3, href: "/docs/cli/schema" },
    { n: 4, href: "https://github.com/rebasepro/rebase", external: true },
    { n: 5, href: "/docs/architecture" },
    { n: 6, href: "/docs/backend/authentication" },
    { n: 7, href: "/docs/frontend/extending" }
] as const;

// Two independent columns rather than a two-column grid. In a grid the items pair
// up into rows, so opening a long answer on the left leaves a matching hole under
// the short one on its right. Two flex columns let each side grow on its own, and
// unlike CSS `columns` nothing reflows from one column into the other on open.
const faqColumns = [
    faqs.filter((_, i) => i % 2 === 0),
    faqs.filter((_, i) => i % 2 === 1)
];

---


<div class="flex flex-col isolate">

    <!-- Hero -->
 <section id="s-hero"
             class="relative isolate overflow-hidden -mt-20 pt-40 pb-24 sm:pt-44 sm:pb-28 lg:pt-48 lg:pb-32">
        <!-- Animated WebGL gradient background (Neat - funky preset) -->
        <NeatBackground client:idle randomize={false} />


        <div class="px-4 mx-auto max-w-7xl text-center lg:px-8 relative z-10 mt-8">
            <!-- Badge -->
            <div class="mb-8 flex items-center justify-center gap-3 animate-on-scroll animate-immediate fade-in">
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-surface-700 bg-surface-900/60 text-xs font-medium text-surface-400">
                        <img src="/img/postgresql-logo.svg" alt="PostgreSQL" width="432" height="445" class="h-4 w-auto"/>
                        {t("hero.badge")}
                    </span>
            </div>

            <!-- Headline -->
            <div class="relative">

                <!-- Display tier, one clear step above the 48px section h2s.
                     Each rung is the largest that still sets the longer line
                     ("The backend you always wanted.") on ONE line at that
                     breakpoint — the line width runs ~14.6x the font size, so:
                       md  (736px usable) -> 48px = 700px
                       lg  (960px usable) -> 60px = 875px
                       xl (1216px usable) -> 72px = 1049px, 86% of the measure
                     72px was picked over 80px because 80 leaves only 4% of slack
                     and any copy edit overflows it. Base stays 36px and wraps,
                     which is correct on phones. -->
                <h1 class="relative mb-6 text-4xl md:text-5xl lg:text-6xl font-semibold leading-[1.08] text-white animate-on-scroll animate-immediate fade-in-up">
                    {t("hero.title.part1")}<br/><span class="text-primary">{t("hero.title.part2")}</span>
                </h1>
            </div>
            <!-- Measure is set with max-w, not side padding: `xl:px-40` only bit
                 above 1280px, so on a 1440px screen the line ran ~90 characters
                 before wrapping. A hero subtitle wants ~60-70. -->
            <!-- Steps up with the headline so the pair keeps its ratio (~3.6:1
                 at xl). Measure is set with max-w, not side padding — `xl:px-40`
                 only bit above 1280px, so the line used to run ~90 characters. -->
            <p class="mx-auto mb-4 max-w-2xl text-lg lg:text-xl leading-relaxed text-surface-300 animate-on-scroll animate-immediate fade-in-up"
               set:html={t("hero.subtitle")}/>

            <!-- One action, then the product itself.
                 The old stack narrated its own CTAs — a note under the button, a
                 two-line paragraph introducing the command, an npx alternative
                 inside the box. Six text moments where a hero carries three.
                 The GitHub button is gone on purpose: a primary hero action that
                 lands an evaluator on a repo with double-digit stars spends the
                 highest-intent click on our weakest signal. Payload and Strapi put
                 their star counts up front because 72.8k is proof; ours is not one
                 yet. GitHub still ships in the header and the footer. -->
            <div class="mt-10 flex items-center justify-center gap-3 flex-wrap animate-on-scroll animate-immediate fade-in-up">
                <a href="https://demo.rebase.pro"
                   target="_blank" rel="noopener noreferrer"
                   id="hero-try-demo"
                   class="inline-flex items-center justify-center gap-x-2 rounded-lg bg-primary border border-transparent px-7 py-0 min-h-(--control-xl) text-base font-medium text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-all duration-200 ease-in-out btn-glow">
                    {t("hero.cta.demo")}
                    <svg
                            class="lucide lucide-arrow-right"
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                    >
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
            </div>

            <!-- The terminal, in the hero rather than three screens below it.
                 This block used to be beat 01 ("The first five minutes"), which
                 restated a command the hero had already printed in a smaller box —
                 the same beat told twice with the logo wall wedged between them.
                 Merging them is also what puts a product artifact above the fold:
                 every competitor hero (Payload, Directus, Strapi) carries one and
                 ours carried a gradient, which is the site breaking its own
                 proof-over-assertion rule in the one place it matters most.
                 The copy-tracking ids are the ones this terminal already shipped
                 with, so the analytics series is continuous across the move. -->
            <div class="mt-8 mb-6 max-w-2xl mx-auto text-left animate-on-scroll animate-immediate fade-in-up">
                <p class="mb-2.5 text-sm text-surface-500 text-center">{t("hero.cli.label")}</p>
                <div class="rounded-2xl bg-surface-900/80 border border-surface-800/80 shadow-[0_0_0_1px_rgba(15,23,42,0.6),0_24px_80px_rgba(0,0,0,0.65)] relative overflow-hidden group hover:border-primary/40 transition-colors duration-300">
                    <!-- Glow effect behind terminal -->
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-500"
                         aria-hidden="true"
                         style="background: radial-gradient(400px 200px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 0;"></div>

                    <div class="relative z-10 flex items-center justify-between px-4 py-3 border-b border-surface-800/80 bg-surface-950/50">
                        <div class="flex items-center gap-1.5">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                        </div>
                        <div class="text-2xs font-mono font-medium text-surface-400 flex items-center gap-2">
                            <svg
                                    class="lucide lucide-terminal"
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                            >
                                <path d="M12 19h8"/>
                                <path d="m4 17 6-6-6-6"/>
                            </svg>
                            bash
                        </div>
                        <div class="w-12"></div> <!-- spacer -->
                    </div>

                    <div class="relative z-10 font-mono text-sm sm:text-sm text-surface-200 space-y-4 px-5 py-5 bg-gradient-to-b from-surface-900/50 to-transparent">
                        <div>
                            <div class="flex gap-3 items-center justify-between">
                                <div class="flex gap-3 items-center whitespace-nowrap overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden mr-4">
                                    <span class="text-primary font-semibold">~</span>
                                    <span class="text-white">pnpm dlx @rebasepro/cli init</span>
                                </div>
                                <button data-track-copy="demo-terminal" data-command="pnpm dlx @rebasepro/cli init"
                                        class="copy-btn shrink-0 text-surface-500 hover:text-white transition-colors"
                                        aria-label="Copy command" title="Copy to clipboard">
                                    <svg
                                            class="lucide lucide-copy"
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                    >
                                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="text-surface-400 text-xs mt-1 ml-6">{t("demo.init")}</div>
                        </div>

                        <div>
                            <div class="flex gap-3 items-center justify-between">
                                <div class="flex gap-3 items-center">
                                    <span class="text-primary font-semibold">~</span>
                                    <span class="text-white">pnpm rebase db push</span>
                                </div>
                                <button data-track-copy="demo-db-push" data-command="pnpm rebase db push"
                                        class="copy-btn text-surface-500 hover:text-white transition-colors"
                                        aria-label="Copy command" title="Copy to clipboard">
                                    <svg
                                            class="lucide lucide-copy"
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                    >
                                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="text-surface-400 text-xs mt-1 ml-6">{t("demo.pull")}</div>
                        </div>

                        <div>
                            <div class="flex gap-3 items-center justify-between">
                                <div class="flex gap-3 items-center">
                                    <span class="text-primary font-semibold">~</span>
                                    <span class="text-white">pnpm dev</span>
                                </div>
                                <button data-track-copy="demo-dev" data-command="pnpm dev"
                                        class="copy-btn text-surface-500 hover:text-white transition-colors"
                                        aria-label="Copy command" title="Copy to clipboard">
                                    <svg
                                            class="lucide lucide-copy"
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                    >
                                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="text-emerald-400/90 text-xs mt-1 ml-6">{t("demo.dev")}</div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </section>


    <!-- Social proof -->
 <!-- The band was 340px tall to carry a 50px logo row and one line of type, so it
      read as a gap the logos happened to be floating in. It is now sized to its
      content and bounded by hairlines, which is what makes a logo wall read as a
      deliberate band rather than as leftover space. The label keeps its "Rebase
      and FireCMS" qualifier — see PRODUCT.md; these are not all Rebase users and
      the copy must not imply otherwise. -->
 <section id="s-social-proof" class="relative z-0 py-6 sm:py-8">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="border-y border-white/[0.06] py-10 sm:py-12">
                <!-- Sentence case, not caps: this label is a nine-word sentence, and
                     uppercase + tracking is a treatment for two or three words. Caps
                     here cost legibility and bought nothing. -->
                <p class="text-center text-xs text-surface-500 mb-7 animate-on-scroll fade-in">{t("social.title")}</p>
                <ClientLogos/>
            </div>
        </div>
    </section>

    <!-- Beat 01 ("The first five minutes") lived here and is now part of the hero.
         It restated a command the hero had already printed in a smaller box — the
         same beat told twice, with the logo wall wedged between the two tellings —
         and merging them is what finally puts a product artifact above the fold.
         The beats below renumber from 01 accordingly. -->



    <!-- Neat gradient divider -->
    <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden" style="z-index: -1; height: 600px;">
        <NeatBackground variant="b" client:visible/>
    </div>

    <div id="s-collection-power" class="relative z-0">
        <!-- One Collection. Everything. -->
        <CollectionPowerSection index="01"/>
    </div>

    <!-- The backend underneath: SDK / REST / realtime proof -->
 <section id="s-backend-engine" class="relative z-0 py-24 sm:py-32 overflow-hidden">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-14 animate-on-scroll fade-in-up">
                <p class="text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase"><span class="font-mono text-surface-500">02</span><span class="mx-2 text-surface-600">·</span>{t("engine.badge")}</p>
                <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-5xl text-balance">{t("engine.title")}</h2>
                <p class="mt-4 text-surface-400 text-base sm:text-lg leading-relaxed">{t("engine.subtitle")}</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5 max-w-5xl mx-auto">
                <!-- TypeScript SDK -->
                <div class="md:col-span-2 lg:col-span-4 group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10 flex flex-col aspect-[5/3] overflow-hidden bg-surface-950 pointer-events-none border-b border-surface-800/80">
                        <!-- Window controls -->
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50 backdrop-blur-sm">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                            <div class="ml-2 text-3xs font-mono text-surface-400">app.ts</div>
                        </div>
                        <div class="relative flex-1 w-full overflow-hidden flex items-center justify-center" inert aria-hidden="true">
                            <SdkMiniDemo client:visible/>
                        </div>
                    </div>
                    <div class="relative z-10 p-5 flex flex-col justify-between h-full min-h-[160px]">
                        <div>
                            <div class="flex items-center gap-2 mb-2">
                                <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20">
                                    <svg class="lucide lucide-code" xmlns="http://www.w3.org/2000/svg" width="20"
                                         height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m16 18 6-6-6-6"/>
                                        <path d="m8 6-6 6 6 6"/>
                                    </svg>
                                </div>
                                <h3 class="text-base font-semibold text-white">{t("features.sdk.title")}</h3>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-3xs font-medium ring-1 ring-primary/20 ml-auto">
                                        {t("features.sdk.badge")}
                                    </span>
                            </div>
                            <p class="text-surface-400 text-sm leading-relaxed">{t("features.sdk.desc")}</p>
                        </div>

                    </div>
                </div>

                <!-- Instant REST API -->
                <div class="md:col-span-1 lg:col-span-2 group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in delay-100">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10 flex flex-col aspect-[5/3] overflow-hidden bg-surface-950 pointer-events-none border-b border-surface-800/80">
                        <!-- Window controls -->
                        <div class="px-3 py-2 flex items-center gap-1.5 bg-surface-900/50 border-b border-surface-800/50 backdrop-blur-sm">
                            <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                            <div class="ml-2 text-3xs font-mono text-surface-400">api.demo.rebase.pro</div>
                        </div>
                        <div class="relative flex-1 w-full overflow-hidden flex items-center justify-center" inert aria-hidden="true">
                            <ApiMiniDemo client:visible/>
                        </div>
                    </div>
                    <div class="relative z-10 p-5 flex flex-col justify-between h-full min-h-[160px]">
                        <div>
                            <div class="flex items-center gap-2 mb-2">
                                <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20">

                                    <svg
                                            class="lucide lucide-webhook"
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                    >
                                        <path d="M18 16.98h-5.99c-1.1 0-1.95.94-2.48 1.9A4 4 0 0 1 2 17c.01-.7.2-1.4.57-2"/>
                                        <path d="m6 17 3.13-5.78c.53-.97.1-2.18-.5-3.1a4 4 0 1 1 6.89-4.06"/>
                                        <path d="m12 6 3.13 5.73C15.66 12.7 16.9 13 18 13a4 4 0 0 1 0 8"/>
                                    </svg>

                                </div>
                                <h3 class="text-base font-semibold text-white">{t("features.api.title")}</h3>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-3xs font-medium ring-1 ring-primary/20 ml-auto">
                                        {t("features.api.badge")}
                                    </span>
                            </div>
                            <p class="text-surface-400 text-sm leading-relaxed">{t("features.api.desc")}</p>
                        </div>

                    </div>
                </div>

                <!-- Real-time everywhere -->
                <div class="lg:col-span-6 group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 animate-on-scroll fade-in delay-300">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <!-- Fixed height, not aspect-ratio: this card spans the full row
                         (lg:col-span-6), so aspect-[4/3] made the media ~900px tall
                         with the 4-row demo stranded at the top. The demo is h-full,
                         so a bounded height is what keeps it a sensible size. -->
                    <!-- No outer window chrome here: this demo draws TWO separate
                         client windows, so a shared title bar would read as one
                         browser with two panes — the opposite of the point. -->
                    <div class="relative z-10 flex flex-col h-[240px] overflow-hidden bg-surface-950 pointer-events-none border-b border-surface-800/80">
                        <div class="relative flex-1 w-full overflow-hidden flex items-center justify-center" inert aria-hidden="true">
                            <RealtimeMiniDemo client:visible/>
                        </div>
                    </div>
                    <div class="relative z-10 p-5">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20">

                                <svg
                                        class="lucide lucide-refresh-cw"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                >
                                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                                    <path d="M21 3v5h-5"/>
                                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                                    <path d="M8 16H3v5"/>
                                </svg>

                            </div>
                            <h3 class="text-base font-semibold text-white">{t("features.realtime.title")}</h3>
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-3xs font-medium ring-1 ring-primary/20 ml-auto">
                                    {t("features.realtime.badge")}
                                </span>
                        </div>
                        <p class="text-surface-400 text-sm leading-relaxed">{t("features.realtime.desc")}</p>

                    </div>
                </div>
            </div>

            <div class="mt-10 text-center animate-on-scroll fade-in delay-300">
                <a href={translatePath("/backend")}
                   class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors group">
                    {t("engine.link")}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
