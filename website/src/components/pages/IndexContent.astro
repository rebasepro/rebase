                                    <div class="flex gap-3 items-center justify-between">
                                        <div class="flex gap-3 items-center">
                                            <span class="text-primary font-bold">~</span>
                                            <span class="text-white">npx rebase db pull</span>
                                        </div>
                                        <button onclick="navigator.clipboard.writeText('npx rebase db pull')" class="text-surface-500 hover:text-white transition-colors" aria-label="Copy command" title="Copy to clipboard">
                                            
