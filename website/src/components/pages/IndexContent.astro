                                        <div class="flex items-center justify-between px-3 py-1.5 border-b border-surface-800/80 bg-surface-950/50">
                                            <div class="flex items-center gap-1.5">
                                                <span class="h-2 w-2 rounded-full bg-rose-500/80"></span>
                                                <span class="h-2 w-2 rounded-full bg-amber-400/80"></span>
                                                <span class="h-2 w-2 rounded-full bg-emerald-400/80"></span>
                                            </div>
                                            <span class="text-[10px] font-medium text-surface-500 font-mono flex items-center gap-1.5">
                                                
<svg
  class="lucide lucide-terminal"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
