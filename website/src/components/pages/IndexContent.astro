---
const { lang, t } = Astro.props;
import ScrollSyncShowcase from '../../components/ScrollSyncShowcase.astro';
import CollectionPowerSection from '../../components/CollectionPowerSection.astro';
import SectionBackgroundAccents from '../../components/SectionBackgroundAccents.astro';
import { EntityViewDemo } from '../../components/demos/EntityViewDemo';
import { KanbanDemo } from '../../components/demos/KanbanDemo';
import { ApiMiniDemo } from '../../components/demos/ApiMiniDemo';
import { SdkMiniDemo } from '../../components/demos/SdkMiniDemo';
import { RealtimeMiniDemo } from '../../components/demos/RealtimeMiniDemo';
import RoadmapSection from '../../components/RoadmapSection.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import { languages, defaultLang, useTranslations } from '../../i18n/ui';




---


    <main>

        <!-- Hero -->
        <section class="relative isolate overflow-hidden bg-linear-to-br from-surface-900 to-black pt-28 pb-20 sm:pt-36 sm:pb-28 lg:pt-52 lg:pb-36">
            <!-- Background gradient top shape -->
            <!-- Animated background orbs -->
            <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
            <div class="hero-orb hero-orb-2" aria-hidden="true"></div>
            <div class="hero-orb hero-orb-3" aria-hidden="true"></div>

            <div class="px-4 mx-auto max-w-7xl text-center lg:px-12 relative z-10">
                <!-- EU badge -->
                <div class="mb-8 flex items-center justify-center gap-3 animate-on-scroll fade-in">
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-surface-700 bg-surface-900/60 text-sm font-medium text-surface-300">
                        <span class="inline-block text-base">🇪🇺</span>
                        {t('hero.badge')}
                    </span>
                </div>

                <!-- Headline -->
                <h1 class="mb-6 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] text-white animate-on-scroll fade-in-up">
                    {t('hero.title.part1')}<br/><span class="text-primary subtle-shimmer">{t('hero.title.part2')}</span>
                </h1>
                <p class="mb-8 text-lg leading-8 text-surface-400 lg:text-xl sm:px-10 xl:px-40 animate-on-scroll fade-in-up" set:html={t('hero.subtitle')} />
                

                <!-- CTAs -->
                <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-x-5 animate-on-scroll fade-in-up">
                    <a href="https://demo.rebase.pro"
                       data-track
                       id="hero-start-building"
                       target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-all duration-200 ease-in-out btn-glow">
                        {t('hero.cta.demo')}
                        
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

                    </a>
                    <a href="https://github.com/rebasepro/rebase"
                       data-track
                       id="hero-explore-self-hosted"
                       target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-x-2 text-sm font-medium text-surface-300 hover:text-white transition-colors">
                        {t('hero.cta.github')}
                        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M4 8H11.333" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M8.667 4L12 7.99967L8.667 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </div>
                

            </div>
        </section>

        <!-- Product demo -->
        <section class="bg-black border-b border-surface-900 relative" style="min-height: 200vh;">
            <!-- subtle separator line -->
            <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-surface-700/40 to-transparent"></div>

            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14 sm:pt-18">
