---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';



// src/pages/startups.astro
import { NeatBackground } from '../../components/NeatBackground';
// The Layout component should handle the Header and Footer
// import Header from '../../components/Header.astro';
// import Footer from '../../components/Footer.astro';
import ScreenshotsMarquee from '../../components/ScreenshotsMarquee.astro';
import { SpreadsheetDemo } from '../../components/demos/SpreadsheetDemo';
import ClientLogos from '../../components/ClientLogos.astro';




// Inline SVG icon definitions
const zapIcon = `<svg class="h-10 w-10 mb-4 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>`;
const cloudIcon = `<svg class="h-10 w-10 mb-4 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" /></svg>`;
const spreadsheetIcon = `<svg class="h-10 w-10 mb-4 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125v-12.75c0-.621.504-1.125 1.125-1.125h17.25c.621 0 1.125.504 1.125 1.125v12.75c0 .621-.504 1.125-1.125 1.125m-17.25 0h17.25m-17.25 0l1.125 1.125c.15.15.313.225.487.225h14.25c.174 0 .337-.075.487-.225l1.125-1.125m-17.25 0h17.25M9 13.125h6M9 16.5h6" /></svg>`;
import ClosingCta from "../ClosingCta.astro";
---

  <div class="flex flex-col isolate">
    <!-- Hero Section -->
 <section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24 lg:pb-24">
     <NeatBackground client:idle transition:persist="neat-hero" />

      <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
        <h1 class="mb-6 text-display-2 text-white" set:html={t("startupspage.00")}></h1>
        <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl" set:html={t("startupspage.01")}></p>
        <a href="/demo" class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all duration-200 ease-in-out btn-glow">
          {t("cta.button.demo")}
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </section>
 <section class="relative isolate py-strip">
        <div class="mx-auto max-w-6xl px-8 lg:px-12">
            <h2 class="text-center text-lg leading-8 text-surface-400">
                {t('social.title')}
            </h2>
            <div class="mx-auto mt-4 mb-8">
                <ClientLogos filter="startups"/>
            </div>
        </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>


    <!-- Problem / Solution Section -->
 <section class="py-chapter">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center mb-16">
          <h2 class="text-3xl sm:text-4xl text-white">{t("startupspage.02")}</h2>
          <p class="mt-lead text-lg leading-8 text-surface-400">{t("startupspage.03")}</p>
        </div>

        <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800">
          <img src="/img/users_table.png" width="2430" height="992"
               alt="Rebase CMS: the generated back office, editing rows in a users table"
               class="w-full h-auto"/>
        </div>

      </div>
    </section>

    <!-- "Built for Velocity" Section -->
 <section class="py-chapter">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <h2 class="text-3xl sm:text-4xl text-white">{t("startupspage.04")}</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800">
            <Fragment set:html={zapIcon} />
            <h3 class="text-xl mb-2 text-white">{t("startupspage.05")}</h3>
            <p class="text-surface-400 text-sm leading-relaxed">{t("startupspage.06")}</p>
          </div>
          <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800">
            <Fragment set:html={cloudIcon} />
            <h3 class="text-xl mb-2 text-white">{t("startupspage.07")}</h3>
            <p class="text-surface-400 text-sm leading-relaxed">{t("startupspage.08")}</p>
          </div>
          <div class="relative overflow-hidden rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800">
            <Fragment set:html={spreadsheetIcon} />
            <h3 class="text-xl mb-2 text-white">{t("startupspage.09")}</h3>
            <p class="text-surface-400 text-sm leading-relaxed">{t("startupspage.10")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Path to Scale Section -->
 <section class="py-chapter">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center">
                <h2 class="text-3xl sm:text-4xl text-white mb-6">{t("startupspage.11")}</h2>
                <p class="text-lg text-surface-400 mb-8">{t("startupspage.12")}</p>
            </div>
            <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 mt-12">
                <SpreadsheetDemo client:load />
            </div>
        </div>
    </section>

    <!-- What comes in the box -->
 <section class="py-chapter">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-16">
                <h2 class="text-3xl sm:text-4xl text-white">{t("startupspage.13")}</h2>
                <p class="mt-lead text-lg leading-8 text-surface-400">{t("startupspage.14")}</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="flex items-start space-x-4 rounded-lg bg-surface-900/50 p-4 ring-1 ring-inset ring-surface-800 p-8">
                    
<svg
  class="lucide lucide-database flex-shrink-0"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <ellipse cx="12" cy="5" rx="9" ry="3" />
  <path d="M3 5V19A9 3 0 0 0 21 19V5" />
  <path d="M3 12A9 3 0 0 0 21 12" />
</svg>

                    <div>
                        <h3 class="text-white">{t("startupspage.36")}</h3>
                        <p class="text-sm text-surface-400">{t("startupspage.15")}</p>
                    </div>
                </div>
                <div class="flex items-start space-x-4 rounded-lg bg-surface-900/50 p-4 ring-1 ring-inset ring-surface-800 p-8">
                    
<svg
  class="lucide lucide-cloud-off flex-shrink-0"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M10.94 5.274A7 7 0 0 1 15.71 10h1.79a4.5 4.5 0 0 1 4.222 6.057" />
  <path d="M18.796 18.81A4.5 4.5 0 0 1 17.5 19H9A7 7 0 0 1 5.79 5.78" />
  <path d="m2 2 20 20" />
</svg>

                    <div>
                        <h3 class="text-white">{t("startupspage.16")}</h3>
                        <p class="text-sm text-surface-400">{t("startupspage.17")}</p>
                    </div>
                </div>
                <div class="flex items-start space-x-4 rounded-lg bg-surface-900/50 p-4 ring-1 ring-inset ring-surface-800 p-8">
                    
<svg
  class="lucide lucide-pencil flex-shrink-0"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
  <path d="m15 5 4 4" />
</svg>

                    <div>
                        <h3 class="text-white">{t("startupspage.18")}</h3>
                        <p class="text-sm text-surface-400">{t("startupspage.19")}</p>
                    </div>
                </div>
                <div class="flex items-start space-x-4 rounded-lg bg-surface-900/50 p-4 ring-1 ring-inset ring-surface-800 p-8">
                    
<svg
  class="lucide lucide-log-in flex-shrink-0"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m10 17 5-5-5-5" />
  <path d="M15 12H3" />
  <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
</svg>

                    <div>
                        <h3 class="text-white">{t("startupspage.20")}</h3>
                        <p class="text-sm text-surface-400">{t("startupspage.21")}</p>
                    </div>
                </div>
                <div class="flex items-start space-x-4 rounded-lg bg-surface-900/50 p-4 ring-1 ring-inset ring-surface-800 p-8">
                    
<svg
  class="lucide lucide-shield-check flex-shrink-0"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
  <path d="m9 12 2 2 4-4" />
</svg>

                    <div>
                        <h3 class="text-white">{t("startupspage.22")}</h3>
                        <p class="text-sm text-surface-400">{t("startupspage.23")}</p>
                    </div>
                </div>
                <div class="flex items-start space-x-4 rounded-lg bg-surface-900/50 p-4 ring-1 ring-inset ring-surface-800 p-8">
                    
<svg
  class="lucide lucide-puzzle flex-shrink-0"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z" />
</svg>

                    <div>
                        <h3 class="text-white">{t("startupspage.37")}</h3>
                        <p class="text-sm text-surface-400">{t("startupspage.24")}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="relative bg-page-ground text-surface-200 py-16">
        <ScreenshotsMarquee/>
    </div>

    <!-- More Than Just a CMS Section -->
 <section class="py-chapter">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-8 items-start">
                <div>
                    <h2 class="text-3xl sm:text-4xl text-white mb-6">{t("startupspage.25")}</h2>
                    <p class="text-xl text-surface-400 mb-8">{t("startupspage.26")}</p>
                </div>
                <ul class="text-left text-lg space-y-4">
                    <li class="flex items-start">
                        <svg
                             class="w-6 h-6 mr-3 text-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/>
                        </svg>
                        <span set:html={t("startupspage.27")}></span>
                    </li>
                    <li class="flex items-start">
                        <svg
                             class="w-6 h-6 mr-3 text-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        <span set:html={t("startupspage.28")}></span>
                    </li>
                    <li class="flex items-start">
                        <svg
                             class="w-6 h-6 mr-3 text-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <span set:html={t("startupspage.29")}></span>
                    </li>
                    <li class="flex items-start">
                        <svg
                             class="w-6 h-6 mr-3 text-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                        <span set:html={t("startupspage.30")}></span>
                    </li>
                    <li class="flex items-start">
                        <svg
                             class="w-6 h-6 mr-3 text-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.096 2.572-1.065z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <span set:html={t("startupspage.31")}></span>
                    </li>
                    <li class="flex items-start">
                        <svg
                             class="w-6 h-6 mr-3 text-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span set:html={t("startupspage.32")}></span>
                    </li>
                    <li class="flex items-start">
                        <svg
                             class="w-6 h-6 mr-3 text-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                        </svg>
                        <span set:html={t("startupspage.33")}></span>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Built for Pivots Section -->
 <section class="py-chapter">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-8 items-center">
          <div class="lg:order-last self-start">
            <h2 class="text-3xl sm:text-4xl text-white mb-6">{t("startupspage.34")}</h2>
            <p class="text-lg text-surface-400 mb-8">{t("startupspage.35")}</p>
            <a href="/product" class="inline-flex items-center gap-x-2 rounded-lg border border-surface-700 bg-surface-800 px-6 py-3 text-base font-semibold text-white hover:bg-surface-700 transition-all duration-200 ease-in-out">{t("startupspage.38")}</a>
          </div>
          <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800">
            <img src="/img/widgets.png" width="1400" height="1408" alt="Rebase Widgets" class="w-full h-auto"/>
          </div>
        </div>
      </div>
    </section>

    <ClosingCta title={t("close.startups.title")} blurb={t("close.startups.blurb")} trackId="startups" />

</div>

