---
const { lang, t } = Astro.props;
import { useTranslatedPath } from "../../i18n/ui";
const translatePath = useTranslatedPath(lang);

const ossFeatures = [
    t("pricing.oss.feat1"),
    t("pricing.oss.feat2"),
    t("pricing.oss.feat3"),
    t("pricing.oss.feat4"),
    t("pricing.oss.feat5"),
    t("pricing.oss.feat6"),
    t("pricing.oss.feat7"),
];

const cloudFeatures = [
    t("pricing.cloud.feat1"),
    t("pricing.cloud.feat2"),
    t("pricing.cloud.feat3"),
    t("pricing.cloud.feat4"),
];

// SSO via OIDC, MFA, scoped API keys and custom auth adapters ship in the
// open-source framework — the page's own FAQ said so while this column claimed
// them. Enterprise is support, SLAs, review and paperwork.
const entFeatures = [
    t("pricing.ent.feat1"),
    t("pricing.ent.feat2"),
    t("pricing.ent.feat3"),
    t("pricing.ent.feat4"),
    t("pricing.ent.feat5"),
];
import ClosingCta from "../ClosingCta.astro";
---

<div class="flex flex-col isolate">
    <section class="relative isolate overflow-hidden hero-under-nav pb-24 sm:pb-28">
        <div class="px-4 mx-auto max-w-6xl lg:px-8 relative z-10">
            <p class="text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">{t("pricing.badge")}</p>
            <h1 class="mt-4 text-display-2 text-white">
                {t("pricing.title")}
            </h1>
            <p class="mt-5 text-lg leading-8 text-surface-400 max-w-2xl"
               set:html={t("pricing.subtitle")}>
            </p>
        </div>
    </section>

    <section class="relative z-0 pb-28 sm:pb-36">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                <!-- Open Source tier -->
                <div class="frame relative overflow-hidden p-8 flex flex-col">
                    <div class="flex items-center gap-2 mb-2">
                        <h2 class="text-xl text-white">{t("pricing.oss.name")}</h2>
                    </div>
                    <div class="flex items-baseline gap-2 mb-1">
                        <span class="text-4xl text-white">{t("pricing.oss.price")}</span>
                    </div>
                    <p class="text-sm text-surface-500 mb-5">{t("pricing.oss.priceNote")}</p>
                    <p class="text-surface-400 leading-relaxed mb-6">{t("pricing.oss.desc")}</p>

                    <ul class="space-y-3 mb-8 flex-1">
                        {ossFeatures.map((feat) => (
                            <li class="flex items-start gap-3 text-sm text-surface-300">
                                <svg class="lucide lucide-check mt-0.5 flex-none text-primary" xmlns="http://www.w3.org/2000/svg"
                                     width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 6 9 17l-5-5"/>
                                </svg>
                                <span>{feat}</span>
                            </li>
                        ))}
                    </ul>

                    <a href={translatePath("/cli")}
                       class="inline-flex items-center justify-center gap-x-2 inline-flex items-center justify-center rounded-lg border border-white/10 bg-white/5 px-6 py-0 min-h-(--control-large) text-base font-semibold text-white hover:bg-white/10 hover:border-white/20 transition-all duration-200">
                        {t("pricing.oss.cta")}
                        <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>

                <!-- Rebase Cloud — private beta.
                     Listed rather than hidden behind a waitlist: it is live,
                     it has tenants, and a pricing page that omits a product we
                     already run reads as evasion. What it does not do yet is
                     sell itself without us in the loop, and the badge says so. -->
                <div class="frame relative overflow-hidden p-8 flex flex-col">
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-xl text-white">{t("pricing.cloud.name")}</h2>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-white/5 text-surface-300 text-2xs font-semibold ring-1 ring-white/10">{t("pricing.cloud.badge")}</span>
                    </div>
                    <div class="flex items-baseline gap-2 mb-1">
                        <span class="text-4xl text-white">{t("pricing.cloud.price")}</span>
                    </div>
                    <p class="text-sm text-surface-500 mb-5">{t("pricing.cloud.priceNote")}</p>
                    <p class="text-surface-400 leading-relaxed mb-6">{t("pricing.cloud.desc")}</p>

                    <ul class="space-y-3 mb-8 flex-1">
                        {cloudFeatures.map((feat) => (
                            <li class="flex items-start gap-3 text-sm text-surface-300">
                                <svg class="lucide lucide-check mt-0.5 flex-none text-primary" xmlns="http://www.w3.org/2000/svg"
                                     width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 6 9 17l-5-5"/>
                                </svg>
                                <span>{feat}</span>
                            </li>
                        ))}
                    </ul>

                    <!-- The one fact a reader otherwise meets as a 402 after a
                         bundle has finished uploading. It belongs on the page
                         that sells the tier, not only in a deploy log. -->
                    <p class="text-sm text-surface-500 mb-6">{t("pricing.cloud.billingNote")}</p>

                    <a href={translatePath("/contact")}
                       class="inline-flex items-center justify-center gap-x-2 rounded-lg border border-white/10 bg-white/5 px-6 py-0 min-h-(--control-large) text-base font-semibold text-white hover:bg-white/10 hover:border-white/20 transition-all duration-200">
                        {t("pricing.cloud.cta")}
                        <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>

                <!-- Enterprise tier -->
                <div class="relative overflow-hidden rounded-2xl border border-primary/30 bg-gradient-to-br from-surface-900/80 to-surface-950/70 p-8 shadow-[0_18px_44px_rgba(0,112,244,0.12)] flex flex-col">
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-xl text-white">{t("pricing.ent.name")}</h2>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-primary/10 text-primary text-2xs font-semibold ring-1 ring-primary/20">{t("pricing.ent.popular")}</span>
                    </div>
                    <div class="flex items-baseline gap-2 mb-1">
                        <span class="text-4xl text-white">{t("pricing.ent.price")}</span>
                    </div>
                    <p class="text-sm text-surface-500 mb-5">{t("pricing.ent.priceNote")}</p>
                    <p class="text-surface-400 leading-relaxed mb-6">{t("pricing.ent.desc")}</p>

                    <ul class="space-y-3 mb-8 flex-1">
                        {entFeatures.map((feat) => (
                            <li class="flex items-start gap-3 text-sm text-surface-300">
                                <svg class="lucide lucide-check mt-0.5 flex-none text-primary" xmlns="http://www.w3.org/2000/svg"
                                     width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 6 9 17l-5-5"/>
                                </svg>
                                <span>{feat}</span>
                            </li>
                        ))}
                    </ul>

                    <a href={translatePath("/contact")}
                       class="inline-flex items-center justify-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark transition-all duration-200 btn-glow">
                        {t("pricing.ent.cta")}
                        <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Reassurance -->
            <div class="frame mt-12 max-w-3xl mx-auto p-6 text-center">
                <h3 class="text-white mb-2">{t("pricing.faq.title")}</h3>
                <p class="text-surface-400 leading-relaxed">{t("pricing.faq.desc")}</p>
            </div>
        </div>
    </section>

    <ClosingCta title={t("close.pricing.title")} blurb={t("close.pricing.blurb")} trackId="pricing" />

</div>
