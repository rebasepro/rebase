<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script>
    // The calculator. Every number is read from the JSON island above, which
    // the page built from cloud-prices.json — the same list the console quotes
    // from. Lines are rounded to the cent and then summed, as an invoice is.
    interface SizePrice { cpu: string; memory: string; monthlyEur: number }
    interface CalcData {
        minimumEur: number;
        includedFilesGb: number;
        filesEurPerGb: number;
        hoursInMonth: number;
        sleep: { hoursInMonth: number } | null;
        region: { app: SizePrice[]; database: SizePrice[]; diskEurPerGib: number };
        labels: Record<"minimum" | "app" | "database" | "disk" | "secondCopy" | "files" | "awake" | "hourly", string>;
    }

    const dataEl = document.getElementById("cloud-calc-data");
    const form = document.getElementById("cloud-calc");
    if (dataEl && form instanceof HTMLFormElement) {
        const data = JSON.parse(dataEl.textContent ?? "{}") as CalcData;
        const cents = (n: number) => Math.round(n * 100) / 100;
        const money = (n: number) => `€${n.toFixed(2)}`;
        const find = (list: SizePrice[], value: string) => {
            const [cpu, memory] = value.split("|");
            return list.find((s) => s.cpu === cpu && s.memory === memory) ?? list[0];
        };
        const num = (name: string, fallback: number) => {
            const el = form.elements.namedItem(name);
            const v = el instanceof HTMLInputElement ? Number(el.value) : NaN;
            return Number.isFinite(v) && v >= 0 ? v : fallback;
        };
        const checked = (name: string) => {
            const el = form.elements.namedItem(name);
            return el instanceof HTMLInputElement && el.checked;
        };
        const linesEl = form.querySelector("[data-lines]");
        const totalEl = form.querySelector("[data-total]");
        const hourlyEl = form.querySelector("[data-hourly]");
        const awakeEl = form.querySelector("[data-awake]");

        const render = () => {
            const appEl = form.elements.namedItem("app");
            const dbEl = form.elements.namedItem("database");
            const app = find(data.region.app, appEl instanceof HTMLSelectElement ? appEl.value : "");
            const db = find(data.region.database, dbEl instanceof HTMLSelectElement ? dbEl.value : "");
            const disk = cents(Math.max(10, Math.round(num("disk", 10))) * data.region.diskEurPerGib);
            const files = cents(Math.max(0, num("files", 0) - data.includedFilesGb) * data.filesEurPerGb);
            // A second copy is a second database instance: its CPU, memory and
            // its own copy of the disk, charged again (saas resource-pricing.ts).
            const secondCopy = checked("secondCopy") ? cents(db.monthlyEur + disk) : 0;
            const sleeping = data.sleep !== null && checked("sleep");
            if (awakeEl instanceof HTMLElement) awakeEl.hidden = !sleeping;

            const alwaysOn = cents(app.monthlyEur + db.monthlyEur + disk + secondCopy);
            let lines: [string, number][];
            let total: number;
            if (sleeping && data.sleep) {
                // src/sleep/accounting.ts: a sleeping month is the disk and the
                // awake hours at the always-on rate, topped up to the monthly
                // minimum, never more than always on.
                const hours = Math.min(data.sleep.hoursInMonth, num("awake", 0));
                const compute = app.monthlyEur + db.monthlyEur + (secondCopy > 0 ? db.monthlyEur : 0);
                const fixed = disk + (secondCopy > 0 ? disk : 0);
                const rate = compute / data.sleep.hoursInMonth;
                const awake = cents(Math.min(hours * rate, alwaysOn - fixed));
                const topUp = cents(Math.max(0, Math.min(data.minimumEur, alwaysOn) - fixed - awake));
                lines = [[data.labels.awake, awake], [data.labels.disk, fixed]];
                if (topUp > 0) lines.push([data.labels.minimum, topUp]);
                total = cents(Math.min(fixed + awake + topUp, alwaysOn));
            } else {
                lines = [[data.labels.app, app.monthlyEur], [data.labels.database, db.monthlyEur], [data.labels.disk, disk]];
                if (secondCopy > 0) lines.push([data.labels.secondCopy, secondCopy]);
                total = alwaysOn;
            }
            if (files > 0) lines.push([data.labels.files, files]);
            total = cents(total + files);

            if (linesEl) {
                linesEl.replaceChildren(...lines.map(([label, amount]) => {
                    const row = document.createElement("div");
                    row.className = "flex justify-between gap-4";
                    const dt = document.createElement("dt");
                    dt.className = "text-tone-400";
                    dt.textContent = label;
                    const dd = document.createElement("dd");
                    dd.className = "text-tone-300 font-mono tabular-nums";
                    dd.textContent = money(amount);
                    row.append(dt, dd);
                    return row;
                }));
            }
            if (totalEl) totalEl.textContent = money(total);
            if (hourlyEl) hourlyEl.textContent = data.labels.hourly.replace("{price}", `€${(total / data.hoursInMonth).toFixed(3)}`);
        };

        form.addEventListener("input", render);
        form.addEventListener("change", render);
        render();
    }
</script>
