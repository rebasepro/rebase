---
const { lang, t } = Astro.props;
import { languages, defaultLang, useTranslations } from '../../i18n/ui';
import SectionBackgroundAccents from '../../components/SectionBackgroundAccents.astro';
import SpotlightCard from '../../components/SpotlightCard.astro';
import { SchemaEditorDemo } from '../../components/SchemaEditorDemo';
import { SQLEditorDemo } from '../../components/demos/SQLEditorDemo';
import { RLSEditorDemo } from '../../components/demos/RLSEditorDemo';
import { KanbanDemo } from '../../components/demos/KanbanDemo';
import { RichTextEditorDemo } from '../../components/demos/RichTextEditorDemo';
import { SpreadsheetDemo } from '../../components/demos/SpreadsheetDemo';
import { Terminal, ShieldCheck, Folder, Network, History, Bot, Zap, Database, Layers } from "lucide-react";
import "../../styles/editor.css";

const honoCode = `<span class="text-blue-400">import</span> { initializeRebaseBackend } <span class="text-blue-400">from</span> <span class="text-emerald-400">"@rebasepro/backend"</span>;

<span class="text-blue-400">const</span> backend = <span class="text-blue-400">await</span> <span class="text-amber-400">initializeRebaseBackend</span>({
  server,
  app,
  bootstrappers: [
    <span class="text-amber-400">createPostgresBootstrapper</span>({
      connection: db,
      schema: { tables, enums, relations },
    })
  ],
  auth: { jwtSecret: process.env.<span class="text-amber-400">JWT_SECRET</span> },
  storage: { type: <span class="text-emerald-400">"local"</span>, basePath: <span class="text-emerald-400">"./uploads"</span> },
});
<span class="text-surface-500">// ✅ REST, WebSocket, Auth, Storage — all ready</span>`;

const mcpCode = `<span class="text-surface-500">// .cursor/mcp.json</span>
{
  <span class="text-blue-400">"mcpServers"</span>: {
    <span class="text-blue-400">"rebase"</span>: {
      <span class="text-blue-400">"command"</span>: <span class="text-emerald-400">"npx"</span>,
      <span class="text-blue-400">"args"</span>: [<span class="text-emerald-400">"@rebasepro/mcp-server"</span>],
      <span class="text-blue-400">"env"</span>: {
        <span class="text-blue-400">"REBASE_BASE_URL"</span>: <span class="text-emerald-400">"http://localhost:3001"</span>
      }
    }
  }
}`;
---

<main>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- HERO                                                       -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class="relative isolate overflow-hidden bg-black pt-28 pb-20 sm:pt-36 sm:pb-28 lg:pt-44 lg:pb-32">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] rounded-full bg-primary/8 blur-[120px]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:48px_48px] opacity-20"></div>
    </div>

    <div class="px-4 mx-auto max-w-7xl text-center lg:px-12">
      <div class="inline-flex items-center py-1.5 px-4 mb-8 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10 mx-auto animate-on-scroll fade-in">
        <span class="text-sm font-medium">Admin · Backend · SDK · AI — One Framework</span>
      </div>
      <h1 class="mb-6 text-4xl font-bold tracking-tight leading-[1.1] md:text-6xl lg:text-7xl text-white animate-on-scroll fade-in-up">
        Everything you need.<br/><span class="text-primary">Nothing you don't.</span>
      </h1>
      <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48 animate-on-scroll fade-in-up delay-100">
        Define your schema in TypeScript. Get a full admin panel, instant APIs, a typed SDK, security policies, and AI tooling — all from a single source of truth.
      </p>
      <div class="flex items-center justify-center gap-x-4 animate-on-scroll fade-in-up delay-200">
        <a href="https://demo.rebase.pro" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-all btn-glow"
           data-track id="product-hero-demo">
          Try the Demo
          <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/docs" class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold" data-track id="product-hero-docs">
          Read the Docs
          <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
    <SectionBackgroundAccents bottomLine={true}/>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 1 · ADMIN PANEL — "Edit like a spreadsheet"                -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class="bg-black py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-12 animate-on-scroll fade-in-up">
        <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-blue-500/10 text-blue-400 ring-1 ring-inset ring-blue-500/20">Rebase Studio</div>
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Edit like a spreadsheet. Save like a database.</h2>
        <p class="mt-4 text-lg text-surface-400">Inline editing, real-time filters, Kanban views, and a Notion-style rich text editor — all reading and writing directly to your Postgres tables.</p>
      </div>
      <div class="mx-auto max-w-[1000px]">
        <video class="aspect-[607/373] bg-surface-950 border border-surface-800 rounded-xl" style="pointer-events:none;" loop autoplay muted playsinline>
          <source src="/img/landing_1080.webm" type="video/webm"/>
        </video>
      </div>
    </div>
  </section>


  <!-- Editing views: Kanban + Spreadsheet + Rich Text -->
  <section class="bg-black py-24 sm:py-32">
    <SectionBackgroundAccents topLine={true}/>
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-24">
        <div>
          <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-violet-500/10 text-violet-400 ring-1 ring-inset ring-violet-500/20">Kanban Boards</div>
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">Drag-and-drop data management</h2>
          <p class="text-lg text-surface-400">Organize records visually by status, priority, or any enum field. Every drag writes directly to Postgres — no sync layer needed.</p>
        </div>
        <div class="rounded-xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl">
          <KanbanDemo client:only="react" />
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-24">
        <div class="lg:order-last">
          <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-emerald-500/10 text-emerald-400 ring-1 ring-inset ring-emerald-500/20">Rich Text</div>
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">Notion-style block editor</h2>
          <p class="text-lg text-surface-400">Headings, lists, images, code blocks, callouts — all stored as structured JSON. Embed media, drag blocks, and collaborate like you would in a modern writing tool.</p>
        </div>
        <div class="rounded-xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl">
          <RichTextEditorDemo client:only="react" />
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-cyan-500/10 text-cyan-400 ring-1 ring-inset ring-cyan-500/20">Spreadsheet View</div>
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">Inline editing at scale</h2>
          <p class="text-lg text-surface-400">Sort, filter, bulk-edit, and paginate thousands of rows. Every cell is editable in place — no modals, no page reloads.</p>
        </div>
        <div class="rounded-xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl">
          <SpreadsheetDemo client:only="react" />
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 2 · SCHEMA-AS-CODE                                         -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class="bg-black py-24 sm:py-32">
    <SectionBackgroundAccents topLine={true} blob={{ position: "top", size: "lg" }}/>
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-10 animate-on-scroll fade-in-up">
        <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-indigo-500/10 text-indigo-400 ring-1 ring-inset ring-indigo-500/20">Schema-as-Code</div>
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">Visual building. Real TypeScript.</h2>
        <p class="text-lg text-surface-400">Design your schema visually — every change writes back to your local TypeScript files via AST. Or connect your existing database and get a full admin panel instantly.</p>
      </div>
      <div class="mx-auto max-w-[1400px]">
        <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-950" style="height:600px;">
          <SchemaEditorDemo client:load/>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 3 · SQL + RLS                                              -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class="bg-black py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-24">
        <div class="lg:order-last">
          <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-cyan-500/10 text-cyan-400 ring-1 ring-inset ring-cyan-500/20">Built-in SQL</div>
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">SQL Editor</h2>
          <p class="text-lg text-surface-400 mb-6">Write and execute SQL directly against your database. Schema-aware autocomplete, result previews, and query history.</p>
          <ul class="space-y-3 text-surface-300">
            <li class="flex gap-3"><span class="text-primary">✓</span> Monaco-based editor with syntax highlighting</li>
            <li class="flex gap-3"><span class="text-primary">✓</span> Schema browser with table/column introspection</li>
            <li class="flex gap-3"><span class="text-primary">✓</span> Inline result table with sorting and pagination</li>
          </ul>
        </div>
        <div class="rounded-xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl">
          <SQLEditorDemo client:only="react" />
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-orange-500/10 text-orange-400 ring-1 ring-inset ring-orange-500/20">Row-Level Security</div>
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">RLS Policy Editor</h2>
          <p class="text-lg text-surface-400 mb-6">Manage Postgres Row-Level Security visually. Define policies per table, sync them between code and database.</p>
          <ul class="space-y-3 text-surface-300">
            <li class="flex gap-3"><span class="text-primary">✓</span> Enable/disable RLS per table with one click</li>
            <li class="flex gap-3"><span class="text-primary">✓</span> Visual USING and WITH CHECK clause editor</li>
            <li class="flex gap-3"><span class="text-primary">✓</span> PERMISSIVE / RESTRICTIVE modes, role targeting</li>
          </ul>
        </div>
        <div class="rounded-xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl">
          <RLSEditorDemo client:only="react" />
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 4 · BACKEND & APIs                                         -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class="bg-black py-24 sm:py-32">
    <SectionBackgroundAccents topLine={true} blob={{ position: "bottom", size: "md" }}/>
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-amber-500/10 text-amber-400 ring-1 ring-inset ring-amber-500/20">Backend</div>
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">One line. Full backend.</h2>
          <p class="text-lg text-surface-400 mb-6">Initialize a Hono-powered server with REST, WebSockets, authentication, and file storage — all from your Drizzle schema.</p>
          <div class="grid grid-cols-2 gap-4 mt-8">
            <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-900/50 ring-1 ring-surface-800">
              <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
              <span class="text-sm text-surface-300">REST API</span>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-900/50 ring-1 ring-surface-800">
              <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
              <span class="text-sm text-surface-300">WebSockets</span>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-900/50 ring-1 ring-surface-800">
              <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
              <span class="text-sm text-surface-300">JWT Auth</span>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-900/50 ring-1 ring-surface-800">
              <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
              <span class="text-sm text-surface-300">File Storage</span>
            </div>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl">
          <div class="flex items-center px-4 py-2.5 border-b border-surface-800 bg-surface-900/60">
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-red-500/60"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-green-500/60"></div>
            </div>
            <span class="text-[11px] text-surface-400 font-mono ml-3">server.ts</span>
          </div>
          <pre class="py-4 px-5 text-[12px] font-mono leading-relaxed text-surface-300 overflow-x-auto bg-surface-950" set:html={honoCode}></pre>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 5 · AI & MCP                                               -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class="bg-black py-24 sm:py-32">
    <SectionBackgroundAccents topLine={true}/>
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center mb-24">
        <div class="lg:col-span-4">
          <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-purple-500/10 text-purple-400 ring-1 ring-inset ring-purple-500/20">AI & Agents</div>
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">AI-powered data workflows</h2>
          <p class="text-lg text-surface-400 mb-4">Use context-aware prompts to generate titles, descriptions, and translations. Accept suggestions across multiple fields in one click.</p>
          <p class="text-lg text-surface-400">Expose your CMS to external AI agents via the built-in <b>MCP server</b>, allowing autonomous systems to safely query and mutate your data.</p>
        </div>
        <div class="lg:col-span-8">
          <video class="aspect-[1240/780] bg-surface-950 border border-surface-800 rounded-xl w-full" style="pointer-events:none;" loop autoplay muted playsinline>
            <source src="/img/data_enhancement.webm" type="video/webm"/>
          </video>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="rounded-xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl">
          <div class="flex items-center px-4 py-2.5 border-b border-surface-800 bg-surface-900/60">
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-red-500/60"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-green-500/60"></div>
            </div>
            <span class="text-[11px] text-surface-400 font-mono ml-3">mcp.json</span>
          </div>
          <pre class="py-4 px-5 text-[12px] font-mono leading-relaxed text-surface-300 overflow-x-auto bg-surface-950" set:html={mcpCode}></pre>
        </div>
        <div>
          <h3 class="text-2xl font-semibold text-white mb-4">Connect AI agents in seconds</h3>
          <p class="text-lg text-surface-400 mb-6">Add Rebase as an MCP server to Cursor, Claude, or any AI tool. Your agents get full CRUD access with schema-aware context.</p>
          <ul class="space-y-3 text-surface-300">
            <li class="flex gap-3"><span class="text-primary">✓</span> Works with Cursor, Claude Desktop, Windsurf</li>
            <li class="flex gap-3"><span class="text-primary">✓</span> Schema-aware — agents know your data model</li>
            <li class="flex gap-3"><span class="text-primary">✓</span> Full CRUD: create, read, update, delete</li>
            <li class="flex gap-3"><span class="text-primary">✓</span> User management and role assignment</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 6 · FEATURE GRID                                           -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class="bg-black py-24 sm:py-32">
    <SectionBackgroundAccents topLine={true}/>
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center mb-16 animate-on-scroll fade-in-up">
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Everything Out of the Box</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        <SpotlightCard icon={Terminal} title="Built-in SQL Editor" description="Run queries, visualize EXPLAIN plans, edit results inline, and save snippets."/>
        <SpotlightCard icon={ShieldCheck} title="Row-Level Security" description="Create and manage Postgres RLS policies visually. Per-row, per-role access rules."/>
        <SpotlightCard icon={Folder} title="File Storage" description="Seamless file storage integration for images, videos, and documents."/>
        <SpotlightCard icon={Network} title="Typed Client SDK" description="Fetch data and resolve deep relations with pure TypeScript autocompletion."/>
        <SpotlightCard icon={Bot} title="AI & MCP Server" description="AI autofill, natural language queries, and full MCP integration for AI agents."/>
        <SpotlightCard icon={History} title="Data History & Audit" description="Track who changed what and when. Compare versions and revert safely."/>
        <SpotlightCard icon={Database} title="Schema Inference" description="Point at an existing Postgres database and get a full admin panel instantly."/>
        <SpotlightCard icon={Zap} title="Instant APIs" description="REST and WebSocket APIs auto-generated from your schema. Zero configuration."/>
        <SpotlightCard icon={Layers} title="Import & Export" description="Bulk import from CSV/JSON with field mapping. Export with a single click."/>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- FINAL CTA                                                  -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class="relative isolate bg-black py-28 sm:py-36 overflow-hidden">
    <SectionBackgroundAccents topLine={true} blob={{ position: "top", size: "lg" }}/>
    <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4 animate-on-scroll fade-in-up">Ready to see it in action?</h2>
      <p class="text-lg text-surface-400 mb-10 max-w-2xl mx-auto animate-on-scroll fade-in-up delay-100">Start with a live demo or scaffold a new project in 30 seconds.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center animate-on-scroll fade-in-up delay-200">
        <a href="https://demo.rebase.pro" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center justify-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-all btn-glow"
           data-track id="product-cta-demo">
          Try the Demo
          <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/docs" class="inline-flex items-center justify-center gap-x-2 rounded-lg border border-surface-700 bg-surface-800 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-surface-700 transition-all" data-track id="product-cta-docs">
          Get Started
          <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

</main>
