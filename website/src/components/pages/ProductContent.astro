---
const { lang, t } = Astro.props;
import { languages, defaultLang, useTranslations } from '../../i18n/ui';
import { NeatBackground } from '../../components/NeatBackground';
import SpotlightCard from '../../components/SpotlightCard.astro';
import { SchemaEditorDemo } from '../../components/SchemaEditorDemo';
import { SQLEditorDemo } from '../../components/demos/SQLEditorDemo';

import { KanbanDemo } from '../../components/demos/KanbanDemo';
import { RichTextEditorDemo } from '../../components/demos/RichTextEditorDemo';
import { SpreadsheetDemo } from '../../components/demos/SpreadsheetDemo';
import { StorageViewDemo } from '../../components/demos/StorageViewDemo';
import { AdminDemoCarousel } from '../../components/demos/AdminDemoCarousel';

import { Terminal, ShieldCheck, Folder, Network, History, Bot, Zap, Database, Layers, Clock, Webhook, Radio, GitBranch, Users, Mail, Globe, KeyRound, Server } from "lucide-react";
import "../../styles/editor.css";
import ScrollSyncShowcase from '../../components/ScrollSyncShowcase.astro';
import RebaseMosaicDemo from '../../components/demos/RebaseMosaicDemo';
import CollectionPowerSection from '../../components/CollectionPowerSection.astro';

---

<div class="flex flex-col isolate">

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- HERO                                                       -->
  <!-- ═══════════════════════════════════════════════════════════ -->
 <section class="relative isolate overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
     <NeatBackground client:idle />


    <div class="px-4 mx-auto max-w-7xl text-center lg:px-12 relative z-10">
      <div class="inline-flex items-center py-1.5 px-4 mb-8 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10 mx-auto">
        <span class="text-sm font-medium">Admin · Backend · SDK · AI — One Framework</span>
      </div>
      <h1 class="mb-6 text-3xl font-semibold tracking-tight md:text-4xl lg:text-5xl text-white">
        Everything you need.<br/><span class="text-primary">Nothing you don't.</span>
      </h1>
      <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48">
        Define your schema in TypeScript. Get a full admin panel, instant APIs, a typed SDK, security policies, and AI tooling — all from a single source of truth.
      </p>
      <div class="flex items-center justify-center gap-x-4">
        <a href="https://demo.rebase.pro" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all btn-glow"
           data-track id="product-hero-demo">
          Try the Demo
          <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/docs" class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold" data-track id="product-hero-docs">
          Read the Docs
          <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>

  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 1 · ADMIN PANEL — "Edit like a spreadsheet"                -->
  <!-- ═══════════════════════════════════════════════════════════ -->
 <section class="relative z-0 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-12 animate-on-scroll fade-in-up">
        <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-blue-500/10 text-blue-400 ring-1 ring-inset ring-blue-500/20">Rebase Studio</div>
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Edit like a spreadsheet. Save like a database.</h2>
        <p class="mt-4 text-lg text-surface-400">Inline editing, real-time filters, Kanban views, and a Notion-style rich text editor — all reading and writing directly to your Postgres tables.</p>
      </div>
      <div class="mx-auto max-w-[1000px]" style="min-height: 700px;">
        <AdminDemoCarousel client:load />
      </div>
    </div>
  </section>

  <!-- Neat gradient divider -->
  <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden" style="z-index: -1; height: 600px;">
      <NeatBackground variant="a" client:visible/>
  </div>


  <!-- Editing views: Bento Grid (Kanban + Rich Text + Spreadsheet + Storage) -->
 <section class="py-24 sm:py-32 relative overflow-hidden">
    <!-- Glow backgrounds for bento section -->
    <div class="pointer-events-none absolute inset-0 -z-10 flex justify-center">
      <div class="absolute top-1/4 w-[600px] h-[300px] rounded-full bg-primary/5 blur-[100px]"></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-16 animate-on-scroll fade-in-up">
        <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-violet-500/10 text-violet-400 ring-1 ring-inset ring-violet-500/20">Flexible Views</div>
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Every way to work with your data.</h2>
        <p class="mt-4 text-lg text-surface-400">Kanban boards, rich text editing, spreadsheet bulk edits, and file management — pick the interface that fits your workflow. Everything writes in real-time to Postgres.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Card 1: Kanban Board (50% Width) -->
        <div class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-surface-800/80 bg-surface-950/40 backdrop-blur-md p-6 hover:border-primary/30 transition-all duration-300 shadow-[0_4px_30px_rgba(0,0,0,0.3)]">
          <div class="mb-6">
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-violet-500/10 text-violet-400 ring-1 ring-inset ring-violet-500/20">Kanban Boards</div>
            <h3 class="text-xl font-medium text-white mb-2">Drag-and-drop management</h3>
            <p class="text-sm text-surface-400 leading-relaxed">Organize records visually by status, priority, or any enum field. Every drag writes directly to Postgres — no sync layer needed.</p>
          </div>
          <div class="rounded-xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 shadow-2xl h-[340px]">
            <KanbanDemo client:only="react" />
          </div>
        </div>

        <!-- Card 2: Rich Text Editor (50% Width) -->
        <div class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-surface-800/80 bg-surface-950/40 backdrop-blur-md p-6 hover:border-primary/30 transition-all duration-300 shadow-[0_4px_30px_rgba(0,0,0,0.3)]">
          <div class="mb-6">
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-emerald-500/10 text-emerald-400 ring-1 ring-inset ring-emerald-500/20">Rich Text</div>
            <h3 class="text-xl font-medium text-white mb-2">Notion-style block editor</h3>
            <p class="text-sm text-surface-400 leading-relaxed">Headings, lists, images, code blocks, callouts — all stored as structured JSON. Collaborate like you would in a modern writing tool.</p>
          </div>
          <div class="rounded-xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 shadow-2xl h-[340px]">
            <RichTextEditorDemo client:only="react" />
          </div>
        </div>

        <!-- Card 3: Spreadsheet View (Full Width) -->
        <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-surface-800/80 bg-surface-950/40 backdrop-blur-md p-6 hover:border-primary/30 transition-all duration-300 shadow-[0_4px_30px_rgba(0,0,0,0.3)] lg:col-span-2">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <div class="lg:col-span-1">
              <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-cyan-500/10 text-cyan-400 ring-1 ring-inset ring-cyan-500/20">Spreadsheet View</div>
              <h3 class="text-2xl font-medium text-white mb-2">Inline editing at scale</h3>
              <p class="text-sm text-surface-400 leading-relaxed mb-6">Sort, filter, bulk-edit, and paginate thousands of rows. Every cell is editable in place — no modals, no page reloads. Fast, responsive, and robust.</p>
            </div>
            <div class="lg:col-span-2 rounded-xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 shadow-2xl">
              <SpreadsheetDemo client:only="react" />
            </div>
          </div>
        </div>

        <!-- Card 4: File Storage (Full Width) -->
        <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-surface-800/80 bg-surface-950/40 backdrop-blur-md p-6 hover:border-primary/30 transition-all duration-300 shadow-[0_4px_30px_rgba(0,0,0,0.3)] lg:col-span-2">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <div class="lg:col-span-2 rounded-xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 shadow-2xl">
              <StorageViewDemo client:only="react" />
            </div>
            <div class="lg:col-span-1">
              <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-pink-500/10 text-pink-400 ring-1 ring-inset ring-pink-500/20">File Storage</div>
              <h3 class="text-2xl font-medium text-white mb-2">Digital asset management</h3>
              <p class="text-sm text-surface-400 leading-relaxed mb-6">Manage uploads, folders, and assets directly within the admin panel. Auto-linked to your database records, with built-in preview and metadata rendering.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 2 · SCHEMA-AS-CODE                                         -->
  <!-- ═══════════════════════════════════════════════════════════ -->
 <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-10 animate-on-scroll fade-in-up">
        <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-indigo-500/10 text-indigo-400 ring-1 ring-inset ring-indigo-500/20">Schema-as-Code</div>
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">Visual building. Real TypeScript.</h2>
        <p class="text-lg text-surface-400">Design your schema visually — every change writes back to your local TypeScript files via AST. Or connect your existing database and get a full admin panel instantly.</p>
      </div>
      <div class="mx-auto max-w-[1400px]">
        <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-950" style="height:600px;">
          <SchemaEditorDemo client:load/>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 3 · SQL EDITOR                                            -->
  <!-- ═══════════════════════════════════════════════════════════ -->
 <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="lg:order-last">
          <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-cyan-500/10 text-cyan-400 ring-1 ring-inset ring-cyan-500/20">Built-in SQL</div>
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">SQL Editor</h2>
          <p class="text-lg text-surface-400 mb-6">Write and execute SQL directly against your database. Schema-aware autocomplete, result previews, and query history.</p>
          <ul class="space-y-3 text-surface-300">
            <li class="flex gap-3"><span class="text-primary">✓</span> Monaco-based editor with syntax highlighting</li>
            <li class="flex gap-3"><span class="text-primary">✓</span> Schema browser with table/column introspection</li>
            <li class="flex gap-3"><span class="text-primary">✓</span> Inline result table with sorting and pagination</li>
          </ul>
        </div>
        <div class="rounded-xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl">
          <SQLEditorDemo client:only="react" />
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 4 · FLEXIBLE & ADAPTABLE                                   -->
  <!-- ═══════════════════════════════════════════════════════════ -->
 <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-14">
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Flexible and Adaptable to Your Needs</h2>
        <p class="mt-6 text-lg leading-8 text-surface-400">Rebase is designed to fit into your existing stack and workflow, not the other way around.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <!-- Import/Export -->
        <div>
          <div class="relative w-full h-96 bg-surface-900 rounded-2xl ring-1 ring-surface-800 flex items-center justify-center mb-6">
            <img src="/img/import_mapping.webp" alt="Import field mapping" class="h-full w-full object-cover object-left-top"/>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-3">Effortless Data Import & Export</h3>
          <p class="text-surface-400 leading-7">Migrate your data seamlessly. Bulk import from CSV or JSON with intuitive field mapping and validation. Export your collections to CSV or JSON with a single click.</p>
        </div>
        <!-- Custom Branding -->
        <div>
          <div class="relative w-full h-96 bg-surface-900 rounded-2xl overflow-hidden ring-1 ring-surface-800 flex items-center justify-center mb-6">
            <img src="/img/toleroo_recipe.webp" alt="Custom Branding Example" class="h-full w-full object-cover object-left-top"/>
          </div>
          <h3 class="text-2xl font-semibold text-white mb-3">Make It Yours with Custom Branding</h3>
          <p class="text-surface-400 leading-7">Customize logos, colors, and themes to match your brand. Provide a seamless experience for your users and clients with a back-office that feels like a part of your own product.</p>
        </div>
      </div>
    </div>
  </section>




  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 6 · FEATURE GRID                                           -->
  <!-- ═══════════════════════════════════════════════════════════ -->
 <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center mb-16 animate-on-scroll fade-in-up">
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Admin & Data Tools</h2>
        <p class="mt-4 text-lg text-surface-400">Everything you need to manage, query, and secure your data.</p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        <SpotlightCard icon={Terminal} title="Built-in SQL Editor" description="Run queries, visualize EXPLAIN plans, edit results inline, and save snippets."/>
        <SpotlightCard icon={ShieldCheck} title="Row-Level Security" description="Create and manage Postgres RLS policies visually. Per-row, per-role access rules."/>
        <SpotlightCard icon={Network} title="Typed Client SDK" description="Fetch data and resolve deep relations with pure TypeScript autocompletion."/>
        <SpotlightCard icon={Globe} title="REST & OpenAPI" description="Auto-generated REST endpoints with OpenAPI 3.0 spec and Swagger UI."/>
        <SpotlightCard icon={Bot} title="AI & MCP Server" description="AI autofill, natural language queries, and full MCP integration for AI agents."/>
        <SpotlightCard icon={Users} title="Users & Roles" description="Manage users, assign roles, and configure RBAC directly from the admin panel."/>
        <SpotlightCard icon={History} title="Entity History" description="Full audit trail with versioning. See who changed what, when, and revert to any previous state."/>
        <SpotlightCard icon={Layers} title="Import & Export" description="Bulk import from CSV/JSON with field mapping. Export with a single click."/>
        <SpotlightCard icon={GitBranch} title="Database Branching" description="Create isolated database copies for development. Branch, experiment, and merge safely."/>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 7 · BACKEND INFRASTRUCTURE                                -->
  <!-- ═══════════════════════════════════════════════════════════ -->
 <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center mb-16 animate-on-scroll fade-in-up">
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Backend Infrastructure</h2>
        <p class="mt-4 text-lg text-surface-400">Production-grade services built into the framework. No third-party assembly required.</p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        <SpotlightCard icon={KeyRound} title="Authentication" description="JWT access/refresh tokens, Google OAuth, MFA, RBAC, API keys, and session management."/>
        <SpotlightCard icon={Radio} title="Realtime Engine" description="WebSocket subscriptions, broadcast channels, and presence tracking — built in."/>
        <SpotlightCard icon={Mail} title="Email Service" description="SMTP integration with password reset, email verification, and transactional email templates."/>
        <SpotlightCard icon={Clock} title="Cron Jobs" description="Schedule background tasks with monitoring, logging, and a Studio dashboard."/>
        <SpotlightCard icon={Zap} title="Custom Functions" description="Drop a Hono route in functions/ — auto-mounted with auth and DB access."/>
        <SpotlightCard icon={Webhook} title="Webhooks" description="HMAC-signed outbound webhooks on INSERT, UPDATE, DELETE with automatic retries."/>
        <SpotlightCard icon={Database} title="Drizzle ORM" description="Auto-generated Drizzle schema with zero N+1 queries, field selection, and relational loading."/>
        <SpotlightCard icon={Server} title="Self-Host Anywhere" description="Your Postgres, your infrastructure. Deploy with Docker, Railway, Fly.io, or bare metal."/>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- ONE COLLECTION. EVERYTHING.                                -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <CollectionPowerSection/>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- SCROLL-SYNC FEATURE SHOWCASE                               -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <ScrollSyncShowcase/>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- VISUAL MOSAIC SHOWCASE                                     -->
  <!-- ═══════════════════════════════════════════════════════════ -->
 <section id="s-mosaic-showcase" class="relative z-0 py-28 sm:py-36 overflow-hidden">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-16 animate-on-scroll fade-in-up">
        <p class="text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase">{t("mosaic.badge")}</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-5xl">
          {t("mosaic.title")}
        </h2>
        <p class="mt-4 text-surface-400 text-base sm:text-lg leading-relaxed">
          {t("mosaic.subtitle")}
        </p>
      </div>

      <div class="max-w-7xl mx-auto animate-on-scroll fade-in-up delay-100" style="min-height: 760px;" inert aria-hidden="true">
        <RebaseMosaicDemo client:visible/>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- FINAL CTA                                                  -->
  <!-- ═══════════════════════════════════════════════════════════ -->
 <section class="relative isolate py-28 sm:py-36 overflow-hidden">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4 animate-on-scroll fade-in-up">Ready to see it in action?</h2>
      <p class="text-lg text-surface-400 mb-10 max-w-2xl mx-auto animate-on-scroll fade-in-up delay-100">Start with a live demo or scaffold a new project in 30 seconds.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center animate-on-scroll fade-in-up delay-200">
        <a href="https://demo.rebase.pro" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center justify-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all btn-glow"
           data-track id="product-cta-demo">
          Try the Demo
          <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/docs" class="inline-flex items-center justify-center gap-x-2 rounded-lg border border-surface-700 bg-surface-800 px-6 py-3 text-base font-semibold text-white hover:bg-surface-700 transition-all" data-track id="product-cta-docs">
          Get Started
          <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

</div>
