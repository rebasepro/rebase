---
const { lang, t } = Astro.props;

import { NeatBackground } from '../../components/NeatBackground';
import CollectionPowerSection from '../../components/CollectionPowerSection.astro';
import ScrollSyncShowcase from '../../components/ScrollSyncShowcase.astro';
import RebaseMosaicDemo from '../../components/demos/RebaseMosaicDemo';
import { useTranslatedPath } from '../../i18n/ui';
import "../../styles/editor.css";

const translatePath = useTranslatedPath(lang);

// ── The map ────────────────────────────────────────────────────────────────
// The one thing this page exists to show: two layers, what is in each, and
// which page goes deeper. Backend first — see website/SITE-STORY.md.
const backendParts = [
    { name: "REST API", note: "CRUD, filtering, sorting, pagination, relations", meta: "/api/data/:collection" },
    { name: "Typed SDK", note: "Generated from your collections, checked at compile time", meta: "@rebasepro/client" },
    { name: "Realtime", note: "Row subscriptions, channels and presence over WebSocket", meta: "listen()" },
    { name: "Auth", note: "JWT access and refresh, OAuth, MFA, roles, API keys", meta: "/api/auth/*" },
    { name: "Storage", note: "Local, S3-compatible or GCS, routed per field", meta: "/api/storage/*" },
    { name: "Functions & cron", note: "Your own Hono routes and scheduled jobs, auto-mounted", meta: "functions/" },
    { name: "Row-level security", note: "Policies compiled into Postgres — closed by default", meta: "securityRules" },
    { name: "OpenAPI", note: "A spec and an explorer, regenerated with the schema", meta: "/api/docs" },
];

const adminParts = [
    { name: "Collection views", note: "Table, cards, list and Kanban over the same rows", meta: "enabledViews" },
    { name: "Entity forms", note: "Generated from properties, with validation and relations", meta: "properties" },
    { name: "Your React", note: "Custom fields, previews, views and entity actions", meta: "admin.Field" },
    { name: "Users & roles", note: "The same roles your policies read, managed by humans", meta: "RBAC" },
    { name: "Rebase Studio", note: "The developer workspace, registered inside the same panel as CMS: SQL, schema, policies, branches, logs", meta: "/studio" },
];

// What you stop maintaining. Concrete, not aspirational.
const replaced = [
    "CRUD controllers, serializers and request validation",
    "A hand-rolled back office, and the sprint it costs every quarter",
    "JWT plumbing, refresh rotation and password-reset email",
    "Permission checks scattered across route handlers",
    "File-upload endpoints and signed-URL helpers",
    "A cron runner, a webhook dispatcher and an audit-log table",
    "The OpenAPI document nobody remembered to update",
    "A second data model, kept in sync with the first by hand",
];
import ClosingCta from "../ClosingCta.astro";
---

<div class="flex flex-col isolate">

    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24 lg:pb-24">
        <NeatBackground client:idle transition:persist="neat-hero" />

        <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
            <div class="inline-flex items-center py-1.5 px-4 mb-8 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10">
                <span class="text-sm font-medium">The backend · and the panel, if you want one</span>
            </div>
            <h1 class="mb-6 text-display-2 text-white">
                One definition.<br/>Everything it produces.
            </h1>
            <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl">
                Rebase turns a Postgres database into a product backend — REST, a typed SDK, realtime, auth,
                storage and access control the database itself enforces. The admin panel renders from the same
                file, and only if you ask for it.
            </p>
            <div class="flex items-center justify-start gap-x-4">
                <a href={translatePath("/demo")}
                   class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all btn-glow"
                   data-track id="product-hero-demo">
                    Try the demo
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
                <a href="/docs" class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold"
                   data-track id="product-hero-docs">
                    Read the docs
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ ONE DEFINITION ═══════════════════════ -->
    <div class="relative z-0">
        <CollectionPowerSection
            badge="What the definition produces"
            title='Both layers come out of the same file.'/>
    </div>

    <!-- ═══════════════════════ ACT I — THE BACKEND ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start mb-14">
                <div class="lg:col-span-5">
                    <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">Act one</p>
                    <h2 class="text-3xl sm:text-4xl text-white mb-5">
                        The half that runs without a browser
                    </h2>
                    <p class="text-base text-surface-400 leading-relaxed mb-4">
                        A Rebase project is a Hono server and a Drizzle schema. It serves your data over REST,
                        streams changes over WebSocket, issues and rotates tokens, stores files, runs your
                        scheduled jobs, and publishes an OpenAPI document that is always current because nobody
                        writes it.
                    </p>
                    <p class="text-base text-surface-400 leading-relaxed mb-6">
                        Every one of those requests executes as a restricted Postgres role. That is the part
                        worth reading twice: authorization is a property of your database, not of this process.
                    </p>
                    <div class="flex flex-col items-start gap-3">
                        <a href={translatePath("/backend")}
                           class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                            The backend, in depth
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>
                        </a>
                        <a href={translatePath("/security")}
                           class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                            How the security model works
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                </div>

                <div class="lg:col-span-7">
                    <div class="rounded-2xl border border-surface-800/80 bg-surface-950/60 p-7">
                        <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-surface-500 mb-5">
                            What you stop maintaining
                        </p>
                        <ul class="space-y-3">
                            {replaced.map(item => (
                                    <li class="flex gap-3 text-sm text-surface-400 leading-relaxed">
                                        <svg class="mt-0.5 h-4 w-4 shrink-0 text-surface-600" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M18 6 6 18"/>
                                            <path d="m6 6 12 12"/>
                                        </svg>
                                        {item}
                                    </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ ACT II — THE PANEL ═══════════════════════ -->
    <ScrollSyncShowcase/>

    <!-- ═══════════════════════ EVERYTHING AT ONCE ═══════════════════════ -->
    <section id="s-mosaic-showcase" class="relative z-0 py-24 sm:py-32 overflow-hidden">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-16 animate-on-scroll fade-in-up">
                <p class="text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">{t("mosaic.badge")}</p>
                <h2 class="mt-4 text-display-2 text-white">
                    {t("mosaic.title")}
                </h2>
                <p class="mt-4 text-surface-400 text-base sm:text-lg leading-relaxed">
                    {t("mosaic.subtitle")}
                </p>
            </div>

            <div class="max-w-6xl mx-auto animate-on-scroll fade-in-up delay-100" style="min-height: 760px;" inert
                 aria-hidden="true">
                <RebaseMosaicDemo client:visible/>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ ACT III — AGENTS & OPS ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-12">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">Act three</p>
                <h2 class="text-3xl sm:text-4xl text-white">
                    Built to be operated — by your team, and by their agents
                </h2>
                <p class="mt-5 text-lg leading-8 text-surface-400">
                    The same authorization model that protects a human session protects a coding agent. That is
                    the only version of agent access we are comfortable shipping.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <a href={translatePath("/ai")}
                   class="group p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 hover:ring-primary/30 transition-all duration-300 block">
                    <h3 class="text-lg font-semibold text-white mb-2">MCP server</h3>
                    <p class="text-sm text-surface-400 mb-4">Thirty-odd tools an agent can call: read the schema,
                        generate migrations, query data, manage storage and cron.</p>
                    <span class="inline-flex items-center gap-2 text-sm font-medium text-primary">
                        AI &amp; agents
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </span>
                </a>
                <a href={translatePath("/security")}
                   class="group p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 hover:ring-primary/30 transition-all duration-300 block">
                    <h3 class="text-lg font-semibold text-white mb-2">Scoped API keys</h3>
                    <p class="text-sm text-surface-400 mb-4">Keys carry a permission list <em>and</em> pass through
                        row-level security. There is no key that bypasses the database.</p>
                    <span class="inline-flex items-center gap-2 text-sm font-medium text-primary">
                        Security &amp; RLS
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </span>
                </a>
                <a href={translatePath("/developers")}
                   class="group p-7 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 hover:ring-primary/30 transition-all duration-300 block">
                    <h3 class="text-lg font-semibold text-white mb-2">Agent skills</h3>
                    <p class="text-sm text-surface-400 mb-4">Installable instructions for Claude Code, Cursor,
                        Windsurf and Gemini, so an agent writes Rebase the way you would.</p>
                    <span class="inline-flex items-center gap-2 text-sm font-medium text-primary">
                        For developers
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </span>
                </a>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ THE MAP ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-14 animate-on-scroll fade-in-up">
                <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">The whole product</p>
                <h2 class="text-3xl sm:text-4xl text-white">
                    Everything Rebase ships, on one screen
                </h2>
                <p class="mt-5 text-lg leading-8 text-surface-400">
                    The left column runs with nothing else installed. The right column is one dependency away,
                    and deleting it does not move a single API response.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
                <!-- Backend -->
                <div class="relative overflow-hidden rounded-2xl border border-primary/25 bg-surface-950/70">
                    <div class="pointer-events-none absolute inset-0" aria-hidden="true"
                         style="background: radial-gradient(600px 300px at 30% 0%, rgba(0,112,244,0.12), transparent 70%);"></div>
                    <div class="relative px-7 py-6 border-b border-surface-800/80 flex items-baseline justify-between gap-4">
                        <div>
                            <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-surface-500 mb-1">Layer 01</p>
                            <h3 class="text-2xl font-semibold text-white">The backend</h3>
                        </div>
                        <span class="text-xs text-surface-500 shrink-0">always on</span>
                    </div>
                    <ul class="relative divide-y divide-surface-800/60">
                        {backendParts.map(part => (
                                <li class="px-7 py-4">
                                    <div class="flex items-baseline justify-between gap-4">
                                        <span class="text-sm font-semibold text-white">{part.name}</span>
                                        <code class="font-mono text-2xs text-surface-500 shrink-0">{part.meta}</code>
                                    </div>
                                    <p class="mt-1 text-sm text-surface-400 leading-relaxed">{part.note}</p>
                                </li>
                        ))}
                    </ul>
                    <div class="relative px-7 py-5 border-t border-surface-800/80">
                        <a href={translatePath("/backend")}
                           class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                            Everything in the backend, with live demos
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Admin panel -->
                <div class="relative overflow-hidden rounded-2xl border border-surface-800/80 bg-surface-950/50">
                    <div class="px-7 py-6 border-b border-surface-800/80 flex items-baseline justify-between gap-4">
                        <div>
                            <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-surface-500 mb-1">Layer 02</p>
                            <h3 class="text-2xl font-semibold text-white">The panel</h3>
                        </div>
                        <span class="text-xs text-surface-500 shrink-0">opt in</span>
                    </div>
                    <ul class="divide-y divide-surface-800/60">
                        {adminParts.map(part => (
                                <li class="px-7 py-4">
                                    <div class="flex items-baseline justify-between gap-4">
                                        <span class="text-sm font-semibold text-white">{part.name}</span>
                                        <code class="font-mono text-2xs text-surface-500 shrink-0">{part.meta}</code>
                                    </div>
                                    <p class="mt-1 text-sm text-surface-400 leading-relaxed">{part.note}</p>
                                </li>
                        ))}
                    </ul>
                    <div class="px-7 py-4 bg-surface-900/30 border-t border-surface-800/60">
                        <p class="text-sm text-surface-400 leading-relaxed">
                            The panel is a React app that talks to the endpoints on the left, under the same
                            row-level security as your own client. There is no private back channel for data.
                        </p>
                    </div>
                    <div class="px-7 py-5 border-t border-surface-800/80">
                        <a href={translatePath("/cms")}
                           class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                            What your team gets from the panel
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>



    <ClosingCta title="Both layers, one command." blurb="Scaffold a project against your own Postgres and see exactly which half you keep." trackId="product" />

</div>
