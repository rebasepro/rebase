---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';



import { NeatBackground } from '../../components/NeatBackground';




const commands = [
    {
        command: "rebase schema generate",
        label: "Schema Generate",
        description: "Read your TypeScript collection definitions and generate a Drizzle ORM schema file. Run this after adding or modifying collections.",
        badge: "schema",
        color: "blue"
    },
    {
        command: "rebase db push",
        label: "DB Push",
        description: "Apply the current Drizzle schema directly to your database. A development shortcut that skips migration files.",
        badge: "db",
        color: "amber"
    },
    {
        command: "rebase schema introspect",
        label: "Schema Introspect",
        description: "Introspect your live PostgreSQL database and generate Rebase collection definitions from existing tables, columns, and relations.",
        badge: "schema",
        color: "blue"
    },
    {
        command: "rebase db generate",
        label: "DB Generate",
        description: "Compare your current Drizzle schema against the last entity and generate SQL migration files for the differences.",
        badge: "db",
        color: "amber"
    },
    {
        command: "rebase db migrate",
        label: "DB Migrate",
        description: "Run all pending SQL migrations against your database. Safe for production deployments.",
        badge: "db",
        color: "amber"
    },
    {
        command: "rebase generate-sdk",
        label: "Generate SDK",
        description: "Generate a fully-typed database.types.ts file from your collection definitions. Use with createRebaseClient<Database>() for end-to-end type safety.",
        badge: "sdk",
        color: "purple"
    },
    {
        command: "rebase dev",
        label: "Dev Server",
        description: "Start the frontend and backend concurrently in development mode with hot reload.",
        badge: "dev",
        color: "pink"
    },
    {
        command: "rebase auth reset-password",
        label: "Reset Password",
        description: "Set a user's password from the terminal, by email — for when nobody can get back into the admin panel.",
        badge: "auth",
        color: "cyan"
    },
];
import ClosingCta from "../ClosingCta.astro";
---

  <div class="flex flex-col isolate">
    <!-- Hero -->
 <section class="relative isolate overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
     <NeatBackground client:idle />

      <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
        <p class="mb-5 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
          <a href="/developers" class="hover:text-primary transition-colors">For developers</a>
          <span class="mx-2 text-surface-600">/</span><span class="text-surface-500">CLI &amp; tooling</span>
        </p>
        <h1 class="mb-6 text-display-2 text-white">
          One CLI for<br/>the whole lifecycle.
        </h1>
        <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl">
          Scaffold a project, introspect a database you already have, move the schema, regenerate the types, run both
          halves in dev, and install the skills your coding agent needs.
        </p>
      </div>
    </section>


    <!-- Command Reference -->
 <section class="relative z-0 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <h2 class="text-3xl sm:text-4xl text-white">Command Reference</h2>
          <p class="mt-4 text-lg text-surface-400">Every command you need, from scaffolding to production migration.</p>
        </div>
        <div class="max-w-4xl mx-auto space-y-4">
          {commands.map(cmd => (
            <div class="rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 overflow-hidden">
              <div class="p-6">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div class="flex items-center gap-3">
                    <h3 class="text-lg font-semibold text-white">{cmd.label}</h3>
                    <span class={`inline-flex items-center py-0.5 px-2 text-xs font-medium rounded-full bg-${cmd.color}-500/10 text-${cmd.color}-400 ring-1 ring-inset ring-${cmd.color}-500/20`}>
                      {cmd.badge}
                    </span>
                  </div>
                </div>
                <div class="bg-surface-900 rounded-lg px-4 py-2.5 mb-3 font-mono text-sm">
                  <span class="text-emerald-400">$</span> <span class="text-surface-300">{cmd.command}</span>
                </div>
                <p class="text-sm text-surface-400">{cmd.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>

    <!-- Workflow Diagram -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <h2 class="text-3xl sm:text-4xl text-white">The Rebase Workflow</h2>
          <p class="mt-4 text-lg text-surface-400">Collections are the source of truth. Everything flows from them.</p>
        </div>
        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-5 gap-4 items-center">
            <div class="p-6 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
              <div class="mx-auto mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-inset ring-primary/20">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                </svg>
              </div>
              <p class="text-white font-semibold text-sm">Define Collections</p>
              <p class="text-xs text-surface-500 mt-1">TypeScript</p>
            </div>
            <div class="hidden md:flex items-center justify-center text-surface-600">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </div>
            <div class="p-6 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
              <div class="mx-auto mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-inset ring-primary/20">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <path d="M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01"/>
                </svg>
              </div>
              <p class="text-white font-semibold text-sm">Generate Schema</p>
              <p class="text-xs text-surface-500 mt-1">rebase schema generate</p>
            </div>
            <div class="hidden md:flex items-center justify-center text-surface-600">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </div>
            <div class="p-6 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
              <div class="mx-auto mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-inset ring-primary/20">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <path d="M12 19V5"/><path d="m5 12 7-7 7 7"/>
                </svg>
              </div>
              <p class="text-white font-semibold text-sm">Push & Deploy</p>
              <p class="text-xs text-surface-500 mt-1">rebase db push</p>
            </div>
          </div>
          <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-4 rounded-xl bg-surface-900/30 ring-1 ring-inset ring-surface-800/50 text-center">
              <p class="text-sm text-surface-400">Generates → <span class="text-white">REST API</span></p>
            </div>
            <div class="p-4 rounded-xl bg-surface-900/30 ring-1 ring-inset ring-surface-800/50 text-center">
              <p class="text-sm text-surface-400">Generates → <span class="text-white">Admin UI</span></p>
            </div>
            <div class="p-4 rounded-xl bg-surface-900/30 ring-1 ring-inset ring-surface-800/50 text-center">
              <p class="text-sm text-surface-400">Generates → <span class="text-white">Typed Client SDK</span></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
 <section class="py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl text-white mb-8">Get started with your project</h2>
        <div class="flex items-center justify-center gap-x-6">
          <a href="/sdk"
             class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all duration-200 ease-in-out btn-glow">
            Client SDK
            
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

          </a>
          <a href="/developers" class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold">
            Developer Guide
            
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

          </a>
        </div>
      </div>
    </section>
  
    <ClosingCta title="The whole lifecycle, one terminal." blurb="Scaffold a project, push a schema, run it, back it up — every step is a command you can put in CI." trackId="cli" />

</div>

