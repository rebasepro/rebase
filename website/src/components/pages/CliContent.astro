---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';



import { NeatBackground } from '../../components/NeatBackground';




const terminalRun = `<span class="text-surface-500">$</span> pnpm dlx @rebasepro/cli init
<span class="text-emerald-400">✔</span> Initialized Rebase in current directory.
<span class="text-surface-500">  backend/  frontend/  .env  rebase.config.ts</span>

<span class="text-surface-500">$</span> rebase db push
<span class="text-emerald-400">✔</span> Schema pushed to database. Tables created.
<span class="text-emerald-400">✔</span> Row-level security enabled on every collection.

<span class="text-surface-500">$</span> rebase dev
<span class="text-emerald-400">✔</span> API and realtime on :3001, panel on :5173.`;

import ClosingCta from "../ClosingCta.astro";
---

  <div class="flex flex-col isolate">
    <!-- Hero -->
 <section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24 lg:pb-24">
     <NeatBackground client:idle transition:persist="neat-hero" />

      <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
        <p class="mb-5 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase" set:html={t("cli.00")}></p>
        <h1 class="mb-6 text-display-2 text-white" set:html={t("cli.01")}></h1>
        <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl">{t("cli.02")}</p>
      </div>
    </section>


    <!-- Command Reference -->
    {/* SITE-STORY §5 and PRODUCT.md principle 3: real terminal output, not a
        card grid. An eight-card "Command Reference" and a five-box "Workflow
        Diagram" stood here; the docs are the reference, and this is the run. */}
    <section class="relative z-0 py-16 sm:py-24">
      <div class="mx-auto max-w-4xl px-6 lg:px-8">
        <div class="max-w-2xl mb-10">
          <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">{t("cli.03")}</p>
          <h2 class="text-3xl sm:text-4xl text-white">{t("cli.04")}</h2>
          <p class="mt-5 text-lg leading-8 text-surface-400">{t("cli.05")}</p>
        </div>

        <div class="frame overflow-hidden">
          <div class="px-4 py-3 border-b border-surface-800/80 bg-surface-900/50 flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-surface-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-surface-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-surface-700"></span>
            <span class="ml-3 font-mono text-xs text-surface-400">zsh</span>
          </div>
          <pre class="p-6 overflow-x-auto text-xs sm:text-sm leading-relaxed font-mono text-surface-300"><code set:html={terminalRun}></code></pre>
        </div>

        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <h3 class="text-lg text-white mb-2">{t("cli.06")}</h3>
            <p class="text-sm text-surface-400 mb-3">{t("cli.07")}</p>
            <div class="rounded-lg border border-surface-800 bg-surface-900/60 px-4 py-2.5 font-mono text-xs text-surface-300">
              rebase skills install --agent claude
            </div>
          </div>
          <div>
            <h3 class="text-lg text-white mb-2">{t("cli.08")}</h3>
            <p class="text-sm text-surface-400 mb-3" set:html={t("cli.09")}></p>
            <div class="rounded-lg border border-surface-800 bg-surface-900/60 px-4 py-2.5 font-mono text-xs text-surface-300">
              rebase db backup --out s3://backups/app.dump
            </div>
          </div>
        </div>

        <a href="/docs/cli" class="accent-link mt-10">
          {t("clipage.link.reference")}
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>

    <ClosingCta title={t("close.cli.title")} blurb={t("close.cli.blurb")} trackId="cli" />

</div>

