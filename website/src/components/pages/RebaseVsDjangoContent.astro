---
const { lang, t } = Astro.props;
const translatePath = useTranslatedPath(lang);

import { languages, defaultLang, useTranslations, useTranslatedPath } from '../../i18n/ui';



import { NeatBackground } from '../../components/NeatBackground';
import VsHeroLockup from '../../components/VsHeroLockup.astro';



import ComparisonFaq from "../ComparisonFaq.astro";
import { COMPARISON_FAQS } from "../../data/comparison-faqs";
import ClosingCta from "../ClosingCta.astro";
---

  <div class="flex flex-col isolate">
 <section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24 lg:pb-24">
     <NeatBackground client:idle transition:persist="neat-hero" />

      
      <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
        <VsHeroLockup name="Django" logo="/img/competitors/django-logo-negative.svg" logoClass="h-8 sm:h-9"/>
        <h1 class="mb-6 text-display-2 text-white">
          Rebase vs Django
        </h1>
        <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl">
          Django gives you an admin scaffolded from your models and a server-rendered page for every screen. Rebase gives you the same scaffolding as a React app, plus the REST API and the typed client the admin is a consumer of — so a mobile client or a separate frontend is not a second thing you build.
        </p>
      </div>
    </section>
    <!-- Content Sections -->
 <section class="relative z-0 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        
        <div class="space-y-16">
          
          <!-- Point 1 -->
          <div class="py-2">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-sm font-medium mb-3">
                    
<svg
  class="lucide lucide-triangle"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M13.73 4a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
</svg>

                    Monolith vs Decoupled
                  </div>
                  <h3 class="text-2xl font-semibold text-white">Server-rendered vs Headless SDK</h3>
                </div>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
                <!-- VS Badge -->
                <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full border border-surface-700 bg-surface-900 items-center justify-center text-xs font-semibold text-surface-400 z-10 shadow-xl">VS</div>
                
                <!-- Competitor Card -->
                <div class="bg-surface-800/20 rounded-xl p-6 border border-surface-700/50 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-red-500/5 blur-[50px] -mr-16 -mt-16"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 mb-3">
                      
<svg
  class="lucide lucide-circle-alert"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <circle cx="12" cy="12" r="10" />
  <line x1="12" x2="12" y1="8" y2="12" />
  <line x1="12" x2="12.01" y1="16" y2="16" />
</svg>

                      <h4 class="text-white font-semibold">The Monolithic Pain</h4>
                    </div>
                    <p class="text-surface-400 text-sm leading-relaxed">Django's admin is tied to its server-rendered templates and to the ORM behind them. A separate consumer app needs an API of its own — Django REST Framework or Ninja — and that means serializers, viewsets, routers and permission classes describing the same models a second time. Rebase generates the API and the admin from one definition, so there is no second description to keep in step.</p>
                  </div>
                </div>

                <!-- Rebase Card -->
                <div class="bg-primary/5 rounded-xl p-6 border border-primary/20 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 blur-[50px] -mr-16 -mt-16"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 mb-3">
                      
<svg
  class="lucide lucide-circle-check-big"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M21.801 10A10 10 0 1 1 17 3.335" />
  <path d="m9 11 3 3L22 4" />
</svg>

                      <h4 class="text-white font-semibold">How Rebase Solves This</h4>
                    </div>
                    <p class="text-surface-300 leading-relaxed text-sm mb-4">
                      Rebase is natively API-first and decoupled by default.
                    </p>
                    <ul class="text-surface-400 space-y-3 text-sm">
                      <li class="flex items-start">
<svg
  class="lucide lucide-check"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M20 6 9 17l-5-5" />
</svg>
 <span class="leading-relaxed">Rebase generates a standalone React UI interacting with its own backend APIs securely.</span></li>
                  <li class="flex items-start">
<svg
  class="lucide lucide-check"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M20 6 9 17l-5-5" />
</svg>
 <span class="leading-relaxed">It simultaneously creates a totally typed React Client SDK for you to use in any external application effortlessly.</span></li>
                    </ul>
                  </div>
                </div>
              </div>
          </div>

          <!-- Point 2 -->
          <div class="py-2">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/10 text-primary text-sm font-medium mb-3">
                    
<svg
  class="lucide lucide-gauge"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m12 14 4-4" />
  <path d="M3.34 19a10 10 0 1 1 17.32 0" />
</svg>

                    User Interface
                  </div>
                  <h3 class="text-2xl font-semibold text-white">Page Reloads vs Instant React SPA</h3>
                </div>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
                <!-- VS Badge -->
                <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full border border-surface-700 bg-surface-900 items-center justify-center text-xs font-semibold text-surface-400 z-10 shadow-xl">VS</div>
                
                <!-- Competitor Card -->
                <div class="bg-surface-800/20 rounded-xl p-6 border border-surface-700/50 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-red-500/5 blur-[50px] -mr-16 -mt-16"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 mb-3">
                      
<svg
  class="lucide lucide-circle-alert"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <circle cx="12" cy="12" r="10" />
  <line x1="12" x2="12" y1="8" y2="12" />
  <line x1="12" x2="12.01" y1="16" y2="16" />
</svg>

                      <h4 class="text-white font-semibold">The Monolithic Pain</h4>
                    </div>
                    <p class="text-surface-400 text-sm leading-relaxed">A server-rendered admin reloads the page on every save, and putting a React component or a live view inside one means bolting a build step onto a template. The Rebase panel is a React app to begin with, so a custom field is a component you export.</p>
                  </div>
                </div>

                <!-- Rebase Card -->
                <div class="bg-primary/5 rounded-xl p-6 border border-primary/20 relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 blur-[50px] -mr-16 -mt-16"></div>
                  <div class="relative">
                    <div class="flex items-center gap-2 mb-3">
                      
<svg
  class="lucide lucide-circle-check-big"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M21.801 10A10 10 0 1 1 17 3.335" />
  <path d="m9 11 3 3L22 4" />
</svg>

                      <h4 class="text-white font-semibold">How Rebase Solves This</h4>
                    </div>
                    <p class="text-surface-300 leading-relaxed text-sm mb-4">
                      The Rebase panel is a React single-page application.
                    </p>
                    <ul class="text-surface-400 space-y-3 text-sm">
                      <li class="flex items-start">
<svg
  class="lucide lucide-check"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M20 6 9 17l-5-5" />
</svg>
 <span class="leading-relaxed">Navigation does not round-trip the server, and an action does not reload the page.</span></li>
                  <li class="flex items-start">
<svg
  class="lucide lucide-check"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M20 6 9 17l-5-5" />
</svg>
 <span class="leading-relaxed">Built-in real-time subscription support means records update natively if someone else edits a field—without refreshing.</span></li>
                  <li class="flex items-start">
<svg
  class="lucide lucide-check"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M20 6 9 17l-5-5" />
</svg>
 <span class="leading-relaxed">Fully customizable with standard React.js components.</span></li>
                    </ul>
                  </div>
                </div>
              </div>
          </div>

          
        </div>

      </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>


    {/* The honest concession, promoted out of the collapsed FAQ at the foot of
        the page. PRODUCT.md principle 4: a comparison has to survive a reader
        who uses the competitor daily, and a page that never says "stay" does
        not. Same text as the FAQ entry, so the two cannot drift. */}
    <section id="concession-section" class="py-16 sm:py-20 border-t border-surface-800/60">
      <div class="mx-auto max-w-3xl px-6 lg:px-8">
        <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">Do not switch</p>
        <h2 class="text-2xl sm:text-3xl text-white mb-5">When to stay on Django</h2>
        <p class="text-base sm:text-lg leading-8 text-surface-300">
          When your team writes Python, when you need its ecosystem — data science libraries, Celery, the ORM's maturity — or when the application is a server-rendered Django app and adding a separate backend would be a second thing to run. Django is a complete framework; Rebase is a backend plus an admin panel, and it does not try to be the former.
        </p>
      </div>
    </section>

    <!-- Back to the comparison hub -->
    <section id="compare-hub-footer" class="py-16 sm:py-20 border-t border-surface-800/60">
      <div class="mx-auto max-w-4xl px-6 lg:px-8 text-center">
        <p class="mb-4 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">Keep comparing</p>
        <h2 class="text-2xl sm:text-3xl text-white mb-4">
          Not the comparison you needed?
        </h2>
        <p class="text-base text-surface-400 mb-8 max-w-2xl mx-auto">
          The hub explains the four kinds of tool Rebase gets confused with, the five questions that actually
          differ, and the cases where you should pick something else.
        </p>
        <a href={translatePath("/compare")}
           class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all btn-glow mb-8">
          All comparisons
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
                    <a href={translatePath("/rebase-vs-supabase")} class="text-sm text-surface-400 hover:text-primary transition-colors">vs Supabase</a>
                    <a href={translatePath("/rebase-vs-firebase")} class="text-sm text-surface-400 hover:text-primary transition-colors">vs Firebase</a>
                    <a href={translatePath("/rebase-vs-hasura")} class="text-sm text-surface-400 hover:text-primary transition-colors">vs Hasura</a>
                    <a href={translatePath("/rebase-vs-directus")} class="text-sm text-surface-400 hover:text-primary transition-colors">vs Directus</a>
                    <a href={translatePath("/rebase-vs-strapi")} class="text-sm text-surface-400 hover:text-primary transition-colors">vs Strapi</a>
                    <a href={translatePath("/rebase-vs-payload")} class="text-sm text-surface-400 hover:text-primary transition-colors">vs Payload</a>
                    <a href={translatePath("/rebase-vs-retool")} class="text-sm text-surface-400 hover:text-primary transition-colors">vs Retool</a>
        </div>
      </div>
    </section>

  
    <ComparisonFaq competitor="Django" faqs={COMPARISON_FAQS.django} pageUrl="https://rebase.pro/rebase-vs-django" />


  
    <ClosingCta title="Don't take our word for it." blurb="The comparison that matters is the one you run. Point Rebase at a Postgres database you already have and see how it holds up next to Django." trackId="vs-django" />

</div>
