  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M21.801 10A10 10 0 1 1 17 3.335" />
  <path d="m9 11 3 3L22 4" />
</svg>

                      <h3 class="text-white">{t("vs.solve")}</h3>
                    </div>
                    <p class="text-surface-300 leading-relaxed text-sm mb-4">{t("vsfirebase.06")}</p>
