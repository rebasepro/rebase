---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';



import ClientLogos from '../../components/ClientLogos.astro';
import { NeatBackground } from '../../components/NeatBackground';
import BrowserFrame from '../../components/BrowserFrame.astro';
import UsageExamples from '../../components/UsageExamples.astro';
import { BodyPartsDemo } from '../../components/demos/BodyPartsDemo';



import ClosingCta from "../ClosingCta.astro";
---


    <div class="flex-grow flex flex-col isolate">
        <!-- Hero Section -->
 <section
 class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24 lg:pb-24">
            <NeatBackground client:idle transition:persist="neat-hero" />
            <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
                <h1 class="mb-6 text-display-2 text-white">
                    {t('agencies.hero.title')}
                </h1>
                <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl" set:html={t('agencies.hero.subtitle')}>
                </p>
            </div>
        </section>
 <section class="relative isolate py-16">
            <div class="mx-auto max-w-6xl px-8 lg:px-12">
                <div class="mx-auto mt-4 mb-8 animate-on-scroll fade-in">
                    <ClientLogos filter="agencies"/>
                </div>
            </div>
        </section>

        <!-- Neat gradient divider -->
        <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
            <NeatBackground variant="a" client:visible/>
        </div>



        <!-- Agency Advantage Section -->
 <section class="relative isolate py-16 sm:py-24">
            <div class="mx-auto max-w-6xl px-6 lg:px-8">
                <div class="mx-auto max-w-4xl text-center animate-on-scroll fade-in-up">
                    <div class="flex items-center justify-center mb-4">
                        <h3 class="m-0 text-3xl text-white">
                            {t('agencies.weapon.title')}
                        </h3>
                    </div>
                    <p class="text-xl md:text-2xl mb-4 text-surface-300">
                        {t('agencies.weapon.desc1')}
                    </p>
                    <p class="text-lg text-surface-400">
                        {t('agencies.weapon.desc2')}
                    </p>
                </div>
            </div>
        </section>


        <UsageExamples/>


 <section class="relative isolate py-16 sm:py-24">
            <div class="max-w-6xl mx-auto px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center animate-on-scroll fade-in-up delay-100">
                    <div class="lg:col-span-6">
                        <div class="text-center mb-12 animate-on-scroll fade-in-up">
                            <h2 class="text-3xl sm:text-4xl text-white">{t('agencies.accelerate.title')}</h2>
                        </div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="h-10 w-10 rounded-lg bg-green-500/15 flex items-center justify-center">
                                
<svg
  class="lucide lucide-zap"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />
</svg>

                            </div>
                            <div>
                                <h3 class="text-xl font-semibold text-white mb-1">{t('agencies.accelerate.f1.title')}</h3>
                                <p class="text-surface-400">{t('agencies.accelerate.f1.desc')}</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="h-10 w-10 rounded-lg bg-indigo-500/15 flex items-center justify-center">
                                
<svg
  class="lucide lucide-sliders-vertical"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M10 8h4" />
  <path d="M12 21v-9" />
  <path d="M12 8V3" />
  <path d="M17 16h4" />
  <path d="M19 12V3" />
  <path d="M19 21v-5" />
  <path d="M3 14h4" />
  <path d="M5 10V3" />
  <path d="M5 21v-7" />
</svg>

                            </div>
                            <div>
                                <h3 class="text-xl font-semibold text-white mb-1">{t('agencies.accelerate.f2.title')}</h3>
                                <p class="text-surface-400">{t('agencies.accelerate.f2.desc')}</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="h-10 w-10 rounded-lg bg-purple-500/15 flex items-center justify-center">
                                
<svg
  class="lucide lucide-users"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
  <path d="M16 3.128a4 4 0 0 1 0 7.744" />
  <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
  <circle cx="9" cy="7" r="4" />
</svg>

                            </div>
                            <div>
                                <h3 class="text-xl font-semibold text-white mb-1">{t('agencies.accelerate.f3.title')}</h3>
                                <p class="text-surface-400">{t('agencies.accelerate.f3.desc')}</p>
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-6">
                        <div
                                style={{
                                    aspectRatio: 550 / 692,
                                    maxHeight: "692px",
                                    maxWidth: "550px"
                                }}
                                class={" flex content-center justify-center"}>
                            <img
                                    class={"pointer-events-none rounded-2xl border border-surface-800 shadow-lg"}
                                    width="100%"
                                    alt="Rebase entity history and audit log showing data changes over time"
                                    src={"/img/history.png"}/>
                        </div>

                    </div>
                </div>
            </div>
        </section>


        <!-- Easy to Customize Section -->
 <section class="relative isolate py-16 sm:py-24">
            <div class="mx-auto max-w-6xl px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center animate-on-scroll fade-in-up">
                    <div class="rounded-xl ring-1 ring-inset ring-surface-800 overflow-hidden bg-surface-950">
                        <BodyPartsDemo client:only="react" />
                    </div>
                    <div>
                        <div class="flex items-center mb-4">
                            <div class="h-10 w-10 mr-3 rounded-lg bg-primary/20 flex items-center justify-center">
                                
<svg
  class="lucide lucide-settings"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" />
  <circle cx="12" cy="12" r="3" />
</svg>

                            </div>
                            <h3 class="m-0 text-3xl text-white">
                                {t('agencies.customize.title')}
                            </h3>
                        </div>
                        <p class="text-xl md:text-2xl mb-4 text-surface-300">
                            {t('agencies.customize.desc1')}
                        </p>
                        <p class="text-lg text-surface-400">
                            {t('agencies.customize.desc2')}
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features for Agency Success Section -->
 <section class="relative isolate py-16 sm:py-24">
            <div class="max-w-6xl mx-auto px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl sm:text-4xl text-white">{t('agencies.features.title')}</h2>
                    <p class="text-xl text-surface-400">{t('agencies.features.subtitle')}</p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Feature Items -->
                    <div class="p-8 rounded-lg ring-1 ring-inset ring-surface-800 bg-surface-900/50">
                        <div class="flex items-start space-x-3">
                            <div class="h-8 w-8 rounded-lg bg-surface-800 flex items-center justify-center flex-shrink-0">
                                
<svg
  class="lucide lucide-puzzle"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z" />
</svg>

                            </div>
                            <div>
                                <h3 class="text-lg font-semibold mb-1 text-white">{t('agencies.features.f1.title')}</h3>
                                <p class="text-sm text-surface-400">{t('agencies.features.f1.desc')}</p>
                            </div>
                        </div>
                    </div>
                    <div class="p-8 rounded-lg ring-1 ring-inset ring-surface-800 bg-surface-900/50">
                        <div class="flex items-start space-x-3">
                            <div class="h-8 w-8 rounded-lg bg-surface-800 flex items-center justify-center flex-shrink-0">
                                
<svg
  class="lucide lucide-palette"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z" />
  <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
  <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
  <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
  <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
</svg>

                            </div>
                            <div>
                                <h3 class="text-lg font-semibold mb-1 text-white">{t('agencies.features.f2.title')}</h3>
                                <p class="text-sm text-surface-400">{t('agencies.features.f2.desc')}</p>
                            </div>
                        </div>
                    </div>
                    <div class="p-8 rounded-lg ring-1 ring-inset ring-surface-800 bg-surface-900/50">
                        <div class="flex items-start space-x-3">
                            <div class="h-8 w-8 rounded-lg bg-surface-800 flex items-center justify-center flex-shrink-0">
                                
<svg
  class="lucide lucide-shield-check"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
  <path d="m9 12 2 2 4-4" />
</svg>

                            </div>
                            <div>
                                <h3 class="text-lg font-semibold mb-1 text-white">{t('agencies.features.f3.title')}</h3>
                                <p class="text-sm text-surface-400">{t('agencies.features.f3.desc')}</p>
                            </div>
                        </div>
                    </div>
                    <div class="p-8 rounded-lg ring-1 ring-inset ring-surface-800 bg-surface-900/50">
                        <div class="flex items-start space-x-3">
                            <div class="h-8 w-8 rounded-lg bg-surface-800 flex items-center justify-center flex-shrink-0">
                                
<svg
  class="lucide lucide-rocket"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
  <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09" />
  <path d="M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z" />
  <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05" />
</svg>

                            </div>
                            <div>
                                <h3 class="text-lg font-semibold mb-1 text-white">{t('agencies.features.f4.title')}</h3>
                                <p class="text-sm text-surface-400">{t('agencies.features.f4.desc')}</p>
                            </div>
                        </div>
                    </div>
                    <div class="p-8 rounded-lg ring-1 ring-inset ring-surface-800 bg-surface-900/50">
                        <div class="flex items-start space-x-3">
                            <div class="h-8 w-8 rounded-lg bg-surface-800 flex items-center justify-center flex-shrink-0">
                                
<svg
  class="lucide lucide-database"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <ellipse cx="12" cy="5" rx="9" ry="3" />
  <path d="M3 5V19A9 3 0 0 0 21 19V5" />
  <path d="M3 12A9 3 0 0 0 21 12" />
</svg>

                            </div>
                            <div>
                                <h3 class="text-lg font-semibold mb-1 text-white">{t('agencies.features.f5.title')}</h3>
                                <p class="text-sm text-surface-400">{t('agencies.features.f5.desc')}</p>
                            </div>
                        </div>
                    </div>
                    <div class="p-8 rounded-lg ring-1 ring-inset ring-surface-800 bg-surface-900/50">
                        <div class="flex items-start space-x-3">
                            <div class="h-8 w-8 rounded-lg bg-surface-800 flex items-center justify-center flex-shrink-0">
                                
<svg
  class="lucide lucide-code"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m16 18 6-6-6-6" />
  <path d="m8 6-6 6 6 6" />
</svg>

                            </div>
                            <div>
                                <h3 class="text-lg font-semibold mb-1 text-white">{t('agencies.features.f6.title')}</h3>
                                <p class="text-sm text-surface-400">{t('agencies.features.f6.desc')}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Neat gradient divider -->
        <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
            <NeatBackground variant="b" client:visible/>
        </div>


 <section class="relative isolate py-10 sm:py-12">
            <div class="mx-auto max-w-6xl px-6 lg:px-8">
                <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 text-center animate-on-scroll scale-in">
                    <div>
                        <div class="text-4xl text-white" set:html={t('agencies.metrics.m1.value')}></div>
                        <div class="mt-1 text-surface-400">{t('agencies.metrics.m1.label')}</div>
                    </div>
                    <div>
                        <div class="text-4xl text-white" set:html={t('agencies.metrics.m2.value')}></div>
                        <div class="mt-1 text-surface-400">{t('agencies.metrics.m2.label')}</div>
                    </div>
                    <div>
                        <div class="text-4xl text-white" set:html={t('agencies.metrics.m3.value')}></div>
                        <div class="mt-1 text-surface-400">{t('agencies.metrics.m3.label')}</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Agency Client Showcase Section -->
 <section class="relative isolate py-16 sm:py-24">
            <div class="max-w-6xl mx-auto px-6 lg:px-8">
                <h2 class="text-3xl md:text-4xl mb-12 text-center text-white animate-on-scroll fade-in-up">
                    {t('agencies.leverage.title')}</h2>
                <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
                    <div class="group relative overflow-hidden p-8 rounded-lg ring-1 ring-inset ring-surface-800 bg-surface-900/50 flex flex-col transition-all duration-300 hover:ring-primary/30 animate-on-scroll scale-in"
                         data-spotlight-card>
                        <!-- Mouse spotlight effect -->
                        <div class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                             data-spotlight></div>

                        <div class="relative z-10">
                            <div class="flex items-center mb-4">
                                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/20 mr-4 flex-shrink-0">
                                    
<svg
  class="lucide lucide-shopping-cart"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <circle cx="8" cy="21" r="1" />
  <circle cx="19" cy="21" r="1" />
  <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />
</svg>

                                </div>
                                <h3 class="text-xl font-semibold text-white">{t('agencies.leverage.c1.title')}</h3>
                            </div>
                            <div class="flex-grow mb-4">
                                <p class="text-sm text-surface-400 mb-2" set:html={t('agencies.leverage.c1.challenge')}></p>
                                <p class="text-sm text-white" set:html={t('agencies.leverage.c1.solution')}></p>
                            </div>
                            <div class="mt-auto pt-4 border-t border-surface-800 flex items-start">
                                
<svg
  class="lucide lucide-circle-check-big"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M21.801 10A10 10 0 1 1 17 3.335" />
  <path d="m9 11 3 3L22 4" />
</svg>

                                <span class="text-sm font-medium text-white" set:html={t('agencies.leverage.c1.result')}>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="group relative overflow-hidden p-8 rounded-lg ring-1 ring-inset ring-surface-800 bg-surface-900/50 flex flex-col transition-all duration-300 hover:ring-primary/30 animate-on-scroll scale-in delay-100"
                         data-spotlight-card>
                        <!-- Mouse spotlight effect -->
                        <div class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                             data-spotlight></div>

                        <div class="relative z-10">
                            <div class="flex items-center mb-4">
                                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/20 mr-4 flex-shrink-0">
                                    
<svg
  class="lucide lucide-settings"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" />
  <circle cx="12" cy="12" r="3" />
</svg>

                                </div>
                                <h3 class="text-xl font-semibold text-white">{t('agencies.leverage.c2.title')}</h3>
                            </div>
                            <div class="flex-grow mb-4">
                                <p class="text-sm text-surface-400 mb-2" set:html={t('agencies.leverage.c2.challenge')}></p>
                                <p class="text-sm text-white" set:html={t('agencies.leverage.c2.solution')}></p>
                            </div>
                            <div class="mt-auto pt-4 border-t border-surface-800 flex items-start">
                                
<svg
  class="lucide lucide-circle-check-big"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
