---
/**
 * /cloud — what Rebase Cloud is, what a project gets, how sizes and billing
 * work, and how to start. The pricing page owns the numbers; this page quotes
 * one (the default project) and links there for the rest.
 *
 * Every claim here is one the control plane makes true today, and each block
 * names its source so the next edit can check it:
 *
 * - Region and provider: `REGION_FACTS[CLOUD_FLAGS.region]` (cloud-flags.ts),
 *   so this page and /pricing move together when the flag flips.
 * - Default sizes, the default project's price and the included allowances:
 *   `cloud-prices.json`, generated from the rate card that bills.
 * - App resize without downtime: saas `TENANT_ROLLOUT_STRATEGY`
 *   (`maxUnavailable: 0, maxSurge: 1`, backend/src/k8s/orchestrator.ts).
 * - Database resize, one copy, "about a minute, a few minutes at worst", and
 *   confirmed first: measured 31 s and 33 s on hz-canary on 2026-11-23 after
 *   the two restart fixes (shutdown waits 10 s, saas restart-behaviour.ts
 *   `smartShutdownTimeout`; the primary keeps its network identity). The
 *   console's `DATABASE_RESTART_SENTENCE` (backend/src/utils/database-applied.ts)
 *   says the same from the deploy that ships those fixes; it said "usually 3
 *   to 8 minutes", measured before them.
 * - Two copies: `--db-instances 2` adds an automatic standby; a resize is a
 *   switchover (`primaryUpdateMethod: switchover`, restart-behaviour.ts); the
 *   copies are spread across servers by a soft rule (`databaseAntiAffinity`),
 *   hence "whenever the cluster has one".
 * - CPU bursts: `fixedNodeBurst` (provider-profile.ts) — 10x the request, at
 *   most half a server — on Falkenstein; the Belgium default bursts to 2 vCPU
 *   (docs deployment/cloud.md "Compute, and what it costs"). `offerKey` picks
 *   the regional sentence.
 * - Billing: prorated, a database change billed at the running size until it
 *   runs (docs deployment/cloud.md; CLI `compute set` help).
 * - 30-day point-in-time restore: `HERO_CLAIM_SOURCES` in cloud-offer.ts.
 *
 * Not live, so not on this page: database autoscale, size recommendations,
 * the new size picker, sleeping projects (`CLOUD_FLAGS.sleep`).
 *
 * Customer words only (SITE-STORY, tenancy vocabulary): servers, copies,
 * sizes — never pods, nodes, namespaces or the operator's name.
 */
const { lang, t } = Astro.props;

import { useTranslatedPath } from "../../i18n/ui";
import {
    CLOUD_FLAGS, CLOUD_PRICES, CLOUD_SIGNUP_URL, REGION_FACTS,
    cpuLabel, eur, fill, memoryLabel, offerKey, regionPrices,
} from "../../data/cloud-offer";
import HeroBackdrop from "../HeroBackdrop.astro";
import ChapterRule from "../ChapterRule.astro";
import ClosingCta from "../ClosingCta.astro";
import {
    ArrowRight, Server, HardDrive, Database, Check, Globe, Activity, Users, Bell,
} from "lucide-react";

const translatePath = useTranslatedPath(lang);
const CLOUD_DEPLOY_COMMAND = "rebase cloud deploy";

const facts = REGION_FACTS[CLOUD_FLAGS.region];
const prices = regionPrices();
const defaults = prices.examples.default;
const size = (s: { cpu: string; memory: string }) => `${memoryLabel(s.memory)} · ${cpuLabel(s.cpu)}`;

// Self-serve open (CLOUD_FLAGS.selfServe): the CTA signs up; before that it
// points at the footer's waitlist, like every other Cloud surface.
const cloudCtaHref = CLOUD_FLAGS.selfServe ? CLOUD_SIGNUP_URL : "#footer-waitlist";
const cloudCtaLabel = CLOUD_FLAGS.selfServe ? t("pricing.cloud.cta.open") : t("cta.lane.cloud.link");

const PARTS = [
    { Icon: Server, title: "cloud.page.get.app.title", desc: "cloud.page.get.app.desc", handle: "deploy · deploy --preview · rollback", dot: "text-primary-light" },
    { Icon: Database, title: "cloud.page.get.db.title", desc: "cloud.page.get.db.desc", handle: "db pitr · db connect", dot: "text-cyan-300" },
    { Icon: HardDrive, title: "cloud.page.get.files.title", desc: "cloud.page.get.files.desc", handle: "storage create · storage attach", dot: "text-emerald-400" },
] as const;

const EXTRAS = [
    { Icon: Globe, key: "cloud.page.get.extra1" },
    { Icon: Activity, key: "cloud.page.get.extra2" },
    { Icon: Users, key: "cloud.page.get.extra3" },
    { Icon: Bell, key: "cloud.page.get.extra4" },
] as const;

// The availability track under each row: the share of the strip that is
// offline. Illustrative widths, not a timescale.
const RESIZE_ROWS = [
    { label: "cloud.page.size.app.label", value: "cloud.page.size.app.value", note: "cloud.page.size.app.note", gap: 0, tone: "text-emerald-400" },
    { label: "cloud.page.size.db1.label", value: "cloud.page.size.db1.value", note: "cloud.page.size.db1.note", gap: 12, tone: "text-amber-300" },
    { label: "cloud.page.size.db2.label", value: "cloud.page.size.db2.value", note: "cloud.page.size.db2.note", gap: 1.5, tone: "text-emerald-400" },
] as const;

// ── The burst chart ─────────────────────────────────────────────────────────
// A made-up day of CPU, in multiples of the reservation, sampled every half
// hour: quiet most of the time, two spikes. Drawn on a 0–10x scale so the
// reservation is the thin band at the bottom and the ceiling the top line.
const USAGE = [
    0.4, 0.35, 0.3, 0.3, 0.32, 0.3, 0.35, 0.45, 0.6, 0.7, 0.75, 0.8, 0.7, 1.2,
    3.6, 6.4, 2.2, 0.9, 0.7, 0.65, 0.7, 0.8, 0.75, 0.7, 0.85, 0.9, 0.8, 0.75,
    0.9, 1.7, 9.2, 4.1, 1.3, 0.8, 0.7, 0.75, 0.9, 2.4, 1.1, 0.8, 0.6, 0.55,
    0.5, 0.45, 0.4, 0.4, 0.35, 0.35,
];
const CHART = { w: 640, h: 220, left: 8, right: 632, top: 18, bottom: 204, max: 10 };
const xAt = (i: number) => CHART.left + (i / (USAGE.length - 1)) * (CHART.right - CHART.left);
const yAt = (v: number) => CHART.bottom - (v / CHART.max) * (CHART.bottom - CHART.top);
const usageLine = USAGE.map((v, i) => `${i === 0 ? "M" : "L"}${xAt(i).toFixed(1)},${yAt(v).toFixed(1)}`).join(" ");
const usageArea = `${usageLine} L${CHART.right},${CHART.bottom} L${CHART.left},${CHART.bottom} Z`;
const reservedY = yAt(1);

const BILL_POINTS = [
    { title: "cloud.page.bill.p1.title", desc: t("cloud.page.bill.p1.desc") },
    { title: "cloud.page.bill.p2.title", desc: t("cloud.page.bill.p2.desc") },
    {
        title: "cloud.page.bill.p3.title",
        desc: fill(t("cloud.page.bill.p3.desc"), {
            requests: `${(CLOUD_PRICES.included.requestsPerMonth / 1_000_000).toLocaleString("en")} million`,
            files: String(CLOUD_PRICES.included.filesGb),
        }),
    },
] as const;

const START_COMMANDS = [
    "rebase cloud login",
    "rebase cloud billing setup",
    "rebase cloud projects create --link",
];
---

<div class="drafted-page flex flex-col isolate">
    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24">
        <HeroBackdrop />
        <div class="relative z-10 mx-auto max-w-6xl px-6 lg:px-8">
            <div class="hero-badge mb-6">
                <span class="dot text-emerald-400" aria-hidden="true"></span>
                <span>{t("cloud.home.badge")}</span>
                <span class="mx-1 text-tone-500">·</span>
                <span class="text-tone-300">{t("cta.lane.cloud.badge")}</span>
            </div>

            <h1 class="mb-6 max-w-[44rem] text-display-2 text-tone-max text-balance">
                {t("cloud.page.hero.title")}
            </h1>

            <p class="mb-4 max-w-[42rem] text-lg leading-8 text-tone-300">
                {fill(t("cloud.page.hero.lead"), { place: facts.place, provider: facts.provider })}
            </p>
            <p class="mb-10 max-w-[42rem] text-base leading-7 text-page-copy">
                {t("cloud.page.hero.sub")}
            </p>

            <div class="flex flex-wrap items-center gap-3">
                <a
                    href={cloudCtaHref}
                    data-track="cloud-hero-cta"
                    class="inline-flex items-center justify-center gap-2.5 rounded-lg bg-primary px-7 min-h-(--control-large) text-base font-semibold text-white shadow-[0_8px_28px_-6px_rgb(0_112_244/0.65)] transition-colors hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                    {cloudCtaLabel}
                    <ArrowRight size={17} aria-hidden="true" />
                </a>

                <button
                    type="button"
                    data-track-copy="cloud-hero-deploy"
                    data-command={CLOUD_DEPLOY_COMMAND}
                    data-copy-done-label={t("copy.command.done")}
                    class="copy-btn group inline-flex items-center gap-3 rounded-lg border border-tone-max/12 bg-tone-max/[0.03] px-4 min-h-(--control-large) font-mono text-sm text-tone-200 transition-colors hover:border-tone-max/25 hover:bg-tone-max/[0.06] data-copied:border-emerald-400/60 data-copied:bg-emerald-400/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                    aria-label={`Copy "${CLOUD_DEPLOY_COMMAND}" to the clipboard`}
                    title="Copy to clipboard"
                >
                    <span class="select-none text-tone-500">$</span>
                    <span class="text-tone-max">{CLOUD_DEPLOY_COMMAND}</span>
                    <span class="grid rounded-md border border-tone-max/10 bg-tone-max/[0.06] px-1.5 py-0.5 text-center font-mono text-2xs uppercase tracking-[0.14em] text-tone-400">
                        <span data-copy-label class="col-start-1 row-start-1">{t("copy.command")}</span>
                        <span aria-hidden="true" class="invisible col-start-1 row-start-1">{t("copy.command.done")}</span>
                    </span>
                </button>

                <a
                    href={translatePath("/pricing")}
                    class="inline-flex items-center justify-center rounded-lg border border-tone-max/12 px-5 min-h-(--control-large) text-sm font-semibold text-tone-200 transition-colors hover:border-tone-max/25 hover:text-tone-max"
                >
                    {t("cloud.home.link.pricing")}
                </a>
            </div>

            <p class="mt-6 text-xs text-tone-400">{t(offerKey("cloud.status"))}</p>
        </div>
    </section>

    <!-- ═══════════════════════ 01 / 05 — WHAT YOU GET ═══════════════════════ -->
    <section class="relative z-0 ground-raised border-y border-tone-max/8 py-chapter">
        <div class="mx-auto max-w-6xl px-6 lg:px-8 mb-lead">
            <ChapterRule label={t("cloud.page.get.badge")} index="01 / 05" dot="text-primary-light" />
        </div>
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mb-10 max-w-[42rem]">
                <h2 class="mb-4 text-3xl sm:text-4xl text-tone-max text-balance">{t("cloud.page.get.title")}</h2>
                <p class="text-base leading-relaxed text-page-copy">{t("cloud.page.get.desc")}</p>
            </div>

            <ul class="cloud-subgrid grid grid-cols-1 md:grid-cols-3 border-t border-l border-tone-max/8">
                {PARTS.map(({ Icon, title, desc, handle, dot }) => (
                    <li class="cloud-subgrid-cell border-r border-b border-tone-max/8 p-6">
                        <h3 class="flex items-center gap-2.5 font-headers text-base text-tone-100">
                            <Icon size={16} class={`shrink-0 ${dot}`} aria-hidden="true" />
                            <span>{t(title)}</span>
                        </h3>
                        <p class="cloud-prose mt-2.5 text-sm leading-relaxed text-page-copy" set:html={t(desc)} />
                        <p class="mt-4 font-mono text-2xs text-tone-400">rebase cloud {handle}</p>
                    </li>
                ))}
            </ul>

            <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-8">
                <p class="eyebrow">{t("cloud.page.get.extras")}</p>
                <ul class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-x-7">
                    {EXTRAS.map(({ Icon, key }) => (
                        <li class="flex items-center gap-2 text-sm text-tone-200">
                            <Icon size={15} class="shrink-0 text-tone-400" aria-hidden="true" />
                            {t(key)}
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 02 / 05 — SIZES ═══════════════════════ -->
    <section class="relative z-0 py-chapter">
        <div class="mx-auto max-w-6xl px-6 lg:px-8 mb-lead">
            <ChapterRule label={t("cloud.page.size.badge")} index="02 / 05" dot="text-cyan-300" />
        </div>
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
                <div class="lg:col-span-5 min-w-0">
                    <h2 class="mb-5 text-3xl sm:text-4xl text-tone-max text-balance">{t("cloud.page.size.title")}</h2>
                    <p
                        class="cloud-prose mb-6 text-base leading-relaxed text-page-copy"
                        set:html={fill(t("cloud.page.size.desc"), { app: size(defaults.app), db: size(defaults.database) })}
                    />
                    <p class="cmd-chip"><span class="select-none text-tone-500">$ </span>rebase cloud compute set --memory 1Gi --db-memory 2Gi</p>
                </div>

                <figure class="lg:col-span-7 min-w-0 frame overflow-hidden">
                    <figcaption class="frame-head">
                        <span>{t("cloud.page.size.figTitle")}</span>
                    </figcaption>
                    <ol class="divide-y divide-tone-max/8">
                        {RESIZE_ROWS.map(({ label, value, note, gap, tone }) => (
                            <li class="px-5 py-5">
                                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                                    <span class="text-sm font-semibold text-tone-100">{t(label)}</span>
                                    <span class={`font-mono text-xs ${tone}`}>{t(value)}</span>
                                </div>
                                <div class="resize-track mt-3" aria-hidden="true">
                                    {gap > 0 ? (
                                        <>
                                            <span class="resize-on" style={`flex-grow:${(100 - gap) / 2}`}></span>
                                            <span class="resize-off" style={`flex-grow:${gap}`}></span>
                                            <span class="resize-on" style={`flex-grow:${(100 - gap) / 2}`}></span>
                                        </>
                                    ) : (
                                        <span class="resize-on" style="flex-grow:100"></span>
                                    )}
                                </div>
                                <p class="mt-3 text-sm leading-relaxed text-page-copy">{t(note)}</p>
                            </li>
                        ))}
                    </ol>
                </figure>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 03 / 05 — CPU BURSTS ═══════════════════════ -->
    <section class="relative z-0 ground-raised border-y border-tone-max/8 py-chapter">
        <div class="mx-auto max-w-6xl px-6 lg:px-8 mb-lead">
            <ChapterRule label={t("cloud.page.burst.badge")} index="03 / 05" dot="text-emerald-400" />
        </div>
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mb-10 max-w-[42rem]">
                <h2 class="mb-4 text-3xl sm:text-4xl text-tone-max text-balance">{t("cloud.page.burst.title")}</h2>
                <p class="text-base leading-relaxed text-page-copy">{t(offerKey("cloud.page.burst.desc"))}</p>
            </div>

            <figure class="frame overflow-hidden">
                <figcaption class="frame-head">
                    <span>{t("cloud.page.burst.fig.title")}</span>
                </figcaption>
                <div class="px-4 pt-5 pb-4 sm:px-6">
                    <svg
                        viewBox={`0 0 ${CHART.w} ${CHART.h}`}
                        class="block h-auto w-full"
                        role="img"
                        aria-label={t("cloud.page.burst.fig.title")}
                    >
                        <defs>
                            <clipPath id="burst-above">
                                <rect x="0" y="0" width={CHART.w} height={reservedY} />
                            </clipPath>
                            <clipPath id="burst-below">
                                <rect x="0" y={reservedY} width={CHART.w} height={CHART.h - reservedY} />
                            </clipPath>
                        </defs>

                        <line x1={CHART.left} x2={CHART.right} y1={CHART.top} y2={CHART.top}
                              class="text-tone-500" stroke="currentColor" stroke-width="1" stroke-dasharray="2 5" />

                        <rect x={CHART.left} y={reservedY} width={CHART.right - CHART.left} height={CHART.bottom - reservedY}
                              class="text-primary-light" fill="currentColor" fill-opacity="0.16" />

                        <path d={usageArea} clip-path="url(#burst-above)" class="text-emerald-400" fill="currentColor" fill-opacity="0.22" />
                        <path d={usageArea} clip-path="url(#burst-below)" class="text-primary-light" fill="currentColor" fill-opacity="0.32" />

                        <line x1={CHART.left} x2={CHART.right} y1={reservedY} y2={reservedY}
                              class="text-primary-light" stroke="currentColor" stroke-width="1.5" />

                        <path d={usageLine} class="text-tone-max" fill="none" stroke="currentColor" stroke-width="1.75"
                              stroke-linejoin="round" stroke-linecap="round" />

                        <line x1={CHART.left} x2={CHART.right} y1={CHART.bottom} y2={CHART.bottom}
                              class="text-tone-600" stroke="currentColor" stroke-width="1" />
                    </svg>

                    <ul class="mt-4 flex flex-col gap-2 text-xs text-tone-300 sm:flex-row sm:flex-wrap sm:gap-x-6">
                        <li class="flex items-center gap-2">
                            <span class="h-2.5 w-4 rounded-sm bg-primary-light/40" aria-hidden="true"></span>
                            {t("cloud.page.burst.fig.reserved")}
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="h-2.5 w-4 rounded-sm bg-emerald-400/35" aria-hidden="true"></span>
                            {t("cloud.page.burst.fig.free")}
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="h-0.5 w-4 bg-tone-max" aria-hidden="true"></span>
                            {t("cloud.page.burst.fig.used")}
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="w-4 border-t border-dashed border-tone-500" aria-hidden="true"></span>
                            {t("cloud.page.burst.fig.ceiling")}
                        </li>
                    </ul>
                </div>
            </figure>
        </div>
    </section>

    <!-- ═══════════════════════ 04 / 05 — TWO DATABASE COPIES ═══════════════════════ -->
    <section class="relative z-0 py-chapter">
        <div class="mx-auto max-w-6xl px-6 lg:px-8 mb-lead">
            <ChapterRule label={t("cloud.page.ha.badge")} index="04 / 05" dot="text-cyan-300" />
        </div>
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
                <div class="lg:col-span-5 min-w-0">
                    <h2 class="mb-5 text-3xl sm:text-4xl text-tone-max text-balance">{t("cloud.page.ha.title")}</h2>
                    <p class="mb-4 text-base leading-relaxed text-page-copy">{t("cloud.page.ha.desc")}</p>
                    <p class="mb-6 text-base leading-relaxed text-page-copy">{t("cloud.page.ha.cost")}</p>
                    <p class="cmd-chip"><span class="select-none text-tone-500">$ </span>rebase cloud compute set --db-instances 2</p>
                </div>

                <div class="lg:col-span-7 min-w-0 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <figure class="frame flex flex-col overflow-hidden">
                        <figcaption class="frame-head"><span>{t("cloud.page.ha.one")}</span></figcaption>
                        <div class="flex flex-1 flex-col p-5">
                            <div class="db-copy">
                                <Database size={15} class="text-cyan-300" aria-hidden="true" />
                                <span class="text-sm text-tone-100">{t("cloud.page.ha.primary")}</span>
                                <span class="ml-auto font-mono text-2xs text-tone-400">{fill(t("cloud.page.ha.server"), { n: "1" })}</span>
                            </div>
                            <p class="db-link db-link-none" aria-hidden="true">&nbsp;</p>
                            <div class="db-copy db-copy-empty">
                                <span class="font-mono text-2xs text-tone-500">{t("cloud.page.ha.none")}</span>
                            </div>
                            <p class="mt-auto pt-2 text-sm leading-relaxed text-amber-300">{t("cloud.page.ha.one.fail")}</p>
                        </div>
                    </figure>

                    <figure class="frame flex flex-col overflow-hidden">
                        <figcaption class="frame-head"><span>{t("cloud.page.ha.two")}</span></figcaption>
                        <div class="flex flex-1 flex-col p-5">
                            <div class="db-copy">
                                <Database size={15} class="text-cyan-300" aria-hidden="true" />
                                <span class="text-sm text-tone-100">{t("cloud.page.ha.primary")}</span>
                                <span class="ml-auto font-mono text-2xs text-tone-400">{fill(t("cloud.page.ha.server"), { n: "1" })}</span>
                            </div>
                            <p class="db-link font-mono text-2xs text-tone-400">{t("cloud.page.ha.sync")}</p>
                            <div class="db-copy">
                                <Database size={15} class="text-tone-400" aria-hidden="true" />
                                <span class="text-sm text-tone-100">{t("cloud.page.ha.standby")}</span>
                                <span class="ml-auto font-mono text-2xs text-tone-400">{fill(t("cloud.page.ha.server"), { n: "2" })}</span>
                            </div>
                            <p class="mt-auto pt-2 text-sm leading-relaxed text-emerald-400">{t("cloud.page.ha.two.fail")}</p>
                        </div>
                    </figure>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ 05 / 05 — BILLING AND HOW TO START ═══════════════════════ -->
    <section class="relative z-0 ground-raised border-t border-tone-max/8 py-chapter">
        <div class="mx-auto max-w-6xl px-6 lg:px-8 mb-lead">
            <ChapterRule label={t("cloud.page.bill.badge")} index="05 / 05" dot="text-amber-300" />
        </div>
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
                <div class="lg:col-span-7 min-w-0">
                    <h2 class="mb-5 text-3xl sm:text-4xl text-tone-max text-balance">{t("cloud.page.bill.title")}</h2>
                    <p class="mb-8 text-base leading-relaxed text-page-copy">{t("cloud.page.bill.desc")}</p>
                    <ul class="flex flex-col gap-5">
                        {BILL_POINTS.map(({ title, desc }) => (
                            <li class="flex gap-3">
                                <Check size={17} class="mt-0.5 shrink-0 text-primary-light" aria-hidden="true" />
                                <div>
                                    <h3 class="font-headers text-base text-tone-100">{t(title)}</h3>
                                    <p class="mt-1 text-sm leading-relaxed text-page-copy">{desc}</p>
                                </div>
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="lg:col-span-5 min-w-0 frame p-6 sm:p-7">
                    <p class="text-sm text-tone-300">{t("cloud.page.bill.default.label")}</p>
                    <p class="mt-2 flex flex-wrap items-baseline gap-x-2">
                        <span class="text-4xl text-tone-max">{eur(defaults.monthlyEur)}</span>
