---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';



import { NeatBackground } from '../../components/NeatBackground';
import { KanbanDemo } from '../../components/demos/KanbanDemo';
import { RichTextEditorDemo } from '../../components/demos/RichTextEditorDemo';
import { SpreadsheetDemo } from '../../components/demos/SpreadsheetDemo';
import { CustomFieldsDemo } from '../../components/demos/CustomFieldsDemo';
import { EditorMiniDemo } from '../../components/demos/EditorMiniDemo';
import { EditorPreviewDemo } from '../../components/demos/EditorPreviewDemo';

import "../../styles/editor.css";



import ClosingCta from "../ClosingCta.astro";
---

  <div class="flex flex-col isolate">

    <!-- Hero -->
 <section class="relative isolate overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
     <NeatBackground client:idle />

      <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
        <div class="inline-flex items-center py-1.5 px-3 mb-6 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10">
          <span class="text-sm font-medium">Rich Text · Blocks · Kanban · Inline</span>
        </div>
        <p class="mb-5 text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
          <a href="/admin" class="hover:text-primary transition-colors">The admin panel</a>
          <span class="mx-2 text-surface-600">/</span><span class="text-surface-500">Content editing</span>
        </p>
        <h1 class="mb-6 text-display-2 text-white">
          The editing experience<br/>your team deserves.
        </h1>
        <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl">
          A Notion-style block editor, drag-and-drop Kanban boards, spreadsheet views, and fully extensible custom fields — all writing directly to your Postgres database.
        </p>
        <div class="flex items-center justify-start gap-x-4">
          <a href="https://demo.rebase.pro" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all duration-200 ease-in-out btn-glow">
            Try It Live
            
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

          </a>
          <a href="/docs" class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold">
            Read the Docs
            
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

          </a>
        </div>
      </div>
    </section>
    <!-- Full-width interactive Notion editor hero -->
 <section class="relative z-0 pb-16 sm:pb-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="rounded-2xl overflow-hidden border border-surface-800/80 bg-surface-950 shadow-[0_0_0_1px_rgba(15,23,42,0.55),0_24px_120px_rgba(0,0,0,0.65)]">
          <!-- Browser Chrome -->
          <div class="px-4 py-3 border-b border-surface-800/80 flex items-center gap-2 bg-surface-900/50 backdrop-blur-md">
            <div class="flex gap-1.5 w-16">
            </div>
            <div class="flex-1 flex justify-center">
              <div class="bg-surface-950/80 border border-surface-800/80 rounded-lg px-3 py-1 text-2xs font-mono text-surface-500 flex items-center gap-1.5">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                admin.yourdomain.com/posts/new
              </div>
            </div>
            <div class="w-16"></div>
          </div>
          <!-- Editor -->
          <div class="relative w-full" style="min-height: 420px;">
            <RichTextEditorDemo client:only="react" />
          </div>
        </div>
        <p class="mt-4 text-center text-xs sm:text-sm text-surface-500">The real Rebase rich text editor — try typing, it's fully interactive.</p>
      </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden" style="z-index: -1; height: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>



    <!-- Editor Features Strip -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <h2 class="text-3xl sm:text-4xl text-white">Every block you need.</h2>
          <p class="mt-4 text-surface-400 text-lg">The editor supports a comprehensive set of content blocks — from simple text to complex embeds. All stored as structured data in your database.</p>
        </div>
        <div class="mx-auto max-w-md mb-10" inert aria-hidden="true">
          <EditorMiniDemo client:visible />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

          <div class="group relative p-6 pb-8 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 hover:ring-violet-500/30 transition-all duration-300 flex flex-col">
            <div class="h-12 w-12 rounded-xl bg-violet-500/10 flex items-center justify-center mb-5 ring-1 ring-violet-500/20">
              
<svg
  class="lucide lucide-type"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M12 4v16" />
  <path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2" />
  <path d="M9 20h6" />
</svg>

            </div>
            <h3 class="text-base font-semibold text-white mb-2">Rich Text & Headings</h3>
            <p class="text-sm text-surface-400">Bold, italic, strikethrough, inline code, and 3 heading levels. Markdown shortcuts auto-convert as you type.</p>
          </div>

          <div class="group relative p-6 pb-8 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 hover:ring-violet-500/30 transition-all duration-300 flex flex-col">
            <div class="h-12 w-12 rounded-xl bg-cyan-500/10 flex items-center justify-center mb-5 ring-1 ring-cyan-500/20">
              
<svg
  class="lucide lucide-code"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m16 18 6-6-6-6" />
  <path d="m8 6-6 6 6 6" />
</svg>

            </div>
            <h3 class="text-base font-semibold text-white mb-2">Code Blocks</h3>
            <p class="text-sm text-surface-400">Fenced code blocks with syntax highlighting for 100+ languages. Perfect for technical documentation and developer content.</p>
          </div>

          <div class="group relative p-6 pb-8 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 hover:ring-violet-500/30 transition-all duration-300 flex flex-col">
            <div class="h-12 w-12 rounded-xl bg-amber-500/10 flex items-center justify-center mb-5 ring-1 ring-amber-500/20">
              
<svg
  class="lucide lucide-image"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
  <circle cx="9" cy="9" r="2" />
  <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
</svg>

            </div>
            <h3 class="text-base font-semibold text-white mb-2">Image Uploads</h3>
            <p class="text-sm text-surface-400">Drag-and-drop or paste images directly into the editor. Files are stored via your configured storage provider.</p>
          </div>

          <div class="group relative p-6 pb-8 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 hover:ring-violet-500/30 transition-all duration-300 flex flex-col">
            <div class="h-12 w-12 rounded-xl bg-emerald-500/10 flex items-center justify-center mb-5 ring-1 ring-emerald-500/20">
              
<svg
  class="lucide lucide-square-check-big"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M21 10.656V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12.344" />
  <path d="m9 11 3 3L22 4" />
</svg>

            </div>
            <h3 class="text-base font-semibold text-white mb-2">Task Lists</h3>
            <p class="text-sm text-surface-400">Interactive checkboxes for TODO lists and checklists. Track progress right inside your content.</p>
          </div>

          <div class="group relative p-6 pb-8 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 hover:ring-violet-500/30 transition-all duration-300 flex flex-col">
            <div class="h-12 w-12 rounded-xl bg-rose-500/10 flex items-center justify-center mb-5 ring-1 ring-rose-500/20">
              
<svg
  class="lucide lucide-table"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M12 3v18" />
  <rect width="18" height="18" x="3" y="3" rx="2" />
  <path d="M3 9h18" />
  <path d="M3 15h18" />
</svg>

            </div>
            <h3 class="text-base font-semibold text-white mb-2">Tables</h3>
            <p class="text-sm text-surface-400">Inline editable tables with row and column controls. Add structured data directly inside rich text content.</p>
          </div>

          <div class="group relative p-6 pb-8 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 hover:ring-violet-500/30 transition-all duration-300 flex flex-col">
            <div class="h-12 w-12 rounded-xl bg-blue-500/10 flex items-center justify-center mb-5 ring-1 ring-blue-500/20">
              
<svg
  class="lucide lucide-grip-vertical"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <circle cx="9" cy="12" r="1" />
  <circle cx="9" cy="5" r="1" />
  <circle cx="9" cy="19" r="1" />
  <circle cx="15" cy="12" r="1" />
  <circle cx="15" cy="5" r="1" />
  <circle cx="15" cy="19" r="1" />
</svg>

            </div>
            <h3 class="text-base font-semibold text-white mb-2">Drag & Drop</h3>
            <p class="text-sm text-surface-400">Reorder any block by dragging. Move paragraphs, images, and code blocks to restructure your content visually.</p>
          </div>

        </div>
      </div>
    </section>


    <!-- Slash Commands Animated Demo -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="lg:order-last">
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-emerald-500/10 text-emerald-400 ring-1 ring-inset ring-emerald-500/20">
              Slash Commands
            </div>
            <h2 class="text-3xl sm:text-4xl text-white mb-4">Type <code class="text-primary">/</code> to do anything.</h2>
            <p class="text-lg text-surface-400 mb-6">A contextual command palette appears when you type <code class="text-xs bg-surface-800/60 px-1.5 py-0.5 rounded text-primary-light">/</code> — just like Notion. Insert images, code blocks, tables, dividers, and more without lifting your fingers from the keyboard.</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Fuzzy search across all available block types</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Register custom slash commands from your code</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Keyboard navigable — never leave your flow</li>
            </ul>
          </div>
          <div class="rounded-2xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl h-[400px]">
            <RichTextEditorDemo client:only="react" />
          </div>
        </div>
      </div>
    </section>


    <!-- Markdown with live preview -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-sky-500/10 text-sky-400 ring-1 ring-inset ring-sky-500/20">
              Markdown
            </div>
            <h2 class="text-3xl sm:text-4xl text-white mb-4">Write Markdown. Watch it render.</h2>
            <p class="text-lg text-surface-400 mb-6">Prefer plain text? Markdown fields come with a split-pane live preview — headings, bold, lists and code render as you type, and the raw Markdown is what lands in your database.</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Side-by-side editor and live preview</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Select text to format with the floating toolbar</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Stored as plain Markdown — portable by default</li>
            </ul>
          </div>
          <div class="rounded-2xl overflow-hidden shadow-2xl" inert aria-hidden="true">
            <EditorPreviewDemo client:visible />
          </div>
        </div>
      </div>
    </section>


    <!-- Kanban View -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-amber-500/10 text-amber-400 ring-1 ring-inset ring-amber-500/20">
              Kanban Board
            </div>
            <h2 class="text-3xl sm:text-4xl text-white mb-4">Drag cards, update your database.</h2>
            <p class="text-lg text-surface-400 mb-6">Every collection with an enum or status field automatically gets a Kanban view. Drag cards between columns to update records — no code, no config. Backed by real Postgres writes.</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Auto-generated from any enum or status property</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Drag-and-drop with optimistic database updates</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Filterable, sortable, and fully responsive</li>
            </ul>
          </div>
          <div class="rounded-2xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl" style="height:260px">
            <KanbanDemo client:only="react" />
          </div>
        </div>
      </div>
    </section>


    <!-- Inline Spreadsheet Editing -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="lg:order-last">
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-cyan-500/10 text-cyan-400 ring-1 ring-inset ring-cyan-500/20">
              Spreadsheet View
            </div>
            <h2 class="text-3xl sm:text-4xl text-white mb-4">Edit like a spreadsheet. Save like a database.</h2>
            <p class="text-lg text-surface-400 mb-6">Click any cell and start typing. Changes are persisted directly to Postgres. Sort, filter, bulk-select, and export — all from a familiar grid interface that non-technical users love.</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Click-to-edit cells with type-aware inputs</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Multi-row selection and bulk actions</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Column resizing, reordering, and visibility toggles</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> CSV / JSON export with one click</li>
            </ul>
          </div>
          <div className="rounded-2xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl h-[400px]">
            <SpreadsheetDemo client:only="react" />
          </div>
        </div>
      </div>
    </section>


    <!-- Extensibility: Custom Fields -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-indigo-500/10 text-indigo-400 ring-1 ring-inset ring-indigo-500/20">
              Extensible
            </div>
            <h2 class="text-3xl sm:text-4xl text-white mb-4">20+ fields. Or build your own.</h2>
            <p class="text-lg text-surface-400 mb-6">Text, numbers, dates, enums, arrays, maps, references, file uploads, rich text, JSON, and more — all pre-built. Need a color picker, a rating widget, or a map selector? Build it in React and plug it in.</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> 20+ built-in field types with custom rendering</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Custom field widgets via standard React components</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Conditional field logic and validation rules</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Preview panels for real-time content previews</li>
            </ul>
          </div>
          <div className="rounded-2xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl h-[450px]">
            <CustomFieldsDemo client:only="react" />
          </div>
        </div>
      </div>
    </section>


    <!-- Full-Width Feature Strip: Data Formats -->
 <section class="py-16 sm:py-24">
