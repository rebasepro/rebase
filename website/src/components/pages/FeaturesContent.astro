---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';



import SectionBackgroundAccents from '../../components/SectionBackgroundAccents.astro';
import { NeatBackground } from '../../components/NeatBackground';
import SpotlightCard from '../../components/SpotlightCard.astro';
import { Terminal, ShieldCheck, Folder, Network, ClipboardList, History, Clock, Zap, Webhook } from "lucide-react";
import { SchemaEditorDemo } from '../../components/SchemaEditorDemo';
import UsageExamples from '../../components/UsageExamples.astro';
import { ContentEditorDemo } from '../../components/demos/ContentEditorDemo';
import { DataTalkDemo } from '../../components/DataTalkDemo';




---


    <div class="flex flex-col isolate">
        <!-- Hero Section -->
 <section
                class="relative isolate overflow-hidden bg-black pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
            <div class="px-4 mx-auto max-w-7xl text-center lg:px-12 relative z-10">
                <div class="inline-flex items-center py-1.5 px-3 mb-6 sm:mb-7 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10 mx-auto"
                     role="status">
                    <span class="text-sm font-medium">See what's under the hood</span>
                </div>
                <h1 class="mb-6 text-3xl font-semibold tracking-tight md:text-4xl lg:text-5xl text-white">
                    One framework. Everything you need.
                </h1>
                <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48">
                    Admin UI, APIs, security, and developer tooling — all generated from your Postgres schema. No glue code, no boilerplate.
                </p>
            </div>
        </section>

        <!-- Data Management Section (large media, centered) -->
 <section class="relative z-0 py-24 sm:py-32">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <div class="mx-auto max-w-3xl text-center mb-10">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Edit like a spreadsheet. Save like a database.</h2>
                    <p class="mt-6 text-lg leading-8 text-surface-400">Inline editing, real-time filters, Kanban views, and a Notion-style rich text editor — all reading and writing directly to your Postgres tables.</p>
                </div>
                <div class="mx-auto max-w-[800px] lg:max-w-[1000px]">
                    <div class="rounded-xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 shadow-2xl">
                        <ContentEditorDemo client:load />
                    </div>
                </div>
            </div>
        </section>

        <!-- Neat gradient divider -->
        <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden" style="z-index: -1; height: 600px;">
            <NeatBackground variant="a" client:visible/>
        </div>

        <!-- Schema Builder Section (split layout for variety) -->
 <section class="py-24 sm:py-32">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <div class="mx-auto max-w-3xl text-center mb-10">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-6">Visual building. Real TypeScript.</h2>
                    <p class="text-lg text-surface-400 mb-8">Design your schema visually in Rebase Studio — every change writes back to your local TypeScript files via AST. Or connect your existing database and get a full admin panel instantly.</p>
                </div>
                <div class="mx-auto max-w-[1400px]">
                    <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-950"
                         style="height: 600px;">
                        <SchemaEditorDemo client:load/>
                    </div>
                </div>
                <ul class="mt-10 mx-auto max-w-3xl grid grid-cols-1 sm:grid-cols-2 gap-4 text-surface-300 text-sm">
                    <li class="flex items-end gap-3">
                        
<svg
  class="lucide lucide-circle-check-big"
  xmlns="http://www.w3.org/2000/svg"
  width="18"
  height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M21.801 10A10 10 0 1 1 17 3.335" />
  <path d="m9 11 3 3L22 4" />
</svg>

                        Automatic schema inference from existing data
                    </li>
                    <li class="flex items-end gap-3">
                        
<svg
  class="lucide lucide-square-pen"
  xmlns="http://www.w3.org/2000/svg"
  width="18"
  height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
  <path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" />
</svg>

                        20+ field types with advanced validation
                    </li>
                </ul>
            </div>
        </section>


        <!-- All Features Grid (reuse SpotlightCard) -->
 <section class="py-24 sm:py-32">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <div class="mx-auto max-w-2xl text-center mb-16">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Everything You Need, Out of
                        the Box</h2>
                </div>
                <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                    <SpotlightCard
                            icon={Terminal}
                            title="Built-in SQL Editor"
                            description="Run queries, visualize EXPLAIN plans, edit results inline, and save favorite snippets — all without leaving the admin panel."
                    />
                    <SpotlightCard
                            icon={ShieldCheck}
                            title="Row-Level Security"
                            description="Create and manage Postgres RLS policies visually. Define per-row, per-role access rules in TypeScript."
                    />
                    <SpotlightCard
                            icon={Folder}
                            title="File Storage"
                            description="Seamless file storage integration for images, videos, and documents."
                    />
                    <SpotlightCard
                            icon={Network}
                            title="Typed Client SDK"
                            description="A unified data layer for your frontend. Fetch data and resolve deep relations with pure TypeScript autocompletion powered by Drizzle ORM."
                    />
                    <SpotlightCard
                            icon={ClipboardList}
                            title="Powerful Forms"
                            description="Conditional logic, complex validation, and custom form widgets for every data type."
                    />
                    <SpotlightCard
                            icon={History}
                            title="Data History & Audit"
                            description="Track who changed what and when. Compare versions and safely revert to previous states."
                    />
                    <SpotlightCard
                            icon={Clock}
                            title="Cron Jobs"
                            description="Schedule background tasks — data cleanup, report generation, API syncs — with built-in monitoring and logging."
                    />
                    <SpotlightCard
                            icon={Zap}
                            title="Custom Functions"
                            description="Drop a Hono route file in functions/ and it auto-mounts with auth middleware and database access. Zero config."
                    />
                    <SpotlightCard
                            icon={Webhook}
                            title="Webhooks"
                            description="Notify external services on data changes with HMAC-signed payloads, automatic retries, and exponential backoff."
                    />
                </div>
            </div>
        </section>

        <!-- Flexible and Adaptable Section -->
 <section class="py-24 sm:py-32">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <div class="mx-auto max-w-3xl text-center mb-14">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Flexible and Adaptable to
                        Your Needs</h2>
                    <p class="mt-6 text-lg leading-8 text-surface-400">Rebase is designed to fit into your existing stack
                        and workflow, not the other way around.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
                    <!-- Import/Export -->
                    <div>
                        <div class="relative w-full h-96 bg-surface-900 rounded-2xl ring-1 ring-surface-800 flex items-center justify-center mb-6">
                            <img src="/img/import_mapping.webp" alt="Custom Branding Example"
                                 class="h-full w-full object-cover object-left-top"/>
                        </div>
                        <h3 class="text-2xl font-semibold text-white mb-3">Effortless Data Import & Export</h3>
                        <p class="text-surface-400 leading-7">Migrate your data seamlessly. Bulk import from CSV or JSON
                            with intuitive field mapping and validation. Export your collections to CSV, or JSON, with a
                            single click, making backups and reporting a breeze.</p>
                    </div>

                    <!-- Custom Branding -->
                    <div>
                        <div class="relative w-full h-96 bg-surface-900 rounded-2xl overflow-hidden ring-1 ring-surface-800 flex items-center justify-center mb-6">
                            <img src="/img/toleroo_recipe.webp" alt="Custom Branding Example"
                                 class="h-full w-full object-cover object-left-top"/>
                        </div>
                        <h3 class="text-2xl font-semibold text-white mb-3">Make It Yours with Custom Branding</h3>
                        <p class="text-surface-400 leading-7">Customize logos, colors, and themes to match your brand.
                            Provide a seamless experience for your users and clients with a back-office that feels like
                            a part of your own product.</p>
                    </div>
                </div>
            </div>
        </section>


        <!-- AI & Conversational Data Section (mixed layouts) -->
 <section class="py-24 sm:py-32">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <div class="mx-auto max-w-3xl text-center mb-14">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Harness AI for Your
                        Structured Data</h2>
                    <p class="mt-6 text-lg leading-8 text-surface-400">Generate content aligned with your schema, and query
                        or update data with natural language.</p>
                </div>

                <!-- AI and MCP (split layout) -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center mb-16">
                    <div class="lg:col-span-4">
                        <h3 class="text-2xl font-semibold text-white mb-3">AI Autofill & MCP Server</h3>
                        <p class="text-surface-400 leading-7 mb-4">Use context‑aware prompts to generate titles, descriptions,
                            and translations. Accept suggestions across multiple fields in one click.</p>
                        <p class="text-surface-400 leading-7">Beyond the UI, expose your CMS to external AI agents via our built-in <b>Model Context Protocol (MCP) server</b>, allowing autonomous systems to safely query and mutate your Postgres data.</p>
                    </div>
                    <div class="lg:col-span-8">
                        <div class="rounded-xl overflow-hidden ring-1 ring-surface-800 bg-surface-950 shadow-2xl">
                            <DataTalkDemo client:only="react" height="480px" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <UsageExamples/>

        <!-- Final CTA Section -->
 <section class="py-24 sm:py-32">
            <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
                <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-8">Ready to see it in
                    action?</h2>
                <div class="flex items-center justify-center gap-x-6">
                    <a href="https://demo.rebase.pro"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all duration-200 ease-in-out btn-glow">
                        Check the Demo
                        
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

                    </a>
                    <a href="/docs"
                       class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold">
                        Start a project
                        
<svg
  class="lucide lucide-arrow-right"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg>

                    </a>
                </div>
            </div>
        </section>


    </div>


