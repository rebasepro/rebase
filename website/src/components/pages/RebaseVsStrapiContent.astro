  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M21.801 10A10 10 0 1 1 17 3.335" />
  <path d="m9 11 3 3L22 4" />
</svg>

                      <h4 class="text-white font-semibold">{t("vs.solve")}</h4>
                    </div>
                    <p class="text-surface-300 leading-relaxed text-sm mb-4">{t("vsstrapi.06")}</p>
