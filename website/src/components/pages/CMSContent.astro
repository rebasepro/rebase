---
const { lang, t } = Astro.props;

import { AdminDemoCarousel } from '../../components/demos/AdminDemoCarousel';
import { StorageViewDemo } from '../../components/demos/StorageViewDemo';
import { CustomFieldsDemo } from '../../components/demos/CustomFieldsDemo';
import { ReactExtMiniDemo } from '../../components/demos/ReactExtMiniDemo';
import { NeatBackground } from '../../components/NeatBackground';
import ScreenshotsMarquee from '../../components/ScreenshotsMarquee.astro';
import { KanbanDemo } from '../../components/demos/KanbanDemo';
import { RichTextEditorDemo } from '../../components/demos/RichTextEditorDemo';
import { SpreadsheetDemo } from '../../components/demos/SpreadsheetDemo';
import { EditorMiniDemo } from '../../components/demos/EditorMiniDemo';
import { EditorPreviewDemo } from '../../components/demos/EditorPreviewDemo';
import "../../styles/editor.css";
import { useTranslatedPath } from '../../i18n/ui';

const translatePath = useTranslatedPath(lang);

// Whitespace matters inside <pre>, so the samples live in frontmatter.
const optInCode = `<span class="text-surface-500"># one dependency more than a headless project</span>
<span class="text-primary">~</span> pnpm add @rebasepro/cms-types

<span class="text-surface-500">// config/cms.d.ts — one line, once per project</span>
<span class="text-surface-500">/// &lt;reference types="@rebasepro/cms-types" /&gt;</span>`;

const adminBlockCode = `<span class="text-primary-light">export const</span> <span class="text-white">orders</span>: PostgresCollectionConfig = {
  <span class="text-surface-500">// … the backend half: table, properties, securityRules</span>

  <span class="text-blue-300">admin</span>: {
    <span class="text-blue-300">icon</span>: <span class="text-green-400">"ShoppingCart"</span>,
    <span class="text-blue-300">group</span>: <span class="text-green-400">"E-Commerce"</span>,
    <span class="text-blue-300">defaultViewMode</span>: <span class="text-green-400">"table"</span>,
    <span class="text-blue-300">enabledViews</span>: [<span class="text-green-400">"table"</span>, <span class="text-green-400">"kanban"</span>],
    <span class="text-blue-300">listProperties</span>: [<span class="text-green-400">"reference"</span>, <span class="text-green-400">"status"</span>, <span class="text-green-400">"total"</span>],
    <span class="text-blue-300">sort</span>: [<span class="text-green-400">"created_at"</span>, <span class="text-green-400">"desc"</span>],
  },
};`;

const customComponentCode = `<span class="text-blue-300">status</span>: {
  <span class="text-blue-300">name</span>: <span class="text-green-400">"Status"</span>,
  <span class="text-blue-300">type</span>: <span class="text-green-400">"string"</span>,
  <span class="text-blue-300">enum</span>: { <span class="text-blue-300">paid</span>: <span class="text-green-400">"Paid"</span>, <span class="text-blue-300">refunded</span>: <span class="text-green-400">"Refunded"</span> },
  <span class="text-blue-300">admin</span>: {
    <span class="text-surface-500">// your own React component, resolved at build time</span>
    <span class="text-blue-300">Field</span>: <span class="text-green-400">"./components/StatusPicker"</span>,
    <span class="text-blue-300">Preview</span>: <span class="text-green-400">"./components/StatusChip"</span>,
  },
},`;

// What the panel does that a database dashboard does not.
const capabilities = [
    { title: "Every view, no code", desc: "The same rows as a data grid, cards, a list or a Kanban board. Switch layout, filter live, edit in place." },
    { title: "Relations as navigation", desc: "Foreign keys and many-to-many joins become tabs. Attach existing rows or create related records without leaving the entity." },
    { title: "Media that belongs to a row", desc: "Uploads land in your storage bucket and resolve inline — thumbnails in the list, previews in the form." },
    { title: "History and revert", desc: "Who changed what, when. Compare two versions side by side and roll one back." },
    { title: "Users, roles and what they can reach", desc: "The same roles your RLS policies read, managed by people who will never open psql." },
    { title: "Import, export, bulk edit", desc: "CSV, JSON or Excel in with field mapping; one click out. Thousands of rows without a migration script." },
];
import ClosingCta from "../ClosingCta.astro";
---

<div class="flex flex-col isolate">

    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative isolate overflow-hidden hero-under-nav pb-12 sm:pb-16">
        <NeatBackground client:idle transition:persist="neat-hero" />

        <div class="px-4 mx-auto max-w-6xl lg:px-12 relative z-10">
            <div class="inline-flex items-center py-1.5 px-3 mb-6 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10">
                <span class="text-sm font-medium">Optional layer · React 19 · Bring your own components</span>
            </div>
            <h1 class="mb-6 text-display-2 text-white">
                Rebase CMS.<br/>{t("cmspage.hero.tagline")}
            </h1>
            <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl">
                A complete back office, generated from the collections your backend already uses. It is a layer
                on top — a client of the same API your own code calls, under the same policies. Add it when a
                human needs to touch the data, skip it when nobody does, and remove it without your API noticing.
            </p>
            <div class="flex flex-wrap items-center justify-start gap-x-6 gap-y-3">
                <a href={translatePath("/demo")}
                   class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white hover:bg-primary-dark hover:brightness-105 transition-all duration-200 ease-in-out btn-glow"
                   data-track id="admin-hero-demo">
                    {t("cta.button.demo")}
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
                <a href={translatePath("/backend")}
                   class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold">
                    {t("cmspage.link.backend")}
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Real back offices, running -->
    <section class="relative z-0 pb-16 sm:pb-24 overflow-hidden">
        <div class="mx-auto max-w-6xl px-6 lg:px-8 mb-8">
            <p class="text-center text-sm text-surface-500">{t("cmspage.marquee.caption")}</p>
        </div>
        <div class="h-72">
            <ScreenshotsMarquee/>
        </div>
    </section>

    <!-- ═══════════════════════ 01 · THE TOUR ═══════════════════════ -->
    <section class="relative z-0 py-chapter">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-12">
                <p class="mb-label text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                    The tour
                </p>
                <h2 class="text-3xl sm:text-4xl text-white">
                    {t("cmspage.work.title")}
                </h2>
                <p class="mt-lead text-lg leading-8 text-surface-400">
                    Everything below is generated from the same collection definitions your API is served from.
                    Nobody drew these screens.
                </p>
            </div>

            <div style="min-height: 700px;">
                <AdminDemoCarousel client:load/>
            </div>
        </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>

    <!-- ═══════════════════════ 02 · WHAT YOUR TEAM GETS ═══════════════════════ -->
    <section class="relative z-0 py-chapter">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
                <div class="lg:col-span-5">
                    <p class="mb-label text-xs font-semibold tracking-[0.25em] text-surface-500 uppercase">
                        {t("cmspage.eyebrow.daytoday")}
                    </p>
                    <h2 class="text-3xl sm:text-4xl text-white mb-8">
                        {t("cmspage.work.sub")}
                    </h2>
                    <div class="space-y-5">
                        {capabilities.map(item => (
                                <div class="flex gap-3">
                                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/60"></span>
                                    <p class="text-sm text-surface-400 leading-relaxed">
                                        <span class="text-white">{item.title}.</span> {item.desc}
                                    </p>
                                </div>
                        ))}
                    </div>
                    <div class="mt-8 flex flex-col items-start gap-3">
                        <a href={translatePath("/studio")}
                           class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                            {t("cmspage.studio.title")}
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                </div>

                <div class="lg:col-span-7">
                    <StorageViewDemo client:visible/>
                    <p class="mt-4 text-sm text-surface-500">
                        {t("cmspage.storage.note")}
                    </p>
                </div>
            </div>
        </div>
    </section>


    <!-- ═══════════════════════ 03 · THE EDITING SURFACE ═══════════════════════
         Folded in from the former /editing page. It was a separate route in the
         nav that almost nobody reached — and it described the same product this
         page does, so the split only ever taught readers that 'the admin panel'
         and 'content editing' were two things. They are one: Rebase CMS. -->
    <!-- Full-width interactive Notion editor hero -->
 <section class="relative z-0 pb-16 sm:pb-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="rounded-2xl overflow-hidden border border-surface-800/80 bg-surface-950 shadow-[0_0_0_1px_rgba(15,23,42,0.55),0_24px_120px_rgba(0,0,0,0.65)]">
          <!-- Browser Chrome -->
          <div class="px-4 py-3 border-b border-surface-800/80 flex items-center gap-2 bg-surface-900/50 backdrop-blur-md">
            <div class="flex gap-1.5 w-16">
            </div>
            <div class="flex-1 flex justify-center">
              <div class="bg-surface-950/80 border border-surface-800/80 rounded-lg px-3 py-1 text-2xs font-mono text-surface-500 flex items-center gap-1.5">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                admin.yourdomain.com/posts/new
              </div>
            </div>
            <div class="w-16"></div>
          </div>
          <!-- Editor -->
          <div class="relative w-full" style="min-height: 420px;">
            <RichTextEditorDemo client:only="react" />
          </div>
        </div>
        <p class="mt-4 text-center text-xs sm:text-sm text-surface-500">{t("cmspage.rte.caption")}</p>
      </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative pointer-events-none overflow-hidden" style="z-index: -1; --divider-h: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>



    {/* A twelve-card grid listing block types stood here. SITE-STORY §5: a
        live demo, not a card grid — and the editor above IS the demo, so the
        grid was restating what the reader had just used. */}

    {/* RichTextEditorDemo was mounted twice on this page. The framed one
        above is the mount; this second copy came in with the folded-in
        /editing content. */}

    <!-- Markdown with live preview -->
 <section class="py-chapter">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-sky-500/10 text-sky-400 ring-1 ring-inset ring-sky-500/20">
              Markdown
            </div>
            <h2 class="text-3xl sm:text-4xl text-white mb-4">{t("cmspage.md.title")}</h2>
            <p class="text-lg text-surface-400 mb-6">{t("cmspage.md.body")}</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {t("cmspage.md.f1")}</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {t("cmspage.md.f2")}</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {t("cmspage.md.f3")}</li>
            </ul>
          </div>
          <div class="rounded-2xl overflow-hidden shadow-2xl" inert aria-hidden="true">
            <EditorPreviewDemo client:visible />
          </div>
        </div>
      </div>
    </section>


    <!-- Kanban View -->
 <section class="py-chapter">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-amber-500/10 text-amber-400 ring-1 ring-inset ring-amber-500/20">
              Kanban
            </div>
            <h2 class="text-3xl sm:text-4xl text-white mb-4">{t("cmspage.kanban.title")}</h2>
            <p class="text-lg text-surface-400 mb-6" set:html={t("cmspage.kanban.body")}></p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {t("cmspage.kanban.f1")}</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {t("cmspage.kanban.f2")}</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {t("cmspage.kanban.f3")}</li>
            </ul>
          </div>
          <div class="rounded-2xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl" style="height:260px">
            <KanbanDemo client:only="react" />
          </div>
        </div>
      </div>
    </section>


    <!-- Inline Spreadsheet Editing -->
 <section class="py-chapter">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="lg:order-last">
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-cyan-500/10 text-cyan-400 ring-1 ring-inset ring-cyan-500/20">
              Spreadsheet View
            </div>
            <h2 class="text-3xl sm:text-4xl text-white mb-4">{t("cmspage.sheet.title")}</h2>
            <p class="text-lg text-surface-400 mb-6">{t("cmspage.sheet.body")}</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {t("cmspage.sheet.f1")}</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {t("cmspage.sheet.f2")}</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {t("cmspage.sheet.f3")}</li>
              <li class="flex gap-3"><span class="mt-1 shrink-0 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {t("cmspage.sheet.f4")}</li>
            </ul>
          </div>
          <div className="rounded-2xl overflow-hidden ring-1 ring-surface-700 bg-surface-950 shadow-2xl h-[400px]">
            <SpreadsheetDemo client:only="react" />
          </div>
        </div>
      </div>
    </section>


    {/* CustomFieldsDemo was mounted twice. The mount that survives is in
        "It is a React app. Treat it like one." below, where the code sample
        beside it says what the demo is showing. */}

    <!-- Full-Width Feature Strip: Data Formats -->
 <section class="py-chapter">
      <div class="mx-auto max-w-6xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <h2 class="text-3xl sm:text-4xl text-white">{t("cmspage.formats.title")}</h2>
          <p class="mt-lead text-surface-400 text-lg">{t("cmspage.formats.body")}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">

          <div class="relative rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 overflow-hidden flex flex-col">
            <div class="aspect-[16/10] overflow-hidden">
              <img src="/img/blog_example.webp" width="2336" height="1168" alt="Blog entry editor with preview panel showing rich content" class="w-full h-full object-cover object-top" loading="lazy"/>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                <div class="h-8 w-8 rounded-lg bg-violet-500/10 flex items-center justify-center ring-1 ring-violet-500/20">
                  
<svg
  class="lucide lucide-file-text"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" />
  <path d="M14 2v5a1 1 0 0 0 1 1h5" />
  <path d="M10 9H8" />
  <path d="M16 13H8" />
  <path d="M16 17H8" />
</svg>

                </div>
                <h3 class="text-base text-white">{t("cmspage.persona.content.title")}</h3>
              </div>
              <p class="text-sm text-surface-400 leading-relaxed">{t("cmspage.persona.content.body")}</p>
            </div>
          </div>

          <div class="relative rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 overflow-hidden flex flex-col">
            <div class="aspect-[16/10] overflow-hidden">
              <img src="/img/users_table.png" width="2430" height="992" alt="Users table view with inline editing, relations, and entity actions" class="w-full h-full object-cover object-top" loading="lazy"/>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                <div class="h-8 w-8 rounded-lg bg-cyan-500/10 flex items-center justify-center ring-1 ring-cyan-500/20">
                  
<svg
  class="lucide lucide-package"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" />
  <path d="M12 22V12" />
  <polyline points="3.29 7 12 12 20.71 7" />
  <path d="m7.5 4.27 9 5.15" />
</svg>

                </div>
                <h3 class="text-base text-white">{t("cmspage.persona.ops.title")}</h3>
              </div>
              <p class="text-sm text-surface-400 leading-relaxed">{t("cmspage.persona.ops.body")}</p>
            </div>
          </div>

          <div class="relative rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 overflow-hidden flex flex-col">
            <div class="aspect-[16/10] overflow-hidden">
              <img src="/img/product_details_view.png" width="1266" height="1478" alt="Product detail view with Custom Preview tab showing product images and rich description — dark mode" class="w-full h-full object-cover object-top" loading="lazy"/>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                <div class="h-8 w-8 rounded-lg bg-emerald-500/10 flex items-center justify-center ring-1 ring-emerald-500/20">
                  
<svg
  class="lucide lucide-code"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m16 18 6-6-6-6" />
  <path d="m8 6-6 6 6 6" />
</svg>

                </div>
                <h3 class="text-base text-white">{t("cmspage.persona.dev.title")}</h3>
              </div>
              <p class="text-sm text-surface-400 leading-relaxed">{t("cmspage.persona.dev.body")}</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════ 04 · IT IS A REACT APP ═══════════════════════ -->
    <section class="py-chapter">
