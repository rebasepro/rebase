---
/**
 * The public roadmap, from the `roadmap`-labelled issues on GitHub.
 *
 * Written out rather than fetched at build time on purpose: a build that
 * depends on the GitHub API fails when the API does, and this page changes a
 * few times a year. The issue numbers are the link back to where the discussion
 * actually happens.
 *
 * `requiredFor1` is a judgement, and the page says whose. The rule applied: a
 * thing is required for 1.0 when 1.0 would be embarrassing without it — the
 * first run, and changing a schema against a running backend. Everything else
 * is wanted, not owed.
 */
interface Props {
    lang: string;
    t: (key: string) => string;
}
const { t } = Astro.props;

const items = [
    {
        issue: 4,
        title: "First run works with nothing but Docker",
        summary:
            "One command from an empty directory to a serving backend, with no undocumented step in between.",
        requiredFor1: true
    },
    {
        issue: 5,
        title: "Create and alter collections against a running backend",
        summary:
            "Schema changes applied to a deployment without a redeploy, with the destructive ones still gated.",
        requiredFor1: true
    },
    {
        issue: 6,
        title: "Authentication: one-time codes, passkeys, bot protection, SAML",
        summary:
            "One-time codes and OIDC ship today. Passkeys, bot protection and SAML do not; the custom auth adapter is the route to SAML for now.",
        requiredFor1: false
    },
    {
        issue: 7,
        title: "Storage: declarative policies and cacheable delivery",
        summary:
            "Storage access is a hook you write. This makes it a declaration beside the collection, and puts a cache in front of delivery.",
        requiredFor1: false
    },
    {
        issue: 8,
        title: "Compute: one trigger model, secrets, per-function deploy",
        summary:
            "Hooks, crons, jobs and webhooks are four ways to say 'run this when'. One model, a secret store, and deploying one function without the rest.",
        requiredFor1: false
    },
    {
        issue: 9,
        title: "Postgres platform: pooling, read routing, branching workflow",
        summary:
            "A pooled endpoint, reads routed to replicas, and database branches that fit a pull-request workflow.",
        requiredFor1: false
    },
    {
        issue: 10,
        title: "Push notifications and non-JavaScript SDKs",
        summary:
            "Push, and generated clients for languages other than TypeScript.",
        requiredFor1: false
    }
];
---

<section class="py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
        <div class="mb-14">
            <span
                class="inline-flex items-center gap-1.5 rounded-md bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary ring-1 ring-primary/30"
                >{t("roadmap.badge")}</span
            >
            <h1 class="mt-5 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
                {t("roadmappage.title")}
            </h1>
            <p class="mt-5 text-lg leading-8 text-surface-300">
                {t("roadmappage.intro")}
            </p>
            <p class="mt-4 text-sm leading-7 text-surface-400">
                {t("roadmappage.note")}
                <a
                    href="https://rebase.pro/docs/compatibility"
                    class="text-primary underline-offset-4 hover:underline"
                    >{t("roadmappage.readiness")}</a
                >
            </p>
        </div>

        <ul class="space-y-5">
            {
                items.map((item) => (
                    <li class="rounded-2xl border border-surface-800 bg-surface-900/50 p-6 transition-colors hover:border-surface-700">
                        <div class="flex flex-wrap items-center gap-3">
                            <a
                                href={`https://github.com/rebasepro/rebase/issues/${item.issue}`}
                                target="_blank"
                                rel="noopener"
                                class="font-mono text-xs text-surface-400 hover:text-primary"
                            >
                                #{item.issue}
                            </a>
                            <h2 class="text-lg font-medium text-white">{item.title}</h2>
                            {item.requiredFor1 && (
                                <span class="rounded-md bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary ring-1 ring-primary/30">
                                    {t("roadmappage.required")}
                                </span>
                            )}
                        </div>
                        <p class="mt-3 text-sm leading-6 text-surface-300">{item.summary}</p>
                    </li>
                ))
            }
        </ul>

        <p class="mt-12 text-sm leading-7 text-surface-400">
            {t("roadmappage.gate")}
        </p>
    </div>
</section>
