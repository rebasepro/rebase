---
const { lang, t } = Astro.props;

import { useTranslatedPath } from '../../i18n/ui';
import { NeatBackground } from '../../components/NeatBackground';
import { AgentConsoleDemo } from '../../components/demos/AgentConsoleDemo';
import McpSessionDemo from '../demos/McpSessionDemo';
import { mcpClients } from '../../utils/mcpClients';

const translatePath = useTranslatedPath(lang);

const mcpConfigCode = `<span class="text-surface-500">// .cursor/mcp.json — or Claude Desktop, Windsurf, Copilot…</span>
{
  <span class="text-blue-400">"mcpServers"</span>: {
    <span class="text-blue-400">"rebase"</span>: {
      <span class="text-blue-400">"command"</span>: <span class="text-emerald-400">"npx"</span>,
      <span class="text-blue-400">"args"</span>: [<span class="text-emerald-400">"@rebasepro/mcp"</span>],
      <span class="text-blue-400">"env"</span>: {
        <span class="text-blue-400">"REBASE_BASE_URL"</span>: <span class="text-emerald-400">"https://api.example.com"</span>,
        <span class="text-blue-400">"REBASE_API_TOKEN"</span>: <span class="text-emerald-400">"rk_live_…"</span>
      }
    }
  }
}`;

const keyCode = `<span class="text-surface-500">// The key behind that token. Three operations, not two —</span>
<span class="text-surface-500">// and \`admin\` is a separate flag, off by default.</span>
{
  <span class="text-blue-400">"name"</span>: <span class="text-emerald-400">"support-agent"</span>,
  <span class="text-blue-400">"permissions"</span>: [
    { <span class="text-blue-400">"collection"</span>: <span class="text-emerald-400">"products"</span>, <span class="text-blue-400">"operations"</span>: [<span class="text-emerald-400">"read"</span>] },
    { <span class="text-blue-400">"collection"</span>: <span class="text-emerald-400">"orders"</span>,   <span class="text-blue-400">"operations"</span>: [<span class="text-emerald-400">"read"</span>, <span class="text-emerald-400">"write"</span>] }
  ],
  <span class="text-blue-400">"admin"</span>: <span class="text-amber-400">false</span>,
  <span class="text-blue-400">"expires_at"</span>: <span class="text-emerald-400">"2026-10-01"</span>
}`;

// The tool surface, taken from the exported tool names in @rebasepro/mcp.
// If that package gains or loses a tool, this list is wrong — keep them together.
const toolGroups = [
    {
        name: "Data",
        icon: "M3 12a9 3 0 1 0 18 0 9 3 0 1 0-18 0M3 5v14a9 3 0 0 0 18 0V5M3 12a9 3 0 0 0 18 0",
        tools: ["list_documents", "get_document", "create_document", "update_document", "delete_document"]
    },
    {
        name: "Users & roles",
        icon: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 8 0 4 4 0 1 0-8 0M22 21v-2a4 4 0 0 0-3-3.87",
        tools: ["list_users", "create_user", "update_user", "delete_user", "list_roles", "rebase_auth_reset_password"]
    },
    {
        name: "Schema & database",
        icon: "M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01",
        tools: ["rebase_schema_generate", "rebase_schema_introspect", "rebase_db_push", "rebase_db_generate", "rebase_db_migrate", "rebase_generate_sdk", "rebase_doctor"]
    },
    {
        name: "Branching",
        icon: "M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6M15 6a9 9 0 0 1-9 9",
        tools: ["rebase_db_branch_create", "rebase_db_branch_list", "rebase_db_branch_info", "rebase_db_branch_delete"]
    },
    {
        name: "Storage",
        icon: "M21 8v13H3V8M1 3h22v5H1zM10 12h4",
        tools: ["storage_list_objects", "storage_get_metadata", "storage_delete_object"]
    },
    {
        name: "Cron",
        icon: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20M12 6v6l4 2",
        tools: ["cron_list_jobs", "cron_get_job", "cron_trigger_job", "cron_get_job_logs", "cron_toggle_job"]
    },
    {
        name: "Functions",
        icon: "m18 16 4-4-4-4M6 8l-4 4 4 4M14.5 4l-5 16",
        tools: ["invoke_function"]
    },
    {
        name: "Dev server",
        icon: "m4 17 6-6-6-6M12 19h8",
        tools: ["rebase_dev_start", "rebase_dev_logs", "rebase_dev_stop"]
    },
    {
        name: "Projects",
        icon: "M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2",
        tools: ["rebase_project_list", "rebase_project_current", "rebase_project_switch", "rebase_project_add", "rebase_project_remove", "rebase_project_status"]
    }
];

const toolCount = toolGroups.reduce((n, g) => n + g.tools.length, 0);
---

<div class="flex flex-col isolate">

    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-20">
        <NeatBackground client:idle transition:persist="neat-hero" />

        <div class="relative z-10 mx-auto max-w-6xl px-4 lg:px-12">
            <p class="mb-5 text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">
                <a href={translatePath("/backend")} class="transition-colors hover:text-primary">The backend</a>
                <span class="mx-2 text-surface-600">/</span><span class="text-surface-500">AI &amp; agents</span>
            </p>
            <div class="mx-auto mb-6 inline-flex items-center rounded-full bg-surface-800/40 px-3 py-1.5 text-sm text-surface-400 ring-1 ring-inset ring-white/10">
                <span class="font-medium">{toolCount} MCP tools · scoped keys · enforced by Postgres</span>
            </div>
            <h1 class="mb-6 text-display-2 text-white">
                The backend an agent<br class="hidden sm:inline"/> can't screw up.
            </h1>
            <p class="mb-4 text-lg leading-8 text-surface-300 sm:px-16 lg:text-xl xl:px-48">
                Give an agent real tools over your data — read, write, migrate, deploy — through an MCP server it
                connects to in one config block.
            </p>
            <p class="text-base leading-7 text-surface-400">
                Then take the safety on trust out of it. What the agent may touch is a scoped key, and what the
                database will return is row-level security. Two gates, neither of them a prompt.
            </p>
        </div>
    </section>

    <!-- ═══════════════════════ ONE CONFIG BLOCK ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
                <div class="lg:col-span-5">
                    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">Model Context Protocol</p>
                    <h2 class="mb-5 text-3xl sm:text-4xl text-white">
                        Your project, as tools an assistant can call
                    </h2>
                    <p class="mb-4 text-base leading-relaxed text-surface-400">
                        <code class="font-mono text-surface-300">@rebasepro/mcp</code> speaks the Model Context Protocol,
                        so anything that speaks MCP can drive your backend: query and edit data, push schema changes,
                        open a database branch, trigger a cron job, tail the dev server.
                    </p>
                    <p class="mb-4 text-base leading-relaxed text-surface-400">
                        Your collection definitions and the generated Drizzle schema are exposed as MCP
                        <i>resources</i> too, so the assistant reads your actual data model rather than guessing at it
                        from the code it happens to have open.
                    </p>
                    <p class="text-base leading-relaxed text-surface-400">
                        There is nothing to build and no adapter to write. It is one block in a config file.
                    </p>
                </div>

                <div class="lg:col-span-7">
                    <div class="frame overflow-hidden">
                        <div class="flex items-center gap-1.5 border-b border-surface-800/80 bg-surface-900/50 px-4 py-3">
                            <span class="ml-2 font-mono text-2xs text-surface-400">.cursor/mcp.json</span>
                        </div>
                        <pre class="overflow-x-auto p-5 font-mono text-2xs leading-relaxed text-surface-300 sm:text-xs"><code set:html={mcpConfigCode}></code></pre>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ THE TOOL SURFACE ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mx-auto mb-12 max-w-3xl text-center">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">The tool surface</p>
                <h2 class="mb-5 text-3xl sm:text-4xl text-white">
                    {toolCount} tools, and these are their real names
                </h2>
                <p class="text-base leading-relaxed text-surface-400">
                    Not a category diagram — the actual list the server registers. An agent that can call these can
                    build and operate an application without a human in the request path.
                </p>
            </div>

            <div class="frame p-6 sm:p-8">
                <div class="grid grid-cols-1 gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
                    {toolGroups.map((group) => (
                        <div>
                            <div class="mb-3 flex items-center gap-2.5">
                                <span class="flex h-7 w-7 flex-none items-center justify-center rounded-lg bg-primary/10 ring-1 ring-inset ring-primary/20">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round" class="text-primary">
                                        <path d={group.icon}/>
                                    </svg>
                                </span>
                                <span class="text-sm font-medium text-surface-200">{group.name}</span>
                                <span class="ml-auto font-mono text-2xs text-surface-600">{group.tools.length}</span>
                            </div>
                            <ul class="space-y-1">
                                {group.tools.map((tool) => (
                                    <li class="truncate font-mono text-[11.5px] text-surface-500">{tool}</li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative overflow-hidden pointer-events-none" style="z-index: -1; --divider-h: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>

    <!-- ═══════════════════════ TRY TO MAKE IT LEAK ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mx-auto mb-12 max-w-3xl text-center">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">Least-privilege agents</p>
                <h2 class="mb-5 text-3xl sm:text-4xl text-white">
                    Authorization the agent cannot forget
                </h2>
                <p class="text-base leading-relaxed text-surface-400">
                    Everyone in this category will tell you their agent integration is safe. The question worth asking
                    is what enforces it — because if the answer is the tool layer, then a bug in the tool layer is a
                    breach. Here the tool layer is the first of two gates, and the second one is the database.
                </p>
                <p class="mt-4 text-base leading-relaxed text-surface-400">
                    Revoke a permission below and watch the same four calls come back refused.
                </p>
            </div>

            <div class="mx-auto max-w-6xl">
                <McpSessionDemo client:visible/>
            </div>

            <div class="mx-auto mt-14 grid max-w-6xl grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
                <div class="lg:col-span-5">
                    <h3 class="mb-4 text-2xl font-semibold text-white">A key, not a god-mode credential</h3>
                    <p class="mb-4 text-base leading-relaxed text-surface-400">
                        Permissions are declared per collection and per operation, and there are three operations
                        rather than the usual two — <code class="font-mono text-surface-300">delete</code> is separable
                        from <code class="font-mono text-surface-300">write</code>, which is the one you actually want
                        to withhold from an agent.
                    </p>
                    <p class="mb-4 text-base leading-relaxed text-surface-400">
                        <code class="font-mono text-surface-300">admin</code> is a separate flag. Without it the key
                        carries only the <code class="font-mono text-surface-300">service</code> role, and Postgres
                        grants that role nothing at all unless one of your policies names it.
                    </p>
                    <p class="text-base leading-relaxed text-surface-400">
                        Keys are SHA-256 hashed at rest, rate-limited per key, expiring, and revocable.
                    </p>
                    <a href={translatePath("/security")}
                       class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors hover:text-primary/80">
                        How the policies are generated
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
                <div class="lg:col-span-7">
                    <div class="frame overflow-hidden">
                        <div class="border-b border-surface-800/80 bg-surface-900/50 px-4 py-3">
                            <span class="font-mono text-xs text-surface-400">POST /api/admin/api-keys</span>
                        </div>
                        <pre class="overflow-x-auto p-5 font-mono text-2xs leading-relaxed text-surface-300 sm:text-xs"><code set:html={keyCode}></code></pre>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ AGENT INFRASTRUCTURE ═══════════════════════ -->
    <section id="s-ai-apps" class="relative isolate overflow-hidden py-24 sm:py-32">
        <div class="pointer-events-none absolute inset-0 -z-10">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:40px_40px] opacity-10"></div>
        </div>

        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <div class="mx-auto mb-16 max-w-3xl text-center">
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-surface-500">Agent infrastructure</p>
                <h2 class="mt-4 text-display-2 text-white">
                    Everything an agent needs to operate
                </h2>
                <p class="mt-4 text-base leading-relaxed text-surface-400 sm:text-lg">
                    Vector search, scoped keys, streaming functions, realtime and scheduled tasks — the operational
                    surface agents build on, in one window instead of a wall of cards.
                </p>
            </div>

            <!-- Not `inert`, unlike the decorative mockups elsewhere on the site:
                 this console's left rail is a real control, and marking the
                 wrapper inert made every capability unclickable. -->
            <div class="mx-auto max-w-6xl">
                <AgentConsoleDemo client:visible/>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ CLIENTS ═══════════════════════ -->
    <section class="relative z-0 py-16 sm:py-20">
        <!-- max-w-6xl so the eight chips clear one row on desktop; the sentence
             keeps its own narrower measure so it does not stretch with them. -->
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
            <p class="mx-auto mb-8 max-w-3xl text-center text-sm text-surface-400">
                MCP is a standard, so the list of things that can drive your backend is not ours to control —
                it is whatever speaks it.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-2.5">
                {mcpClients.map((client) => (
                    <span class="group inline-flex items-center gap-2 rounded-lg px-3.5 py-2 text-sm text-surface-300 ring-1 ring-inset ring-surface-800 transition-colors duration-200 hover:text-white hover:ring-surface-700">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                             fill="currentColor" aria-hidden="true"
                             class="flex-none text-surface-500 transition-colors duration-200 group-hover:text-surface-300">
                            <path d={client.icon}/>
                        </svg>
                        {client.name}
                    </span>
                ))}
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ CTA ═══════════════════════ -->
    <section class="relative z-0 py-20 sm:py-28">
        <div class="mx-auto max-w-3xl px-6 text-center lg:px-8">
            <h2 class="mb-5 text-3xl sm:text-4xl text-white">
                Point an agent at it
            </h2>
            <p class="mb-8 text-lg leading-relaxed text-surface-400">
                Scaffold a project, add the config block, and hand your assistant a key that can read one collection.
                It is a faster way to find out whether any of this is true than reading the rest of this page.
            </p>
            <div class="mb-8 inline-flex items-center gap-3 rounded-xl border border-surface-800 bg-[#0c0d10] px-5 py-3.5 font-mono text-sm">
                <span class="select-none font-semibold text-primary">&gt;</span>
                <span class="select-all text-white">pnpm dlx @rebasepro/cli init</span>
            </div>
            <div class="flex flex-col justify-center gap-4 sm:flex-row">
                <a href={translatePath("/demo")}
                   class="inline-flex items-center justify-center gap-x-2 rounded-lg border border-surface-700 bg-surface-800 px-6 py-3 text-base font-semibold text-white transition-all hover:bg-surface-700">
                    Try the demo
                </a>
                <a href="/docs/ai"
                   class="btn-glow inline-flex items-center justify-center gap-x-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white transition-all hover:bg-primary-dark hover:brightness-105">
                    Read the AI docs
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>
</div>
