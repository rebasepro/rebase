---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';



import { NeatBackground } from '../../components/NeatBackground';




const mcpConfigCode = `<span class="text-surface-500">// .cursor/mcp.json</span>
{
  <span class="text-blue-400">"mcpServers"</span>: {
    <span class="text-blue-400">"rebase"</span>: {
      <span class="text-blue-400">"command"</span>: <span class="text-emerald-400">"npx"</span>,
      <span class="text-blue-400">"args"</span>: [<span class="text-emerald-400">"@rebasepro/mcp"</span>],
      <span class="text-blue-400">"env"</span>: {
        <span class="text-blue-400">"REBASE_BASE_URL"</span>: <span class="text-emerald-400">"http://localhost:3001"</span>
      }
    }
  }
}`;

const enhancementCode = `<span class="text-blue-400">import</span> { useDataEnhancementPlugin } <span class="text-blue-400">from</span>
  <span class="text-emerald-400">"@rebasepro/plugin-ai"</span>;

<span class="text-blue-400">const</span> plugin = <span class="text-amber-400">useDataEnhancementPlugin</span>({
  getConfigForPath: ({ path }) =&gt; ({
    suggestions: <span class="text-amber-400">true</span>,
    autofill: <span class="text-amber-400">true</span>,
  })
});

<span class="text-surface-500">// Drop into your Rebase app:</span>
&lt;Rebase
  plugins={[plugin]}
  ...
/&gt;`;
---

  <div class="flex flex-col isolate">
    <!-- Hero -->
 <section class="relative isolate overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
     <NeatBackground client:idle />

      <div class="px-4 mx-auto max-w-7xl text-center lg:px-12 relative z-10">
        <div class="inline-flex items-center py-1.5 px-3 mb-6 text-sm rounded-full bg-violet-500/10 text-violet-400 ring-1 ring-inset ring-violet-500/20 mx-auto">
          <span class="text-sm font-medium">MCP · AI Autofill · DataTalk</span>
        </div>
        <h1 class="mb-6 text-3xl font-semibold tracking-tight md:text-4xl lg:text-5xl text-white">
          AI & Agents
        </h1>
        <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48">
          Let AI agents read, write, and manage your data autonomously. Rebase is the bridge between your database and the agentic future.
        </p>
      </div>
    </section>

    <!-- MCP Server -->
 <section class="relative z-0 py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
          <div>
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-violet-500/10 text-violet-400 ring-1 ring-inset ring-violet-500/20">
              Model Context Protocol
            </div>
            <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">MCP Server</h2>
            <p class="text-lg text-surface-400 mb-6">The <code class="text-sm bg-surface-800 px-1.5 py-0.5 rounded">@rebasepro/mcp</code> package exposes your entire Rebase project to AI assistants like Cursor, Claude, and Windsurf via the Model Context Protocol standard.</p>
            <p class="text-surface-400 mb-6">AI agents can autonomously manage your data, run migrations, generate SDKs, and control the dev server — all through a standardized, secure interface.</p>
            <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-900 p-6 mt-6">
              <div class="text-xs font-semibold text-surface-500 mb-3 uppercase tracking-wider">Configuration</div>
              <pre class="text-sm font-mono overflow-x-auto"><code class="text-surface-300" set:html={mcpConfigCode}/></pre>
            </div>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-white mb-6">Available Tools</h3>
            <div class="space-y-4">
              <div class="p-4 rounded-xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
                <h4 class="text-white font-semibold mb-1">📝 Data Tools</h4>
                <p class="text-sm text-surface-400">List, get, create, update, and delete documents in any collection with filtering and pagination.</p>
              </div>
              <div class="p-4 rounded-xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
                <h4 class="text-white font-semibold mb-1">👤 Admin Tools</h4>
                <p class="text-sm text-surface-400">List users, create users, assign roles, delete users, and list roles — all programmatically.</p>
              </div>
              <div class="p-4 rounded-xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
                <h4 class="text-white font-semibold mb-1">🗄️ Schema & DB Tools</h4>
                <p class="text-sm text-surface-400"><code class="text-xs bg-surface-800 px-1 rounded">schema_generate</code>, <code class="text-xs bg-surface-800 px-1 rounded">db_push</code>, <code class="text-xs bg-surface-800 px-1 rounded">db_pull</code>, <code class="text-xs bg-surface-800 px-1 rounded">db_generate</code>, <code class="text-xs bg-surface-800 px-1 rounded">db_migrate</code>, <code class="text-xs bg-surface-800 px-1 rounded">generate_sdk</code></p>
              </div>
              <div class="p-4 rounded-xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
                <h4 class="text-white font-semibold mb-1">🖥️ Dev Server</h4>
                <p class="text-sm text-surface-400">Start, stop, and read logs from the dev server without leaving your AI assistant.</p>
              </div>
              <div class="p-4 rounded-xl bg-surface-900/50 ring-1 ring-inset ring-surface-800">
                <h4 class="text-white font-semibold mb-1">📁 Resources</h4>
                <p class="text-sm text-surface-400">Collection definitions and generated Drizzle schema exposed as MCP resources for context-aware AI assistance.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Neat gradient divider -->
    <div class="neat-divider relative -my-72 pointer-events-none overflow-hidden" style="z-index: -1; height: 600px;">
        <NeatBackground variant="a" client:visible/>
    </div>

    <!-- AI Data Enhancement -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="lg:order-last">
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-pink-500/10 text-pink-400 ring-1 ring-inset ring-pink-500/20">
              Schema-Aware AI
            </div>
            <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">AI Data Enhancement</h2>
            <p class="text-lg text-surface-400 mb-6">The data enhancement plugin analyzes your collection schema and uses AI to auto-fill fields, suggest descriptions, generate SEO metadata, and translate content — all from within the admin UI.</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="text-primary">✓</span> One-click autofill based on existing field values</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> Schema-aware prompts (knows your field types and constraints)</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> Inline AI completions in the rich text editor</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> Works with any OpenAI-compatible API</li>
            </ul>
          </div>
          <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-900 p-6">
            <pre class="text-sm font-mono overflow-x-auto"><code class="text-surface-300" set:html={enhancementCode}/></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- DataTalk -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center py-1 px-2.5 mb-4 text-xs font-medium rounded-full bg-cyan-500/10 text-cyan-400 ring-1 ring-inset ring-cyan-500/20">
              Natural Language → SQL
            </div>
            <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-4">DataTalk</h2>
            <p class="text-lg text-surface-400 mb-6">Ask questions about your data in plain English. DataTalk converts natural language to SQL, executes it against your Postgres database, and renders the results in charts and tables.</p>
            <ul class="space-y-3 text-surface-300">
              <li class="flex gap-3"><span class="text-primary">✓</span> Schema-aware query generation</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> Auto-generated visualizations</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> Conversation history and follow-ups</li>
              <li class="flex gap-3"><span class="text-primary">✓</span> Integrated as a Rebase admin view</li>
            </ul>
          </div>
          <div class="relative rounded-2xl overflow-hidden ring-1 ring-surface-800 bg-surface-900/50 p-8">
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="h-8 w-8 rounded-full bg-blue-500/20 flex items-center justify-center flex-shrink-0">
                  <span class="text-blue-400 text-sm">You</span>
                </div>
                <div class="bg-surface-800/50 rounded-xl px-4 py-2.5">
                  <p class="text-surface-300 text-sm">Show me the top 10 users by order count this month</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="h-8 w-8 rounded-full bg-violet-500/20 flex items-center justify-center flex-shrink-0">
                  <span class="text-violet-400 text-sm">AI</span>
                </div>
                <div class="bg-surface-800/50 rounded-xl px-4 py-2.5 flex-1">
                  <p class="text-surface-300 text-sm mb-2">Here are the top 10 users:</p>
                  <div class="bg-surface-900 rounded-lg p-3 font-mono text-xs text-surface-400">
                    <div class="text-emerald-400 mb-1">SELECT u.display_name, COUNT(o.id)</div>
                    <div>FROM users u JOIN orders o ON ...</div>
                    <div>WHERE o.created_at &gt;= ...</div>
                    <div>GROUP BY u.id ORDER BY count DESC</div>
                    <div>LIMIT 10;</div>
                  </div>
                  <div class="mt-3 flex items-end gap-1 h-20">
                    <div class="flex-1 rounded-t bg-gradient-to-t from-violet-500/30 to-violet-500/80" style="height: 100%"></div>
                    <div class="flex-1 rounded-t bg-gradient-to-t from-violet-500/30 to-violet-500/80" style="height: 85%"></div>
                    <div class="flex-1 rounded-t bg-gradient-to-t from-violet-500/30 to-violet-500/80" style="height: 75%"></div>
                    <div class="flex-1 rounded-t bg-gradient-to-t from-violet-500/30 to-violet-500/80" style="height: 60%"></div>
                    <div class="flex-1 rounded-t bg-gradient-to-t from-violet-500/30 to-violet-500/80" style="height: 53%"></div>
                    <div class="flex-1 rounded-t bg-gradient-to-t from-violet-500/30 to-violet-500/80" style="height: 45%"></div>
                    <div class="flex-1 rounded-t bg-gradient-to-t from-violet-500/30 to-violet-500/80" style="height: 38%"></div>
                    <div class="flex-1 rounded-t bg-gradient-to-t from-violet-500/30 to-violet-500/80" style="height: 33%"></div>
                    <div class="flex-1 rounded-t bg-gradient-to-t from-violet-500/30 to-violet-500/80" style="height: 25%"></div>
                    <div class="flex-1 rounded-t bg-gradient-to-t from-violet-500/30 to-violet-500/80" style="height: 18%"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Integration Grid -->
 <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Works With Your AI Stack</h2>
          <p class="mt-4 text-lg text-surface-400">Rebase integrates with the tools developers are already using.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
            <p class="text-white font-semibold mb-1">Cursor</p>
            <p class="text-sm text-surface-400">MCP integration</p>
          </div>
          <div class="p-6 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
            <p class="text-white font-semibold mb-1">Claude Desktop</p>
            <p class="text-sm text-surface-400">MCP integration</p>
          </div>
          <div class="p-6 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
            <p class="text-white font-semibold mb-1">Windsurf</p>
            <p class="text-sm text-surface-400">MCP integration</p>
          </div>
          <div class="p-6 rounded-2xl bg-surface-900/50 ring-1 ring-inset ring-surface-800 text-center">
            <p class="text-white font-semibold mb-1">OpenAI API</p>
            <p class="text-sm text-surface-400">Data enhancement</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Agent Infrastructure Feature Grid -->
 <section id="s-ai-apps" class="relative isolate py-24 sm:py-32 overflow-hidden">

        <div class="pointer-events-none absolute inset-0 -z-10">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:40px_40px] opacity-10"></div>
        </div>

        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-16 animate-on-scroll fade-in-up">
                <p class="text-xs font-semibold tracking-[0.25em] text-primary/80 uppercase">Agent infrastructure</p>
                <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-5xl">Everything an agent needs to operate</h2>
                <p class="mt-4 text-surface-400 text-base sm:text-lg leading-relaxed">
                    Vector search, scoped keys, streaming functions, realtime and scheduled tasks — the operational surface agents build on.
                </p>
            </div>

            <!-- Agent Infrastructure Feature Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-6xl mx-auto animate-on-scroll fade-in-up delay-100">

                <!-- Vector Similarity Search -->
                <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 p-6">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 border border-primary/20 flex-none ring-1 ring-primary/20 text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" class="text-primary">
                                    <circle cx="11" cy="11" r="8"/>
                                    <path d="m21 21-4.3-4.3"/>
                                    <path d="M11 8v6"/>
                                    <path d="M8 11h6"/>
                                </svg>
                            </div>
                        </div>
                        <h3 class="text-lg font-semibold text-white mb-2">Vector Similarity Search</h3>
                        <p class="text-surface-400 text-sm leading-relaxed mb-4">Native pgvector integration with
                            cosine, L2, and inner product distance. Query embeddings via REST API — no external vector
                            DB needed.</p>
                        <div class="rounded-lg bg-surface-950/80 p-3 ring-1 ring-surface-800/50">
                            <code class="text-xs font-mono text-surface-300">
                                <span class="text-surface-400">GET</span> <span
                                    class="text-emerald-400">/api/docs</span><br/>
                                <span class="text-surface-400">&nbsp;&nbsp;?vector_search=</span><span
                                    class="text-amber-400">embedding</span><br/>
                                <span class="text-surface-400">&nbsp;&nbsp;&vector=</span><span class="text-primary">[0.1,0.2,...]</span><br/>
                                <span class="text-surface-400">&nbsp;&nbsp;&vector_distance=</span><span
                                    class="text-cyan-400">cosine</span>
                            </code>
                        </div>
                    </div>
                </div>

                <!-- Service API Keys -->
                <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 p-6">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 border border-primary/20 flex-none ring-1 ring-primary/20 text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" class="text-primary">
                                    <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/>
                                    <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>
                                </svg>
                            </div>
                        </div>
                        <h3 class="text-lg font-semibold text-white mb-2">Scoped Service API Keys</h3>
                        <p class="text-surface-400 text-sm leading-relaxed mb-4">Issue keys with granular
                            per-collection, per-operation permissions. Built-in rate limiting, automatic expiry, and
                            Studio management.</p>
                        <div class="flex flex-wrap gap-1.5">
                            <span class="px-2 py-1 rounded-lg bg-surface-800/60 text-xs text-surface-300 ring-1 ring-surface-700/50">SHA-256 hashed</span>
                            <span class="px-2 py-1 rounded-lg bg-surface-800/60 text-xs text-surface-300 ring-1 ring-surface-700/50">Per-key rate limits</span>
                            <span class="px-2 py-1 rounded-lg bg-surface-800/60 text-xs text-surface-300 ring-1 ring-surface-700/50">Soft revocation</span>
                        </div>
                    </div>
                </div>

                <!-- Custom Functions & Streaming -->
                <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 p-6">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 border border-primary/20 flex-none ring-1 ring-primary/20 text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" class="text-primary">
                                    <path d="m5 8 6 6"/>
                                    <path d="m4 14 6-6 2-3"/>
                                    <path d="M2 5h12"/>
                                    <path d="M7 2h1"/>
                                    <path d="m22 22-5-10-5 10"/>
                                    <path d="M14 18h6"/>
                                </svg>
                            </div>
                        </div>
                        <h3 class="text-lg font-semibold text-white mb-2">Custom Functions & Streaming</h3>
                        <p class="text-surface-400 text-sm leading-relaxed mb-4">Define server-side endpoints with full
                            access to your typed data layer. Stream LLM responses, chain agent actions, or build
                            webhooks — all in TypeScript.</p>
                        <div class="rounded-lg bg-surface-950/80 p-3 ring-1 ring-surface-800/50">
                            <code class="text-xs font-mono text-surface-300">
                                <span class="text-blue-400">export default</span> <span
                                    class="text-amber-400">async</span> (req, res) => {"{"}
                                <br/>&nbsp;&nbsp;<span class="text-surface-400">// Full typed access to driver</span>
                                <br/>&nbsp;&nbsp;<span class="text-blue-400">const</span> docs = <span
                                    class="text-blue-400">await</span> <span class="text-amber-400">data</span>.docs.find();
                                <br/>{"}"}
                            </code>
                        </div>
                    </div>
                </div>

                <!-- MCP Server -->
                <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-gradient-to-br from-surface-900/80 to-surface-950/70 shadow-[0_10px_30px_rgba(0,0,0,0.45)] hover:border-primary/40 hover:shadow-[0_18px_44px_rgba(0,112,244,0.12)] transition-all duration-300 p-6">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300"
                         aria-hidden="true"
                         style="background: radial-gradient(300px 300px at 50% 0%, rgba(0,112,244,0.15), transparent 80%); z-index: 1;"></div>
                    <div class="relative z-10">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 border border-primary/20 flex-none ring-1 ring-primary/20 text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" class="text-primary">
                                    <rect x="2" y="6" width="20" height="12" rx="2"/>
                                    <path d="M12 12h.01"/>
                                    <path d="M17 12h.01"/>
                                    <path d="M7 12h.01"/>
                                </svg>
                            </div>
                        </div>
                        <h3 class="text-lg font-semibold text-white mb-2">MCP Server</h3>
                        <p class="text-surface-400 text-sm leading-relaxed mb-4">Expose your entire project to Cursor,
                            Claude, and Windsurf via the Model Context Protocol. Agents can CRUD data, run migrations,
                            and manage schemas.</p>
                        <div class="flex flex-wrap gap-1.5">
                            <span class="px-2 py-1 rounded-lg bg-surface-800/60 text-xs text-surface-300 ring-1 ring-surface-700/50">Data tools</span>
                            <span class="px-2 py-1 rounded-lg bg-surface-800/60 text-xs text-surface-300 ring-1 ring-surface-700/50">Schema tools</span>
                            <span class="px-2 py-1 rounded-lg bg-surface-800/60 text-xs text-surface-300 ring-1 ring-surface-700/50">Admin tools</span>
                        </div>
                    </div>
                </div>

                <!-- Real-time Subscriptions -->
