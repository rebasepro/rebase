---
const { lang, t } = Astro.props;

import { languages, defaultLang, useTranslations } from '../../i18n/ui';

import SectionBackgroundAccents from '../../components/SectionBackgroundAccents.astro';
---

<main class="manifesto">
    <!-- Hero — minimal, editorial -->
    <section class="relative isolate overflow-hidden bg-linear-to-br from-black to-surface-950 pt-24 pb-12 sm:pt-32 sm:pb-16 lg:pt-40 lg:pb-20">
      <SectionBackgroundAccents topLine={true} blob={{ position: "top", size: "lg", opacity: 40 }} />
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:60px_60px] opacity-10"></div>
      </div>

      <div class="px-4 mx-auto max-w-3xl text-center lg:px-12">
        <div class="inline-flex items-center py-1.5 px-3 mb-6 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10 mx-auto">
          <span class="text-sm font-medium">{t("manifesto.badge")}</span>
        </div>
        <h1 class="mb-6 text-4xl font-medium tracking-tight md:text-5xl lg:text-6xl text-white font-sans leading-tight">
          {t("manifesto.hero.title")}
        </h1>
        <p class="text-lg leading-8 text-surface-400 lg:text-xl">
          {t("manifesto.hero.subtitle")}
        </p>
      </div>
    </section>

    <!-- Body — long-form editorial -->
    <section class="bg-black py-16 sm:py-24">
      <article class="mx-auto max-w-3xl px-6 lg:px-8">

        <!-- The Problem -->
        <div class="mb-16">
          <h2 class="text-2xl font-medium tracking-tight text-white sm:text-3xl mb-6 border-l-2 border-primary pl-4">
            {t("manifesto.problem.title")}
          </h2>
          <div class="prose prose-lg prose-invert max-w-none space-y-5">
            <p class="text-lg text-surface-300 leading-relaxed">
              {t("manifesto.problem.p1")}
            </p>
            <p class="text-lg text-surface-300 leading-relaxed">
              {t("manifesto.problem.p2")}
            </p>
            <p class="text-lg text-surface-300 leading-relaxed">
              {t("manifesto.problem.p3")}
            </p>
          </div>
        </div>

        <!-- Where We Come From -->
        <div class="mb-16">
          <h2 class="text-2xl font-medium tracking-tight text-white sm:text-3xl mb-6 border-l-2 border-primary pl-4">
            {t("manifesto.origin.title")}
          </h2>
          <div class="prose prose-lg prose-invert max-w-none space-y-5">
            <p class="text-lg text-surface-300 leading-relaxed" set:html={t("manifesto.origin.p1")}>
            </p>
            <p class="text-lg text-surface-300 leading-relaxed">
              {t("manifesto.origin.p2")}
            </p>
            <p class="text-lg text-surface-300 leading-relaxed">
              {t("manifesto.origin.p3")}
            </p>
          </div>
        </div>

        <!-- What We Believe -->
        <div class="mb-16">
          <h2 class="text-2xl font-medium tracking-tight text-white sm:text-3xl mb-6 border-l-2 border-primary pl-4">
            {t("manifesto.beliefs.title")}
          </h2>
          <div class="space-y-6">
            <div class="border-l border-surface-800 pl-5">
              <h3 class="text-xl font-semibold text-white mb-2">{t("manifesto.beliefs.b1.title")}</h3>
              <p class="text-surface-400 leading-relaxed">{t("manifesto.beliefs.b1.desc")}</p>
            </div>
            <div class="border-l border-surface-800 pl-5">
              <h3 class="text-xl font-semibold text-white mb-2">{t("manifesto.beliefs.b2.title")}</h3>
              <p class="text-surface-400 leading-relaxed">{t("manifesto.beliefs.b2.desc")}</p>
            </div>
            <div class="border-l border-surface-800 pl-5">
              <h3 class="text-xl font-semibold text-white mb-2">{t("manifesto.beliefs.b3.title")}</h3>
              <p class="text-surface-400 leading-relaxed">{t("manifesto.beliefs.b3.desc")}</p>
            </div>
            <div class="border-l border-surface-800 pl-5">
              <h3 class="text-xl font-semibold text-white mb-2">{t("manifesto.beliefs.b4.title")}</h3>
              <p class="text-surface-400 leading-relaxed">{t("manifesto.beliefs.b4.desc")}</p>
            </div>
            <div class="border-l border-surface-800 pl-5">
              <h3 class="text-xl font-semibold text-white mb-2">{t("manifesto.beliefs.b5.title")}</h3>
              <p class="text-surface-400 leading-relaxed">{t("manifesto.beliefs.b5.desc")}</p>
            </div>
            <div class="border-l border-surface-800 pl-5">
              <h3 class="text-xl font-semibold text-white mb-2">{t("manifesto.beliefs.b6.title")}</h3>
              <p class="text-surface-400 leading-relaxed">{t("manifesto.beliefs.b6.desc")}</p>
            </div>
          </div>
        </div>

        <!-- Who Is Rebase For -->
        <div class="mb-16">
          <h2 class="text-2xl font-medium tracking-tight text-white sm:text-3xl mb-6 border-l-2 border-primary pl-4">
            {t("manifesto.audience.title")}
          </h2>
          <div class="prose prose-lg prose-invert max-w-none space-y-5">
            <p class="text-lg text-surface-300 leading-relaxed">
              {t("manifesto.audience.p1")}
            </p>
            <ul class="space-y-3 text-surface-300 list-none pl-0">
              <li class="flex gap-3 items-start"><svg class="h-4 w-4 text-primary mt-1.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg> <span>{t("manifesto.audience.l1")}</span></li>
              <li class="flex gap-3 items-start"><svg class="h-4 w-4 text-primary mt-1.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg> <span>{t("manifesto.audience.l2")}</span></li>
              <li class="flex gap-3 items-start"><svg class="h-4 w-4 text-primary mt-1.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg> <span>{t("manifesto.audience.l3")}</span></li>
              <li class="flex gap-3 items-start"><svg class="h-4 w-4 text-primary mt-1.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg> <span>{t("manifesto.audience.l4")}</span></li>
            </ul>
            <p class="text-lg text-surface-300 leading-relaxed">
              {t("manifesto.audience.p2")}
            </p>
          </div>
        </div>

        <!-- Built for Three Worlds -->
        <div class="mb-16">
          <h2 class="text-2xl font-medium tracking-tight text-white sm:text-3xl mb-6 border-l-2 border-primary pl-4">
            {t("manifesto.threeworlds.title")}
          </h2>
          <div class="prose prose-lg prose-invert max-w-none space-y-5">
            <p class="text-lg text-surface-300 leading-relaxed">
              {t("manifesto.threeworlds.p1")}
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
            <div class="text-center p-5 rounded-xl bg-surface-900/30 ring-1 ring-inset ring-surface-800/50">
              <div class="mx-auto h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center mb-3">
                <svg class="h-5 w-5 text-primary" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              </div>
              <h3 class="text-white font-semibold mb-1">{t("manifesto.threeworlds.w1.title")}</h3>
              <p class="text-surface-400 text-sm">{t("manifesto.threeworlds.w1.desc")}</p>
            </div>
            <div class="text-center p-5 rounded-xl bg-surface-900/30 ring-1 ring-inset ring-surface-800/50">
              <div class="mx-auto h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center mb-3">
                <svg class="h-5 w-5 text-primary" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m16 18 6-6-6-6" /><path d="m8 6-6 6 6 6" />
                </svg>
              </div>
              <h3 class="text-white font-semibold mb-1">{t("manifesto.threeworlds.w2.title")}</h3>
              <p class="text-surface-400 text-sm">{t("manifesto.threeworlds.w2.desc")}</p>
            </div>
            <div class="text-center p-5 rounded-xl bg-surface-900/30 ring-1 ring-inset ring-surface-800/50">
              <div class="mx-auto h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center mb-3">
                <svg class="h-5 w-5 text-primary" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 8V4H8" /><rect width="16" height="12" x="4" y="8" rx="2" /><path d="M2 14h2" /><path d="M20 14h2" /><path d="M15 13v2" /><path d="M9 13v2" />
                </svg>
              </div>
              <h3 class="text-white font-semibold mb-1">{t("manifesto.threeworlds.w3.title")}</h3>
              <p class="text-surface-400 text-sm">{t("manifesto.threeworlds.w3.desc")}</p>
            </div>
          </div>
        </div>

        <!-- The Promise -->
        <div class="mb-16">
          <h2 class="text-2xl font-medium tracking-tight text-white sm:text-3xl mb-6 border-l-2 border-primary pl-4">
            {t("manifesto.promise.title")}
          </h2>
          <div class="prose prose-lg prose-invert max-w-none space-y-5">
            <p class="text-lg text-surface-300 leading-relaxed">
              {t("manifesto.promise.p1")}
            </p>
            <p class="text-lg text-surface-300 leading-relaxed">
              {t("manifesto.promise.p2")}
            </p>
          </div>
        </div>

        <!-- Closing / Signature -->
        <div class="mt-20 pt-12 border-t border-surface-800/50">
          <p class="text-lg text-surface-300 leading-relaxed italic mb-8">
            {t("manifesto.closing")}
          </p>
          <p class="text-white font-medium">
            {t("manifesto.signature")}
          </p>
          <p class="text-surface-500 text-sm mt-1">
            {t("manifesto.signatureSubtitle")}
          </p>
        </div>

      </article>
    </section>

    <!-- CTA -->
    <section class="bg-black py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-8">{t("manifesto.cta.title")}</h2>
        <div class="flex items-center justify-center gap-x-6">
          <a href="/docs" class="inline-flex items-center gap-x-2 rounded-md bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-all duration-200 ease-in-out btn-glow">
            {t("manifesto.cta.getStarted")}
            <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a href="https://github.com/rebasepro/rebase" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold">
            {t("manifesto.cta.github")}
            <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>
</main>
