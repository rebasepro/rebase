---
import NavigationDropdown from "./NavigationDropdown.astro";
import LanguageSelect from "./LanguageSelect.astro";
import GitHubStarButton from "./GitHubStarButton.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/ui";
import { DEMO_URL } from "../utils/links";
import { CLOUD_FLAGS } from "../data/cloud-offer";

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// While Rebase Cloud is in private beta, route the header's primary action to
// the instant live demo rather than a waitlist; flip automatically once
// self-serve signup opens.
const headerCtaHref = CLOUD_FLAGS.selfServe ? translatePath("/cloud") : DEMO_URL;
const headerCtaExternal = !CLOUD_FLAGS.selfServe;
const headerCtaLabel = CLOUD_FLAGS.selfServe ? t("nav.startCloud") : t("nav.tryDemo");

// SVG path data for nav icons (Lucide-style, 24×24 viewBox)
const iconSvgPaths: Record<string, string> = {
    "layers": "M12 2 2 7l10 5 10-5-10-5ZM2 17l10 5 10-5M2 12l10 5 10-5",
    "layout-dashboard": "M3 3h7v9H3zM14 3h7v5h-7zM14 12h7v9h-7zM3 16h7v5H3z",
    "server": "M2 9a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9ZM2 17a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-2ZM6 10h.01M6 18h.01",
    "bot": "M12 8V4H8M8 2h8M6 12h.01M18 12h.01M2 16h20M4 12a8 4 0 0 1 16 0v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-4Z",
    "code": "m16 18 6-6-6-6M8 6l-6 6 6 6",
    "terminal": "m4 17 6-6-6-6M12 19h8",
    "square-terminal": "M7 11l2-2-2-2M11 13h4M3 3h18a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z",
    "shield-check": "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10ZM9 12l2 2 4-4",
    "rocket": "M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09ZM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2Z",
    "git-compare-arrows": "M9 9H5v4M15 15h4v-4M5 9l4.5 4.5a7 7 0 0 0 5 2.07H19M19 15l-4.5-4.5a7 7 0 0 0-5-2.07H5",
    "briefcase": "M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16M2 10a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8Z",
    "edit-note": "M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z",
    "globe": "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z",
};

// ── Navigation ─────────────────────────────────────────────────────────────
// The nav itself has to teach the product: Rebase is a backend, and the admin
// panel comes with it, one layer up. So each menu is three labelled columns —
// backend, panel, then where to go next — not a list of overlapping links.
// Three columns rather than two keeps the panel short enough to read at a
// glance; the overview/docs links that used to sit in a full-width footer row
// are the third column now. See website/SITE-STORY.md.
const dropdownNavLinks = [
    {
        href: translatePath("/product"),
        label: t("nav.product"),
        columns: [
            {
                heading: t("nav.col.backend"),
                items: [
                    {
                        href: translatePath("/backend"),
                        label: t("nav.backend"),
                        description: t("nav.backend.desc"),
                        icon: "server"
                    },
                    {
                        href: translatePath("/security"),
                        label: t("nav.security"),
                        description: t("nav.security.desc"),
                        icon: "shield-check"
                    },
                    {
                        href: translatePath("/ai"),
                        label: t("nav.ai"),
                        description: t("nav.ai.desc"),
                        icon: "bot"
                    },
                ]
            },
            {
                heading: t("nav.col.admin"),
                items: [
                    {
                        href: translatePath("/studio"),
                        label: t("nav.studio"),
                        description: t("nav.studio.desc"),
                        icon: "square-terminal"
                    },
                    {
                        href: translatePath("/cms"),
                        label: t("nav.cms"),
                        description: t("nav.cms.desc"),
                        icon: "layout-dashboard"
                    },
                ]
            },
            {
                heading: t("nav.col.explore"),
                items: [
                    {
                        href: translatePath("/cloud"),
                        label: t("nav.cloud"),
                        description: t("nav.cloud.desc"),
                        icon: "rocket"
                    },
                    {
                        href: translatePath("/product"),
                        label: t("nav.overview"),
                        description: t("nav.overview.desc"),
                        icon: "layers"
                    },
                    {
                        href: translatePath("/compare"),
                        label: t("nav.compare"),
                        description: t("nav.compare.desc"),
                        icon: "git-compare-arrows"
                    },
                ]
            },
        ],
    },
    {
        href: translatePath("/developers"),
        label: t("nav.developers"),
        columns: [
            {
                heading: t("nav.col.build"),
                items: [
                    {
                        href: translatePath("/developers"),
                        label: t("nav.devOverview"),
                        description: t("nav.devOverview.desc"),
                        icon: "code"
                    },
                    {
                        href: translatePath("/sdk"),
                        label: t("nav.sdk"),
                        description: t("nav.sdk.desc"),
                        icon: "terminal"
                    },
                ]
            },
            {
                heading: t("nav.col.ship"),
                items: [
                    {
                        href: translatePath("/cli"),
                        label: t("nav.cli"),
                        description: t("nav.cli.desc"),
                        icon: "square-terminal"
                    },
                    {
                        href: "/docs/deployment/self-hosting",
                        label: t("nav.selfHost"),
                        description: t("nav.selfHost.desc"),
                        icon: "rocket"
                    },
                    {
                        href: translatePath("/europe"),
                        label: t("nav.europe"),
                        description: t("nav.europe.desc"),
                        icon: "globe"
                    },
                ]
            },
            {
                heading: t("nav.col.resources"),
                items: [
                    {
                        href: "/docs",
                        label: t("nav.docs"),
                        description: t("nav.docs.desc"),
                        icon: "briefcase"
                    },
                ]
            },
        ],
    },


    { href: translatePath("/cloud"), label: t("nav.cloudShort") },
    { href: translatePath("/pricing"), label: t("nav.pricing") },
    { href: translatePath("/docs"), label: t("nav.docs") },
];

// Flat navigation links (flat-nav variant)
const flatNavLinks = [
    { href: translatePath("/product"), label: t("nav.product") },
    { href: translatePath("/cloud"), label: t("nav.cloudShort") },
    { href: translatePath("/developers"), label: t("nav.developers") },
    { href: translatePath("/pricing"), label: t("nav.pricing") },

    { href: translatePath("/docs"), label: t("nav.docs") }
];
---
<header class="site-header sticky top-0 z-20">
    <nav class="mx-auto flex min-h-(--header-h) max-w-6xl items-center justify-between py-2 px-4 lg:px-8" aria-label="Global">
        <div class="flex items-center">
            <a id="header-logo-link" href={translatePath("/")} class="flex items-center -m-1.5 p-1.5 relative z-50 mr-6" transition:name="site-logo">
                <!-- Intrinsic size is declared so the header reserves the box before
                     the SVG lands; without it the nav shifts on first paint. Deliberately
                     NOT lazy — this is above the fold on every route, and deferring it
                     would trade a layout shift for a slower first render. -->
                <img src="/img/rebase_logo.svg" width="32" height="32" fetchpriority="high"
                     class="h-8 w-8 mr-4" alt="Rebase Logo" transition:name="logo-image"/>
                <span class="self-center text-lg font-semibold whitespace-nowrap text-tone-max"
                      transition:name="logo-text">Rebase</span>
            </a>

            <!-- ═══ CONTROL: Dropdown mega-nav ═══ -->
            <div class="hidden lg:flex items-center gap-2 text-sm font-semibold" id="nav-desktop-control">
                {dropdownNavLinks.map(link => (
                    link.columns ? (
                            <NavigationDropdown title={link.label} href={link.href}>
                                <div class="grid grid-cols-3 gap-x-10 gap-y-3">
                                    {link.columns.map(column => (
                                            <div class="flex flex-col gap-1">
                                                <p class="px-3 pb-2 text-2xs font-semibold uppercase tracking-[0.18em] text-tone-500">{column.heading}</p>
                                                {column.items.map(subLink => (
                                                        <a href={subLink.href}
                                                           class="flex items-start gap-3 px-3 py-2.5 rounded-lg hover:bg-tone-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/60">
                                                            <svg class="w-6 h-6 text-primary-light shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d={iconSvgPaths[subLink.icon] || ""} />
                                                            </svg>
                                                            <div>
                                                                <p class="font-semibold text-tone-max">{subLink.label}</p>
                                                                <p class="text-tone-400 text-sm leading-snug">{subLink.description}</p>
                                                            </div>
                                                        </a>
                                                ))}
                                            </div>
                                    ))}
                                </div>
                            </NavigationDropdown>
                    ) : (
                            <a
                                    href={link.href}
                                    class={`p-3 transition-colors hover:text-primary-light ${currentPath === link.href ? "text-primary-light" : "text-tone-300"}`}
                                    aria-current={currentPath === link.href ? "page" : undefined}
                            >
                                {link.label}
                            </a>
                    )
                ))}
            </div>

            <!-- ═══ FLAT-NAV: Simple flat links ═══ -->
            <div class="hidden items-center gap-2 text-sm font-semibold" id="nav-desktop-flat">
                {flatNavLinks.map(link => (
                    <a
                        href={link.href}
                        class={`p-3 transition-colors hover:text-primary-light ${currentPath === link.href ? "text-primary-light" : "text-tone-300"}`}
                                    aria-current={currentPath === link.href ? "page" : undefined}
                    >
                        {link.label}
                    </a>
                ))}
            </div>
        </div>
        <div class="flex flex-1 justify-end items-center gap-4">
            <LanguageSelect iconOnly={true} />
            <!-- Theme switch. The label names the mode a click goes TO; both
                 strings ship and Layout's boot script picks one, so the label
                 is right before any script on this component runs. -->
            <button
                    type="button"
                    class="theme-toggle relative w-9 h-9 inline-flex items-center justify-center rounded-md text-tone-300 hover:text-tone-max hover:bg-tone-max/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 transition-colors"
                    data-label-light={t("nav.theme.toLight")}
                    data-label-dark={t("nav.theme.toDark")}
                    aria-label={t("nav.theme.toLight")}
                    title={t("nav.theme.toLight")}
                    data-track
                    id="header-theme-toggle"
            >
                <!-- Sun: shown in dark mode (the click lights the page). -->
                <svg class="theme-icon-sun w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                </svg>
                <!-- Moon: shown in light mode. -->
                <svg class="theme-icon-moon w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                </svg>
            </button>
            <GitHubStarButton class="hidden sm:inline-flex" />
            <a
                    href={headerCtaHref}
                    target={headerCtaExternal ? "_blank" : undefined}
                    rel={headerCtaExternal ? "noopener noreferrer" : undefined}
                    class="hidden sm:inline-flex items-center justify-center gap-x-2 rounded-lg bg-primary border border-transparent px-4 py-0 min-h-(--control-medium) text-sm font-semibold text-white shadow-sm hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-all duration-200 ease-in-out btn-glow"
                    transition:name="start-building-button"
                    data-track
                    id="header-start-building-desktop"
            >
                {headerCtaExternal && <span class="dot text-emerald-300" aria-hidden="true"></span>}
                {headerCtaLabel}
                <svg
                  class="lucide lucide-arrow-right"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
            </a>
            <!-- Mobile menu button -->
            <button
                    type="button"
                    class="lg:hidden relative z-50 inline-flex items-center justify-center p-2 rounded-md text-tone-300 hover:text-tone-max hover:bg-tone-max/10 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-tone-max transition-colors"
                    aria-controls="mobile-menu"
                    aria-expanded="false"
                    id="mobile-menu-button"
                    data-track
            >
                <span class="sr-only">Open main menu</span>
                <!-- Icon when menu is closed -->
                <svg class="block h-6 w-6" id="menu-icon-closed" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
                </svg>
                <!-- Icon when menu is open -->
                <svg class="hidden h-6 w-6" id="menu-icon-open" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
    </nav>

    <!-- ═══ Mobile menu: CONTROL (dropdown sub-menus) ═══ -->
    <div class="lg:hidden hidden fixed inset-0 z-50 overflow-y-auto h-screen" id="mobile-menu">
        <div class="flex flex-col items-center justify-center min-h-screen px-6 py-20 bg-surface-frame/95 backdrop-blur-lg">
            <nav class="flex flex-col items-center space-y-8 w-full max-w-md">
                {dropdownNavLinks.map((link, index) => (
                    link.columns ? (
                            <div class="w-full text-center">
                                <button
                                        type="button"
                                        id={`mobile-menu-toggle-${index}`}
                                        class="flex items-center justify-center text-2xl font-semibold transition-colors w-full text-center py-3 rounded-lg text-tone-300 hover:bg-tone-max/10 hover:text-tone-max"
                                        aria-expanded="false"
                                        aria-controls={`mobile-submenu-${index}`}
                                >
                                    {link.label}
                                    <svg class="w-5 h-5 ml-2 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/>
                                    </svg>
                                </button>
                                <div class="hidden flex-col items-center space-y-4 mt-4"
                                     id={`mobile-submenu-${index}`}>
                                    {link.columns.flatMap(c => c.items).map(subLink => (
                                            <a
                                                    href={subLink.href}
                                                    class={`block text-xl font-medium transition-colors w-full text-center py-2 rounded-lg ${
                                                        currentPath === subLink.href
                                                            ? "bg-primary/20 text-primary-light"
                                                            : "text-tone-400 hover:bg-tone-max/10 hover:text-tone-max"
                                                    }`}
                                            >
                                                {subLink.label}
                                            </a>
                                    ))}
                                </div>
                            </div>
                    ) : (
                            <a
                                    href={link.href}
                                    class={`block text-2xl font-semibold transition-colors w-full text-center py-3 rounded-lg ${
                                        currentPath === link.href
                                            ? "bg-primary/20 text-primary-light"
                                            : "text-tone-300 hover:bg-tone-max/10 hover:text-tone-max"
                                    }`}
                            >
                                {link.label}
                            </a>
                    )
                ))}
                <a
                        href={headerCtaHref}
                        target={headerCtaExternal ? "_blank" : undefined}
                        rel={headerCtaExternal ? "noopener noreferrer" : undefined}
                        class="mt-8 w-full inline-flex items-center justify-center gap-x-2 rounded-lg bg-primary px-6 py-4 text-xl font-semibold text-white shadow-lg hover:bg-primary-dark transition-all duration-200 ease-in-out btn-glow"
                        data-track
                        id="header-start-building-mobile-control"
                >
                    {headerCtaExternal && <span class="dot text-emerald-300" aria-hidden="true"></span>}
                    {headerCtaLabel}
                    <svg
                      class="lucide lucide-arrow-right"
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
                <div class="mt-4 w-full flex justify-center">
                    <LanguageSelect />
                </div>
            </nav>
        </div>
    </div>

    <!-- ═══ Mobile menu: FLAT-NAV (simple list) ═══ -->
    <div class="lg:hidden hidden fixed inset-0 z-50 overflow-y-auto h-screen" id="mobile-menu-flat">
        <div class="flex flex-col items-center justify-center min-h-screen px-6 py-20 bg-surface-frame/95 backdrop-blur-lg">
            <nav class="flex flex-col items-center space-y-8 w-full max-w-md">
                <div class="w-full flex flex-col items-center space-y-8">
                    {flatNavLinks.map(link => (
                        <a
                            href={link.href}
                            class={`block text-2xl font-semibold transition-colors w-full text-center py-3 rounded-lg ${
                                currentPath === link.href
                                    ? "bg-primary/20 text-primary-light"
                                    : "text-tone-300 hover:bg-tone-max/10 hover:text-tone-max"
                            }`}
                        >
                            {link.label}
                        </a>
                    ))}
                </div>
                <a
                        href={headerCtaHref}
                        target={headerCtaExternal ? "_blank" : undefined}
                        rel={headerCtaExternal ? "noopener noreferrer" : undefined}
                        class="mt-8 w-full inline-flex items-center justify-center gap-x-2 rounded-lg bg-primary px-6 py-4 text-xl font-semibold text-white shadow-lg hover:bg-primary-dark transition-all duration-200 ease-in-out btn-glow"
                        data-track
                        id="header-start-building-mobile-flat"
                >
                    {headerCtaExternal && <span class="dot text-emerald-300" aria-hidden="true"></span>}
                    {headerCtaLabel}
                    <svg
                      class="lucide lucide-arrow-right"
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
                <div class="mt-4 w-full flex justify-center">
                    <LanguageSelect />
                </div>
            </nav>
        </div>
    </div>
</header>

<style is:global>
    /* ── The bar at the top of the page ──
       At the very top of a page the header is a bar over nothing: the hero owns
       that band, and on the home page its Neat canvas runs up behind the nav, so
       a tinted plate there cuts a horizontal seam across a continuous piece of
       art. Once the page has moved, the header IS over content and needs to
       separate itself from it — that is what the tint and the blur are for.

       The blur is kept at 0 rather than removed in the top state on purpose.
       `backdrop-filter` makes the header a containing block for its own
       fixed-position descendants (the mobile menu), so toggling the property on
       and off would move the menu's containing block with the scroll position.
       A zero-radius blur is invisible and keeps that constant — and, unlike
       `none`, it interpolates, so the transition runs on both properties. */
    .site-header {
        background-color: transparent;
        -webkit-backdrop-filter: blur(0);
        backdrop-filter: blur(0);
        transition: background-color 200ms ease, backdrop-filter 200ms ease, -webkit-backdrop-filter 200ms ease;
    }

    /* 40% and 8px let scrolled headings read through the bar (the 2026-09-23
       audit caught section titles ghosting behind the nav); 78% and 14px keep
       the art visible as colour without letting type through. */
    html[data-scrolled] .site-header {
        background-color: color-mix(in oklab, var(--surface-frame) 78%, transparent);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
    }

    /* ── The bar over a light-ink slab ──
       The scrolled tint above is 40% of a near-black frame, which is a wash
       tuned for the dark grounds it spends 95% of the page over. Over
       `.ground-close` — the coral ask, the one bright slab on the site — that
       same 40% blends INTO the coral and paints a dark maroon smudge across
       the top of the screen the whole page exists to reach.

       The bar goes opaque here rather than light: its own ink (white links,
       the blue CTA) is tuned for a dark bar, and inverting the wash would take
       the whole nav vocabulary with it. Opaque reads as a deliberate bar laid
       on the colour, which is the same gesture `ground-chroma` already makes
       with `--ground-lift` for frames on a slab. */
    html[data-scrolled][data-over-bright] .site-header {
        background-color: color-mix(in oklab, var(--surface-frame) 94%, transparent);
    }

    /* ── The bar while a menu is open ──
       The mega-menu panel (NavigationDropdown.astro) is a 95% surface-950 plate
       hung from the bar's bottom edge. At the top of a page the bar above it was
       still transparent, so the open menu read as a black slab with a strip of
       hero art running over its head — and the panel's own tint let the hero
       type bleed through around it. While any panel is open the bar takes the
       panel's exact surface and blur, so the two paint as one plate, and this
       state wins over the lighter scrolled tint above by source order. */
    html[data-menu-open] .site-header {
        background-color: color-mix(in oklab, var(--tone-950) 95%, transparent);
        -webkit-backdrop-filter: blur(24px);
        backdrop-filter: blur(24px);
    }

    @media (prefers-reduced-motion: reduce) {
        .site-header { transition: none; }
    }

    /* ── Navigation-structure AB test ──
       Default: control (dropdown mega-nav) is shown; flat-nav is hidden.
       When the AB engine assigns "flat-nav", the html data attribute flips them.
    */

    /* Default state: control visible on lg+, flat hidden */
    #nav-desktop-control { /* Already has: hidden lg:flex */ }
    #nav-desktop-flat    { display: none !important; }

    /* Flat-nav variant: hide control, show flat */
    html[data-ab-navigation-structure="flat-nav"] #nav-desktop-control { display: none !important; }
    html[data-ab-navigation-structure="flat-nav"] #nav-desktop-flat    { display: none; }
    @media (min-width: 1024px) {
        html[data-ab-navigation-structure="flat-nav"] #nav-desktop-flat { display: flex !important; }
    }
</style>

<script is:inline>
    // Whether the header shows its plate is a property of the *page*, not of this
    // element: with view transitions the header node is replaced on every
    // navigation, and a listener bound to it would either die with it or leak.
    // The attribute lives on <html>, the listener binds once per document, and
    // both survive a swap.
    (function watchScrollState() {
        if (window.__rebaseHeaderScrollBound) return;
        window.__rebaseHeaderScrollBound = true;

        var root = document.documentElement;
        var ticking = false;

        function apply() {
            ticking = false;
            // A few pixels of slack: iOS rubber-banding reports small positive
            // offsets at rest, and toggling on those flickers the bar.
            root.toggleAttribute('data-scrolled', window.scrollY > 8);

            // Is the bar currently over a light-ink slab? Rect maths against
            // the handful of `.ground-close` sections, inside the rAF the
            // scroll handler already pays for — no observer, no second
            // listener. `bar` is the bar's own height rather than a constant
            // so the mobile and desktop bars both measure themselves.
            var bar = document.querySelector('.site-header');
            bar = bar ? bar.offsetHeight : 0;
            var bright = false;
            var slabs = document.querySelectorAll('.ground-close');
            for (var i = 0; i < slabs.length; i++) {
                var r = slabs[i].getBoundingClientRect();
                if (r.top <= bar && r.bottom > 0) { bright = true; break; }
            }
            root.toggleAttribute('data-over-bright', bright);
        }

        window.addEventListener('scroll', function () {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(apply);
        }, { passive: true });

        // Scroll restoration lands the reader mid-page *after* this script has
        // run, and the restore does not always fire a scroll event — so a reload
        // deep in the page left the bar transparent over content until the next
        // wheel tick. Recompute at every point the position can have changed
        // underneath us: first paint, after restoration, and after a view
        // transition swaps the page.
        document.addEventListener('astro:after-swap', apply);
        document.addEventListener('astro:page-load', apply);
        window.addEventListener('load', apply);
        apply();
    })();

    function setupHeader() {
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        if (!mobileMenuButton || mobileMenuButton.dataset.initialized) {
            return;
        }
        mobileMenuButton.dataset.initialized = 'true';

        // Determine which mobile menu to use based on AB variant
        var variant = document.documentElement.getAttribute('data-ab-navigation-structure') || 'control';
        var mobileMenuId = variant === 'flat-nav' ? 'mobile-menu-flat' : 'mobile-menu';
        var mobileMenu = document.getElementById(mobileMenuId);

        const menuIconClosed = document.getElementById('menu-icon-closed');
        const menuIconOpen = document.getElementById('menu-icon-open');

        mobileMenuButton.addEventListener('click', function() {
            var isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
                // Close menu
                mobileMenu.classList.add('hidden');
                menuIconClosed.classList.remove('hidden');
                menuIconOpen.classList.add('hidden');
                document.body.style.overflow = '';
                mobileMenuButton.setAttribute('aria-expanded', 'false');
            } else {
                // Open menu
                mobileMenu.classList.remove('hidden');
                menuIconClosed.classList.add('hidden');
                menuIconOpen.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                mobileMenuButton.setAttribute('aria-expanded', 'true');
            }
        });

        // Mobile submenu toggles (control variant with dropdowns)
        var mobileMenuToggles = document.querySelectorAll('[id^="mobile-menu-toggle-"]');
        mobileMenuToggles.forEach(function(toggle) {
            toggle.addEventListener('click', function() {
                var submenuId = toggle.getAttribute('aria-controls');
                var submenu = document.getElementById(submenuId);
                var isExpanded = toggle.getAttribute('aria-expanded') === 'true';

                toggle.setAttribute('aria-expanded', String(!isExpanded));
                submenu.classList.toggle('hidden');
                submenu.classList.toggle('flex');
                var svg = toggle.querySelector('svg');
                if (svg) svg.classList.toggle('rotate-180');
            });
        });

        // Track all header link clicks
        function trackHeaderLinkClick(link, linkType, isMobile) {
            if (isMobile === undefined) isMobile = false;
            if (!link.dataset.trackingAdded) {
                link.dataset.trackingAdded = 'true';
                link.addEventListener('click', function(e) {
                    var href = link.getAttribute('href');
                    var linkText = (link.textContent || '').trim();
                    // Send analytics event
                    if (typeof window.gtag === 'function') {
                        var eventName = 'header_link_click';
                        window.gtag('event', eventName, {
                            event_category: 'header_navigation',
                            event_label: href,
                            link_type: linkType,
                            link_text: linkText,
                            link_url: href,
                            is_mobile: isMobile,
                            page_path: window.location.pathname,
                            // Which nav a click came from is the whole question the
                            // navigation-structure experiment asks, and this is the only
                            // event that records nav clicks. Without the variant on it,
                            // the two arms are indistinguishable in GA4 and the test
                            // reports nothing about the thing it varies.
                            variant_id: document.documentElement.getAttribute('data-ab-navigation-structure') || 'unassigned'
                        });
                    }

                    // Log to console for debugging
                    console.log('Header link clicked: ' + linkText + ' (' + href + ') - ' + linkType + (isMobile ? ' [mobile]' : ''));
                });
            }
        }

        // Track desktop navigation links
        var desktopLinks = document.querySelectorAll('header nav > div.hidden.lg\\:flex a');
        desktopLinks.forEach(function(link) { trackHeaderLinkClick(link, 'desktop_nav', false); });

        // Track desktop CTA button
        var desktopCTA = document.getElementById('header-start-building-desktop');
        if (desktopCTA) trackHeaderLinkClick(desktopCTA, 'desktop_cta', false);

        // Track logo link
        var logoLink = document.getElementById('header-logo-link');
        if (logoLink) trackHeaderLinkClick(logoLink, 'logo', false);

        // Track mobile menu links (both menus)
        var mobileLinks = document.querySelectorAll('#mobile-menu a, #mobile-menu-flat a');
        mobileLinks.forEach(function(link) { trackHeaderLinkClick(link, 'mobile_nav', true); });
    }

    document.addEventListener('astro:page-load', setupHeader);
</script>
