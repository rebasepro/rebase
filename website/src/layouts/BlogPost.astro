---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getAuthor } from '../utils/authors';
import HeroBackdrop from '../components/HeroBackdrop.astro';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string };

const { title, description, pubDate, updatedDate, heroImage, authors, image, slug } = Astro.props;
const author = authors ? getAuthor(authors) : null;

// The social card is a *file*, because a crawler renders no WebGL and reads no
// HTML — `scripts/generate_blog_images.mjs` writes it. The hero on this page is
// the live field instead, seated off this post's own pathname.
// `heroImage` still wins when a post ships a real picture.
const generatedCard = slug ? `/img/blog/og/${slug}.png` : null;

// Generate breadcrumbs for blog posts
const breadcrumbs = [
	{ name: "Home", url: "https://rebase.pro" },
	{ name: "Blog", url: "https://rebase.pro/blog" },
	{ name: title, url: `https://rebase.pro${Astro.url.pathname}` }
];

// Resolve the OG image: prefer the string `image` field (social-sized),
// fall back to the processed heroImage src.
const ogImageUrl = image
	? `https://rebase.pro${image}`
	: heroImage
		? `https://rebase.pro${heroImage.src}`
		: generatedCard
			// The per-post card: the same gradient as the hero, with the title
			// burned in. Before this existed every post fell through to the one
			// section card below, so seven different links previewed as the same
			// picture with the same words — the one place a reader decides
			// whether to click, saying nothing about what they would be clicking.
			? `https://rebase.pro${generatedCard}`
			: "https://rebase.pro/img/og/blog.png";

// BlogPosting structured data for rich snippets
const articleSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": title,
	"description": description,
	"datePublished": pubDate?.toISOString(),
	...(updatedDate && { "dateModified": updatedDate.toISOString() }),
	...(ogImageUrl && { "image": ogImageUrl }),
	"url": `https://rebase.pro${Astro.url.pathname}`,
	"author": author ? {
		"@type": "Person",
		"name": author.name,
		...(author.image_url && { "image": author.image_url }),
		...(author.url && { "url": author.url })
	} : { "@type": "Organization", "name": "Rebase" },
	"publisher": {
		"@type": "Organization",
		"name": "Rebase",
		"logo": {
			"@type": "ImageObject",
			"url": "https://rebase.pro/img/logo_small.png"
		}
	},
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": `https://rebase.pro${Astro.url.pathname}`
	}
};
---

<Layout
	title={`${title} — Rebase`}
	description={description}
	breadcrumbs={breadcrumbs}
	ogImage={ogImageUrl}
	ogType="article"
>
	<Fragment slot="head">
		<meta property="article:published_time" content={pubDate?.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		{author && <meta property="article:author" content={author.name} />}
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
	</Fragment>

	<div class="drafted-page flex flex-col isolate">
		<!-- The hero every page opens with: the shared field (persisted, so it
		     flows here from /blog and lands on this post's seat — the light its
		     card shows) under the drafting grid, the date as the eyebrow. -->
		<section class="relative isolate overflow-hidden hero-under-nav pb-16 sm:pb-24">
			<HeroBackdrop />
			<div class="relative z-10 mx-auto max-w-6xl px-6 lg:px-8">
				<p class="hero-eyebrow">
					<FormattedDate date={pubDate} />
					{updatedDate && <> · Updated <FormattedDate date={updatedDate} /></>}
				</p>
				<h1 class="mt-4 max-w-4xl text-4xl md:text-5xl lg:text-6xl text-white">{title}</h1>
				{description && <p class="mt-5 max-w-2xl text-lg leading-8 text-surface-400">{description}</p>}

				{author && (
					<div class="mt-8 flex items-center gap-4">
						<img
							src={author.image_url}
							alt={author.name}
							class="w-11 h-11 rounded-full"
						/>
						<div>
							<div class="text-white font-semibold">{author.name}</div>
							<div class="font-mono text-2xs uppercase tracking-[0.2em] text-surface-500">{author.title}</div>
						</div>
					</div>
				)}
			</div>
		</section>

		<section class="relative z-0 pb-24">
		<article class="max-w-6xl mx-auto px-4 lg:px-8">
			{heroImage && (
				<div class="mb-12 max-w-4xl rounded-2xl overflow-hidden">
					<Image
						width={1020}
						height={510}
						src={heroImage}
						alt={title}
						class="w-full h-auto"
					/>
				</div>
			)}

		<div class="prose prose-invert prose-lg max-w-3xl [&_p]:my-3 [&_img]:my-8 [&_h1]:mt-8 [&_h1]:mb-4 [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:mt-6 [&_h3]:mb-2 [&_h4]:mt-4 [&_h4]:mb-2 [&_ul]:my-4 [&_ol]:my-4 [&_li]:my-1 [&_blockquote]:my-4 [&_pre]:my-4 [&_hr]:my-6 [&_table]:my-4 [&_table]:block [&_table]:max-w-full [&_table]:overflow-x-auto [&_figure]:my-4">
			<slot />
		</div>
		</article>
		</section>
	</div>
</Layout>
