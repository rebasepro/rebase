---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getAuthor } from '../utils/authors';
import { NeatBackground } from '../components/NeatBackground';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string };

const { title, description, pubDate, updatedDate, heroImage, authors, image, slug } = Astro.props;
const author = authors ? getAuthor(authors) : null;

// The social card is a *file*, because a crawler renders no WebGL and reads no
// HTML — `scripts/generate_blog_images.mjs` writes it. The hero on this page is
// the live gradient instead, seated off this post's own pathname.
// `heroImage` still wins when a post ships a real picture.
const generatedCard = slug ? `/img/blog/og/${slug}.png` : null;

// Generate breadcrumbs for blog posts
const breadcrumbs = [
	{ name: "Home", url: "https://rebase.pro" },
	{ name: "Blog", url: "https://rebase.pro/blog" },
	{ name: title, url: `https://rebase.pro${Astro.url.pathname}` }
];

// Resolve the OG image: prefer the string `image` field (social-sized),
// fall back to the processed heroImage src.
const ogImageUrl = image
	? `https://rebase.pro${image}`
	: heroImage
		? `https://rebase.pro${heroImage.src}`
		: generatedCard
			// The per-post card: the same gradient as the hero, with the title
			// burned in. Before this existed every post fell through to the one
			// section card below, so seven different links previewed as the same
			// picture with the same words — the one place a reader decides
			// whether to click, saying nothing about what they would be clicking.
			? `https://rebase.pro${generatedCard}`
			: "https://rebase.pro/img/og/blog.png";

// BlogPosting structured data for rich snippets
const articleSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": title,
	"description": description,
	"datePublished": pubDate?.toISOString(),
	...(updatedDate && { "dateModified": updatedDate.toISOString() }),
	...(ogImageUrl && { "image": ogImageUrl }),
	"url": `https://rebase.pro${Astro.url.pathname}`,
	"author": author ? {
		"@type": "Person",
		"name": author.name,
		...(author.image_url && { "image": author.image_url }),
		...(author.url && { "url": author.url })
	} : { "@type": "Organization", "name": "Rebase" },
	"publisher": {
		"@type": "Organization",
		"name": "Rebase",
		"logo": {
			"@type": "ImageObject",
			"url": "https://rebase.pro/img/logo_small.png"
		}
	},
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": `https://rebase.pro${Astro.url.pathname}`
	}
};
---

<Layout
	title={`${title} — Rebase`}
	description={description}
	breadcrumbs={breadcrumbs}
	ogImage={ogImageUrl}
	ogType="article"
>
	<Fragment slot="head">
		<meta property="article:published_time" content={pubDate?.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		{author && <meta property="article:author" content={author.name} />}
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
	</Fragment>

	<main class="min-h-screen">
		<!-- The hero is a full-bleed band, the same composition every other page on
		     the site opens with: the gradient spans the viewport and the title sits
		     on it, rather than a picture boxed inside the article column. -->
		<section class="relative isolate overflow-hidden hero-under-nav flex min-h-[26rem] items-end pb-14 sm:min-h-[32rem] sm:pb-20">
			{/* The canvas has to be taken out of flow. `variant="card"` renders a
			    bare canvas sized to its parent, so left in the document it becomes
			    a full-height block that pushes the title below the fold instead of
			    sitting behind it.

			    `poseKey` is the slug, not the pathname, so this lands on exactly
			    the seat this post's card uses on /blog — the same picture in both
			    places. Leaving it off would hash "/blog/<slug>" here and "<slug>"
			    there. */}
			<div class="absolute inset-0">
				<NeatBackground client:idle variant="card" poseKey={slug} />
			</div>
			{/* The pose is a function of the slug, so where the bright part of the
			    ribbon lands is not knowable when this is written. The scrim makes the
			    title legible against any frame the orbit produces. */}
			<div class="absolute inset-0 bg-gradient-to-t from-surface-950 via-surface-950/75 to-surface-950/30"></div>

			<div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
				<div class="text-sm text-surface-300 mb-4">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<div class="italic mt-2">
							Last updated on <FormattedDate date={updatedDate} />
						</div>
					)}
				</div>
				<h1 class="text-4xl md:text-5xl lg:text-6xl text-white mb-6 [text-shadow:0_2px_30px_rgba(0,0,0,.55)]">{title}</h1>

				{author && (
					<div class="flex items-center justify-center gap-4">
						<img
							src={author.image_url}
							alt={author.name}
							class="w-12 h-12 rounded-full"
						/>
						<div class="text-left">
							<div class="text-white font-semibold">{author.name}</div>
							<div class="text-sm text-surface-300">{author.title}</div>
						</div>
					</div>
				)}
			</div>
		</section>

		<article class="max-w-4xl mx-auto px-6 pb-24">
			{heroImage && (
				<div class="mb-12 rounded-2xl overflow-hidden">
					<Image
						width={1020}
						height={510}
						src={heroImage}
						alt={title}
						class="w-full h-auto"
					/>
				</div>
			)}

		<div class="prose prose-invert prose-lg max-w-3xl mx-auto [&_p]:my-3 [&_img]:my-8 [&_h1]:mt-8 [&_h1]:mb-4 [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:mt-6 [&_h3]:mb-2 [&_h4]:mt-4 [&_h4]:mb-2 [&_ul]:my-4 [&_ol]:my-4 [&_li]:my-1 [&_blockquote]:my-4 [&_pre]:my-4 [&_hr]:my-6 [&_table]:my-4 [&_table]:block [&_table]:max-w-full [&_table]:overflow-x-auto [&_figure]:my-4">
			<slot />
		</div>
		</article>
	</main>
</Layout>
