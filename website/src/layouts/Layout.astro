---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter";
import "@fontsource-variable/instrument-sans";
import "../styles/global.css";
import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import instrumentSansLatinUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import ABDevPanel from "../components/ABDevPanel.astro";
import TypeDevPanel from "../components/TypeDevPanel.astro";

import ManifestoBanner from "../components/ManifestoBanner.astro";

import { getLangFromUrl } from "../i18n/ui";

export interface BreadcrumbItem {
    name: string;
    url: string;
}

export interface Props {
    title?: string;
    description?: string;
    breadcrumbs?: BreadcrumbItem[];
    lang?: string;
    showBanner?: boolean;
    ogImage?: string;
    ogType?: string;
}



const {
    title = "Rebase - The Postgres Admin Panel Built for Developers",
    description = "Build powerful back-office applications in minutes with Rebase. An open-source, React-based admin framework for PostgreSQL featuring an AI-powered UI, visual schema builder, and beautiful data management.",
    breadcrumbs,
    lang = getLangFromUrl(Astro.url),
    showBanner = false,
    ogImage = "https://rebase.pro/img/teaser.png",
    ogType = "website"
} = Astro.props;

const canonicalBase = "https://rebase.pro";
const path = Astro.url.pathname;
const canonical = path === "/" ? canonicalBase : `${canonicalBase}${path}`;

// Generate breadcrumb structured data
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url
    }))
} : null;
---

<!DOCTYPE html>
<!-- `data-theme` drives Tailwind (see the `@custom-variant dark` in global.css);
     `class="dark"` is what the RUNTIME reads. @rebasepro/ui/index.css keys
     `color-scheme` off `html.dark`, and Chip picks its palette in JS from
     `documentElement.classList.contains("dark")` — with only the attribute set,
     every real <Chip> on this site rendered its LIGHT scheme on a black page.
     The product sets the class (useBuildModeController); so do we. -->
<html lang={lang} data-theme="dark" class="dark">
<head>
    <meta charset="UTF-8">

    <!-- Immediate check for dismissed manifesto banner & active A/B tests to avoid CLS -->
    <script is:inline>
    (function(){
        try {
            if (localStorage.getItem('rb_manifesto_banner_dismissed') === 'true') {
                document.documentElement.classList.add('banner-dismissed-instant');
            }
            
            // 1. Get existing ab object from cookie
            var match = document.cookie.match(/(^|;)\s*rb_ab\s*=\s*([^;]+)/);
            var ab = {};
            if (match) {
                try { ab = JSON.parse(decodeURIComponent(match[2])); } catch(e) {}
            }

            // 2. Experiments definition
            var experiments = [
                // The nav is where the two-layer story is taught (backend column /
                // admin-panel column), so the flat variant is parked at 0% rather
                // than deleted — flip the weights back to split-test it again.
                { id: "navigation-structure", variants: ["control", "flat-nav"], weights: [100, 0] },
                { id: "manifesto-banner-text", variants: ["control", "mission", "founders"], weights: [34, 33, 33] }
            ];

            var updated = false;
            var H = document.documentElement;

            for (var i = 0; i < experiments.length; i++) {
                var exp = experiments[i];
                var variant = ab[exp.id];

                // If not assigned or not a valid variant, assign one
                if (!variant || exp.variants.indexOf(variant) === -1) {
                    var r = Math.random() * 100;
                    var sum = 0;
                    var assigned = exp.variants[0];
                    for (var j = 0; j < exp.variants.length; j++) {
                        sum += exp.weights[j];
                        if (r <= sum) {
                            assigned = exp.variants[j];
                            break;
                        }
                    }
                    ab[exp.id] = assigned;
                    variant = assigned;
                    updated = true;
                }

                // Apply attribute to html element
                H.setAttribute("data-ab-" + exp.id, variant);
            }

            // Write back cookie if updated
            if (updated) {
                var dm = location.hostname.indexOf("rebase.pro") > -1 ? ";domain=.rebase.pro" : "";
                document.cookie = "rb_ab=" + encodeURIComponent(JSON.stringify(ab)) +
                    ";path=/;max-age=7776000;samesite=lax" + dm;
            }

            // Inject CSS for active non-control content variants
            var css = "";
            for (var id in ab) {
                var v = ab[id];
                if (v && v !== "control") {
                    css += '[data-ab-show="' + id + ':control"]{display:none!important}';
                    css += '[data-ab-show="' + id + ':' + v + '"]{display:block!important}';
                }
            }
            if (css) {
                var s = document.createElement("style");
                s.id = "ab-styles-head";
                s.textContent = css;
                document.head.appendChild(s);
            }
        } catch(e) {}
    })();
    </script>



    <title>{title}</title>
    <link rel="shortcut icon" href="/favicon.svg" type="image/x-icon">
    <link rel="preload" as="font" type="font/woff2" href={interLatinUrl} crossorigin>
    <link rel="preload" as="font" type="font/woff2" href={instrumentSansLatinUrl} crossorigin>
    <link rel="stylesheet" href="/styles/fonts-mono.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="/styles/fonts-mono.css"></noscript>
    <link rel="canonical" href={canonical}>
    <meta name="description" content={description}>
    <meta name="keywords"
          content="Postgres admin panel, React admin panel, internal tools builder, no-code backend, AI-powered admin, visual schema builder, data management, back-office application, database UI">
    <meta name="robots" content="index, follow">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="sitemap" href="/sitemap-index.xml"/>
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@rebasepro">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image:type" content="image/png">
    <meta name="twitter:image:width" content="1200">
    <meta name="twitter:image:height" content="630">
    <meta name="twitter:image" content="https://rebase.pro/img/twitter_teaser.png">

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "WebSite",
                    "name": "Rebase",
                    "url": "https://rebase.pro",
                    "description": "Build powerful back-office applications in minutes with Rebase. A modern React admin framework for PostgreSQL.",
                    "publisher": {
                        "@id": "https://rebase.pro/#organization"
                    }
                },
                {
                    "@type": "Organization",
                    "@id": "https://rebase.pro/#organization",
                    "name": "Rebase",
                    "url": "https://rebase.pro",
                    "logo": {
                        "@type": "ImageObject",
                        "url": "https://rebase.pro/img/logo_small.png",
                        "width": 512,
                        "height": 512
                    },
                    "sameAs": [
                        "https://x.com/rebaseco",
                        "https://github.com/rebasepro/rebase",
                        "https://www.linkedin.com/company/rebase"
                    ]
                },
                {
                    "@type": "SoftwareApplication",
                    "name": "Rebase",
                    "applicationCategory": "DeveloperApplication",
                    "operatingSystem": "Web",
                    "description": "Build powerful back-office applications in minutes with Rebase. An open-source, React-based admin framework for PostgreSQL featuring an AI-powered UI, visual schema builder, and beautiful data management.",
                    "url": "https://rebase.pro",
                    "screenshot": "https://rebase.pro/img/teaser.png",
                    "offers": {
                        "@type": "Offer",
                        "price": "0",
                        "priceCurrency": "USD",
                        "availability": "https://schema.org/InStock"
                    },
                    "softwareVersion": "3.1",
                    "applicationSubCategory": "Content Management System",
                    "keywords": "PostgreSQL admin panel, React admin panel, internal tools builder, no-code backend, AI-powered admin",
                    "publisher": {
                        "@id": "https://rebase.pro/#organization"
                    }
                }
            ]
        }
    </script>

    {breadcrumbSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

<script is:inline>

        // Initialize dataLayer and gtag function
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }

        // Set default consents - only once
        window.gtag("consent", "default", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: "denied",
        });


        // Check if user has already consented via root domain cookie
        const match = document.cookie.match(/(^|;)\s*cookie-consent\s*=\s*([^;]+)/);
        const cookieConsent = match ? match[2] : null;
        if (cookieConsent === "accepted") {
            window.gtag("consent", "update", {
                ad_storage: "granted",
                ad_user_data: "granted",
                ad_personalization: "granted",
                analytics_storage: "granted",
            });
        }

        // Set timestamp - only once
        window.gtag("js", new Date());

        // Initialize GA4
        window.gtag("config", "G-715WKXSHF3");

        // gtag.js is 167KB and used to load `async` from the head, where it ate
        // bandwidth and main thread the hero needed first. Every call above is
        // just a dataLayer.push, so the queue survives an arbitrarily late
        // library — it replays the whole thing on arrival and the pageview is
        // still recorded. Load it once the page is idle, or sooner if the user
        // interacts, whichever comes first.
        //
        // **And not before consent is granted.** Consent Mode was already set to
        // deny everything by default, which is what stops gtag STORING anything
        // — but the script was fetched regardless, on every visit, before the
        // banner had been answered. That is still a request to Google carrying
        // the visitor's IP and referrer from a page that has just told them
        // nothing has been agreed to yet. Denying storage and not making the
        // request are different promises, and the banner implies the second.
        //
        // So: load on consent. The idle and interaction triggers still apply,
        // but only once `cookie-consent=accepted` exists — either from a
        // previous visit (read above) or from the banner, which dispatches
        // `rebase:consent` when the visitor accepts.
        (function () {
            var loaded = false;

            function loadGtag() {
                if (loaded) return;
                loaded = true;
                var s = document.createElement("script");
                s.async = true;
                s.src = "https://www.googletagmanager.com/gtag/js?id=G-715WKXSHF3";
                document.head.appendChild(s);
            }

            function armLoaders() {
                ["pointerdown", "keydown", "scroll"].forEach(function (evt) {
                    addEventListener(evt, loadGtag, { once: true, passive: true });
                });

                // requestIdleCallback can be starved indefinitely on a busy page,
                // so the timeout is what actually bounds this on slow devices.
                if ("requestIdleCallback" in window) {
                    requestIdleCallback(loadGtag, { timeout: 3500 });
                } else {
                    setTimeout(loadGtag, 3500);
                }
            }

            if (cookieConsent === "accepted") {
                armLoaders();
            } else {
                // Accepting mid-visit should start analytics on this page view,
                // not the next one — the queued `config` call above is replayed
                // when the library arrives, so the pageview is not lost.
                addEventListener("rebase:consent", function (event) {
                    if (event.detail === "accepted") armLoaders();
                }, { once: true });
            }
        })();

    </script>

    <!-- View Transitions -->
    <ClientRouter/>
    <slot name="head"/>
</head>

<body class="font-sans bg-page-ground text-surface-300 antialiased" style="color-scheme: dark;">
<div id="app-shell" class="flex flex-col min-h-screen">
{showBanner && <ManifestoBanner />}
<Header/>
<!-- page-v2 carries the 2026-08 system (ground, copy colour, heading tracking,
     frame, shell and measure) to every route from one place. -->
<main class="flex-1 bg-page-ground text-page-ink">
    <slot/>
</main>
<Footer/>
</div>
<CookieBanner/>
<ABDevPanel/>
<TypeDevPanel/>

<script src="../scripts/tracking-params.js"/>

<script src="../scripts/analytics.ts"/>
<script src="../page-effects.ts"/>
</body>

</html>
