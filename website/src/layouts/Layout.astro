---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter";
import "@fontsource-variable/instrument-sans";
import "../styles/global.css";
import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import instrumentSansLatinUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import ABDevPanel from "../components/ABDevPanel.astro";
import { EXPERIMENTS } from "../scripts/ab-testing";
import TypeDevPanel from "../components/TypeDevPanel.astro";

import ManifestoBanner from "../components/ManifestoBanner.astro";

import { getLangFromUrl, useTranslations } from "../i18n/ui";

export interface BreadcrumbItem {
    name: string;
    url: string;
}

export interface Props {
    title?: string;
    description?: string;
    breadcrumbs?: BreadcrumbItem[];
    lang?: string;
    showBanner?: boolean;
    ogImage?: string;
    ogType?: string;
}



// The defaults ARE the home page's meta pair. They used to be their own
// sentence — "The Postgres Admin Panel Built for Developers" — which sold the
// retired panel-first brand to every page that forgets to pass a title, and to
// the Organization schema below. One source, `index.meta.*`.
const defaultT = useTranslations(getLangFromUrl(Astro.url));

const {
    title = defaultT("index.meta.title"),
    description = defaultT("index.meta.description"),
    breadcrumbs,
    lang = getLangFromUrl(Astro.url),
    showBanner = false,
    ogImage = "https://rebase.pro/img/teaser.png",
    ogType = "website"
} = Astro.props;

// The English pair, for the JSON-LD graph: structured data describes the
// organisation, not the localised page the crawler happens to be on.
const schemaTitle = "Rebase — The Open-Source Backend for Postgres: APIs, Auth, Realtime & CMS";
const schemaDescription = "Point Rebase at your Postgres and get REST APIs, auth, storage, realtime and backups — plus a schema-driven admin panel when you want one. Secured by row-level security. Open-source, deploy anywhere.";

const siteSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            name: "Rebase",
            url: "https://rebase.pro",
            description: schemaDescription,
            publisher: { "@id": "https://rebase.pro/#organization" },
        },
        {
            "@type": "Organization",
            "@id": "https://rebase.pro/#organization",
            name: "Rebase",
            url: "https://rebase.pro",
            logo: {
                "@type": "ImageObject",
                url: "https://rebase.pro/img/logo_small.png",
                width: 512,
                height: 512,
            },
            // Only profiles that are actually ours. `x.com/rebaseco` 404s and
            // `@rebasepro` on X belongs to an unrelated account; the LinkedIn
            // company page named here was a different company called Rebase.
            sameAs: ["https://github.com/rebasepro/rebase"],
        },
        {
            "@type": "SoftwareApplication",
            name: "Rebase",
            alternateName: schemaTitle,
            applicationCategory: "DeveloperApplication",
            operatingSystem: "Web",
            description: schemaDescription,
            url: "https://rebase.pro",
            screenshot: "https://rebase.pro/img/teaser.png",
            offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "USD",
                availability: "https://schema.org/InStock",
            },
            applicationSubCategory: "Backend as a Service",
            keywords:
                "Postgres backend, Postgres REST API, row-level security, typed SDK, realtime, headless CMS, self-hosted",
            license: "https://opensource.org/licenses/MIT",
            publisher: { "@id": "https://rebase.pro/#organization" },
        },
    ],
};

// Variant visibility, generated at build time from the one experiment list.
//
// Hide-only, deliberately. The rule this replaces was injected at runtime and
// revealed the winner with `display:block!important`, which silently overrode
// whatever the caller had asked for — ManifestoBanner passes `class="inline"`
// because its variants are a sentence inside a <p>, and block broke the line.
// Hiding the losers instead leaves the winner's own classes to lay it out.
const abVariantCss = EXPERIMENTS.flatMap((exp) =>
    exp.variants.map((v) =>
        v === "control"
            // Control is the SEO- and noscript-safe default, so it is hidden only
            // once an assignment actually exists on <html>.
            ? `html[data-ab-${exp.id}]:not([data-ab-${exp.id}="control"]) [data-ab-show="${exp.id}:control"]{display:none!important}`
            : `html:not([data-ab-${exp.id}="${v}"]) [data-ab-show="${exp.id}:${v}"]{display:none!important}`
    )
).join("");

const canonicalBase = "https://rebase.pro";
const path = Astro.url.pathname;
const canonical = path === "/" ? canonicalBase : `${canonicalBase}${path}`;

// Generate breadcrumb structured data
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url
    }))
} : null;
---

<!DOCTYPE html>
<!-- `data-theme` drives Tailwind (see the `@custom-variant dark` in global.css);
     `class="dark"` is what the RUNTIME reads. @rebasepro/ui/index.css keys
     `color-scheme` off `html.dark`, and Chip picks its palette in JS from
     `documentElement.classList.contains("dark")` — with only the attribute set,
     every real <Chip> on this site rendered its LIGHT scheme on a black page.
     The product sets the class (useBuildModeController); so do we. -->
<html lang={lang} data-theme="dark" class="dark">
<head>
    <meta charset="UTF-8">

    <!-- Variant visibility. Static, so it survives a view-transition swap and needs
         no runtime <style> to be kept in sync by two different call sites. -->
    <style is:inline set:html={abVariantCss}></style>

    <!-- Dismissed-banner class + active A/B assignment, applied before paint to avoid CLS.

         Everything below writes to the *document*: a class and the data-ab-* attributes
         on <html>. A view transition destroys both — Astro's swap strips every attribute
         off documentElement and re-applies only the ones the incoming server-rendered
         document carried. The script cannot repair that on its own either: Astro dedupes
         inline scripts by content, so this one is marked data-astro-exec after the first
         load and never runs again. Hence a named, idempotent apply() called on first
         paint and again on every swap — the same shape as the data-scrolled listener in
         Header.astro. -->
    <script is:inline define:vars={{ abExperiments: EXPERIMENTS }}>
    (function(){
        if (window.__rebaseAbBound) return;
        window.__rebaseAbBound = true;

        function applyAbState() {
            try {
                if (localStorage.getItem('rb_manifesto_banner_dismissed') === 'true') {
                    document.documentElement.classList.add('banner-dismissed-instant');
                }

                // 1. Get existing ab object from cookie
                var match = document.cookie.match(/(^|;)\s*rb_ab\s*=\s*([^;]+)/);
                var ab = {};
                if (match) {
                    try { ab = JSON.parse(decodeURIComponent(match[2])); } catch(e) {}
                }

                var updated = false;
                var H = document.documentElement;

                // A variant forced from the dev panel outranks assignment and expiry,
                // and is session-scoped so it never reaches a real visitor. Without it
                // the panel could not preview a parked or expired experiment past the
                // first navigation, since this function would retire it again.
                var forced = {};
                try { forced = JSON.parse(sessionStorage.getItem("rb_ab_force") || "{}"); } catch(e) {}

                for (var i = 0; i < abExperiments.length; i++) {
                    var exp = abExperiments[i];

                    if (forced[exp.id] && exp.variants.indexOf(forced[exp.id]) !== -1) {
                        H.setAttribute("data-ab-" + exp.id, forced[exp.id]);
                        continue;
                    }

                    // `expires` now means what the type says it means. It used to gate
                    // only the GA4 reporting, so an expired experiment kept serving
                    // variants with nothing recording the result — and because a stored
                    // assignment is only re-rolled when it is *invalid*, parking an
                    // experiment at 0% never moved anyone already bucketed. Skipping it
                    // here is what actually retires it, cookie and all.
                    if (exp.expires && new Date(exp.expires).getTime() < Date.now()) {
                        H.removeAttribute("data-ab-" + exp.id);
                        continue;
                    }

                    var variant = ab[exp.id];

                    // If not assigned or not a valid variant, assign one
                    if (!variant || exp.variants.indexOf(variant) === -1) {
                        // The type documents weights as optional with an equal split
                        // default. Nothing implemented it, so an experiment written to
                        // that contract threw on exp.weights[j] — inside the catch, which
                        // would have silently dropped every later experiment too.
                        var weights = exp.weights;
                        if (!weights || weights.length !== exp.variants.length) {
                            weights = exp.variants.map(function(){ return 100 / exp.variants.length; });
                        }
                        var r = Math.random() * 100;
                        var sum = 0;
                        var assigned = exp.variants[0];
                        for (var j = 0; j < exp.variants.length; j++) {
                            sum += weights[j];
                            if (r <= sum) {
                                assigned = exp.variants[j];
                                break;
                            }
                        }
                        ab[exp.id] = assigned;
                        variant = assigned;
                        updated = true;
                    }

                    // Apply attribute to html element
                    H.setAttribute("data-ab-" + exp.id, variant);
                }

                // Write back cookie if updated. A re-apply after a swap finds every
                // assignment already valid, so this is a first-visit-only write.
                if (updated) {
                    var dm = location.hostname.indexOf("rebase.pro") > -1 ? ";domain=.rebase.pro" : "";
                    document.cookie = "rb_ab=" + encodeURIComponent(JSON.stringify(ab)) +
                        ";path=/;max-age=7776000;samesite=lax" + dm;
                }
            } catch(e) {}
        }

        applyAbState();
        // Fires after the swap has cleared <html>'s attributes, and before the new body
        // is painted — so the variant is restored with no flash of the control.
        document.addEventListener('astro:after-swap', applyAbState);
    })();
    </script>



    <title>{title}</title>
    <link rel="shortcut icon" href="/favicon.svg" type="image/x-icon">
    <link rel="preload" as="font" type="font/woff2" href={interLatinUrl} crossorigin>
    <link rel="preload" as="font" type="font/woff2" href={instrumentSansLatinUrl} crossorigin>
    <link rel="stylesheet" href="/styles/fonts-mono.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="/styles/fonts-mono.css"></noscript>
    <link rel="canonical" href={canonical}>
    <meta name="description" content={description}>
    <meta name="keywords"
          content="Postgres backend, open-source Firebase alternative, Postgres REST API, row-level security, typed SDK, Postgres realtime, headless CMS for Postgres, self-hosted backend">
    <meta name="robots" content="index, follow">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="sitemap" href="/sitemap-index.xml"/>
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image:type" content="image/png">
    <meta name="twitter:image:width" content="1200">
    <meta name="twitter:image:height" content="630">
    <meta name="twitter:image" content="https://rebase.pro/img/twitter_teaser.png">

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    {breadcrumbSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

<script is:inline>

        // Initialize dataLayer and gtag function
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }

        // Set default consents - only once
        window.gtag("consent", "default", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: "denied",
        });


        // Check if user has already consented via root domain cookie
        const match = document.cookie.match(/(^|;)\s*cookie-consent\s*=\s*([^;]+)/);
        const cookieConsent = match ? match[2] : null;
        if (cookieConsent === "accepted") {
            window.gtag("consent", "update", {
                ad_storage: "granted",
                ad_user_data: "granted",
                ad_personalization: "granted",
                analytics_storage: "granted",
            });
        }

        // Set timestamp - only once
        window.gtag("js", new Date());

        // Initialize GA4
        window.gtag("config", "G-715WKXSHF3");

        // gtag.js is 167KB and used to load `async` from the head, where it ate
        // bandwidth and main thread the hero needed first. Every call above is
        // just a dataLayer.push, so the queue survives an arbitrarily late
        // library — it replays the whole thing on arrival and the pageview is
        // still recorded. Load it once the page is idle, or sooner if the user
        // interacts, whichever comes first.
        //
        // **And not before consent is granted.** Consent Mode was already set to
        // deny everything by default, which is what stops gtag STORING anything
        // — but the script was fetched regardless, on every visit, before the
        // banner had been answered. That is still a request to Google carrying
        // the visitor's IP and referrer from a page that has just told them
        // nothing has been agreed to yet. Denying storage and not making the
        // request are different promises, and the banner implies the second.
        //
        // So: load on consent. The idle and interaction triggers still apply,
        // but only once `cookie-consent=accepted` exists — either from a
        // previous visit (read above) or from the banner, which dispatches
        // `rebase:consent` when the visitor accepts.
        (function () {
            var loaded = false;

            function loadGtag() {
                if (loaded) return;
                loaded = true;
                var s = document.createElement("script");
                s.async = true;
                s.src = "https://www.googletagmanager.com/gtag/js?id=G-715WKXSHF3";
                document.head.appendChild(s);
            }

            function armLoaders() {
                ["pointerdown", "keydown", "scroll"].forEach(function (evt) {
                    addEventListener(evt, loadGtag, { once: true, passive: true });
                });

                // requestIdleCallback can be starved indefinitely on a busy page,
                // so the timeout is what actually bounds this on slow devices.
                if ("requestIdleCallback" in window) {
                    requestIdleCallback(loadGtag, { timeout: 3500 });
                } else {
                    setTimeout(loadGtag, 3500);
                }
            }

            if (cookieConsent === "accepted") {
                armLoaders();
            } else {
                // Accepting mid-visit should start analytics on this page view,
                // not the next one — the queued `config` call above is replayed
                // when the library arrives, so the pageview is not lost.
                addEventListener("rebase:consent", function (event) {
                    if (event.detail === "accepted") armLoaders();
                }, { once: true });
            }
        })();

    </script>

    <!-- View Transitions -->
    <ClientRouter/>
    <slot name="head"/>
</head>

<body class="font-sans bg-page-ground text-surface-300 antialiased" style="color-scheme: dark;">
<div id="app-shell" class="flex flex-col min-h-screen">
{showBanner && <ManifestoBanner />}
<Header/>
<!-- page-v2 carries the 2026-08 system (ground, copy colour, heading tracking,
     frame, shell and measure) to every route from one place. -->
<main class="flex-1 bg-page-ground text-page-ink">
    <slot/>
</main>
<Footer/>
</div>
<CookieBanner/>
<ABDevPanel/>
<TypeDevPanel/>

<script src="../scripts/tracking-params.js"/>

<script src="../scripts/analytics.ts"/>
<script src="../page-effects.ts"/>
</body>

</html>
