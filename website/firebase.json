{
  "hosting": {
    "public": "dist",
    "site": "rebase-578f2",
    "ignore": [
      "firebase.json",
      "**/.DS_Store",
      "**/.git/**",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/f/backend_extension",
        "destination": "/backend",
        "type": 301
      },
      {
        "source": "/openai",
        "destination": "/ai",
        "type": 301
      },
      {
        "source": "/features",
        "destination": "/product",
        "type": 301
      },
      {
        "source": "/:lang(es|de|fr)/features",
        "destination": "/:lang/product",
        "type": 301
      },
      {
        "source": "/why-rebase",
        "destination": "/compare",
        "type": 301
      },
      {
        "source": "/:lang(es|de|fr)/why-rebase",
        "destination": "/:lang/compare",
        "type": 301
      },
      {
        "source": "/admin",
        "destination": "/cms",
        "type": 301
      },
      {
        "source": "/:lang(es|de|fr)/admin",
        "destination": "/:lang/cms",
        "type": 301
      },
      {
        "source": "/editing",
        "destination": "/cms",
        "type": 301
      },
      {
        "source": "/:lang(es|de|fr)/editing",
        "destination": "/:lang/cms",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|avif|ico|mp4|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|otf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, must-revalidate"
          }
        ]
      },
      {
        "source": "**/favicon*.@(ico|svg|png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(json|xml|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "i18n": {
      "root": "/"
    }
  }
}
