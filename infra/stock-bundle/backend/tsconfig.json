{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "."
  },
  // Only resources.ts: the stock backend has no code of its own. Its tables
  // come from the database and its storage model is the project's
  // STORAGE_POLICIES (see resources.ts), so there is no src/, schema/,
  // functions/ or crons/ to include — and an include that matches nothing
  // fails check:tsconfig-entries. Add a directory here when one exists.
  //
  // `rootDir` is `.`: inferring it stopped being an option in TypeScript 6
  // (TS5011).
  "include": ["resources.ts"]
}
