{
    "name": "@rebasepro/app-example",
    "version": "0.8.0",
    "description": "Complete Rebase application example with PostgreSQL backend",
    "private": true,
    "type": "module",
    "workspaces": [
        "frontend",
        "backend",
        "config"
    ],
    "scripts": {
        "dev": "rebase dev",
        "build": "pnpm --filter \"./frontend\" --filter \"./backend\" --filter \"./config\" -r run build",
        "start": "pnpm --filter \"*-backend\" start",
        "db:generate": "rebase db generate --collections ../config/collections",
        "db:migrate": "rebase db migrate",
        "schema:introspect": "rebase schema introspect",
        "db:push": "rebase db push --collections ../config/collections",
        "schema:generate": "rebase schema generate --collections ../config/collections",
        "generate:sdk": "rebase generate-sdk",
        "deploy": "cd .. && ./tooling/scripts/deploy-demo.sh"
    },
    "devDependencies": {
        "@rebasepro/cli": "workspace:*",
        "@rebasepro/types": "workspace:*",
        "concurrently": "^10.0.4",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=22.22.0"
    }
}
