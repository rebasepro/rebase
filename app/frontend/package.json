{
    "name": "rebase-app-frontend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@fontsource/jetbrains-mono": "^5.2.5",
        "@rebasepro/admin": "workspace:*",
        "@rebasepro/auth": "workspace:*",
        "@rebasepro/client": "workspace:*",
        "@rebasepro/core": "workspace:*",
        "@rebasepro/plugin-data-enhancement": "workspace:*",
        "@rebasepro/plugin-insights": "workspace:*",
        "@rebasepro/studio": "workspace:*",
        "@rebasepro/types": "workspace:*",
        "@rebasepro/ui": "workspace:*",
        "@tailwindcss/typography": "^0.5.19",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.0.0",
        "typeface-rubik": "^1.1.13"
    },
    "scripts": {
        "login": "rebase login",
        "logout": "rebase logout",
        "clean": "rm -rf dist && find ./src -name '*.js' -type f | xargs rm -f",
        "dev": "vite --mode development",
        "build": "vite build && tsc",
        "preview": "vite build && vite preview",
        "deploy": "vite build && firebase deploy --only hosting:rebase-demo-27150"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.12",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-n": "^17.15.1",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.18",
        "rollup-plugin-visualizer": "7.0.1",
        "typescript": "^5.8.3",
        "vite": "^5.4.17",
        "vite-plugin-svgr": "^4.3.0"
    }
}
