{
    "name": "rebase-app-backend",
    "version": "0.1.1",
    "description": "Custom PostgreSQL backend for Rebase with real-time sync",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --watch=\"../config/**/*\" --watch=\"../../packages/server-core/src/**/*\" --conditions development src/index.ts",
        "build": "tsc",
        "start": "node dist/src/index.js",
        "start:dev": "tsx src/index.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.11.0",
        "@rebasepro/server-core": "workspace:*",
        "@rebasepro/server-mongodb": "workspace:*",
        "@rebasepro/server-postgresql": "workspace:*",
        "dotenv": "^16.0.0",
        "drizzle-orm": "^0.44.4",
        "hono": "^4.2.0",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@faker-js/faker": "10.4.0",
        "@types/node": "^20.10.5",
        "drizzle-kit": "^0.31.4",
        "tsc-alias": "1.8.17",
        "tsx": "^4.20.6",
        "typescript": "^5.3.3"
    },
    "gitHead": "e42be25c08d53e4b59790f8619ba848cce455363",
    "private": true
}
