{
  "name": "rebase-app-backend",
  "version": "0.8.0",
  "description": "Custom PostgreSQL backend for Rebase with real-time sync",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --watch=\"../config/**/*\" --watch=\"../../packages/server/src/**/*\" --conditions development src/index.ts",
    "build": "tsc",
