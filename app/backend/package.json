    "start:dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@hono/node-server": "^2.0.4",
    "@rebasepro/server": "workspace:*",
    "@rebasepro/server-postgres": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "gitHead": "e42be25c08d53e4b59790f8619ba848cce455363",
