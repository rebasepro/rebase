# Rebase App Environment Configuration
# Copy this file to .env and customize for your environment:
#   cp .env.example .env

# Database Configuration
# These are the credentials `app/backend/docker-compose.yml` starts the local
# database with (user, password and database are all `rebase`). Change the
# password there and here together, or export POSTGRES_PASSWORD before
# `docker compose up`.
# sslmode=disable matches that container, which has no TLS; the schema tooling
# (atlas, behind `pnpm run db:push`) would otherwise default to requiring SSL
# and fail with "SSL is not enabled on the server". Drop it when you point this
# at a managed database.
DATABASE_URL=postgresql://rebase:rebasepassword@localhost:5432/rebase?sslmode=disable
# ADMIN_CONNECTION_STRING=            # Separate admin connection for migrations (defaults to DATABASE_URL)
DB_POOL_MAX=5
# DB_POOL_IDLE_TIMEOUT=30000          # Idle connection timeout in ms (default: 30000)
# DB_POOL_CONNECT_TIMEOUT=10000       # Connection timeout in ms (default: 10000)

# Server Configuration
PORT=3001
NODE_ENV=development
# Allow connecting to localhost / 127.0.0.1 in production mode (for local testing of prod builds)
# ALLOW_LOCALHOST_IN_PRODUCTION=false

# Logging Configuration
LOG_LEVEL=info

# JWT Authentication
# Leave blank to auto-generate a secure random secret on first run.
# In production, set an explicit 64+ character secret and persist it.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Email (optional — required for password-reset and verification flows)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=hello@rebase.pro
# SMTP_PASS=
# SMTP_FROM="Rebase <hello@rebase.pro>"
# APP_NAME=Rebase
# Logo atop the default email templates. Absolute http(s) PNG/JPG only.
# EMAIL_LOGO_URL=https://rebase.pro/img/logo_small.png

# Canonical frontend URL (used in password-reset / verification emails)
FRONTEND_URL=http://localhost:5173

# Allowed CORS origins in production (comma-separated, required in production)
# CORS_ORIGINS=https://yourdomain.com

# Google OAuth (optional) — all THREE are required for the login button to
# appear and work. The backend only advertises the provider when
# GOOGLE_CLIENT_ID is set, the login button only renders when
# VITE_GOOGLE_CLIENT_ID is set (same value), and the click only succeeds with
# GOOGLE_CLIENT_SECRET, since the admin uses the authorization-code flow.
# Restart both processes after changing these — neither is hot-reloaded.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VITE_GOOGLE_CLIENT_ID=

# Frontend API URL
VITE_API_URL=http://localhost:3001

ALLOW_REGISTRATION=true

# Service Key — grants admin-level API access. Leave blank to auto-generate.
# In production, set an explicit key and store it in a secrets manager.
REBASE_SERVICE_KEY=

# Storage Configuration
# STORAGE_TYPE=local                  # "local" or "s3" (default: local)
# STORAGE_PATH=                       # Local storage path (default: ./uploads)
# FORCE_LOCAL_STORAGE=false           # Suppress production warning for local storage

# S3-Compatible Storage (required when STORAGE_TYPE=s3)
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                        # Custom endpoint for S3-compatible services (MinIO, R2, etc.)
# S3_FORCE_PATH_STYLE=false           # Use path-style URLs (required for MinIO)
