{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDir": "../../",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@rebasepro/types": ["../../packages/types/src/index.ts"],
      "@rebasepro/types/*": ["../../packages/types/src/*"],
      "@rebasepro/common": ["../../packages/common/src/index.ts"],
      "@rebasepro/common/*": ["../../packages/common/src/*"],
      "@rebasepro/cms": ["../../packages/cms/src/index.ts"],
      "@rebasepro/cms/*": ["../../packages/cms/src/*"]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
