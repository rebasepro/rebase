# ─── Rebase Cloud Run Production Environment ─────────────────────────
# These variables are baked into the frontend at build time by Vite.
# They are NOT secrets — they are embedded in the client bundle.

# API URL: empty string = same-origin (backend and frontend share the Cloud Run URL)
VITE_API_URL=

# Google OAuth Client ID (public — embedded in client bundle)
VITE_GOOGLE_CLIENT_ID=206914083973-ks3fms8itjrm40s4ti53vqu4meqlcptj.apps.googleusercontent.com
