{
    "//": "Typechecks the core packages ALONE, with @rebasepro/cms-types deliberately absent from the program. Run via `pnpm check:core-types`.",
    "//why": "tsconfig.typecheck.json includes packages/cms-types/src, and a TypeScript augmentation applies to the whole program — so the `admin` field it declares is visible to every core package there. That makes the root typecheck structurally incapable of catching a core package that reads or writes `admin`, which is the exact thing the split forbids. `packages/inference` was doing it, `pnpm typecheck` reported 0 errors, and only a per-package `tsc` found it. This config is that per-package check as one fast gate.",
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "incremental": false,
        "module": "ESNext",
        "target": "ESNext",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "strict": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "ignoreDeprecations": "6.0",
        "types": [
            "node"
        ],
        // `jsx` is unset on purpose: real JSX in a core package must fail here too.
        // No @rebasepro/cms-types mapping below — a core package that imports it
        // fails to resolve, which is the point.
        "paths": {
            "@rebasepro/types": [
                "./packages/types/src"
            ],
            "@rebasepro/utils": [
                "./packages/utils/src"
            ],
            "@rebasepro/common": [
                "./packages/common/src"
            ],
            "@rebasepro/client": [
                "./packages/client/src"
            ],
            "@rebasepro/codegen": [
                "./packages/codegen/src"
            ],
            "@rebasepro/server": [
                "./packages/server/src"
            ],
            "@rebasepro/server-postgres": [
                "./packages/server-postgres/src"
            ],
            "@rebasepro/server-mongo": [
                "./packages/server-mongo/src"
            ],
            "@rebasepro/inference": [
                "./packages/inference/src"
            ],
            "@rebasepro/cli": [
                "./packages/cli/src"
            ],
            "@rebasepro/mcp": [
                "./packages/mcp/src"
            ],
            "hono": [
                "./node_modules/hono"
            ]
        },
        "typeRoots": [
            "node_modules/.pnpm/node_modules/@types",
            "node_modules/@types"
        ],
        "allowImportingTsExtensions": true
    },
    "include": [
        "packages/types/src",
        "packages/utils/src",
        "packages/common/src",
        "packages/client/src",
        "packages/codegen/src",
        "packages/server/src",
        "packages/server-postgres/src",
        "packages/server-mongo/src",
        "packages/inference/src",
        "packages/cli/src",
        "packages/mcp/src"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/__tests__",
        "**/test/**",
        "packages/*/src/test/**"
    ]
}
