{
    "name": "@rebasepro/videos",
    "version": "0.0.1",
    "description": "Remotion product videos for Rebase",
    "private": true,
    "type": "module",
    "dependencies": {
        "@firecms/neat": "1.0.2",
        "@remotion/cli": "4.0.500",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "remotion": "4.0.500"
    },
    "devDependencies": {
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "puppeteer": "25.4.0",
