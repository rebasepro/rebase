{
    "name": "rebase-parent",
    "private": true,
    "description": "Open-source headless CMS and admin panel for Postgres",
    "author": "Rebase",
    "repository": {
        "type": "git",
        "url": "https://github.com/rebasepro/rebase.git"
    },
    "homepage": "https://rebase.pro",
    "workspaces": [
        "packages/types",
        "packages/utils",
        "packages/common",
        "packages/formex",
        "packages/ui",
        "packages/core",
        "packages/client",
        "packages/server-core",
        "packages/auth",
        "packages/cli",
        "packages/studio",
        "packages/admin",
        "packages/client-postgresql",
        "packages/server-postgresql",
        "packages/server-mongodb",
        "packages/client-firebase",
        "packages/plugin-data-enhancement",
        "packages/plugin-insights",
        "packages/schema-inference",
        "packages/sdk-generator",
        "packages/mcp-server",
        "app",
        "app/frontend",
        "app/backend",
        "app/config",
        "saas/config",
        "saas/backend",
        "saas/frontend"
    ],
    "scripts": {
        "test": "pnpm -r test",
        "dev": "cd app && run-s dev",
        "web": "cd website && run-s dev",
        "saas": "cd saas && pnpm run dev",
        "deploy:web": "cd website && run-s deploy",
        "build": "pnpm --filter './packages/*' -r run build && pnpm --filter './app' -r run build",
        "build:stream": "lerna run build --stream --loglevel=info",
        "clean": "lerna run clean",
        "release": "./scripts/release.sh",
        "release:patch": "./scripts/release.sh patch",
        "release:minor": "./scripts/release.sh minor",
        "release:major": "./scripts/release.sh major",
        "release:dry": "./scripts/release.sh patch --dry-run",
        "e2e": "npx playwright test -c e2e/playwright.config.ts",
        "deploy:demo": "./scripts/deploy-demo.sh",
        "deploy:demo:quick": "./scripts/deploy-demo.sh --only-deploy",
        "kill": "pkill -f 'rebase.*dev' || true; pkill -f 'tsx watch' || true; pkill -f vite || true"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@playwright/test": "1.59.1",
        "@types/json-logic-js": "2.0.8",
        "@typescript-eslint/eslint-plugin": "^8.59.4",
        "eslint": "^9.39.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^17.24.0",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^16.5.0",
        "lerna": "^9.0.7",
        "npm-run-all2": "^7.0.2",
        "ts-morph": "27.0.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.4"
    },
    "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67"
}
