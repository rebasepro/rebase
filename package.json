{
  "name": "rebase-parent",
  "private": true,
  "description": "Open-source backend-as-a-service for Postgres, with an optional headless CMS and admin panel",
  "author": "Rebase",
  "repository": {
    "type": "git",
    "url": "https://github.com/rebasepro/rebase.git"
  },
  "homepage": "https://rebase.pro",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "dev": "cd app && run-s dev",
    "web": "cd website && run-s dev",
    "saas": "cd saas && pnpm run dev",
    "saas:prod": "./saas/scripts/dev-prod.sh",
    "deploy:web": "cd website && run-s deploy",
    "build": "pnpm --filter './packages/*' -r run build && pnpm --filter './app' -r run build",
    "build:stream": "pnpm -r run build --reporter=append-only",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p tsconfig.tests.json",
    "verify:docs": "node --max-old-space-size=8192 tooling/scripts/verify-docs.mjs",
    "verify:docs:strict": "node --max-old-space-size=8192 tooling/scripts/verify-docs.mjs --strict",
    "verify:selfhost": "node --import tsx tooling/scripts/verify-selfhost.mts",
    "verify:selfhost:docker": "node --import tsx tooling/scripts/verify-selfhost-docker.mts",
    "verify:corpus": "node --import tsx tooling/scripts/verify-bundle-corpus.mts",
    "rls:check": "node --import tsx tooling/scripts/rls-scan.mts",
    "check:headless": "node tooling/scripts/headless-guard/check.mjs",
    "check:types-headless": "node tooling/scripts/headless-guard/check-types.mjs --src",
    "check:ts-expect-error-coverage": "node tooling/scripts/check-ts-expect-error-coverage.mjs",
    "check:types-headless:dts": "node tooling/scripts/headless-guard/check-types.mjs --dts",
    "check:browser-deps": "node tooling/scripts/headless-guard/check-browser-deps.mjs",
    "check:core-types": "tsc --noEmit -p tsconfig.core.json",
    "check:baas-types": "tsc -p tests/e2e/baas-typecheck/tsconfig.json",
    "check:templates": "node tooling/scripts/check-templates.mjs",
    "check:template-pins": "node tooling/scripts/check-template-pins.mjs",
    "check:contributor-setup": "node tooling/scripts/check-contributor-setup.mjs",
    "check:contributor-setup:live": "node tooling/scripts/check-contributor-setup.mjs --live",
    "check:gates-doc": "node tooling/scripts/check-gates-doc.mjs",
    "check:resource-graphs": "node tooling/scripts/check-resource-graphs.mjs",
    "check:eject": "TSX_TSCONFIG_PATH=tsconfig.typecheck.json node --import tsx tooling/scripts/check-eject.mts",
    "check:examples": "pnpm --filter \"./examples/*\" -r run typecheck",
    "check:llms-coverage": "node tooling/scripts/check-llms-coverage.mjs",
    "check:generated": "pnpm -C website run generate-all && pnpm check:llms-coverage && git -c core.fsmonitor=false diff --exit-code -- website/public/llms.txt website/public/llms-full.txt website/public/sitemap.md website/src/content/docs/docs/CHANGELOG.md website/src/content/docs/de/docs/CHANGELOG.md website/src/content/docs/es/docs/CHANGELOG.md website/src/content/docs/fr/docs/CHANGELOG.md website/src/content/docs/it/docs/CHANGELOG.md website/src/content/docs/pt/docs/CHANGELOG.md website/src/content/docs/docs/compatibility.md website/src/content/docs/docs/troubleshooting.md",
    "check:names": "node tooling/scripts/headless-guard/check-package-names.mjs",
    "check:floors": "node tooling/scripts/check-declared-floors.mjs",
    "check:pnpm-settings": "node tooling/scripts/check-pnpm-settings.mjs",
    "check:deps": "node tooling/scripts/check-undeclared-deps.mjs",
    "check:publishable-set": "node tooling/scripts/check-publishable-set.mjs",
  "check:package-contents": "node tooling/scripts/check-package-contents.mjs",
    "check:api-surface": "node tooling/scripts/check-api-surface.mjs",
    "check:dts": "node tooling/scripts/assert-dts-resolution.mjs --all",
    "write:api-surface": "node tooling/scripts/api-surface.mjs --write",
    "generate:mcp-readme": "node tooling/scripts/generate-mcp-readme.mjs",
    "check:release-bump": "node tooling/scripts/check-release-bump.mjs",
    "check:portable-core": "node tooling/scripts/check-portable-core.mjs",
    "check:derived-names": "TSX_TSCONFIG_PATH=tsconfig.typecheck.json node --import tsx tooling/scripts/check-derived-names.mts",
    "check:schema-fresh": "TSX_TSCONFIG_PATH=tsconfig.typecheck.json node --import tsx tooling/scripts/check-generated-schema.mts",
    "write:derived-names": "TSX_TSCONFIG_PATH=tsconfig.typecheck.json node --import tsx tooling/scripts/derived-names.mts --write",
    "record:project-snapshot": "pnpm --filter @rebasepro/server-postgres record:project-snapshot",
    "check:chart": "node tooling/scripts/check-chart.mjs",
    "check:version-pins": "node tooling/scripts/docs-verify/check-version-pins.mjs",
    "fix:version-pins": "node tooling/scripts/docs-verify/check-version-pins.mjs --write",
    "check:runtime-image": "node tooling/scripts/check-runtime-image.mjs",
    "check:runtime-deps": "node tooling/scripts/check-runtime-provided-deps.mjs",
    "check:runtime-image:boots": "node tooling/scripts/check-runtime-image-boots.mjs",
    "check:runtime-image:live": "node tooling/scripts/check-runtime-image.mjs --live",
    "check:bundle": "node tooling/scripts/check-bundle-budget.mjs",
    "check:hooks": "node tooling/scripts/check-hooks-baseline.mjs",
    "check:unused": "node tooling/scripts/check-unused-locals.mjs",
    "check:test-scripts": "node tooling/scripts/check-test-scripts.mjs",
    "check:control-chars": "node tooling/scripts/check-control-chars.mjs",
    "check:untranslated": "node tooling/scripts/check-untranslated.mjs",
    "check:locale-parity": "node tooling/scripts/check-locale-parity.mjs",
    "check:jsdoc-coverage": "node tooling/scripts/check-jsdoc-coverage.mjs",
    "check:rebase-props": "node tooling/scripts/check-rebase-props-table.mjs",
    "check:property-options": "node tooling/scripts/check-property-options-table.mjs",
    "check:subpath-imports": "node tooling/scripts/check-subpath-imports.mjs",
    "check:studio-tools": "node tooling/scripts/check-studio-tools-table.mjs",
    "check:ui-string-paths": "node tooling/scripts/check-ui-string-paths.mjs",
    "check:doc-links": "node tooling/scripts/check-doc-links.mjs",
    "check:bug-classes": "node tooling/scripts/check-bug-classes.mjs",
    "check:lint": "eslint . --quiet",
    "ci:static": "node tooling/scripts/ci-static.mjs",
    "ci:build-gates": "node tooling/scripts/ci-build-gates.mjs",
    "harness": "node tooling/scripts/harness/harness.mjs",
    "harness:preflight": "node tooling/scripts/harness/harness.mjs preflight",
    "harness:eval": "node tooling/scripts/harness/harness.mjs eval",
    "test:harness": "node --test tooling/scripts/harness/test/harness.test.mjs",
    "test:saas-console": "pnpm --filter rebase-saas-frontend test",
    "test:gates": "node --test tooling/scripts/test/api-surface.test.mjs tooling/scripts/test/release-bump.test.mjs tooling/scripts/test/add-dts-extensions.test.mjs tooling/scripts/test/dts-resolution.test.mjs tooling/scripts/test/runtime-provided.test.mjs tooling/scripts/test/publishable-set.test.mjs tooling/scripts/test/ui-docs-props.test.mjs tooling/scripts/test/template-pins.test.mjs",
    "clean": "pnpm -r run clean",
    "release": "./tooling/scripts/release.sh",
    "release:patch": "./tooling/scripts/release.sh patch",
    "release:minor": "./tooling/scripts/release.sh minor",
    "release:major": "./tooling/scripts/release.sh major",
    "release:dry": "./tooling/scripts/release.sh patch --dry-run",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "deploy:demo": "./tooling/scripts/deploy-demo.sh",
    "deploy:demo:quick": "./tooling/scripts/deploy-demo.sh --only-deploy",
    "kill": "pkill -f 'rebase.*dev' || true; pkill -f 'tsx watch' || true; pkill -f vite || true",
    "smoke:baas": "pnpm --filter @rebasepro/server-postgres smoke:baas",
    "check:docs-imports": "node tooling/scripts/check-docs-imports.mjs",
    "check:glued-code": "node tooling/scripts/check-glued-code.mjs",
    "check:legacy-rls": "node tooling/scripts/check-legacy-rls-removable.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@types/dompurify": "^3.2.0",
    "@types/json-logic-js": "2.0.8",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "npm-run-all2": "^9.0.2",
    "ts-morph": "28.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "dompurify": "^3.4.13"
  }
}
