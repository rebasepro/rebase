{
  "name": "rebase-parent",
  "private": true,
  "description": "Open-source headless CMS and admin panel for Postgres",
  "author": "Rebase",
  "repository": {
    "type": "git",
    "url": "https://github.com/rebasepro/rebase.git"
  },
  "homepage": "https://rebase.pro",
  "workspaces": [
    "packages/types",
    "packages/utils",
    "packages/common",
    "packages/formex",
    "packages/ui",
    "packages/core",
    "packages/client",
    "packages/server-core",
    "packages/auth",
    "packages/cli",
    "packages/studio",
    "packages/admin",
    "packages/client-postgresql",
    "packages/server-postgresql",
    "packages/server-mongodb",
    "packages/client-firebase",
    "packages/plugin-data-enhancement",
    "packages/plugin-insights",
    "packages/schema-inference",
    "packages/sdk-generator",
    "packages/mcp",
    "app",
    "app/frontend",
    "app/backend",
    "app/config",
    "saas/config",
    "saas/backend",
    "saas/frontend"
  ],
  "scripts": {
    "test": "pnpm -r test",
    "dev": "cd app && run-s dev",
    "web": "cd website && run-s dev",
    "saas": "cd saas && pnpm run dev",
    "saas:prod": "./saas/scripts/dev-prod.sh",
    "deploy:web": "cd website && run-s deploy",
    "build": "pnpm --filter './packages/*' -r run build && pnpm --filter './app' -r run build",
    "build:stream": "pnpm -r run build --reporter=append-only",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "check:headless": "node scripts/headless-guard/check.mjs",
    "clean": "pnpm -r run clean",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "release:dry": "./scripts/release.sh patch --dry-run",
    "e2e": "npx playwright test -c e2e/playwright.config.ts",
    "deploy:demo": "./scripts/deploy-demo.sh",
    "deploy:demo:quick": "./scripts/deploy-demo.sh --only-deploy",
    "kill": "pkill -f 'rebase.*dev' || true; pkill -f 'tsx watch' || true; pkill -f vite || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@types/dompurify": "^3.2.0",
    "@types/json-logic-js": "2.0.8",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "npm-run-all2": "^9.0.2",
    "ts-morph": "28.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "dependencies": {
    "dompurify": "^3.4.11"
  }
}
