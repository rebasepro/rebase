{
  "//": "Authoritative whole-monorepo type check. Resolves @rebasepro/* to SOURCE (not dist), so it is immune to stale build output, build ordering, and incremental caches. Run via `pnpm typecheck`. This is the gate that `pnpm build` (esbuild, no type-check) does NOT provide.",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "module": "ESNext",
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "ignoreDeprecations": "6.0",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@rebasepro/admin": [
        "packages/admin/src"
      ],
      "@rebasepro/admin/*": [
        "packages/admin/src/*"
      ],
      "@rebasepro/auth": [
        "packages/auth/src"
      ],
      "@rebasepro/auth/*": [
        "packages/auth/src/*"
      ],
      "@rebasepro/cli": [
        "packages/cli/src"
      ],
      "@rebasepro/cli/*": [
        "packages/cli/src/*"
      ],
      "@rebasepro/client": [
        "packages/client/src"
      ],
      "@rebasepro/client/*": [
        "packages/client/src/*"
      ],
      "@rebasepro/client-firebase": [
        "packages/client-firebase/src"
      ],
      "@rebasepro/client-firebase/*": [
        "packages/client-firebase/src/*"
      ],
      "@rebasepro/client-postgres": [
        "packages/client-postgres/src"
      ],
      "@rebasepro/client-postgres/*": [
        "packages/client-postgres/src/*"
      ],
      "@rebasepro/common": [
        "packages/common/src"
      ],
      "@rebasepro/common/*": [
        "packages/common/src/*"
      ],
      "@rebasepro/app": [
        "packages/app/src"
      ],
      "@rebasepro/app/*": [
        "packages/app/src/*"
      ],
      "@rebasepro/forms": [
        "packages/forms/src"
      ],
      "@rebasepro/forms/*": [
        "packages/forms/src/*"
      ],
      "@rebasepro/mcp": [
        "packages/mcp/src"
      ],
      "@rebasepro/mcp/*": [
        "packages/mcp/src/*"
      ],
      "@rebasepro/plugin-data-enhancement": [
        "packages/plugin-data-enhancement/src"
      ],
      "@rebasepro/plugin-data-enhancement/*": [
        "packages/plugin-data-enhancement/src/*"
      ],
      "@rebasepro/plugin-insights": [
        "packages/plugin-insights/src"
      ],
      "@rebasepro/plugin-insights/*": [
        "packages/plugin-insights/src/*"
      ],
      "@rebasepro/inference": [
        "packages/inference/src"
      ],
      "@rebasepro/inference/*": [
        "packages/inference/src/*"
      ],
      "@rebasepro/codegen": [
        "packages/codegen/src"
      ],
      "@rebasepro/codegen/*": [
        "packages/codegen/src/*"
      ],
      "@rebasepro/server": [
        "packages/server/src"
      ],
      "@rebasepro/server/*": [
        "packages/server/src/*"
      ],
      "@rebasepro/server-mongo": [
        "packages/server-mongo/src"
      ],
      "@rebasepro/server-mongo/*": [
        "packages/server-mongo/src/*"
      ],
      "@rebasepro/server-postgres": [
        "packages/server-postgres/src"
      ],
      "@rebasepro/server-postgres/*": [
        "packages/server-postgres/src/*"
      ],
      "@rebasepro/studio": [
        "packages/studio/src"
      ],
      "@rebasepro/studio/*": [
        "packages/studio/src/*"
      ],
      "@rebasepro/types": [
        "packages/types/src"
      ],
      "@rebasepro/types/*": [
        "packages/types/src/*"
      ],
      "@rebasepro/ui": [
        "packages/ui/src"
      ],
      "@rebasepro/ui/*": [
        "packages/ui/src/*"
      ],
      "@rebasepro/utils": [
        "packages/utils/src"
      ],
      "@rebasepro/utils/*": [
        "packages/utils/src/*"
      ],
      "hono": [
        "node_modules/hono"
      ]
    },
    "typeRoots": [
      "node_modules/.pnpm/node_modules/@types",
      "node_modules/@types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/admin/src",
    "packages/auth/src",
    "packages/cli/src",
    "packages/client/src",
    "packages/client-firebase/src",
    "packages/client-postgres/src",
    "packages/common/src",
    "packages/app/src",
    "packages/forms/src",
    "packages/mcp/src",
    "packages/plugin-data-enhancement/src",
    "packages/plugin-insights/src",
    "packages/inference/src",
    "packages/codegen/src",
    "packages/server/src",
    "packages/server-mongo/src",
    "packages/server-postgres/src",
    "packages/studio/src",
    "packages/types/src",
    "packages/ui/src",
    "packages/utils/src"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__",
    "**/test/**",
    "packages/*/src/test/**"
  ]
}
