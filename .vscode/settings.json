{
    "files.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/lib": true,
        "**/.turbo": true,
        "**/coverage": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/lib": true,
        "**/.turbo": true,
        "**/coverage": true
    },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/lib/**": true,
        "**/.turbo/**": true
    },
    "typescript.preferences.autoImportFileExcludePatterns": [
        "**/dist/**",
        "**/build/**",
        "**/lib/**",
        "**/*.d.ts",
        "*.d.ts"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    }
}