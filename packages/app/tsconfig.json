{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDir": ".",
    "outDir": "dist",
    "module": "ESNEXT",
    "target": "ESNEXT",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,

    "declaration": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // `vitePlugin.ts` imports `./mcp_view_build.ts` with its extension: a
    // Vite config may load the plugin from source under Node, which resolves
    // no extensionless relative import. (The package emits declarations only.)
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node",
      "jest"
    ],
    "paths": {
      "@rebasepro/ui": [
        "../ui/src"
      ],
      "@rebasepro/common": [
        "../common/src"
      ],
      "@rebasepro/types": [
        "../types/src"
      ],
      "@rebasepro/forms": [
        "../forms/src"
      ],
      "@rebasepro/utils": [
        "../utils/src"
      ]
    }
  },
  "include": [
    "src",
    "./src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/test"
  ]
}
