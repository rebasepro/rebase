{
  "name": "@rebasepro/admin",
  "type": "module",
  "version": "0.14.0",
  "description": "Rebase CMS — content management views, forms, and routing",
  "funding": {
    "url": "https://github.com/sponsors/rebaseco"
  },
  "author": "Rebase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rebasepro/rebase.git",
    "directory": "packages/admin"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "src/index.ts",
  "engines": {
    "node": ">=22.22.0"
  },
  "keywords": [
    "rebase",
    "cms",
    "admin",
    "admin panel",
    "postgresql",
    "typescript",
    "headless",
    "headless cms",
    "content manager"
  ],
  "scripts": {
    "prepack": "node -e \"const ua=process.env.npm_config_user_agent||'';if(ua.startsWith('pnpm'))process.exit(0);const p=JSON.parse(require('fs').readFileSync('package.json','utf8'));const d=Object.assign({},p.dependencies,p.peerDependencies);const ws=Object.entries(d).filter(([,v])=>String(v).startsWith('workspace:'));if(ws.length){console.error('ERROR: workspace: protocol found — use pnpm publish, not npm publish. Deps:',JSON.stringify(ws));process.exit(1)}\"",
    "watch": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.prod.json && node ../../scripts/assert-build-output.mjs",
    "test:lint": "eslint \"src/**\" --quiet",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist && find ./src -name '*.js' -type f | xargs rm -f",
    "generateIcons": "ts-node --esm src/icons/generateIcons.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "development": "./dist/editor.js",
      "import": "./dist/editor.js"
    },
    "./collection_editor_ui": {
      "types": "./dist/collection_editor_ui.d.ts",
      "development": "./dist/collection_editor_ui.js",
      "import": "./dist/collection_editor_ui.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.8.0",
    "@rebasepro/admin-types": "workspace:*",
    "@rebasepro/app": "workspace:*",
    "@rebasepro/common": "workspace:*",
    "@rebasepro/forms": "workspace:*",
    "@rebasepro/inference": "workspace:*",
    "@rebasepro/types": "workspace:*",
    "@rebasepro/ui": "workspace:*",
    "@rebasepro/utils": "workspace:*",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "fast-equals": "6.0.2",
    "fractional-indexing": "4.0.0",
    "fuse.js": "^7.5.0",
    "json5": "^2.2.3",
    "markdown-it": "^14.3.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "react-dropzone": "^19.1.1",
    "react-use-measure": "^2.1.7",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-measure": "^2.0.12",
    "@vitejs/plugin-react": "^6.0.4",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "react-router": "^8.3.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "files": [
    "dist",
    "src"
  ],
  "gitHead": "d935eefa5aa8d1009a2398cfac2c1e4ee9aeb6b6",
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.m?jsx?$": "<rootDir>/../../scripts/jest/react-router-esm-transform.cjs"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "mjs",
      "jsx",
      "json",
      "node"
    ],
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transformIgnorePatterns": [],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setupTests.ts"
    ],
    "moduleNameMapper": {
      "\\.(css|less)$": "<rootDir>/test/__mocks__/styleMock.js",
      "^@rebasepro/([a-z0-9-]+)$": "<rootDir>/../$1/src/index.ts",
      "^@rebasepro/admin-types$": "<rootDir>/../admin-types/src/index.ts"
    }
  }
}
