{
  "name": "@rebasepro/admin",
  "type": "module",
  "version": "0.2.1",
  "description": "Rebase CMS — content management views, forms, and routing",
  "funding": {
    "url": "https://github.com/sponsors/rebaseco"
  },
  "author": "Rebase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rebasepro/rebase.git",
    "directory": "packages/admin"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "src/index.ts",
  "engines": {
    "node": ">=14"
  },
  "keywords": [
    "rebase",
    "cms",
    "admin",
    "admin panel",
    "postgresql",
    "typescript",
    "headless",
    "headless cms",
    "content manager"
  ],
  "scripts": {
    "watch": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.prod.json",
    "test:lint": "eslint \"src/**\" --quiet",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist && find ./src -name '*.js' -type f | xargs rm -f",
    "generateIcons": "ts-node --esm src/icons/generateIcons.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "development": "./dist/editor.js",
      "import": "./dist/editor.js"
    },
    "./collection_editor_ui": {
      "types": "./dist/collection_editor_ui.d.ts",
      "development": "./dist/collection_editor_ui.js",
      "import": "./dist/collection_editor_ui.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.7.6",
    "@rebasepro/common": "workspace:*",
    "@rebasepro/core": "workspace:*",
    "@rebasepro/formex": "workspace:*",
    "@rebasepro/schema-inference": "workspace:*",
    "@rebasepro/types": "workspace:*",
    "@rebasepro/ui": "workspace:*",
    "@rebasepro/utils": "workspace:*",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "fast-equals": "6.0.0",
    "fractional-indexing": "3.2.0",
    "fuse.js": "^7.3.0",
    "json5": "^2.2.3",
    "markdown-it": "^14.1.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.7",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.8",
    "react-dropzone": "^14.4.1",
    "react-use-measure": "^2.1.7",
    "exceljs": "^4.4.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router": "^7.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-measure": "^2.0.12",
    "@vitejs/plugin-react": "^4.7.0",
    "jest": "^29.7.0",
    "react-router": "^7.15.1",
    "react-router-dom": "^7.15.1",
    "ts-jest": "^29.4.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "gitHead": "d935eefa5aa8d1009a2398cfac2c1e4ee9aeb6b6",
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setupTests.ts"
    ],
    "moduleNameMapper": {
      "\\.(css|less)$": "<rootDir>/test/__mocks__/styleMock.js",
      "^@rebasepro/ui$": "<rootDir>/../ui/src/index.ts",
      "^@rebasepro/core$": "<rootDir>/../core/src/index.ts",
      "^@rebasepro/common$": "<rootDir>/../common/src/index.ts",
      "^@rebasepro/types$": "<rootDir>/../types/src/index.ts",
      "^@rebasepro/formex$": "<rootDir>/../formex/src/index.ts",
      "^@rebasepro/utils$": "<rootDir>/../utils/src/index.ts"
    }
  }
}
