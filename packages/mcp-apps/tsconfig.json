{
  "compilerOptions": {
    "rootDir": "..",
    "module": "ESNEXT",
    "target": "ESNEXT",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "vite/client",
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@rebasepro/cms/mcp-view": [
        "../cms/src/mcp-view.ts"
      ],
      "@rebasepro/*": [
        "../*/src/index.ts"
      ],
      "react-router": [
        "../cms/node_modules/react-router/dist/production/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "views",
    "test"
  ]
}
