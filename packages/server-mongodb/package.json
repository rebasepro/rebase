{
  "name": "@rebasepro/server-mongodb",
  "type": "module",
  "version": "0.7.0",
  "description": "MongoDB backend for Rebase",
  "funding": {
    "url": "https://github.com/sponsors/rebaseco"
  },
  "author": "Rebase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rebasepro/rebase.git",
    "directory": "packages/server-mongodb"
  },
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "source": "src/index.ts",
  "engines": {
    "node": ">=14"
  },
  "keywords": [
    "rebase",
    "cms",
    "admin",
    "admin panel",
    "mongodb",
    "backend",
    "database"
  ],
  "scripts": {
    "watch": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.prod.json",
    "test:lint": "eslint \"src/**\" --quiet",
    "test": "jest --passWithNoTests --forceExit",
    "clean": "rm -rf dist && find ./src -name '*.js' -type f | xargs rm -f"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.es.js",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rebasepro/common": "workspace:*",
    "@rebasepro/types": "workspace:*",
    "@rebasepro/utils": "workspace:*",
    "mongodb": "^7.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "ts-jest": "29.4.11",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "@rebasepro/server-core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@rebasepro/server-core": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "gitHead": "d935eefa5aa8d1009a2398cfac2c1e4ee9aeb6b6",
  "publishConfig": {
    "access": "public"
  }
}
