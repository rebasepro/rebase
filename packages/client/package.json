{
  "name": "@rebasepro/client",
  "type": "module",
  "version": "0.5.0",
  "description": "HTTP SDK client for the Rebase custom backend",
  "funding": {
    "url": "https://github.com/sponsors/rebaseco"
  },
  "author": "Rebase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rebasepro/rebase.git",
    "directory": "packages/client"
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "source": "src/index.ts",
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "watch": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.prod.json",
    "test:lint": "eslint \"src/**\" --quiet",
    "test": "jest --passWithNoTests --forceExit",
    "clean": "rm -rf dist && find ./src -name '*.js' -type f | xargs rm -f"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.es.js",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rebasepro/common": "workspace:*",
    "@rebasepro/types": "workspace:*",
    "@rebasepro/utils": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "files": [
    "dist",
    "src"
  ],
  "gitHead": "d935eefa5aa8d1009a2398cfac2c1e4ee9aeb6b6",
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@rebasepro/types$": "<rootDir>/../types/src/index.ts",
      "^@rebasepro/utils$": "<rootDir>/../utils/src/index.ts"
    }
  }
}
