{
  "name": "@rebasepro/server-postgresql",
  "type": "module",
  "version": "0.4.0",
  "description": "PostgreSQL data source backend implementation for Rebase with Drizzle ORM",
  "funding": {
    "url": "https://github.com/sponsors/rebaseco"
  },
  "author": "Rebase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rebasepro/rebase.git",
    "directory": "packages/server-postgresql"
  },
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "source": "src/index.ts",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cms",
    "admin",
    "postgresql",
    "database",
    "drizzle",
    "backend",
    "rebase"
  ],
  "scripts": {
    "watch": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.prod.json",
    "test:lint": "eslint \"src/**\" --quiet",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist && find ./src -name '*.js' -type f | xargs rm -f"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "^@rebasepro/client$": "<rootDir>/../client/src/index.ts",
      "^@rebasepro/common$": "<rootDir>/../common/src/index.ts",
      "^@rebasepro/types$": "<rootDir>/../types/src/index.ts",
      "^@rebasepro/utils$": "<rootDir>/../utils/src/index.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.es.js",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rebasepro/common": "workspace:*",
    "@rebasepro/sdk-generator": "workspace:*",
    "@rebasepro/server-core": "workspace:*",
    "@rebasepro/types": "workspace:*",
    "@rebasepro/utils": "workspace:*",
    "arg": "^5.0.2",
    "chalk": "^5.6.2",
    "chokidar": "5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.6.1",
    "hono": "^4.12.25",
    "pg": "^8.21.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "gitHead": "d935eefa5aa8d1009a2398cfac2c1e4ee9aeb6b6",
  "publishConfig": {
    "access": "public"
  }
}
