        "meaning": "The role your application's requests run as, as a quoted identifier — run SELECT current_user; on the application's own connection.",
        "token": "<app_role>",
      },
    ],
    "rebase": {
      "applicable": true,
      "note": "A rule without \`pgRoles\` applies TO PUBLIC — every connection — and Rebase's API decides who is signed in; \`pgRoles\` is what pointed these policies at reporting_bot. A raw rule keeps the expression as SQL; Rebase writes it into the policy as is, with \`{column}\` standing for the row being checked. https://rebase.pro/docs/collections/security-rules",
      "securityRules": "[
    { name: "todos_reports", operation: "select", using: "true" }
]",
      "snippet": "// The collection whose table is public.todos (config/collections/ in a Rebase project)
defineCollection({
    // …name, slug, properties and the rest stay as they are…
    table: "todos",
    securityRules: [
        { name: "todos_reports", operation: "select", using: "true" }
    ]
});",
    },
    "sql": "ALTER POLICY "todos_reports" ON "public"."todos" TO <app_role>;",
    "summary": "Point the policy on public.todos at the role your application connects as; today it names only reporting_bot, which no session uses.",
  },
}
`;

