exports[`remediation per check id > 'anonymous-write-allowed' 1`] = `
{
  "key": "anonymous-write-allowed:public.todos:todos_insert",
  "remediation": {
    "alternatives": [
      {
        "sql": "REVOKE INSERT ON "public"."todos" FROM "anon";",
        "summary": "If no unauthenticated caller should ever write this table, also take the privilege away.",
      },
    ],
    "apply": "sql",
    "caveats": [],
    "placeholders": [],
    "rebase": {
      "applicable": true,
      "note": "Rebase enables row-level security on every collection's table and compiles each rule into a policy at boot and on \`rebase db push\`; \`ownerField\` compiles to \`<column>::text = rebase.uid()\`, so a row is visible and writable only to the user whose id it holds. https://rebase.pro/docs/collections/security-rules",
      "securityRules": "[
    { name: "todos_insert", operation: "insert", ownerField: "user_id" }
]",
      "snippet": "// The collection whose table is public.todos (config/collections/ in a Rebase project)
defineCollection({
    // …name, slug, properties and the rest stay as they are…
    table: "todos",
    securityRules: [
        { name: "todos_insert", operation: "insert", ownerField: "user_id" }
    ]
});",
    },
    "sql": "ALTER POLICY "todos_insert" ON "public"."todos"
    WITH CHECK ("user_id" = auth.uid());",
    "summary": "Scope the writes policy "todos_insert" on public.todos admits to the row's owner, so a request without credentials — whose caller id matches no row — is refused.",
  },
}
`;

