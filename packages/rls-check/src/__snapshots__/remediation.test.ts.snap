exports[`remediation per check id > 'junction-table-unprotected' 1`] = `
{
  "key": "junction-table-unprotected:public.post_tags",
  "remediation": {
    "alternatives": [
      {
        "sql": "REVOKE SELECT ON "public"."post_tags" FROM "anon";",
        "summary": "If callers never read the join table directly, revoke their privileges instead.",
      },
    ],
    "apply": "sql",
    "caveats": [
      "INSERT, UPDATE and DELETE on public.post_tags are refused for every API role until a policy admits them: decide who may create a link — usually the owner of one endpoint — and add that policy.",
      "rls-check inferred that public.post_tags is a join table from its shape; confirm before applying.",
    ],
    "placeholders": [],
    "rebase": {
      "applicable": true,
      "note": "If this is the junction of a many-to-many link, declare it as a \`relation\` property with \`kind: "manyToMany"\` instead: Rebase then creates the junction itself, with row-level security on and policies derived from both collections. The rule here is for a join table modelled as its own collection. A raw rule keeps the expression as SQL; Rebase writes it into the policy as is, with \`{column}\` standing for the row being checked. https://rebase.pro/docs/collections/security-rules",
      "securityRules": "[
    { name: "post_tags_select_via_endpoints", operation: "select", using: "EXISTS (SELECT 1 FROM \\"public\\".\\"posts\\" AS e1 WHERE e1.\\"id\\" = {post_id}) AND EXISTS (SELECT 1 FROM \\"public\\".\\"tags\\" AS e2 WHERE e2.\\"id\\" = {tag_id})" }
]",
      "snippet": "// The collection whose table is public.post_tags (config/collections/ in a Rebase project)
defineCollection({
    // …name, slug, properties and the rest stay as they are…
    table: "post_tags",
    securityRules: [
        { name: "post_tags_select_via_endpoints", operation: "select", using: "EXISTS (SELECT 1 FROM \\"public\\".\\"posts\\" AS e1 WHERE e1.\\"id\\" = {post_id}) AND EXISTS (SELECT 1 FROM \\"public\\".\\"tags\\" AS e2 WHERE e2.\\"id\\" = {tag_id})" }
    ]
});",
    },
    "sql": "ALTER TABLE "public"."post_tags" ENABLE ROW LEVEL SECURITY;
CREATE POLICY "post_tags_select_via_endpoints" ON "public"."post_tags"
    FOR SELECT
    USING (EXISTS (SELECT 1 FROM "public"."posts" AS e1 WHERE e1."id" = "post_tags"."post_id") AND EXISTS (SELECT 1 FROM "public"."tags" AS e2 WHERE e2."id" = "post_tags"."tag_id"));",
    "summary": "Enable row-level security on public.post_tags and let a caller read a link only when it can read both rows it joins (public.posts and public.tags).",
  },
}
`;

