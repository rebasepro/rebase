exports[`remediation per check id > 'security-definer-mutable-search-path' 1`] = `
{
  "key": "security-definer-mutable-search-path:public.promote_user()",
  "remediation": {
    "alternatives": [],
    "apply": "sql",
    "caveats": [
      "Only pg_catalog is on the path afterwards: schema-qualify every table and function the body uses (public.orders, not orders), or the routine fails at its next call.",
    ],
    "placeholders": [],
    "rebase": {
      "applicable": false,
      "note": "Not a securityRules setting: it concerns a function, not a collection's rows.",
      "securityRules": null,
      "snippet": null,
    },
    "sql": "DO $$
DECLARE r record;
BEGIN
    FOR r IN
        SELECT p.oid::regprocedure AS sig
        FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
        WHERE n.nspname = 'public' AND p.proname = 'promote_user'
    LOOP
        EXECUTE format('ALTER ROUTINE %s SET search_path = pg_catalog, pg_temp', r.sig);
    END LOOP;
END $$;",
    "summary": "Pin search_path on every overload of the SECURITY DEFINER routine public.promote_user.",
  },
}
`;

exports[`remediation per check id > 'unqualified-column-in-subquery: a col…' 1`] = `
{
  "key": "unqualified-column-in-subquery:public.documents:documents_select:org_id",
  "remediation": {
    "alternatives": [],
    "apply": "sql",
    "caveats": [
      "This assumes documents.org_id — the row being checked — was meant, not public.memberships.org_id. Confirm before applying: it changes which rows the policy admits.",
    ],
    "placeholders": [],
    "rebase": {
      "applicable": true,
      "note": "A raw rule keeps the expression as SQL; Rebase writes it into the policy as is, with \`{column}\` standing for the row being checked. Rebase rewrites \`auth.uid()\` to \`rebase.uid()\`, which returns text: compare a uuid column with it as \`{column}::text = rebase.uid()\`. The structured form, \`policy.existsIn({ collection, where })\` with \`policy.outerField("…")\` for the outer row, makes the binding explicit and is checked by the type system. https://rebase.pro/docs/collections/security-rules",
      "securityRules": "[
    { name: "documents_select", operation: "select", using: "(EXISTS ( SELECT 1 FROM memberships WHERE ((memberships.user_id = auth.uid()) AND (memberships.org_id = {org_id}))))" }
]",
      "snippet": "// The collection whose table is public.documents (config/collections/ in a Rebase project)
defineCollection({
    // …name, slug, properties and the rest stay as they are…
    table: "documents",
    securityRules: [
        { name: "documents_select", operation: "select", using: "(EXISTS ( SELECT 1 FROM memberships WHERE ((memberships.user_id = auth.uid()) AND (memberships.org_id = {org_id}))))" }
    ]
});",
    },
    "sql": "ALTER POLICY "documents_select" ON "public"."documents"
    USING ((EXISTS ( SELECT 1 FROM memberships WHERE ((memberships.user_id = auth.uid()) AND (memberships.org_id = "documents"."org_id")))));",
    "summary": "Point \`org_id\` in policy "documents_select" on public.documents at the row being checked, documents.org_id.",
  },
}
`;

