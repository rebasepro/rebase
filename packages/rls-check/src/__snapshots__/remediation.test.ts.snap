exports[`remediation per check id > 'rls-disabled: a text owner column is …' 1`] = `
{
  "key": "rls-disabled:public.todos",
  "remediation": {
    "alternatives": [
      {
        "sql": "REVOKE SELECT ON "public"."todos" FROM "anon";",
        "summary": "If API callers should not reach this table at all, revoke their privileges instead.",
      },
    ],
    "apply": "sql",
    "caveats": [
      "This database was not recognised as Supabase, so \`auth.uid()\` may not exist here. Replace it with however your API hands Postgres the caller's id — on PostgREST, \`(current_setting('request.jwt.claims', true)::json ->> 'sub')\`, cast to the owner column's type.",
      "With row-level security on, every role that neither owns the table nor holds BYPASSRLS sees only the rows a policy admits — a backend job connecting as such a role is filtered too.",
    ],
    "placeholders": [],
    "rebase": {
      "applicable": true,
      "note": "Rebase enables row-level security on every collection's table and compiles each rule into a policy at boot and on \`rebase db push\`; \`ownerField\` compiles to \`<column>::text = rebase.uid()\`, so a row is visible and writable only to the user whose id it holds. Declare the table as a collection, or add the rule to the one that maps it. https://rebase.pro/docs/collections/security-rules",
      "securityRules": "[
    { operation: "all", ownerField: "owner_id" }
]",
      "snippet": "// The collection whose table is public.todos (config/collections/ in a Rebase project)
defineCollection({
    // …name, slug, properties and the rest stay as they are…
    table: "todos",
    securityRules: [
        { operation: "all", ownerField: "owner_id" }
    ]
});",
    },
    "sql": "ALTER TABLE "public"."todos" ENABLE ROW LEVEL SECURITY;
CREATE POLICY "todos_owner" ON "public"."todos"
    FOR ALL
    USING ("owner_id" = auth.uid()::text)
    WITH CHECK ("owner_id" = auth.uid()::text);",
    "summary": "Enable row-level security on public.todos and add a policy that limits every row to its owner.",
  },
}
`;

