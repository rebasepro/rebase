{
    "extends": "./tsconfig.json",
    "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "paths": {},
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        // No declarationMap: a .d.ts.map points at `../src/*.ts`, and `src` is
        // not published. Emitting one ships a go-to-definition target that
        // resolves to a file the tarball does not contain. The JS sourcemaps
        // carry full `sourcesContent`, so stepping through the real sources
        // still works — it is only this dangling pointer that goes.
        "outDir": "dist"
    },
    "exclude": [
        "node_modules",
        "dist",
        "test",
        "**/*.test.ts"
    ]
}