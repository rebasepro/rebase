{
  "name": "@rebasepro/client-postgresql",
  "type": "module",
  "version": "0.2.0",
  "description": "PostgreSQL data source client for Rebase",
  "funding": {
    "url": "https://github.com/sponsors/rebaseco"
  },
  "author": "Rebase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rebasepro/rebase.git",
    "directory": "packages/client-postgresql"
  },
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "source": "src/index.ts",
  "engines": {
    "node": ">=14"
  },
  "keywords": [
    "rebase",
    "postgresql",
    "database",
    "client",
    "typescript",
    "admin"
  ],
  "scripts": {
    "watch": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.prod.json",
    "test:lint": "eslint \"src/**\" --quiet",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist && find ./src -name '*.js' -type f | xargs rm -f"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "^@rebasepro/core$": "<rootDir>/../core/src/index.ts",
      "^@rebasepro/common$": "<rootDir>/../common/src/index.ts",
      "^@rebasepro/types$": "<rootDir>/../types/src/index.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.es.js",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rebasepro/client": "workspace:*",
    "@rebasepro/types": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.10",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "gitHead": "d935eefa5aa8d1009a2398cfac2c1e4ee9aeb6b6",
  "publishConfig": {
    "access": "public"
  }
}
