{
  "name": "@rebasepro/cli",
  "version": "0.2.0",
  "description": "Developer tools for Rebase projects",
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "source": "src/index.ts",
  "bin": {
    "rebase": "bin/rebase.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "clean": "rm -rf dist && find ./src -name '*.js' -type f | xargs rm -f"
  },
  "keywords": [
    "cli",
    "create-rebase-app",
    "rebase",
    "cms",
    "react",
    "typescript",
    "postgresql"
  ],
  "author": "rebase.pro",
  "license": "MIT",
  "dependencies": {
    "@rebasepro/sdk-generator": "workspace:*",
    "@rebasepro/server-core": "workspace:*",
    "@rebasepro/types": "workspace:*",
    "arg": "^5.0.2",
    "chalk": "^5.6.2",
    "dotenv": "^16.6.1",
    "execa": "^9.6.1",
    "inquirer": "12.11.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "pg": "^8.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "4.1.5"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    }
  },
  "exclude": [
    "node_modules",
    "templates/template/node_modules"
  ],
  "gitHead": "d935eefa5aa8d1009a2398cfac2c1e4ee9aeb6b6"
}
