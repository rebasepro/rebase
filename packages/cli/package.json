{
  "name": "@rebasepro/cli",
  "version": "0.6.1",
  "description": "Developer tools for Rebase projects",
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "source": "src/index.ts",
  "bin": {
    "rebase": "bin/rebase.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prebuild": "rm -rf skills && cp -r ../../rebase-agent-skills/skills skills",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "clean": "rm -rf dist skills && find ./src -name '*.js' -type f | xargs rm -f"
  },
  "keywords": [
    "cli",
    "create-rebase-app",
    "rebase",
    "cms",
    "react",
    "typescript",
    "postgresql"
  ],
  "author": "rebase.pro",
  "license": "MIT",
  "dependencies": {
    "@rebasepro/sdk-generator": "workspace:*",
    "@rebasepro/server-core": "workspace:*",
    "@rebasepro/server-postgresql": "workspace:*",
    "@rebasepro/types": "workspace:*",
    "arg": "^5.0.2",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "inquirer": "14.0.2",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "pg": "^8.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "4.1.8"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "skills/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rebasepro/rebase.git",
    "directory": "packages/cli"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
