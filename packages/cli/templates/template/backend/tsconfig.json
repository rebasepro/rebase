{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    // Everything this program compiles lives under backend/, so the emit
    // mirrors it: `dist/schema/…`, `dist/functions/…`, `dist/src/…`. Saying so
    // is required from TypeScript 6, which refuses to infer it (TS5011).
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "jsx": "preserve",
    // Pin the ambient type libraries.
    //
    // Unset, TypeScript sweeps every `node_modules/@types` it can reach and
    // treats each folder as an implicit type library. Under pnpm that reaches
    // the virtual store, where packages hoisted for peer resolution live —
    // `dompurify` among them, pulled in transitively by the admin editor. The
    // backend has no dependency on it and cannot resolve its entry point, so
    // `rebase build` failed the whole bundle with:
    //
    //     error TS2688: Cannot find type definition file for 'dompurify'
    //
    // `frontend/tsconfig.json` has always pinned its own list, which is why the
    // frontend never saw this. Naming what this program needs is both the fix
    // and the faster compile.
    "types": ["node"]
  },
  // Every directory you write server code in, so `tsc` checks all of it:
  //
  // `schema/` holds the tables, and `resources.ts` / `storage.ts` what the
  // runtime reads beside them. `functions/` are your routes — the one place
  // you write server code by hand, so the one place a type error must not wait
  // until runtime. `crons/`: `rebase build` compiles it through a generated
  // tsconfig, but an ejected project builds with *this* file, so leaving it out
  // meant an ejected server had no compiled jobs and stopped every schedule.
  // `scripts/` because that is where the Scripts page puts a script that opens
  // the project with `openRebase`, typed by the same `Database` as a function.
  // `generated/` holds `register.ts`, which `rebase generate-sdk --register`
  // writes so `Database` is the generated one everywhere this program compiles.
  "include": ["src/**/*", "schema/**/*", "functions/**/*", "crons/**/*", "scripts/**/*", "generated/**/*", "resources.ts", "storage.ts"]
}
