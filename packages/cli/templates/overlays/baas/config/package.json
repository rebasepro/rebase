{
  "name": "{{PROJECT_NAME}}-config",
  "version": "1.0.0",
  "description": "Storage access control for a headless Rebase project",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc && rebase normalize-imports dist",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rebasepro/common": "workspace:*",
    "@rebasepro/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
