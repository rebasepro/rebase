/**
 * __LABEL__ — a screen of the admin panel, at /__SLUG__.
 *
 * Scaffolded by `rebase generate view __SLUG__` and listed in `./index.ts`.
 * It renders inside the admin shell, so the signed-in user, the sidebar, the
 * router and the data layer are already there: read rows with `useRows()`,
 * write them with `useRowWrites()`, and the table's `rls` rules and hooks
 * apply.
 *
 * Replace the body with your screen. The `rebase-custom-views` agent skill
 * documents the contract and the design tokens.
 */
import { useState } from "react";
import { useAuthController, useRows, useSnackbarController } from "@rebasepro/app";
import {
    Button,
    Card,
    Chip,
    CircularProgressCenter,
    Container,
    Sheet,
    Tab,
    Table,
    TableBody,
    TableCell,
    TableHeader,
    TableRow,
    Tabs,
    Typography
} from "@rebasepro/ui";

/** The table this screen reads. Change it to the one you need. */
const COLLECTION = "__COLLECTION__";

export function __COMPONENT__() {
    const { user } = useAuthController();
    const snackbar = useSnackbarController();
    // Rows as the server sends them, kept current after every write.
    const { rows, loading, error, refresh } = useRows(COLLECTION, { limit: 20 });

    const [tab, setTab] = useState("rows");
    const [selected, setSelected] = useState<Record<string, unknown> | undefined>();

    const columns = rows[0] ? Object.keys(rows[0]).filter(key => key !== "id").slice(0, 3) : [];

    return (
        <Container maxWidth="6xl" className="py-8 flex flex-col gap-4">
            <div className="flex items-start justify-between gap-4">
                <div className="flex flex-col gap-1">
                    <Typography variant="h5">__LABEL_JSX__</Typography>
                    <Typography variant="body2" color="secondary">
                        Signed in as {user?.displayName ?? user?.email ?? "an anonymous user"}
                    </Typography>
                </div>
                <Button color="primary" onClick={() => {
                    refresh();
                    snackbar.open({ type: "success", message: "Refreshed" });
                }}>
                    Refresh
                </Button>
            </div>

            <Tabs value={tab} onValueChange={setTab}>
                <Tab value="rows">Rows</Tab>
                <Tab value="summary">Summary</Tab>
            </Tabs>

            {error && <Typography color="error">{error}</Typography>}
            {!error && loading && rows.length === 0 && <CircularProgressCenter/>}

            {!error && tab === "rows" && (
                <Card className="overflow-hidden">
                    <Table>
                        <TableHeader>
                            <TableCell>id</TableCell>
                            {columns.map(column => <TableCell key={column}>{column}</TableCell>)}
                        </TableHeader>
                        <TableBody>
                            {rows.map(row => (
                                <TableRow key={String(row.id)} onClick={() => setSelected(row)}>
                                    <TableCell>{String(row.id)}</TableCell>
                                    {columns.map(column => <TableCell key={column}>{display(row[column])}</TableCell>)}
                                </TableRow>
                            ))}
                        </TableBody>
                    </Table>
                </Card>
            )}

            {!error && tab === "summary" && (
                <div className="grid grid-cols-2 gap-4">
                    <Card className="p-4 flex flex-col gap-1">
                        <Typography variant="caption" color="secondary">Rows loaded</Typography>
                        <Typography variant="stat">{rows.length}</Typography>
                    </Card>
                    <Card className="p-4 flex flex-col gap-2 items-start">
                        <Typography variant="caption" color="secondary">Table</Typography>
                        <Chip size="small">{COLLECTION}</Chip>
                    </Card>
                </div>
            )}

            <Sheet open={selected !== undefined} onOpenChange={open => !open && setSelected(undefined)} title="Row">
                <div className="w-[28rem] max-w-full h-full overflow-auto p-6 flex flex-col gap-3">
                    <Typography variant="h6">{selected ? String(selected.id) : ""}</Typography>
                    {selected && Object.entries(selected).map(([key, value]) => (
                        <div key={key} className="flex flex-col gap-0.5">
                            <Typography variant="caption" color="secondary">{key}</Typography>
                            <Typography variant="body2">{display(value)}</Typography>
                        </div>
                    ))}
                </div>
            </Sheet>
        </Container>
    );
}

/** A cell's text. A date arrives as its ISO string, a belongsTo as its foreign key. */
function display(value: unknown): string {
    if (value === null || value === undefined) return "—";
    if (typeof value === "object") return JSON.stringify(value);
    return String(value);
}

export default __COMPONENT__;
