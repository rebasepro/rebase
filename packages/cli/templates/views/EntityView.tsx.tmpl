/**
 * __LABEL__ — a tab on every record of the `__COLLECTION__` table.
 *
 * Scaffolded by `rebase generate view __SLUG__ --collection __COLLECTION__` and
 * listed in the `entityViews` of that table's `customizeTable(…)` under
 * `src/cms`, which the admin bundles and the backend never reads.
 *
 * The admin hands the component `EntityCustomViewParams`: the collection, the
 * saved record as the server sends the row (`row`) and its id (`id`), both
 * absent while it is being created, the form's values with unsaved edits
 * (`modifiedValues`) and the form (`formContext`). The `rebase-custom-views` agent skill documents the
 * contract and the design tokens.
 */
import type { EntityCustomViewParams } from "@rebasepro/cms-types";
import { useSnackbarController } from "@rebasepro/app";
import { Button, Card, Chip, Typography } from "@rebasepro/ui";

export function __COMPONENT__({ collection, row, modifiedValues, formContext }: EntityCustomViewParams) {
    const snackbar = useSnackbarController();
    const values = modifiedValues ?? row ?? {};

    if (!row) {
        return (
            <div className="p-6">
                <Typography variant="body2" color="secondary">
                    Save this {collection.singularName ?? collection.name} to see __label_jsx__.
                </Typography>
            </div>
        );
    }

    const copy = () => navigator.clipboard.writeText(JSON.stringify(values, null, 2))
        .then(() => snackbar.open({ type: "success", message: "Copied" }));

    return (
        <div className="p-6 flex flex-col gap-4">
            <div className="flex items-center justify-between gap-2">
                <Typography variant="h6">__LABEL_JSX__</Typography>
                {formContext.readOnly && <Chip size="small">Read only</Chip>}
            </div>
            <Card className="p-4 flex flex-col gap-3">
                {Object.entries(values).map(([key, value]) => (
                    <div key={key} className="flex flex-col gap-0.5">
                        <Typography variant="caption" color="secondary">{key}</Typography>
                        <Typography variant="body2">{display(value)}</Typography>
                    </div>
                ))}
            </Card>
            <div>
                <Button color="neutral" variant="outlined" onClick={copy}>Copy as JSON</Button>
            </div>
        </div>
    );
}

/** A field's text. In the form's values a date is a `Date`; in the row, ISO text. */
function display(value: unknown): string {
    if (value === null || value === undefined) return "—";
    if (value instanceof Date) return value.toLocaleString();
    if (typeof value === "object") return JSON.stringify(value);
    return String(value);
}

export default __COMPONENT__;
